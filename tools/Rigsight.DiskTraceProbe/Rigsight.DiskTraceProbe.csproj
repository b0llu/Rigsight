<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measures the agent's disk trace (Storage\DiskTrace.cs) on its own: its CPU at rest and under heavy disk work, events a
       second, memory, and which process each read and write is put down to. Needs admin rights; a test data folder only.
       Not in the solution: run it by hand (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredCompilation>true</TieredCompilation>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rigsight.Agent\Rigsight.Agent.csproj" />
  </ItemGroup>

</Project>
