<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Tests run with the runtime's normal (tiered) compilation, like any test project. -->
    <TieredCompilation>true</TieredCompilation>
    <NoWarn>$(NoWarn);WPF0001;WFO0003;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rigsight.Core\Rigsight.Core.csproj" />
    <ProjectReference Include="..\..\src\Rigsight.Agent\Rigsight.Agent.csproj" />
    <ProjectReference Include="..\..\src\Rigsight\Rigsight.csproj" />
  </ItemGroup>

</Project>
