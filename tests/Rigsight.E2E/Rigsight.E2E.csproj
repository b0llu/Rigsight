<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end check of built Rigsight: runs the agent and app as an isolated test copy (their own data, pipe and
       names; never the real ones), drives the window, and measures startup, CPU, memory and handles. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- System.Drawing, for screenshots. -->
    <UseWindowsForms>true</UseWindowsForms>
    <TieredCompilation>true</TieredCompilation>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Rigsight.Tests\Support\SeedData.cs" Link="SeedData.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rigsight.Core\Rigsight.Core.csproj" />
  </ItemGroup>

</Project>
