<Project>
  <PropertyGroup>
    <Version>0.5.2</Version>
    <Product>Rigsight</Product>
    <Company>Rigsight</Company>
    <Copyright>Rigsight</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- English only: skips the framework's translated resource folders (smaller installer). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- The agent and the app are built into one folder so each can find the other. -->
    <SharedBinDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\</SharedBinDir>
    <!-- Memory and CPU (measured): code is compiled ahead of time when published (ReadyToRun) and used as is,
         instead of being compiled at runtime and then again for speed (tiered compilation). About 4 MB less
         for the agent and a large part of the app's CPU while it's open. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <!-- Test installers only (RigsightTestFeed=true): updates may come from a local test server. See ReleaseFeed. -->
    <DefineConstants Condition="'$(RigsightTestFeed)' == 'true'">$(DefineConstants);RIGSIGHT_TEST_FEED</DefineConstants>
  </PropertyGroup>
</Project>
