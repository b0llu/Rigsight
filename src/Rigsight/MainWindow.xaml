<Window x:Class="Rigsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rigsight.Views"
        Title="Rigsight" Icon="Assets/Rigsight.ico"
        Width="1400" Height="920" MinWidth="1140" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <!-- Bottom: an agent warning if needed, then a live readout -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{StaticResource WarmSoftBrush}"
                            BorderBrush="{StaticResource WarmBrush}" BorderThickness="1"
                            Visibility="{Binding ShowAgentWarning, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource WarmBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Background agent not running" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="Agent running without admin rights" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AgentHint}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding StartAgentCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AgentButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="8,10" Background="{StaticResource SurfaceBrush}"
                            Visibility="{Binding IsConnected, Converter={StaticResource Vis}}">
                        <UniformGrid Columns="3">
                            <UniformGrid.Resources>
                                <Style TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                            </UniformGrid.Resources>
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CpuBrush}" />
                                <TextBlock Text="{Binding Live.CpuTemp.ShortValue, FallbackValue='—'}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{Binding Live.CpuTemp.Value, Converter={StaticResource TempBrush}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="GPU" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource GpuBrush}" />
                                <TextBlock Text="{Binding Live.GpuTemp.ShortValue, FallbackValue='—'}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{Binding Live.GpuTemp.Value, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="RAM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PurpleBrush}" />
                                <TextBlock Text="{Binding Live.RamLoad.ShortValue, FallbackValue='—'}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Home"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=home}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9F9;" Content="Reports"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=reports}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xECA5;" Content="Apps"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=apps}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7BA;" Content="Crashes"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=crashes}" />

                    <TextBlock Text="HARDWARE" Style="{StaticResource Caption}" Margin="12,18,0,8" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9CA;" Content="Temperatures"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=temperatures}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE964;" Content="Memory"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=memory}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEDA2;" Content="Storage"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=storage}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="All sensors"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=sensors}" />

                    <TextBlock Text="CUSTOMIZE" Style="{StaticResource Caption}" Margin="12,18,0,8" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xF246;" Content="Widgets"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=widgets}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=settings}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE946;" Content="Guide"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=guide}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages (created on first visit, then kept) -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
    </Grid>
</Window>
