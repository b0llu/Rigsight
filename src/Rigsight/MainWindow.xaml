<Window x:Class="Rigsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
        xmlns:views="clr-namespace:Rigsight.Views"
        xmlns:rw="clr-namespace:Rigsight.Rewind"
        Title="RigSight" Icon="Assets/Rigsight.ico"
        Width="1400" Height="920" MinWidth="1140" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        ctl:Select.Text="True"
        FontFamily="Segoe UI">
    <!-- The window draws its own title bar: Windows' own one was made shorter when maximized, squeezing its buttons
         (see TitleBar below and MainWindow.TitleBar.cs). The frame, shadow, rounded corners and resizing stay Windows'. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- What's new (see the layer at the end of the window). -->
        <!-- A line of What's new: flat, shaded under the pointer only when it opens a page. -->
        <Style x:Key="WhatsNewLineButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An earlier update's row: a filled bar that opens in place. -->
        <Style x:Key="WhatsNewRowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One line of an update: a coloured square for its kind (the page's icon when it names one), the kind in colour,
             the words, and the page's name with an arrow when it names one (approved mock-up, 2026-10-24). -->
        <DataTemplate x:Key="WhatsNewLine">
            <Button x:Name="Row" Style="{StaticResource WhatsNewLineButton}" Command="{Binding DataContext.OpenLineCommand, RelativeSource={RelativeSource AncestorType=ctl:SmoothBorder}}"
                    CommandParameter="{Binding}" IsHitTestVisible="{Binding CanOpen}" Focusable="{Binding CanOpen}" AutomationProperties.Name="{Binding Text}">
                <DockPanel>
                    <Border x:Name="Square" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top" Margin="0,1,12,0" Background="{DynamicResource WarmSoftBrush}">
                        <ContentControl x:Name="Glyph" Content="{Binding Icon, Converter={StaticResource NavIcon}}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource WarmBrush}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding PageName}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="6,1,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="Kind" Text="{Binding KindTitle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarmBrush}" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="new">
                    <Setter TargetName="Square" Property="Background" Value="{DynamicResource CpuSoftBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource CpuBrush}" />
                    <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource CpuBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="better">
                    <Setter TargetName="Square" Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                    <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- What's new (see the layer at the end of the window): the heading with the version, the update in a glance, its
             feature with a picture, every line, the updates skipped as rows, and real buttons at the foot. -->
        <DataTemplate x:Key="WhatsNewCard">
                    <ctl:SmoothBorder Width="680" MaxHeight="780" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                                      AutomationProperties.Name="What's new">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="28,22,16,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="Close" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE711;" />
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding SubHeading}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <!-- Real buttons at the foot: every update, and Got it (Esc, the x and a click outside close it too). -->
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="28,12,28,18">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{ctl:T 'Got it'}" Command="{Binding CloseCommand}" />
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="{ctl:T 'Every update'}" Command="{Binding SeeAllCommand}"
                                            Visibility="{Binding CanSeeAll, Converter={StaticResource Vis}}" />
                                </DockPanel>
                            </Border>
                            <!-- 20 at the sides, and 8 more around everything but the lines, so a line's hover shade has room for its rounded corners
                                 (a shade pushed out past the padding was cut square by the scroll area). -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,24" Focusable="False">
                                <StackPanel>
                                    <!-- The update in a glance: how many new, better and fixed, before any detail. -->
                                    <ItemsControl ItemsSource="{Binding Counts}" Focusable="False" Margin="8,4,8,2">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="7" Padding="9,3" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="8,14,8,4" Visibility="{Binding Converter={StaticResource Vis}}" DataContext="{Binding Newest.Feature}">
                                                    <Border CornerRadius="14" Padding="22,20,22,22" BorderThickness="1" AutomationProperties.Name="{Binding Tag}">
                                                        <!-- Something new is in colour. Something taken away is plain and grey: colour says "new". -->
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.30">
                                                                            <GradientStop Color="{DynamicResource CpuColor}" Offset="0" />
                                                                            <GradientStop Color="{DynamicResource PurpleColor}" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="BorderBrush">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.75">
                                                                            <GradientStop Color="{DynamicResource CpuColor}" Offset="0" />
                                                                            <GradientStop Color="{DynamicResource PurpleColor}" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource CpuBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource FaintBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="ai">
                                                                                    <Setter Property="Background" Value="{DynamicResource AiBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <!-- The page's own icon as in the sidebar (a font character, or the drawn fan), larger. -->
                                                                    <Viewbox Width="26" Height="26">
                                                                        <ContentControl Content="{Binding Icon, Converter={StaticResource NavIcon}}" Focusable="False"
                                                                                        FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource CpuBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource FaintBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                        <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Pitch}" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,4" />
                                                            <ItemsControl ItemsSource="{Binding Points}" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="0,9,0,0">
                                                                            <!-- A tick for what something new can do; a plain dot for a reason. -->
                                                                            <Grid DockPanel.Dock="Left" Width="13" Margin="0,3,10,0" VerticalAlignment="Top">
                                                                                <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource CpuBrush}" />
                                                                                <Ellipse x:Name="Dot" Width="5" Height="5" Margin="0,5,0,0" VerticalAlignment="Top" Fill="{DynamicResource FaintBrush}" Visibility="Collapsed" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource TextBrush}" />
                                                                        </DockPanel>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsRemoval, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                                <Setter TargetName="Tick" Property="Visibility" Value="Collapsed" />
                                                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- Something true about this PC, where the feature already has it. -->
                                                            <TextBlock Text="{Binding Fact}" FontSize="13" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" Foreground="{DynamicResource CpuBrush}" Margin="0,16,0,0"
                                                                       Visibility="{Binding Fact, Converter={StaticResource Vis}}" />
                                                            <!-- What comes with the feature (1.0.0: the free trial), inside its card. -->
                                                            <ctl:SmoothBorder CornerRadius="12" Background="{DynamicResource AiSoftBrush}" BorderBrush="{DynamicResource AiStrokeBrush}" BorderThickness="1"
                                                                              Padding="14,12" Margin="0,16,0,0" Visibility="{Binding HasAside, Converter={StaticResource Vis}}">
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" BorderBrush="{DynamicResource AiStrokeBrush}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding AsideNumber}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AiBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding AsideTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                                        <TextBlock Text="{Binding AsideText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </ctl:SmoothBorder>
                                                            <!-- Something new has a way straight to it; something gone has nowhere to send you. -->
                                                            <Button HorizontalAlignment="Left" Margin="0,16,0,0" Content="{Binding OpenText}"
                                                                    Command="{Binding DataContext.OpenFeatureCommand, RelativeSource={RelativeSource AncestorType=ctl:SmoothBorder}}" CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowsButton}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                            <!-- A picture of the feature beside its words, where it has one (drawn: a screenshot would show one PC's own drives). -->
                                                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" Visibility="{Binding HasPicture, Converter={StaticResource Vis}}">
                                                                <ctl:FeaturePicture Kind="{Binding Picture}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Newest.Lines}" ItemTemplate="{StaticResource WhatsNewLine}" Focusable="False" Margin="0,10,0,0" />
                                    <!-- The updates before it: one row each, its version and biggest change, opening in place. -->
                                    <StackPanel Margin="8,0,8,0" Visibility="{Binding HasOlder, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding OlderHeading}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,18,0,2" />
                                        <ItemsControl ItemsSource="{Binding Older}" Focusable="False" VirtualizingPanel.IsVirtualizing="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Button Style="{StaticResource WhatsNewRowButton}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Version}">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="Bold" Width="70" DockPanel.Dock="Left" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Margin="12,0,0,0"
                                                                           Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                    <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                                                                </TextBlock>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Notes.MoreText}" FontSize="12.5" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Notes.Summary}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Button>
                                                        <ItemsControl x:Name="Body" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource WhatsNewLine}" Focusable="False" Margin="-8,2,-8,6" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </ctl:SmoothBorder>
        </DataTemplate>
        <!-- New dashboard (see the layer at the end of the window): a card per preset, built only while open. -->
        <DataTemplate x:Key="PresetPicker">
            <ctl:SmoothBorder Width="820" MaxHeight="760" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                              AutomationProperties.Name="New dashboard">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="28,22,16,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="Close">
                            <TextBlock Text="&#xE711;" />
                        </Button>
                        <TextBlock Text="{ctl:T 'New dashboard'}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{ctl:T 'Start from a preset made for this PC\'s sensors, then change anything you like.'}"
                               Style="{StaticResource Muted}" Margin="28,0,28,16" TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22,0,10,22" Padding="0,0,12,0">
                        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Cursor="Hand" Focusable="False" Margin="6" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" MinWidth="0" MinHeight="0" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ctl:SmoothBorder x:Name="Bd" CornerRadius="12" Padding="16,14" Background="{DynamicResource Surface2Brush}"
                                                                  BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                                    <ContentPresenter />
                                                </ctl:SmoothBorder>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Shows}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding Shows, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <!-- The question before a part of Windows is ended from the Processes page: what will happen, then the buttons.
             The one in front (Enter) is the safe one: Cancel, or "Restart it" for Windows Explorer. -->
        <DataTemplate x:Key="EndQuestionCard">
            <ctl:SmoothBorder Width="470" Margin="24" Padding="26,22,26,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                              AutomationProperties.Name="{Binding Question.Title}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource WarmBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Question.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Question.Body}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Question.Body, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Question.Intro}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Question.Intro, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Question.Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" · " /><Run Text="{Binding Effect, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="{ctl:T 'I understand that unsaved work may be lost'}" IsChecked="{Binding Question.Ticked}" FontSize="13" Margin="0,16,0,0"
                              Foreground="{DynamicResource TextBrush}" Visibility="{Binding Question.NeedsTick, Converter={StaticResource Vis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="{ctl:T 'End anyway'}" Command="{Binding AnswerCommand}" CommandParameter="End" IsEnabled="{Binding Question.CanEnd}"
                                Background="{DynamicResource HotSoftBrush}" Foreground="{DynamicResource HotBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{ctl:T 'Cancel'}" Command="{Binding AnswerCommand}" CommandParameter="Cancel" Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Question.CancelIsDefault}" Value="True">
                                            <Setter Property="IsDefault" Value="True" />
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{ctl:T 'Restart it'}" Style="{StaticResource AccentButton}" IsDefault="True" Command="{Binding AnswerCommand}" CommandParameter="Restart" Margin="10,0,0,0"
                                Visibility="{Binding Question.CanRestart, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>
        <!-- A title bar button: Windows 11's size and glyphs; close turns red under the pointer. Hover and press come
             from Tag for maximize, whose pointer Windows keeps (it is a maximize button to Windows, for snap layouts). -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="Tag" Value="hover"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" /></Trigger>
                            <Trigger Property="Tag" Value="pressed"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C83C30" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Maximized, Windows puts the window's edge a frame's width beyond the screen: Frame's padding takes it back. -->
    <Border x:Name="Frame">
    <DockPanel>
    <!-- 40 px since the ask box (2026-10-27; Windows' own is 32, a search box in it wants more), zoomed with the pages. -->
    <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40" Background="{DynamicResource BgBrush}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Icons only, or the pages' names: the sidebar's own switch, where Windows apps keep theirs (2026-10-25). -->
            <Image Source="Assets/Rigsight.png" Width="16" Height="16" Margin="12,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="TitleText" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12.5" Margin="10,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
        </StackPanel>
        <!-- The ask box (approved mock-up "The ask box grows into a place to type", 2026-10-27): in the middle of the bar, clear
             of the window's buttons so the bar either side still drags the window. A click or the Ask shortcut grows it into
             the panel under it (AskDrop); while Ask is open it shows the chat's name and goes to Ask's own box. RigSight's
             window is never narrower than 1140 px, so it always fits with its words (Settings › Ask RigSight can move Ask to
             the sidebar instead). -->
        <Button x:Name="AskBox" WindowChrome.IsHitTestVisibleInChrome="True" Click="AskBox_Click" Cursor="IBeam" Focusable="False" FocusVisualStyle="{x:Null}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Height="30" AutomationProperties.Name="{ctl:T 'Ask about your PC'}"
                Visibility="{Binding ShowAskBar, Converter={StaticResource Vis}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12,0,7,0">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource AiSparkle}" Stroke="{DynamicResource AiBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border DockPanel.Dock="Right" CornerRadius="5" BorderBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource HoverBrush}" BorderThickness="1" Padding="6,1,6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Ask.BarKey}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            </Border>
                            <TextBlock x:Name="Words" Text="{Binding Ask.BarText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,1" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AiStrokeBrush}" /></Trigger>
                        <DataTrigger Binding="{Binding Ask.BarHasDraft}" Value="True"><Setter TargetName="Words" Property="Foreground" Value="{DynamicResource TextBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Ask.BarLocked}" Value="True"><Setter Property="Cursor" Value="Hand" /></DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- Ask itself, opened straight away on its chats without asking anything (2026-10-27: there was no other way since the
             box replaced the Ask button); lit while Ask is open, and closes it. Beside the box, so the box stays the bar's middle. -->
        <Button x:Name="AskChats" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding Ask.ToggleCommand}" Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" Margin="526,0,0,0" ToolTip="{ctl:T 'Your chats'}" AutomationProperties.Name="{ctl:T 'Your chats'}"
                Visibility="{Binding ShowAskBar, Converter={StaticResource Vis}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <ctl:InkCentered x:Name="Glyph" Text="&#xE8BD;" Font="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="16" Height="16" Fill="{DynamicResource MutedBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AiStrokeBrush}" /></Trigger>
                        <DataTrigger Binding="{Binding Ask.IsOpen}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AiSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AiStrokeBrush}" />
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource AiBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- The drop: grown down out of the box (AskDrop_Open), the box hidden under it. A big box to type in (Enter asks, Shift+
             Enter a new line), questions to start from and the last chats while nothing is typed, and how it works at the foot. -->
        <Popup x:Name="AskDrop" PlacementTarget="{Binding ElementName=AskBox}" Placement="Custom" AllowsTransparency="True" StaysOpen="True"
               PopupAnimation="None" Focusable="True">
            <Border x:Name="AskDropRoot" Width="640" Margin="14,0,14,20" Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource AiStrokeBrush}"
                    BorderThickness="1" CornerRadius="12" RenderTransformOrigin="0.5,0" KeyboardNavigation.TabNavigation="Cycle">
                <Border.RenderTransform><ScaleTransform x:Name="AskDropScale" /></Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel x:Name="AskDropContent" Opacity="0">
                    <!-- Before the first question (the person's call, 2026-10-27): the consent here, before anything is typed, instead of
                         after Enter. Start asking turns the drop into the box to type in; nothing reaches RigSight's server before it. -->
                    <StackPanel Margin="20,18,20,16" Visibility="{Binding Ask.ShowFirstQuestion, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource AiSparkle}" Stroke="{DynamicResource AiBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{ctl:T 'Before your first question'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding Ask.FirstIntro}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
                            <Run Text="{Binding Ask.FirstWhere, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding Ask.FirstWhereText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Ask.FirstNever}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Ask.FirstNever, Converter={StaticResource Vis}}" />
                        <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Ask.FirstKept, Converter={StaticResource Vis}}">
                            <Run Text="{ctl:T 'What is kept.'}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding Ask.FirstKept, Mode=OneWay}" />
                        </TextBlock>
                        <DockPanel Margin="0,16,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="{ctl:T 'Start asking'}" Command="{Binding Ask.StartAskingCommand}" />
                            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Background="{DynamicResource HoverBrush}" Content="{ctl:T 'Not now'}" Margin="8,0,0,0" Click="AskDropNotNow_Click" />
                            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Background="{DynamicResource HoverBrush}" Content="{ctl:T 'Settings'}" Margin="8,0,0,0" Click="AskDropSettings_Click" />
                            <!-- Ask's own "Privacy page" link (LinkAction in AskWindow): muted words and an arrow, lit on hover. -->
                            <Button Content="{ctl:T 'Privacy page'}" AutomationProperties.Name="{ctl:T 'Privacy page'}" Command="{Binding Ask.OpenPrivacyCommand}" Cursor="Hand" Focusable="False"
                                    Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,6,4,6">
                                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12.5" />
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Ask.ShowFirstQuestion, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <DockPanel Margin="18,15,14,13">
                            <Path DockPanel.Dock="Left" Data="{StaticResource AiSparkle}" Stroke="{DynamicResource AiBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Top" Margin="0,4,12,0" />
                            <Button DockPanel.Dock="Right" Width="32" Height="32" VerticalAlignment="Top" Margin="12,-3,0,0" Command="{Binding Ask.AskFromBarCommand}" Cursor="Hand"
                                    IsEnabled="{Binding Ask.CanAskFromBar}" ToolTip="{ctl:T 'Ask'}" AutomationProperties.Name="{ctl:T 'Ask'}" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!-- An arrow up, drawn on a 16 px square centred in the button (a glyph's box never sits true). -->
                                        <Border x:Name="Bd" CornerRadius="9" Background="{DynamicResource AiBrush}">
                                            <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="Arrow" Data="M 8,13 L 8,3.5 M 3.5,8 L 8,3.5 L 12.5,8" Stroke="{DynamicResource BgBrush}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource FaintBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Grid>
                                <TextBlock Text="{Binding Ask.BarPlaceholder}" FontSize="15" Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False" Margin="2,1,0,0"
                                           Visibility="{Binding Ask.BarSuggests, Converter={StaticResource Vis}}" />
                                <TextBox x:Name="AskDropText" Text="{Binding Ask.BarDraft, UpdateSourceTrigger=PropertyChanged}" FontSize="15" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxHeight="184" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}" PreviewKeyDown="AskDropText_PreviewKeyDown" AutomationProperties.Name="{ctl:T 'Ask about your PC'}">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" /></ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="{Binding Ask.BarCount}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="46,0,14,10"
                                   Visibility="{Binding Ask.BarShowCount, Converter={StaticResource Vis}}" />
                        <!-- Questions to start from and the last chats, while nothing is typed. ↓ from the box steps into them. -->
                        <StackPanel x:Name="AskDropList" Visibility="{Binding Ask.BarSuggests, Converter={StaticResource Vis}}" KeyboardNavigation.DirectionalNavigation="Contained">
                            <StackPanel.Resources>
                                <Style x:Key="DropHead" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                    <Setter Property="Margin" Value="18,12,0,6" />
                                </Style>
                                <Style x:Key="DropRow" TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,9" Margin="8,0">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" />
                            <TextBlock Text="{ctl:T 'TRY ASKING'}" Style="{StaticResource DropHead}" />
                            <ItemsControl ItemsSource="{Binding Ask.Starters}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DropRow}" Command="{Binding DataContext.Ask.AskStarterFromBarCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Text}">
                                            <DockPanel>
                                                <ctl:InkCentered DockPanel.Dock="Left" Text="{Binding Glyph}" Font="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="16" Height="20" Fill="{DynamicResource FaintBrush}" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding Text}" FontSize="13.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding Ask.HasBarRecent, Converter={StaticResource Vis}}">
                                <TextBlock Text="{ctl:T 'YOUR LAST CHATS'}" Style="{StaticResource DropHead}" />
                                <ItemsControl ItemsSource="{Binding Ask.BarRecent}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DropRow}" Command="{Binding DataContext.Ask.OpenFromBarCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <DockPanel>
                                                    <ctl:InkCentered DockPanel.Dock="Left" Text="&#xE8BD;" Font="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="16" Height="20" Fill="{DynamicResource FaintBrush}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Height="6" />
                        </StackPanel>
                        <!-- How it works, the questions left and the shortcut (set or changed in Settings › Ask RigSight). -->
                        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,9,16,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding Ask.SetBarShortcutCommand}" Cursor="Hand" Focusable="False" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="T" FontSize="12" Foreground="{DynamicResource FaintBrush}">
                                                <Run Text="{ctl:T 'From anywhere'}" /> <Run Text="{Binding Ask.BarShortcut, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /> · <Run x:Name="Act" Text="{ctl:T 'Change'}" Foreground="{DynamicResource AiBrush}" />
                                            </TextBlock>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Ask.HasBarShortcut}" Value="False">
                                                    <Setter TargetName="T" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button DockPanel.Dock="Right" Command="{Binding Ask.SetBarShortcutCommand}" Cursor="Hand" Focusable="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Ask.HasBarShortcut, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button"><TextBlock Text="{ctl:T 'Set a shortcut for anywhere'}" FontSize="12" Foreground="{DynamicResource AiBrush}" /></ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Ask.QuestionsLine}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Ask.ShowQuestionsLine, Converter={StaticResource Vis}}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center">
                                    <Run Text="{ctl:T 'Enter'}" Foreground="{DynamicResource MutedBrush}" /> <Run Text="{ctl:T 'ask'}" />  ·  <Run Text="{ctl:T 'Shift+Enter'}" Foreground="{DynamicResource MutedBrush}" /> <Run Text="{ctl:T 'new line'}" />  ·  <Run Text="{ctl:T 'Esc'}" Foreground="{DynamicResource MutedBrush}" /> <Run Text="{ctl:T 'close'}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- The zoom, for a moment while it changes (Ctrl + wheel): up here, where it isn't zoomed itself; beside the window's
                 buttons, the middle being the ask box's. -->
            <TextBlock x:Name="ZoomText" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12" Opacity="0"
                       Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
            <!-- What's new after an update, waiting here instead of opening up front (approved mock-up "What's new in the title
                 bar", 2026-10-27; Settings › Updates picks it, the card, or nothing). Gone once the card is read. Its words go
                 when the bar has no room for them beside the ask box (FitWhatsNew), the dot and icon stay. -->
            <Button x:Name="WhatsNewButton" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding WhatsNew.OpenWaitingCommand}" Cursor="Hand"
                    Focusable="False" FocusVisualStyle="{x:Null}" VerticalAlignment="Center" Height="28" Margin="0,0,8,0"
                    ToolTip="{ctl:T 'What\'s new in this update'}" AutomationProperties.Name="{ctl:T 'What\'s new'}"
                    Visibility="{Binding WhatsNew.IsWaiting, Converter={StaticResource Vis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="9,0,11,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="WhatsNewIcon" Text="&#xE7C3;" Style="{StaticResource Icon}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="WhatsNewWords" Text="{ctl:T 'What\'s new'}" FontSize="12.5" Margin="7,0,0,1" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="Tag" Value="compact">
                                <Setter TargetName="WhatsNewWords" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="WhatsNewIcon" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" AutomationProperties.Name="Maximize" />
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close" />
        </StackPanel>
    </Grid>
    <!-- Everything under the title bar, zoomed with Ctrl + wheel (MainWindow.xaml.cs, ApplyZoom) -->
    <Grid x:Name="Body">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: 232 wide, or 72 with icons only (everything in it follows SidebarLook.Narrow) -->
        <Border x:Name="SidebarHost" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0"
                ctl:SidebarLook.Narrow="{Binding Sidebar.IconsOnly}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="232" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sidebar.IconsOnly}" Value="True"><Setter Property="Width" Value="72" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Margin" Value="14,16,14,16" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Sidebar.IconsOnly}" Value="True"><Setter Property="Margin" Value="13,16,13,16" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <!-- Bottom: an update if there is one, an agent warning if needed, then Settings and its menu -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Icons only: each card at the foot is one icon that says it on hover; a press shows the names again, card
                         and all (a rewind waiting opens itself). -->
                    <StackPanel Visibility="{Binding Sidebar.IconsOnly, Converter={StaticResource Vis}}">
                        <StackPanel.Resources>
                            <Style x:Key="FootIcon" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Command" Value="{Binding Sidebar.ToggleIconsCommand}" />
                                <Setter Property="ToolTipService.Placement" Value="Right" />
                                <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue=''}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ctl:SmoothBorder x:Name="Bd" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="15" Foreground="{TemplateBinding Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </ctl:SmoothBorder>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE768;" Foreground="{DynamicResource CpuBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                DataContext="{Binding Rewind}" Command="{Binding Waiting.WatchCommand}" ToolTip="{Binding WaitingTitle}"
                                Visibility="{Binding HasWaiting, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE896;" Foreground="{DynamicResource GoodBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                ToolTip="{Binding Update.LineTitle}" Visibility="{Binding Update.ShowLine, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE896;" Foreground="{DynamicResource GoodBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                ToolTip="{Binding Update.ProgressTitle}" Visibility="{Binding Update.ShowProgress, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE930;" Foreground="{DynamicResource GoodBrush}" BorderBrush="{DynamicResource GoodBrush}"
                                ToolTip="{Binding Update.PromptTitle}" Visibility="{Binding Update.ShowPrompt, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE7BA;" Foreground="{DynamicResource WarmBrush}" BorderBrush="{DynamicResource WarmBrush}"
                                ToolTip="{ctl:T 'Update didn\'t finish'}" Visibility="{Binding Update.ShowFailed, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE895;" Foreground="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                ToolTip="{Binding AgentStatus}" Visibility="{Binding ShowAgentStarting, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xEA18;" Foreground="{DynamicResource CpuBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                ToolTip="{ctl:T 'Standard account'}" Visibility="{Binding ShowStandardNote, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE7BA;" Foreground="{DynamicResource WarmBrush}" BorderBrush="{DynamicResource WarmBrush}"
                                ToolTip="{Binding HistoryCard.Title}" Visibility="{Binding HistoryCard, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE7BA;" Foreground="{DynamicResource WarmBrush}" BorderBrush="{DynamicResource WarmBrush}"
                                ToolTip="{ctl:T 'Background agent not running'}" Visibility="{Binding ShowAgentWarning, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource FootIcon}" Tag="&#xE7BA;" Foreground="{DynamicResource WarmBrush}" BorderBrush="{DynamicResource WarmBrush}"
                                ToolTip="{ctl:T 'The latest language pack couldn\'t be downloaded'}" Visibility="{Binding Language.ShowCard, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Sidebar.IconsOnly, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                    <!-- A rewind waiting to be watched (shown full screen and put off with Later, or full screen switched off). -->
                    <Button DataContext="{Binding Rewind}" Command="{Binding Waiting.WatchCommand}" Cursor="Hand" Focusable="False"
                            AutomationProperties.Name="{Binding WaitingTitle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"
                            Visibility="{Binding HasWaiting, Converter={StaticResource Vis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ctl:SmoothBorder x:Name="Bd" CornerRadius="10" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </ctl:SmoothBorder>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" Background="{DynamicResource HoverBrush}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource CpuBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding WaitingTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WaitingLine}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <!-- Update: a quiet line, then download progress, then the restart prompt -->
                    <StackPanel DataContext="{Binding Update}">
                        <Button Command="{Binding ActionCommand}" ToolTip="{Binding LineTip}" AutomationProperties.Name="{Binding LineTitle}" Cursor="Hand" Focusable="False"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"
                                Visibility="{Binding ShowLine, Converter={StaticResource Vis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ctl:SmoothBorder x:Name="Bd" CornerRadius="10" Padding="12,9" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </ctl:SmoothBorder>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock Text="{Binding LineIcon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource GoodBrush}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding LineTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <ctl:SmoothBorder CornerRadius="12" Padding="12,10,12,12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               Visibility="{Binding State, Converter={StaticResource EqualsVis}, ConverterParameter=Downloading}" />
                                    <TextBlock Text="{Binding ProgressTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource Bar}" Height="4" Margin="0,8,0,6" Value="{Binding Progress}" Foreground="{DynamicResource GoodBrush}" />
                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource GoodBrush}" BorderThickness="1"
                                Visibility="{Binding ShowPrompt, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PromptTitle}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding PromptText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource AccentButton}" Content="{Binding InstallText}" Command="{Binding InstallCommand}" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Later'}" Command="{Binding LaterCommand}" Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <!-- Didn't work: try again, or get the installer from the website -->
                        <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1"
                                Visibility="{Binding ShowFailed, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource WarmBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{ctl:T 'Update didn\'t finish'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding FailedText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Try again'}" Command="{Binding ActionCommand}" HorizontalAlignment="Stretch" />
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Open download page'}" Command="{Binding OpenDownloadPageCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                                <!-- Put away: the quiet update line takes its place (it stayed for good before, a user's report). -->
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Not now'}" Command="{Binding DismissFailedCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                            </StackPanel>
                        </ctl:SmoothBorder>
                    </StackPanel>

                    <!-- The agent is being started: said quietly, with nothing to press. The warning below is for when it didn't come. -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12,10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            Visibility="{Binding ShowAgentStarting, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="M 6,0.75 A 5.25,5.25 0 1 1 0.75,6" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform />
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowAgentStarting}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="AgentSpin">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="AgentSpin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding AgentStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </ctl:SmoothBorder>

                    <!-- A standard account, once: nothing is wrong, some readings just can't be had. One press opens Settings on
                         the tab that lists them, and the note is gone for good. -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            Visibility="{Binding ShowStandardNote, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource CpuSoftBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource CpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{ctl:T 'Standard account'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{ctl:T 'CPU temperature and a few other readings are off here.'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenAdminRightsCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="See what's off">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'See what\'s off'}" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- The history file: damage the check confirmed, a repair waiting, or what a repair kept (see HistoryRepair). -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" BorderThickness="1" AutomationProperties.Name="History file"
                                      DataContext="{Binding HistoryCard}" Visibility="{Binding Converter={StaticResource Vis}}">
                        <ctl:SmoothBorder.Style>
                            <Style TargetType="ctl:SmoothBorder">
                                <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarm}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:SmoothBorder.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWarm}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <!-- Equal halves, one height (a lone button takes the whole width): collapsed buttons take no cell. -->
                            <UniformGrid Rows="1" Margin="-3,0">
                                <Button Style="{StaticResource AccentButton}" Margin="3,0" HorizontalAlignment="Stretch" Content="{ctl:T 'Repair'}" AutomationProperties.Name="Repair history"
                                        Command="{Binding DataContext.RepairHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanRepair, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource AccentButton}" Margin="3,0" HorizontalAlignment="Stretch" Content="{ctl:T 'Try again'}" AutomationProperties.Name="Try the history repair again"
                                        Command="{Binding DataContext.RepairHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanRetry, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource GhostButton}" Margin="3,0" Padding="6,8" HorizontalAlignment="Stretch" Content="{ctl:T 'Open folder'}" AutomationProperties.Name="Open the history folder"
                                        Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanOpenFolder, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource GhostButton}" Margin="3,0" Padding="6,8" HorizontalAlignment="Stretch" Content="{Binding DismissText}"
                                        Command="{Binding DataContext.DismissHistoryCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanDismiss, Converter={StaticResource Vis}}" />
                            </UniformGrid>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource WarmSoftBrush}"
                            BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1"
                            Visibility="{Binding ShowAgentWarning, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{ctl:T 'Background agent not running'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="{ctl:T 'Agent running without admin rights'}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AgentOutOfDate}" Value="True">
                                                <Setter Property="Text" Value="{ctl:T 'Background agent is another version'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AgentHint}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding StartAgentCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AgentButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- The newest language pack couldn't be had after an update: the old one keeps working, the newest words
                         show in English until it's downloaded (Settings → Language has the same line). -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource WarmSoftBrush}"
                            BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1" DataContext="{Binding Language}"
                            Visibility="{Binding ShowCard, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'The latest language pack couldn\'t be downloaded'}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{ctl:T 'Some new words show in English until it\'s downloaded.'}" FontSize="11.5"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding ActCommand}" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Try the language pack again">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{ctl:T 'Try again'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctl:SmoothBorder>
                    </StackPanel>

                    <!-- Settings: always at the foot of the sidebar, however far the pages above are scrolled. A press opens a
                         small menu over it (Settings first, then the things people come looking for: updates, what's new,
                         reporting a bug); the menu floats, so nothing moves. Marked like a page while Settings is open. -->
                    <!-- Ask, when Settings › Ask RigSight puts its button in the sidebar instead of the top bar. -->
                    <RadioButton Style="{StaticResource NavItem}" GroupName="AskSide" Tag="{StaticResource AiIcon}" Content="{ctl:T 'Ask'}" Command="{Binding Ask.ToggleCommand}"
                                 IsChecked="{Binding Ask.IsOpen, Mode=OneWay}" AutomationProperties.Name="Ask RigSight" Margin="0,0,0,4"
                                 Visibility="{Binding Ask.InSidebar, Converter={StaticResource Vis}}" />
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="12,4,12,10" />
                    <ToggleButton x:Name="SettingsRow" AutomationProperties.Name="Settings and more" Cursor="Hand" Focusable="False"
                                  HorizontalAlignment="Stretch" Foreground="{DynamicResource MutedBrush}"
                                  Tag="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=settings}">
                        <!-- While the menu is open, a press on the row only closes it: the menu shuts on that press, and the
                             row would otherwise take the same press and open it again. -->
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=SettingsMenu}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                    <Grid>
                                        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        <DockPanel x:Name="Row">
                                            <Grid DockPanel.Dock="Left">
                                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Foreground="{TemplateBinding Foreground}" />
                                                <!-- Icons only: the attention dot sits on the gear's corner. -->
                                                <Ellipse x:Name="CornerDot" Width="7" Height="7" Margin="0,-3,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource WarmBrush}"
                                                         Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="10"
                                                       Foreground="{DynamicResource FaintBrush}" Margin="8,0,0,0" />
                                            <!-- A dot while something in Settings needs a look (sensors being left out), until it's been seen there. -->
                                            <Ellipse x:Name="Dot" DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource WarmBrush}"
                                                     ToolTip="{ctl:T 'Something in Settings needs a look'}"
                                                     Visibility="{Binding SettingsNeedAttention, Converter={StaticResource Vis}}" />
                                            <TextBlock x:Name="Label" Text="{ctl:T 'Settings'}" Margin="12,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <!-- The menu closes on a click anywhere outside it; without this, a click on the row
                                             itself would close it and open it again at once. -->
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="ctl:SidebarLook.Narrow" Value="True">
                                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="{ctl:T 'Settings'}" />
                                        <Setter Property="ToolTipService.Placement" Value="Right" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding (ctl:SidebarLook.Narrow), RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding SettingsNeedAttention}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="CornerDot" Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="SettingsMenu" PlacementTarget="{Binding ElementName=SettingsRow}" Placement="Top" VerticalOffset="-6" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=SettingsRow, Mode=TwoWay}" Closed="SettingsMenu_Closed">
                        <Border Width="{Binding ActualWidth, ElementName=SettingsRow}" MinWidth="204" Background="{DynamicResource TooltipBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="6">
                            <StackPanel Button.Click="SettingsMenu_Click">
                                <StackPanel.Resources>
                                    <!-- A line of the menu: its icon (the Tag) and its words. -->
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <!-- The icon's colour (an item can have its own, as Support RigSight's yellow) -->
                                        <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="14"
                                                                       Foreground="{TemplateBinding BorderBrush}" Width="16" TextAlignment="Center" />
                                                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.FontSize="13"
                                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="MenuRule" TargetType="Border">
                                        <Setter Property="Height" Value="1" />
                                        <Setter Property="Margin" Value="4,5" />
                                        <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
                                    </Style>
                                </StackPanel.Resources>
                                <Button Tag="&#xE713;" Content="{ctl:T 'Settings'}" Command="{Binding GoCommand}" CommandParameter="settings" AutomationProperties.Name="Settings" />
                                <!-- Checking for an update keeps the menu open, and the line itself becomes the answer
                                     ("Checking…", then "Up to date" with a tick) until the menu closes: see the code
                                     behind. Every other line closes the menu. -->
                                <Button x:Name="MenuUpdate" Tag="&#xE72C;" Command="{Binding Update.ActionCommand}" AutomationProperties.Name="{Binding Update.ActionText}">
                                    <Grid>
                                        <TextBlock x:Name="MenuUpdateText" Text="{Binding Update.ActionText}" />
                                        <TextBlock x:Name="MenuUpdateAnswer" Text="{Binding Update.AnswerText}" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <Button Tag="&#xE7C3;" Content="{ctl:T 'What\'s new'}" Command="{Binding WhatsNew.SeeAllCommand}" />
                                <Border Style="{StaticResource MenuRule}" />
                                <Button Tag="&#xEBE8;" Content="{ctl:T 'Report a bug'}" Command="{Binding SettingsPage.ReportBugCommand}" />
                                <Button Tag="&#xE715;" Content="{ctl:T 'Contact support'}" Command="{Binding SettingsPage.ContactSupportCommand}" />
                                <Button Tag="&#xE8C8;" Content="{ctl:T 'Copy logs'}" Command="{Binding SettingsPage.CopyProblemReportCommand}" />
                                <!-- In Buy Me a Coffee's yellow until it has been pressed, or the support card answered for good -->
                                <Button Tag="&#xEB51;" Content="{ctl:T 'Support RigSight'}" Command="{Binding SettingsPage.SupportCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Support.HighlightMenu}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SupportBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SupportBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Style="{StaticResource MenuRule}" />
                                <Button Tag="&#xE946;" Content="{ctl:T 'About RigSight'}" Command="{Binding AboutCommand}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="10,6,10,4">
                                    <Run Text="{ctl:T 'Version'}" /> <Run Text="{Binding SettingsPage.AppVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Navigation (scrolls if there are many dashboards on a short screen). Which page is in which group, their order
                     and names, and what is hidden come from the sidebar editor in Settings; DASHBOARDS, HARDWARE and ON SCREEN
                     fold away with a click on their heading. A heading left out takes no room: its pages follow the ones above. -->
                <!-- Its bar sits in the sidebar's right margin, clear of the items (it used to lie on their edge). -->
                <!-- When the pages don't fit, a soft fade shows the side with more (see MainWindow.Sidebar); Settings and the cards
                     at the foot stay put. -->
                <ScrollViewer x:Name="NavScroll" Style="{StaticResource CardScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              ScrollChanged="NavScroll_ScrollChanged">
                <StackPanel DataContext="{Binding Sidebar}">
                    <StackPanel.Resources>
                        <DataTemplate x:Key="NavEntry">
                            <!-- The name may be the user's own: one too long for the sidebar is cut short, as a dashboard's is. -->
                            <RadioButton Style="{StaticResource NavItem}" Tag="{Binding Icon, Converter={StaticResource NavIcon}}" AutomationProperties.Name="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding IsVisible, Converter={StaticResource Vis}}" Click="NavClicked">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="8,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource CpuBrush}"
                                             ToolTip="{Binding NewText}" Visibility="{Binding IsNew, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </RadioButton>
                        </DataTemplate>
                        <!-- A page in a group's list beside its icon (icons only): shown even while the group is folded. -->
                        <DataTemplate x:Key="FlyoutEntry">
                            <RadioButton Style="{StaticResource NavItem}" Tag="{Binding Icon, Converter={StaticResource NavIcon}}" AutomationProperties.Name="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="NavClicked">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </RadioButton>
                        </DataTemplate>
                        <!-- A section heading that folds its group: the caption, and a chevron at the right in the muted text colour (white while hovered). -->
                        <Style x:Key="SectionToggle" TargetType="Button">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,14,0,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,4,10,4">
                                            <Grid>
                                                <DockPanel x:Name="Words">
                                                    <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="10"
                                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Text="&#xE70D;" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Border x:Name="Line" Height="1" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource StrokeBrush}" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource MutedBrush}" />
                                            </Trigger>
                                            <Trigger Property="ctl:SidebarLook.Narrow" Value="True">
                                                <Setter TargetName="Words" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Bd" Property="Padding" Value="0,8" />
                                                <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
                                                <Setter Property="ToolTipService.Placement" Value="Right" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <ItemsControl ItemsSource="{Binding Main}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />

                    <!-- Icons only: DASHBOARDS, HARDWARE and ON SCREEN are one icon each; a press lists the group's pages beside it
                         (approved mock-up, 2026-10-25), so the narrow sidebar rarely needs to scroll. -->
                    <StackPanel Visibility="{Binding IconsOnly, Converter={StaticResource Vis}}">
                        <Border Height="1" Width="24" Background="{DynamicResource HoverBrush}" Margin="0,12,0,10" />
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Visibility="{Binding InRail, Converter={StaticResource Vis}}" Margin="0,0,0,4">
                                        <ToggleButton x:Name="GroupIcon" Cursor="Hand" Focusable="True" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}"
                                                      ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="250" HorizontalAlignment="Stretch">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="0,10">
                                                        <Grid HorizontalAlignment="Center">
                                                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Margin="-22,0,0,0" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource MutedBrush}" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding HasSelected}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <!-- Its pages, beside it: names shown here even with icons only. -->
                                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupIcon, Mode=TwoWay}" PlacementTarget="{Binding ElementName=GroupIcon}" Placement="Right"
                                               HorizontalOffset="8" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="6"
                                                    MinWidth="200" ctl:SidebarLook.Narrow="False" AutomationProperties.Name="{Binding Title}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Caption}" Margin="10,6,10,4" />
                                                    <ItemsControl ItemsSource="{Binding ShownPages}" ItemTemplate="{StaticResource FlyoutEntry}" Focusable="False" />
                                                    <Button Click="RailNewDashboard_Click" AutomationProperties.Name="New dashboard" Cursor="Hand" Focusable="True" Foreground="{DynamicResource FaintBrush}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="{Binding OffersNewDashboard, Converter={StaticResource Vis}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{TemplateBinding Foreground}" />
                                                                        <TextBlock Text="{ctl:T 'New dashboard'}" Margin="12,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- With names: each group under its heading. -->
                    <StackPanel Visibility="{Binding IconsOnly, Converter={StaticResource Vis}, ConverterParameter=Invert}">

                    <Button Style="{StaticResource SectionToggle}" Tag="{Binding DashboardsCollapsed}" Command="{Binding ToggleSectionCommand}" CommandParameter="dashboards"
                            AutomationProperties.Name="{Binding DashboardsGroup.Title}" ToolTip="{ctl:T 'Show or hide your dashboards'}"
                            Visibility="{Binding DashboardsGroup.HeadingInSidebar, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding DashboardsGroup.Heading}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <!-- The user's dashboards, and any page moved in among them; a dashboard moved out is in the group it was put in. -->
                    <ItemsControl ItemsSource="{Binding DashboardsGroup.Pages}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />
                    <Button Command="{Binding DataContext.Presets.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="New dashboard"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" Focusable="False" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,4"
                            ToolTip="{ctl:T 'Start from a preset or a blank page'}" ToolTipService.Placement="Right"
                            Visibility="{Binding ShowNewDashboard, Converter={StaticResource Vis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                    <StackPanel x:Name="Row" Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock x:Name="Label" Text="{ctl:T 'New dashboard'}" Margin="12,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="ctl:SidebarLook.Narrow" Value="True">
                                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Style="{StaticResource SectionToggle}" Tag="{Binding HardwareCollapsed}" Command="{Binding ToggleSectionCommand}" CommandParameter="hardware"
                            AutomationProperties.Name="{Binding HardwareGroup.Title}" ToolTip="{ctl:T 'Show or hide these pages'}"
                            Visibility="{Binding HardwareGroup.HeadingInSidebar, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding HardwareGroup.Heading}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />

                    <Button Style="{StaticResource SectionToggle}" Tag="{Binding OnScreenCollapsed}" Command="{Binding ToggleSectionCommand}" CommandParameter="onscreen"
                            AutomationProperties.Name="{Binding OnScreenGroup.Title}" ToolTip="{ctl:T 'Show or hide these pages'}"
                            Visibility="{Binding OnScreenGroup.HeadingInSidebar, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding OnScreenGroup.Heading}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding OnScreen}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Folds and opens the sidebar: a round handle on its edge, shown only while the pointer is over the sidebar or the handle
             (it takes no keyboard focus, which kept it showing after a click: Ctrl+B is the keyboard way). Centred on the edge line (the
             sidebar's 1px right border), level with Home and clear of it in either width (the user, 2026-10-25). -->
        <Button x:Name="SidebarHandle" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,-10.5,0" Width="22" Height="22"
                Panel.ZIndex="6" Cursor="Hand" Focusable="False" Command="{Binding Sidebar.ToggleIconsCommand}"
                ToolTip="{Binding Sidebar.IconsTip}" ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right" AutomationProperties.Name="{Binding Sidebar.IconsTip}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=SidebarHost}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="11" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <TextBlock x:Name="Glyph" Text="{Binding Sidebar.HandleGlyph}" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Pages (created on first visit, then kept), with a note at the top of one that couldn't read part of its history. -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Margin="28,14,28,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource WarmSoftBrush}"
                    AutomationProperties.Name="Part of this page can't be read" Visibility="{Binding PageUnreadable, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{ctl:T 'Repair'}" Command="{Binding RepairHistoryCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource WarmBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}">
                        <Run Text="{ctl:T 'Part of this page\'s history can\'t be read.'}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <Run Text="{ctl:T 'It may show less than was recorded, or nothing. A repair brings back everything that can still be read.'}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Focusable="False" />
        </DockPanel>

        <!-- What's new: once after an update, over the whole window. Closed with the x, Esc or a click outside; every update is in Settings. -->
        <!-- It fades in from code (MainWindow.xaml.cs): a style-triggered animation here kept closed pages in memory. -->
        <Grid x:Name="WhatsNewLayer" Grid.ColumnSpan="2" DataContext="{Binding WhatsNew}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
            <Border Background="#99000000" MouseLeftButtonDown="WhatsNewBackdrop_MouseDown" />
            <!-- The card itself exists only while open: kept in the window while closed, its list held on to closed pages
                 after a theme change (a WPF quirk; MemoryLeakTests caught it). -->
            <ContentControl x:Name="WhatsNewCardHost" Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource WhatsNewCard}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- "Enjoying RigSight?": in the middle of the window, the page dimmed behind it, at a good moment only (see
             SupportViewModel). Esc or a click beside it is "Maybe later". Buy Me a Coffee's yellow in every theme. -->
        <Grid x:Name="SupportLayer" Grid.ColumnSpan="2" DataContext="{Binding Support}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
            <!-- Darker than What's new's: the card is about as dark as the page's own cards, so the page steps back further -->
            <Border Background="#B8000000" MouseLeftButtonDown="SupportBackdrop_MouseDown" />
            <!-- The card's shadow, on a box of its own behind it: on the card itself it would soften the text -->
            <Border Width="420" Height="{Binding ActualHeight, ElementName=SupportCard}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.75" Color="Black" />
                </Border.Effect>
            </Border>
            <ctl:SmoothBorder x:Name="SupportCard" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,28,28,22"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="1.5" CornerRadius="16"
                              AutomationProperties.Name="Support RigSight">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="14" Background="#FFDD00" HorizontalAlignment="Center">
                        <Grid>
                            <!-- A heart while asking (as the menu's Support RigSight), a tick once thanked -->
                            <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="24" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Thanked, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="24" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Thanked, Converter={StaticResource Vis}}" />
                        </Grid>
                    </Border>
                    <!-- Asking -->
                    <StackPanel Visibility="{Binding Thanked, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <TextBlock Text="{ctl:T 'Enjoying RigSight?'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="{ctl:T 'I build RigSight on my own, in my spare time. If it\'s been useful to you, a coffee helps me keep working on it.'}"
                                   FontSize="13.5" LineHeight="21" Foreground="{DynamicResource TextBrush}" Opacity="0.85" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                        <Button Style="{StaticResource AccentButton}" Background="#FFDD00" Foreground="#000000" Content="{ctl:T 'Buy me a coffee'}"
                                Command="{Binding CoffeeCommand}" HorizontalAlignment="Stretch" Margin="0,18,0,0" Padding="14,10" FontSize="14"
                                AutomationProperties.Name="Buy me a coffee" />
                        <UniformGrid Columns="2" Margin="-4,8,-4,0">
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Maybe later'}" Command="{Binding LaterCommand}" Margin="4,0" Padding="12,9"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Maybe later" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Don\'t show again'}" Command="{Binding NeverCommand}" Margin="4,0" Padding="12,9"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Don't show again" />
                        </UniformGrid>
                    </StackPanel>
                    <!-- After the coffee button -->
                    <StackPanel Visibility="{Binding Thanked, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'Thank you'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="{ctl:T 'It means a lot. RigSight won\'t ask again.'}" FontSize="13.5" Foreground="{DynamicResource TextBrush}" Opacity="0.85"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,6" />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>
        </Grid>

        <!-- A new install, once: which pages the sidebar shows (the few most people use, or every page). A press on either
             answers it; Settings › Look has the same choice after. (2026-10-25) -->
        <Grid x:Name="PagesLayer" Grid.ColumnSpan="2" DataContext="{Binding Sidebar}" Visibility="{Binding AskPages, Converter={StaticResource Vis}}"
              AutomationProperties.Name="Pick the pages">
            <Border Background="#B8000000" />
            <ctl:SmoothBorder Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,28,28,20"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="1.5" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="{ctl:T 'How much should RigSight show?'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{ctl:T 'Pick the pages for your sidebar. RigSight records the same either way.'}"
                               FontSize="13.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22" />
                    <UniformGrid Columns="2" Margin="-7,0">
                        <UniformGrid.Resources>
                            <!-- One choice: a card that is a button. The basics, recommended, has the accent's edge from the start. -->
                            <Style x:Key="PagesChoice" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Margin" Value="7,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ctl:SmoothBorder x:Name="Bd" CornerRadius="14" Padding="18,16" Background="{DynamicResource Surface2Brush}"
                                                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                                                <ContentPresenter />
                                            </ctl:SmoothBorder>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBrush}" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBrush}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- The 16 pages as tiles in a 4 by 4 square: lit ones filled, the rest a dashed outline. -->
                            <DataTemplate x:Key="PageTileT">
                                <Grid Margin="4">
                                    <Border x:Name="Tile" CornerRadius="8" Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" />
                                    <!-- Left out: a dashed outline (a Border can't draw dashes). -->
                                    <Rectangle x:Name="Dashed" RadiusX="8" RadiusY="8" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 3" Visibility="Collapsed" />
                                    <ContentPresenter x:Name="TileIcon" Content="{Binding Icon, Converter={StaticResource NavIcon}}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="15" TextElement.Foreground="{DynamicResource TextBrush}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Lit}" Value="False">
                                        <Setter TargetName="Tile" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Dashed" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TileIcon" Property="TextElement.Foreground" Value="{DynamicResource FaintBrush}" />
                                        <Setter TargetName="TileIcon" Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <Style x:Key="TileBox" TargetType="Border">
                                <Setter Property="Height" Value="164" />
                                <Setter Property="Padding" Value="18,12" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Background" Value="{DynamicResource BgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </UniformGrid.Resources>
                        <Button Style="{StaticResource PagesChoice}" BorderBrush="{DynamicResource AccentBrush}" Command="{Binding PickPagesCommand}" CommandParameter="basic" AutomationProperties.Name="The basics">
                            <StackPanel>
                                <Border Style="{StaticResource TileBox}">
                                    <ItemsControl ItemsSource="{Binding BasicTiles}" ItemTemplate="{StaticResource PageTileT}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                                <StackPanel Orientation="Horizontal" Height="24" Margin="0,14,0,0">
                                    <TextBlock Text="{ctl:T 'The basics'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{ctl:T 'RECOMMENDED'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{ctl:T '6 of the 16 pages, to see whether your PC is fine and what went wrong.'}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" MinHeight="38" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PagesChoice}" Command="{Binding PickPagesCommand}" CommandParameter="full" AutomationProperties.Name="Everything">
                            <StackPanel>
                                <Border Style="{StaticResource TileBox}">
                                    <ItemsControl ItemsSource="{Binding FullTiles}" ItemTemplate="{StaticResource PageTileT}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                                <StackPanel Orientation="Horizontal" Height="24" Margin="0,14,0,0">
                                    <TextBlock Text="{ctl:T 'Everything'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{ctl:T 'All 16 pages, for every detail like what\'s running, fans, sensors and widgets.'}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" MinHeight="38" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <!-- Where pages come back: Settings, page by page (there is no "More pages" in the sidebar: the user, 2026-10-25). -->
                    <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
                                <Run Text="{ctl:T 'Change it any time in'}" /> <Run Text="{ctl:T 'Settings › Appearance › Sidebar'}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text="{ctl:T ', where every page has its own switch.'}" />
                            </TextBlock>
                        </DockPanel>
                    </ctl:SmoothBorder>
                    <Button Style="{StaticResource ActionButton}" Content="{ctl:T 'Decide later (shows every page)'}" Command="{Binding PickPagesCommand}" CommandParameter="full"
                            HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </ctl:SmoothBorder>
        </Grid>

        <!-- New dashboard: presets this PC can fill, and a blank page. Closed with the x, Esc or a click outside. -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Presets}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
            <Border Background="#99000000" MouseLeftButtonDown="PresetsBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource PresetPicker}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- Export: opened from Settings → History. Closed with the x, Cancel, Esc or a click outside (not while it writes). -->
        <Grid x:Name="ExportLayer" Grid.ColumnSpan="2" DataContext="{Binding Export}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Background="#99000000" MouseLeftButtonDown="ExportBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:ExportBox />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- A page's own Export box: opened from the Export button in its header. Closed like the Export box. -->
        <Grid x:Name="PageExportLayer" Grid.ColumnSpan="2" DataContext="{Binding PageExport}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Background="#99000000" MouseLeftButtonDown="PageExportBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PageExportBox />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- Instructions for Ollama or my own key: opened from Settings › Ask RigSight. Closed with the x, Cancel, Esc or a click outside. -->
        <Grid x:Name="InstructionsLayer" Grid.ColumnSpan="2" DataContext="{Binding SettingsPage.Ai.Editor}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Background="#99000000" MouseLeftButtonDown="InstructionsBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:InstructionsBox />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- "End … ?": asked before a part of Windows is ended from the Processes page. Esc or a click outside cancels. -->
        <Grid x:Name="EndQuestionLayer" Grid.ColumnSpan="2" DataContext="{Binding Processes.Question}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Background="#99000000" MouseLeftButtonDown="EndQuestionBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource EndQuestionCard}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
        <!-- The Ask window: over the pages, but not in their way (only the window itself takes clicks). Built only while
             open, like the cards above; what it shows stays in Ask between openings. -->
        <ContentControl Grid.ColumnSpan="2" Content="{Binding Ask}" Focusable="False" Visibility="{Binding Ask.IsOpen, Converter={StaticResource Vis}}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Ask.IsOpen}" Value="True">
                            <Setter Property="ContentTemplate">
                                <Setter.Value><DataTemplate><views:AskWindow /></DataTemplate></Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <!-- RigSight AI's plans over the whole window: opened from Settings › AI or an Ask card; Back or Esc closes it.
             After the Ask window, so a card's See plans covers it, and Back returns to the chat. -->
        <Grid x:Name="PlansLayer" Grid.ColumnSpan="2" DataContext="{Binding Plans}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle">
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PlansScreen />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- "Cancel Essentials?" and "Switch to Complete?": asked before anything about money changes. Esc or a click outside closes. -->
        <Grid x:Name="PlanDialogLayer" Grid.ColumnSpan="2" DataContext="{Binding Plans}" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CancelOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding SwitchOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding BillingOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="#99000000" MouseLeftButtonDown="PlanDialogBackdrop_MouseDown" />
            <ctl:SmoothBorder Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22,24,18"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <!-- Cancel -->
                    <StackPanel Visibility="{Binding CancelOpen, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding CancelTitle}">
                        <TextBlock Text="{Binding CancelTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CancelText}" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />
                        <TextBlock Text="{ctl:T 'What made you cancel? (optional)'}" FontSize="12" Foreground="{DynamicResource FaintBrush}" />
                        <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,8,0,4" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Margin="0,0,6,6" Padding="11,4" FontSize="12.5" AutomationProperties.Name="{Binding Text}"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chip" CornerRadius="13" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter TextElement.Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                    <DataTrigger Binding="{Binding Picked}" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextBrush}" /></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <ctl:Spinner Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding ConfirmCancelCommand.IsRunning, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Keep my plan'}" Command="{Binding CloseDialogsCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Cancel plan'}" Command="{Binding ConfirmCancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Switch -->
                    <StackPanel Visibility="{Binding SwitchOpen, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding SwitchTitle}">
                        <TextBlock Text="{Binding SwitchTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SwitchText2}" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <ctl:Spinner Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding ConfirmSwitchCommand.IsRunning, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Not now'}" Command="{Binding CloseDialogsCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AccentButton}" Content="{Binding SwitchConfirm}" Command="{Binding ConfirmSwitchCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Monthly <-> yearly: to yearly with about what's paid today -->
                    <StackPanel Visibility="{Binding BillingOpen, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding BillingTitle}">
                        <TextBlock Text="{Binding BillingTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BillingText}" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding ShowsBillingMoney, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="{ctl:T 'A year of your plan'}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{Binding BillingYear}" FontSize="13" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="{ctl:T 'Back for the rest of this month'}" FontSize="13" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BillingBack}" FontSize="13" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BillingToday}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{ctl:T 'About, today'}" FontSize="13" FontWeight="SemiBold" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </ctl:SmoothBorder>
                        <TextBlock Text="{ctl:T 'Lemon Squeezy works out the exact sum.'}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding ShowsBillingMoney, Converter={StaticResource Vis}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <ctl:Spinner Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding ConfirmBillingCommand.IsRunning, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Not now'}" Command="{Binding CloseDialogsCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AccentButton}" Content="{Binding BillingConfirm}" Command="{Binding ConfirmBillingCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Problem}" FontSize="12.5" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasProblem, Converter={StaticResource Vis}}" />
                </StackPanel>
            </ctl:SmoothBorder>
        </Grid>

        <!-- Rewind: the full screen when one is ready (like the update screen), then the cards and Share. -->
        <rw:RewindLayer Grid.ColumnSpan="2" DataContext="{Binding Rewind}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}" />
        <!-- Updating: over the whole window from the moment someone presses Update now until the installer closes it (see
             UpdateViewModel.ShowOverlay). Opaque, so nothing on the pages behind it can be clicked meanwhile. -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Update}" Background="{DynamicResource BgBrush}"
              Visibility="{Binding ShowOverlay, Converter={StaticResource Vis}}" AutomationProperties.Name="Updating RigSight">
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding OverlayFailed, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                <!-- The full-size picture, scaled down: the .ico's nearest frame is 48 px, which stretched to 56 looked soft. -->
                <Image Source="Assets/Rigsight.png" Width="56" Height="56" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True" />
                <TextBlock Text="{ctl:T 'Updating RigSight'}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding OverlayVersions}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,22" />
                <ProgressBar Style="{StaticResource Bar}" Height="8" Value="{Binding OverlayFill, Mode=OneWay}" Maximum="100" />
                <TextBlock Text="{ctl:T 'RigSight closes and opens again by itself.'}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="{ctl:T 'This takes about 15 seconds. Your history and settings stay as they are.'}" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                <!-- Longer than an install takes (an admin's password asked for, say): a way back to the app, the sidebar
                     still saying how it goes. Its room is kept from the start, so nothing moves when it shows. -->
                <Button Content="{ctl:T 'Keep using RigSight'}" Command="{Binding LeaveOverlayCommand}" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverlayCanLeave}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding OverlayFailed, Converter={StaticResource Vis}}">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource WarmBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock Text="{ctl:T 'The update didn\'t install'}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ReleaseFeedCurrentText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,18" />
                <UniformGrid Columns="2" Width="260">
                    <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Try again'}" Command="{Binding RetryFromOverlayCommand}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Close'}" Command="{Binding CloseOverlayCommand}" Margin="4,0,0,0" />
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Grid>
    </DockPanel>
    </Border>
</Window>
