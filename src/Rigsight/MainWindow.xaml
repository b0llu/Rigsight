<Window x:Class="Rigsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
        xmlns:views="clr-namespace:Rigsight.Views"
        Title="RigSight" Icon="Assets/Rigsight.ico"
        Width="1400" Height="920" MinWidth="1140" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <!-- What's new (see the layer at the end of the window). -->
        <DataTemplate x:Key="WhatsNewCard">
                    <ctl:SmoothBorder Width="540" MaxHeight="760" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                                      AutomationProperties.Name="What's new">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="28,22,16,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="Close">
                                    <TextBlock Text="&#xE711;" />
                                </Button>
                                <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- Virtualized: "See all updates" builds only the releases in view, not every one of them at once. -->
                            <ItemsControl ItemsSource="{Binding Shown}" Focusable="False" Margin="28,0,12,0" AlternationCount="100000"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0" CanContentScroll="True" Focusable="False">
                                            <ItemsPresenter Margin="0,0,0,24" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- One version: a line above it (not above the first), then its number, date and groups. -->
                                            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,4" Margin="0,8,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Padding" Value="0,6,0,4" />
                                                                <Setter Property="Margin" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Short}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                    </DockPanel>
                                                    <!-- The release's headline feature: big, in colour, with what it does and a way straight to it. -->
                                                    <!-- The feature is the card's data from here in; the card itself is the border inside, so what it looks
                                                         like can depend on the feature (a style on this one would be read before the feature is its data). -->
                                                    <Grid Margin="0,16,0,4" Visibility="{Binding Converter={StaticResource Vis}}" DataContext="{Binding Feature}">
                                                    <Border CornerRadius="14" Padding="22,20,22,22" BorderThickness="1" AutomationProperties.Name="{Binding Tag}">
                                                        <!-- Something new is in colour. Something taken away is plain and grey: colour says "new". -->
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.30">
                                                                            <GradientStop Color="{DynamicResource CpuColor}" Offset="0" />
                                                                            <GradientStop Color="{DynamicResource PurpleColor}" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="BorderBrush">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.75">
                                                                            <GradientStop Color="{DynamicResource CpuColor}" Offset="0" />
                                                                            <GradientStop Color="{DynamicResource PurpleColor}" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource CpuBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource FaintBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <!-- The page's own icon as in the sidebar (a font character, or the drawn fan), larger. -->
                                                                    <Viewbox Width="26" Height="26">
                                                                        <ContentControl Content="{Binding Icon, Converter={StaticResource NavIcon}}" Focusable="False"
                                                                                        FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource CpuBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource FaintBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                        <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Pitch}" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,4" />
                                                            <ItemsControl ItemsSource="{Binding Points}" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="0,9,0,0">
                                                                            <!-- A tick for what something new can do; a plain dot for a reason. -->
                                                                            <Grid DockPanel.Dock="Left" Width="13" Margin="0,3,10,0" VerticalAlignment="Top">
                                                                                <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource CpuBrush}" />
                                                                                <Ellipse x:Name="Dot" Width="5" Height="5" Margin="0,5,0,0" VerticalAlignment="Top" Fill="{DynamicResource FaintBrush}" Visibility="Collapsed" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource TextBrush}" />
                                                                        </DockPanel>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsRemoval, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                                <Setter TargetName="Tick" Property="Visibility" Value="Collapsed" />
                                                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- Something true about this PC, where the feature already has it. -->
                                                            <TextBlock Text="{Binding Fact}" FontSize="13" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" Foreground="{DynamicResource CpuBrush}" Margin="0,16,0,0"
                                                                       Visibility="{Binding Fact, Converter={StaticResource Vis}}" />
                                                            <!-- Something new has a way straight to it; something gone has nowhere to send you. -->
                                                            <Button HorizontalAlignment="Left" Margin="0,16,0,0" Content="{Binding OpenText}"
                                                                    Command="{Binding DataContext.OpenFeatureCommand, RelativeSource={RelativeSource AncestorType=ctl:SmoothBorder}}" CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowsButton}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,14,0,0">
                                                                    <!-- The group as a small coloured badge: new in blue, better in green, fixed in amber. -->
                                                                    <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left" Margin="0,0,0,2">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="new">
                                                                                        <Setter Property="Background" Value="{DynamicResource CpuSoftBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="better">
                                                                                        <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="new">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource CpuBrush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="better">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <DockPanel Margin="0,8,0,0">
                                                                                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="4" Height="4" Margin="2,8,12,0" VerticalAlignment="Top"
                                                                                             Fill="{DynamicResource FaintBrush}" />
                                                                                    <TextBlock x:Name="Spark" DockPanel.Dock="Left" Text="&#xE735;" Style="{StaticResource Icon}" FontSize="11" Margin="0,4,8,0"
                                                                                               VerticalAlignment="Top" Foreground="{DynamicResource CpuBrush}" Visibility="Collapsed" />
                                                                                    <TextBlock x:Name="Line" Text="{Binding}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                                                                                               Foreground="{DynamicResource MutedBrush}" />
                                                                                </DockPanel>
                                                                                <DataTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.Kind, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="new">
                                                                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Spark" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                                        <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                                                                                    </DataTrigger>
                                                                                </DataTemplate.Triggers>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </ctl:SmoothBorder>
        </DataTemplate>
        <!-- New dashboard (see the layer at the end of the window): a card per preset, built only while open. -->
        <DataTemplate x:Key="PresetPicker">
            <ctl:SmoothBorder Width="820" MaxHeight="760" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                              AutomationProperties.Name="New dashboard">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="28,22,16,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="Close">
                            <TextBlock Text="&#xE711;" />
                        </Button>
                        <TextBlock Text="{ctl:T 'New dashboard'}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{ctl:T 'Start from a preset made for this PC\'s sensors, then change anything you like.'}"
                               Style="{StaticResource Muted}" Margin="28,0,28,16" TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22,0,10,22" Padding="0,0,12,0">
                        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Cursor="Hand" Focusable="False" Margin="6" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" MinWidth="0" MinHeight="0" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ctl:SmoothBorder x:Name="Bd" CornerRadius="12" Padding="16,14" Background="{DynamicResource Surface2Brush}"
                                                                  BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                                    <ContentPresenter />
                                                </ctl:SmoothBorder>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Shows}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding Shows, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <!-- The question before a part of Windows is ended from the Processes page: what will happen, then the buttons.
             The one in front (Enter) is the safe one: Cancel, or "Restart it" for Windows Explorer. -->
        <DataTemplate x:Key="EndQuestionCard">
            <ctl:SmoothBorder Width="470" Margin="24" Padding="26,22,26,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                              AutomationProperties.Name="{Binding Question.Title}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource WarmBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Question.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Question.Body}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Question.Body, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Question.Intro}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Question.Intro, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Question.Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" · " /><Run Text="{Binding Effect, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="{ctl:T 'I understand that unsaved work may be lost'}" IsChecked="{Binding Question.Ticked}" FontSize="13" Margin="0,16,0,0"
                              Foreground="{DynamicResource TextBrush}" Visibility="{Binding Question.NeedsTick, Converter={StaticResource Vis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="{ctl:T 'End anyway'}" Command="{Binding AnswerCommand}" CommandParameter="End" IsEnabled="{Binding Question.CanEnd}"
                                Background="{DynamicResource HotSoftBrush}" Foreground="{DynamicResource HotBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{ctl:T 'Cancel'}" Command="{Binding AnswerCommand}" CommandParameter="Cancel" Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Question.CancelIsDefault}" Value="True">
                                            <Setter Property="IsDefault" Value="True" />
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{ctl:T 'Restart it'}" Style="{StaticResource AccentButton}" IsDefault="True" Command="{Binding AnswerCommand}" CommandParameter="Restart" Margin="10,0,0,0"
                                Visibility="{Binding Question.CanRestart, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="SidebarHost" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <!-- Bottom: an update if there is one, an agent warning if needed, then Settings and its menu -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Update: a quiet line, then download progress, then the restart prompt -->
                    <StackPanel DataContext="{Binding Update}">
                        <Button Command="{Binding ActionCommand}" ToolTip="{Binding LineTip}" AutomationProperties.Name="{Binding LineTitle}" Cursor="Hand" Focusable="False"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"
                                Visibility="{Binding ShowLine, Converter={StaticResource Vis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ctl:SmoothBorder x:Name="Bd" CornerRadius="10" Padding="12,9" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </ctl:SmoothBorder>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock Text="{Binding LineIcon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource GoodBrush}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding LineTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <ctl:SmoothBorder CornerRadius="12" Padding="12,10,12,12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               Visibility="{Binding State, Converter={StaticResource EqualsVis}, ConverterParameter=Downloading}" />
                                    <TextBlock Text="{Binding ProgressTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource Bar}" Height="4" Margin="0,8,0,6" Value="{Binding Progress}" Foreground="{DynamicResource GoodBrush}" />
                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource GoodBrush}" BorderThickness="1"
                                Visibility="{Binding ShowPrompt, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PromptTitle}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding PromptText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource AccentButton}" Content="{Binding InstallText}" Command="{Binding InstallCommand}" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Later'}" Command="{Binding LaterCommand}" Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <!-- Didn't work: try again, or get the installer from the website -->
                        <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1"
                                Visibility="{Binding ShowFailed, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource WarmBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{ctl:T 'Update didn\'t finish'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding FailedText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Try again'}" Command="{Binding ActionCommand}" HorizontalAlignment="Stretch" />
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Open download page'}" Command="{Binding OpenDownloadPageCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                            </StackPanel>
                        </ctl:SmoothBorder>
                    </StackPanel>

                    <!-- The agent is being started: said quietly, with nothing to press. The warning below is for when it didn't come. -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12,10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            Visibility="{Binding ShowAgentStarting, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="M 6,0.75 A 5.25,5.25 0 1 1 0.75,6" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform />
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowAgentStarting}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="AgentSpin">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="AgentSpin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding AgentStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </ctl:SmoothBorder>

                    <!-- A standard account, once: nothing is wrong, some readings just can't be had. One press opens Settings on
                         the tab that lists them, and the note is gone for good. -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            Visibility="{Binding ShowStandardNote, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource CpuSoftBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource CpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{ctl:T 'Standard account'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{ctl:T 'CPU temperature and a few other readings are off here.'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenAdminRightsCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="See what's off">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'See what\'s off'}" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- The history file: damage the check confirmed, a repair waiting, or what a repair kept (see HistoryRepair). -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" BorderThickness="1" AutomationProperties.Name="History file"
                                      DataContext="{Binding HistoryCard}" Visibility="{Binding Converter={StaticResource Vis}}">
                        <ctl:SmoothBorder.Style>
                            <Style TargetType="ctl:SmoothBorder">
                                <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarm}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:SmoothBorder.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWarm}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <!-- Equal halves, one height (a lone button takes the whole width): collapsed buttons take no cell. -->
                            <UniformGrid Rows="1" Margin="-3,0">
                                <Button Style="{StaticResource AccentButton}" Margin="3,0" HorizontalAlignment="Stretch" Content="{ctl:T 'Repair'}" AutomationProperties.Name="Repair history"
                                        Command="{Binding DataContext.RepairHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanRepair, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource AccentButton}" Margin="3,0" HorizontalAlignment="Stretch" Content="{ctl:T 'Try again'}" AutomationProperties.Name="Try the history repair again"
                                        Command="{Binding DataContext.RepairHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanRetry, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource GhostButton}" Margin="3,0" Padding="6,8" HorizontalAlignment="Stretch" Content="{ctl:T 'Open folder'}" AutomationProperties.Name="Open the history folder"
                                        Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanOpenFolder, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource GhostButton}" Margin="3,0" Padding="6,8" HorizontalAlignment="Stretch" Content="{Binding DismissText}"
                                        Command="{Binding DataContext.DismissHistoryCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanDismiss, Converter={StaticResource Vis}}" />
                            </UniformGrid>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource WarmSoftBrush}"
                            BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1"
                            Visibility="{Binding ShowAgentWarning, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{ctl:T 'Background agent not running'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="{ctl:T 'Agent running without admin rights'}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AgentOutOfDate}" Value="True">
                                                <Setter Property="Text" Value="{ctl:T 'Background agent is another version'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AgentHint}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding StartAgentCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AgentButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- The newest language pack couldn't be had after an update: the old one keeps working, the newest words
                         show in English until it's downloaded (Settings → Language has the same line). -->
                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource WarmSoftBrush}"
                            BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1" DataContext="{Binding Language}"
                            Visibility="{Binding ShowCard, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'The latest language pack couldn\'t be downloaded'}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{ctl:T 'Some new words show in English until it\'s downloaded.'}" FontSize="11.5"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding ActCommand}" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Try the language pack again">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{ctl:T 'Try again'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- Settings: always at the foot of the sidebar, however far the pages above are scrolled. A press opens a
                         small menu over it (Settings first, then the things people come looking for: updates, what's new,
                         reporting a bug); the menu floats, so nothing moves. Marked like a page while Settings is open. -->
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="12,4,12,10" />
                    <ToggleButton x:Name="SettingsRow" AutomationProperties.Name="Settings and more" Cursor="Hand" Focusable="False"
                                  HorizontalAlignment="Stretch" Foreground="{DynamicResource MutedBrush}"
                                  Tag="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=settings}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                    <Grid>
                                        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE713;" Style="{StaticResource Icon}" Foreground="{TemplateBinding Foreground}" />
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="10"
                                                       Foreground="{DynamicResource FaintBrush}" Margin="8,0,0,0" />
                                            <!-- A dot while something in Settings needs a look (sensors being left out), until it's been seen there. -->
                                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource WarmBrush}"
                                                     ToolTip="{ctl:T 'Something in Settings needs a look'}"
                                                     Visibility="{Binding SettingsNeedAttention, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{ctl:T 'Settings'}" Margin="12,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <!-- The menu closes on a click anywhere outside it; without this, a click on the row
                                             itself would close it and open it again at once. -->
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="SettingsMenu" PlacementTarget="{Binding ElementName=SettingsRow}" Placement="Top" VerticalOffset="-6" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=SettingsRow, Mode=TwoWay}" Closed="SettingsMenu_Closed">
                        <Border Width="{Binding ActualWidth, ElementName=SettingsRow}" Background="{DynamicResource TooltipBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="6">
                            <StackPanel Button.Click="SettingsMenu_Click">
                                <StackPanel.Resources>
                                    <!-- A line of the menu: its icon (the Tag) and its words. -->
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="14"
                                                                       Foreground="{DynamicResource MutedBrush}" Width="16" TextAlignment="Center" />
                                                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.FontSize="13"
                                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="MenuRule" TargetType="Border">
                                        <Setter Property="Height" Value="1" />
                                        <Setter Property="Margin" Value="4,5" />
                                        <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
                                    </Style>
                                </StackPanel.Resources>
                                <Button Tag="&#xE713;" Content="{ctl:T 'Settings'}" Command="{Binding GoCommand}" CommandParameter="settings" AutomationProperties.Name="Settings" />
                                <!-- Checking for an update keeps the menu open, and the line itself becomes the answer
                                     ("Checking…", then "Up to date" with a tick) until the menu closes: see the code
                                     behind. Every other line closes the menu. -->
                                <Button x:Name="MenuUpdate" Tag="&#xE72C;" Command="{Binding Update.ActionCommand}" AutomationProperties.Name="{Binding Update.ActionText}">
                                    <Grid>
                                        <TextBlock x:Name="MenuUpdateText" Text="{Binding Update.ActionText}" />
                                        <TextBlock x:Name="MenuUpdateAnswer" Text="{Binding Update.AnswerText}" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <Button Tag="&#xE7C3;" Content="{ctl:T 'What\'s new'}" Command="{Binding WhatsNew.SeeAllCommand}" />
                                <Border Style="{StaticResource MenuRule}" />
                                <Button Tag="&#xEBE8;" Content="{ctl:T 'Report a bug'}" Command="{Binding SettingsPage.ReportBugCommand}" />
                                <Button Tag="&#xE8C8;" Content="{ctl:T 'Copy logs'}" Command="{Binding SettingsPage.CopyProblemReportCommand}" />
                                <Button Tag="&#xEB51;" Content="{ctl:T 'Support RigSight'}" Command="{Binding SettingsPage.SupportCommand}" />
                                <Border Style="{StaticResource MenuRule}" />
                                <Button Tag="&#xE946;" Content="{ctl:T 'About RigSight'}" Command="{Binding AboutCommand}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="10,6,10,4">
                                    <Run Text="{ctl:T 'Version'}" /> <Run Text="{Binding SettingsPage.AppVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Navigation (scrolls if there are many dashboards on a short screen). Which page is in which group, their order
                     and names, and what is hidden come from the sidebar editor in Settings; DASHBOARDS, HARDWARE and ON SCREEN
                     fold away with a click on their heading. A heading left out takes no room: its pages follow the ones above. -->
                <!-- Its bar sits in the sidebar's right margin, clear of the items (it used to lie on their edge). -->
                <ScrollViewer Style="{StaticResource CardScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel DataContext="{Binding Sidebar}">
                    <StackPanel.Resources>
                        <DataTemplate x:Key="NavEntry">
                            <!-- The name may be the user's own: one too long for the sidebar is cut short, as a dashboard's is. -->
                            <RadioButton Style="{StaticResource NavItem}" Tag="{Binding Icon, Converter={StaticResource NavIcon}}" AutomationProperties.Name="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding IsVisible, Converter={StaticResource Vis}}" Click="NavClicked">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </RadioButton>
                        </DataTemplate>
                        <!-- A section heading that folds its group: the caption, and a chevron at the right in the muted text colour (white while hovered). -->
                        <Style x:Key="SectionToggle" TargetType="Button">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,14,0,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,4,10,4">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Text="&#xE70D;" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <ItemsControl ItemsSource="{Binding Main}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />

                    <Button Style="{StaticResource SectionToggle}" Tag="{Binding DashboardsCollapsed}" Command="{Binding ToggleSectionCommand}" CommandParameter="dashboards"
                            AutomationProperties.Name="{Binding DashboardsGroup.Title}" ToolTip="{ctl:T 'Show or hide your dashboards'}"
                            Visibility="{Binding DashboardsGroup.ShowHeading, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding DashboardsGroup.Heading}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <!-- The user's dashboards, and any page moved in among them; a dashboard moved out is in the group it was put in. -->
                    <ItemsControl ItemsSource="{Binding DashboardsGroup.Pages}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />
                    <Button Command="{Binding DataContext.Presets.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="New dashboard"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" Focusable="False" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,4"
                            ToolTip="{ctl:T 'Start from a preset or a blank page'}"
                            Visibility="{Binding DashboardsCollapsed, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock Text="{ctl:T 'New dashboard'}" Margin="12,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Style="{StaticResource SectionToggle}" Tag="{Binding HardwareCollapsed}" Command="{Binding ToggleSectionCommand}" CommandParameter="hardware"
                            AutomationProperties.Name="{Binding HardwareGroup.Title}" ToolTip="{ctl:T 'Show or hide these pages'}"
                            Visibility="{Binding HardwareGroup.ShowHeading, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding HardwareGroup.Heading}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />

                    <Button Style="{StaticResource SectionToggle}" Tag="{Binding OnScreenCollapsed}" Command="{Binding ToggleSectionCommand}" CommandParameter="onscreen"
                            AutomationProperties.Name="{Binding OnScreenGroup.Title}" ToolTip="{ctl:T 'Show or hide these pages'}"
                            Visibility="{Binding OnScreenGroup.ShowHeading, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding OnScreenGroup.Heading}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding OnScreen}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Pages (created on first visit, then kept), with a note at the top of one that couldn't read part of its history. -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Margin="28,14,28,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource WarmSoftBrush}"
                    AutomationProperties.Name="Part of this page can't be read" Visibility="{Binding PageUnreadable, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{ctl:T 'Repair'}" Command="{Binding RepairHistoryCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource WarmBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}">
                        <Run Text="{ctl:T 'Part of this page\'s history can\'t be read.'}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <Run Text="{ctl:T 'It may show less than was recorded, or nothing. A repair brings back everything that can still be read.'}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Focusable="False" />
        </DockPanel>

        <!-- What's new: once after an update, over the whole window. Closed with the x, Esc or a click outside; every update is in Settings. -->
        <!-- It fades in from code (MainWindow.xaml.cs): a style-triggered animation here kept closed pages in memory. -->
        <Grid x:Name="WhatsNewLayer" Grid.ColumnSpan="2" DataContext="{Binding WhatsNew}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
            <Border Background="#99000000" MouseLeftButtonDown="WhatsNewBackdrop_MouseDown" />
            <!-- The card itself exists only while open: kept in the window while closed, its list held on to closed pages
                 after a theme change (a WPF quirk; MemoryLeakTests caught it). -->
            <ContentControl x:Name="WhatsNewCardHost" Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource WhatsNewCard}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- New dashboard: presets this PC can fill, and a blank page. Closed with the x, Esc or a click outside. -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Presets}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
            <Border Background="#99000000" MouseLeftButtonDown="PresetsBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource PresetPicker}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- Export: opened from Settings → History. Closed with the x, Cancel, Esc or a click outside (not while it writes). -->
        <Grid x:Name="ExportLayer" Grid.ColumnSpan="2" DataContext="{Binding Export}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Background="#99000000" MouseLeftButtonDown="ExportBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:ExportBox />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- "End … ?": asked before a part of Windows is ended from the Processes page. Esc or a click outside cancels. -->
        <Grid x:Name="EndQuestionLayer" Grid.ColumnSpan="2" DataContext="{Binding Processes.Question}" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Background="#99000000" MouseLeftButtonDown="EndQuestionBackdrop_MouseDown" />
            <ContentControl Content="{Binding}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource EndQuestionCard}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
        <!-- Updating: over the whole window from the moment someone presses Update now until the installer closes it (see
             UpdateViewModel.ShowOverlay). Opaque, so nothing on the pages behind it can be clicked meanwhile. -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Update}" Background="{DynamicResource BgBrush}"
              Visibility="{Binding ShowOverlay, Converter={StaticResource Vis}}" AutomationProperties.Name="Updating RigSight">
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding OverlayFailed, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                <!-- The full-size picture, scaled down: the .ico's nearest frame is 48 px, which stretched to 56 looked soft. -->
                <Image Source="Assets/Rigsight.png" Width="56" Height="56" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True" />
                <TextBlock Text="{ctl:T 'Updating RigSight'}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding OverlayVersions}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,22" />
                <ProgressBar Style="{StaticResource Bar}" Height="8" Value="{Binding OverlayFill, Mode=OneWay}" Maximum="100" />
                <TextBlock Text="{ctl:T 'RigSight closes and opens again by itself.'}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="{ctl:T 'This takes about 15 seconds. Your history and settings stay as they are.'}" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding OverlayFailed, Converter={StaticResource Vis}}">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource WarmBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock Text="{ctl:T 'The update didn\'t install'}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ReleaseFeedCurrentText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,18" />
                <UniformGrid Columns="2" Width="260">
                    <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Try again'}" Command="{Binding RetryFromOverlayCommand}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Close'}" Command="{Binding CloseOverlayCommand}" Margin="4,0,0,0" />
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
