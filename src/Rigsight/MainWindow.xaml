<Window x:Class="Rigsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
        xmlns:views="clr-namespace:Rigsight.Views"
        Title="Rigsight" Icon="Assets/Rigsight.ico"
        Width="1400" Height="920" MinWidth="1140" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <!-- Bottom: an update if there is one, an agent warning if needed, then a live readout -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Update: a quiet line, then download progress, then the restart prompt -->
                    <StackPanel DataContext="{Binding Update}">
                        <Button Command="{Binding ActionCommand}" ToolTip="{Binding LineTip}" AutomationProperties.Name="{Binding LineTitle}" Cursor="Hand" Focusable="False"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"
                                Visibility="{Binding ShowLine, Converter={StaticResource Vis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ctl:SmoothBorder x:Name="Bd" CornerRadius="10" Padding="12,9" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </ctl:SmoothBorder>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock Text="{Binding LineIcon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource GoodBrush}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding LineTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>

                        <ctl:SmoothBorder CornerRadius="12" Padding="12,10,12,12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               Visibility="{Binding State, Converter={StaticResource EqualsVis}, ConverterParameter=Downloading}" />
                                    <TextBlock Text="{Binding ProgressTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource Bar}" Height="4" Margin="0,8,0,6" Value="{Binding Progress}" Foreground="{DynamicResource GoodBrush}" />
                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource GoodBrush}" BorderThickness="1"
                                Visibility="{Binding ShowPrompt, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Update ready" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding PromptText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource AccentButton}" Content="Restart" Command="{Binding InstallCommand}" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="Later" Command="{Binding LaterCommand}" Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <!-- Didn't work: try again, or get the installer from the website -->
                        <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1"
                                Visibility="{Binding ShowFailed, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource WarmBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Update didn't finish" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding FailedText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <Button Style="{StaticResource AccentButton}" Content="Try again" Command="{Binding ActionCommand}" HorizontalAlignment="Stretch" />
                                <Button Style="{StaticResource GhostButton}" Content="Open download page" Command="{Binding OpenDownloadPageCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                            </StackPanel>
                        </ctl:SmoothBorder>
                    </StackPanel>

                    <ctl:SmoothBorder CornerRadius="12" Padding="12" Margin="0,0,0,10" Background="{DynamicResource WarmSoftBrush}"
                            BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1"
                            Visibility="{Binding ShowAgentWarning, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Background agent not running" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="Agent running without admin rights" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AgentHint}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding StartAgentCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AgentButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <ctl:SmoothBorder CornerRadius="12" Padding="8,10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            Visibility="{Binding IsConnected, Converter={StaticResource Vis}}">
                        <UniformGrid Columns="3">
                            <UniformGrid.Resources>
                                <Style TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                            </UniformGrid.Resources>
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource CpuBrush}" />
                                <TextBlock Text="{Binding Live.CpuTemp.ShortValue, FallbackValue='—'}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{Binding Live.CpuTemp.Value, Converter={StaticResource TempBrush}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="GPU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource GpuBrush}" />
                                <TextBlock Text="{Binding Live.GpuTemp.ShortValue, FallbackValue='—'}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{Binding Live.GpuTemp.Value, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="RAM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PurpleBrush}" />
                                <TextBlock Text="{Binding Live.RamLoad.ShortValue, FallbackValue='—'}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </ctl:SmoothBorder>
                </StackPanel>

                <!-- Navigation (scrolls if there are many dashboards on a short screen) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Home"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=home}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9F9;" Content="Reports"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=reports}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xECA5;" Content="Apps"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=apps}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7BA;" Content="Crashes"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=crashes}" />

                    <TextBlock Text="DASHBOARDS" Style="{StaticResource Caption}" Margin="12,18,0,8" />
                    <ItemsControl ItemsSource="{Binding CustomPages}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource NavItem}" Tag="&#xF0E2;" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding NewPageCommand}" AutomationProperties.Name="New dashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" Focusable="False" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,4"
                            ToolTip="Build your own dashboard from tiles">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock Text="New dashboard" Margin="12,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="HARDWARE" Style="{StaticResource Caption}" Margin="12,18,0,8" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9CA;" Content="Temperatures"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=temperatures}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE964;" Content="Memory"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=memory}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEDA2;" Content="Storage"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=storage}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="All sensors"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=sensors}" />

                    <TextBlock Text="CUSTOMIZE" Style="{StaticResource Caption}" Margin="12,18,0,8" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xF246;" Content="Widgets"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=widgets}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="Overlay"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=overlay}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=settings}" />
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Pages (created on first visit, then kept) -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
    </Grid>
</Window>
