<UserControl x:Class="Rigsight.Controls.WhatToTryBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <!-- What to try (approved mock-up 2026-11-26, issue #12): the same block under every finding that has steps. The first
         step is "Try first", the rest unnumbered; a button only where RigSight can open or do it; tags only for a
         consequence; a quiet outlined "Tried it" that becomes "Tried 26 Nov". Its DataContext is a TryBlockView; with none,
         the block isn't there. -->
    <UserControl.Resources>
        <!-- "Tried it": a small outlined button, filled on hover, so it reads as something to press. -->
        <Style x:Key="TriedButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Detail}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                        <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{x:Static ctl:Corner.Small}" />
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="{x:Static ctl:Corner.Small}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- A style trigger, not the template's: the first step's filled button keeps its dark text on hover. -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <!-- A step's button: one height with "Tried it" and with what it did, so all three sit level. The card's own
             darker fill and an outline, so it stands out on the block's lighter one (a ghost button's fill is the
             block's own, and it showed no box at all). -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource TriedButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Body}" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="FootLink" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Control}" Padding="16,14,16,10">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock DockPanel.Dock="Left" Text="{ctl:T 'What to try'}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SeenText}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Right" Margin="16,0,0,0" Visibility="{Binding HasSeen, Converter={StaticResource Vis}}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FirstLabel}" FontSize="{x:Static ctl:TextSize.MiniPlus}" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
                            <StackPanel Grid.Column="1" Margin="0,5,12,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{x:Static ctl:TextSize.Body}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Text, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding HasTag, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding TagIcon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding TagText}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                                    </StackPanel></InlineUIContainer>
                                </TextBlock>
                                <TextBlock Text="{Binding Why}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasWhy, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{ctl:T 'RigSight can\'t see whether this was done.'}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding ShowCantSee, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding Note}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                            </StackPanel>

                            <!-- The button, or what it did, or the spinner while it works: all one height, level with "Tried it". -->
                            <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,0,8,0">
                                <Button x:Name="Do" Content="{Binding ButtonText}" Command="{Binding ActCommand}" AutomationProperties.Name="{Binding ButtonText}"
                                        Visibility="{Binding HasButton, Converter={StaticResource Vis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StepButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TextBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding DoneText}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource FaintBrush}" Height="28" Padding="0,6,0,0"
                                           TextWrapping="Wrap" MaxWidth="260" TextAlignment="Right" Visibility="{Binding HasDone, Converter={StaticResource Vis}}" />
                                <ctl:Spinner Width="16" Height="16" StrokeThickness="2" HorizontalAlignment="Center" Visibility="{Binding Busy, Converter={StaticResource Vis}}" />

                                <!-- The question before a change: over the page beside the button, so nothing below moves. -->
                                <Popup x:Name="Question" IsOpen="{Binding Asking, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Do}" Placement="Custom"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Loaded="Question_Loaded" Opened="Question_Opened">
                                    <Border x:Name="Box" Width="360" Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="1"
                                            CornerRadius="{x:Static ctl:Corner.Control}" Padding="16,14" Margin="8" Focusable="True" KeyDown="Box_KeyDown"
                                            AutomationProperties.Name="{Binding AskTitle}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AskTitle}" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AskText}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding AskExtra}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Visibility="{Binding HasAskExtra, Converter={StaticResource Vis}}" />
                                            <!-- Enter presses nothing here: focus starts on the box, and the change needs its own click. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button Style="{StaticResource DangerButton}" Background="{DynamicResource HotBrush}" Foreground="{DynamicResource OnHotBrush}" FontWeight="SemiBold"
                                                        Content="{Binding GoText}" Command="{Binding GoCommand}" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource GhostButton}" Content="{Binding AltText}" Command="{Binding AltCommand}" Margin="0,0,8,0"
                                                        Visibility="{Binding HasAlt, Converter={StaticResource Vis}}" />
                                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Cancel'}" Command="{Binding CancelCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Grid Grid.Column="3" VerticalAlignment="Top">
                                <Button Style="{StaticResource TriedButton}" Content="{ctl:T 'Tried it'}" Command="{Binding TriedCommand}" ToolTip="{ctl:T 'Mark this step as tried'}"
                                        AutomationProperties.Name="{ctl:T 'Mark this step as tried'}" Visibility="{Binding IsTried, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                <StackPanel Orientation="Horizontal" Height="28" Margin="4,0" Visibility="{Binding IsTried, Converter={StaticResource Vis}}">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding TriedText}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="-6,4,-6,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource FootLink}" Content="{Binding HideText}" Command="{Binding ToggleHideCommand}"
                        Visibility="{Binding CanHide, Converter={StaticResource Vis}}" />
                <!-- The AI's link hides itself while the AI is off; a condition of the block's own goes on what holds it. -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AiLink}" Content="{ctl:T 'Ask about this'}" CommandParameter="{Binding Ask}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
