<UserControl x:Class="Rigsight.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <!-- A colour to pick: a rounded square in it, outlined and ticked when it's the one in use (Tag "on"). -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The "+" that opens the custom colour: dashed until it's open. -->
        <Style x:Key="AddSwatch" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Dash" RadiusX="8" RadiusY="8" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource FaintBrush}"
                                       StrokeThickness="1" StrokeDashArray="3 2" />
                            <Border x:Name="On" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" Visibility="Collapsed" />
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="On" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Dash" Property="Stroke" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource StrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Floats over the page, so nothing under it moves (opened by its owner next to the button pressed). -->
    <Popup x:Name="Pop" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom" VerticalOffset="6">
        <ctl:SmoothBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                          CornerRadius="12" Padding="13,12,13,12" Margin="0,0,8,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <StackPanel Width="205">
                <TextBlock x:Name="Heading" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />

                <TextBlock Text="{ctl:T 'NUMBER'}" Style="{StaticResource Caption}" Margin="0,12,0,8" />
                <!-- Temperatures only: by how warm, as RigSight colours them everywhere -->
                <Button x:Name="HeatButton" Style="{StaticResource Swatch}" Width="198" HorizontalAlignment="Left" Height="30" Background="{DynamicResource Surface2Brush}" Click="Heat_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource CoolBrush}" Margin="0,0,3,0" />
                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource GoodBrush}" Margin="0,0,3,0" />
                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource WarmBrush}" Margin="0,0,3,0" />
                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource HotBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{ctl:T 'By heat'}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Three rows at most, the fourth half in sight so it's plain there are more to scroll to -->
                <ScrollViewer x:Name="NumberScroll" Style="{StaticResource CardScroll}" MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="NumberTiles" />
                </ScrollViewer>

                <TextBlock Text="{ctl:T 'NAME AND MARK'}" Style="{StaticResource Caption}" Margin="0,6,0,8" />
                <ScrollViewer x:Name="NameScroll" Style="{StaticResource CardScroll}" MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="NameTiles" />
                </ScrollViewer>

                <!-- Any colour: a square for how light and strong, a bar for the hue, and its code -->
                <StackPanel x:Name="Custom" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="CustomHeading" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <Border Height="124" CornerRadius="8" ClipToBounds="True" Cursor="Cross" Background="Transparent"
                            MouseLeftButtonDown="Square_Down" MouseMove="Square_Move" MouseLeftButtonUp="Drag_Up">
                        <Grid x:Name="Square">
                            <Rectangle x:Name="SquareHue" RadiusX="8" RadiusY="8" Fill="Red" />
                            <Rectangle RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="White" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="Black" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas>
                                <Ellipse x:Name="SquareKnob" Width="14" Height="14" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" Color="Black" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Border>
                    <Grid x:Name="HueBar" Height="14" Margin="0,10,0,0" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Drag_Up">
                        <Rectangle RadiusX="7" RadiusY="7">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas>
                            <Ellipse x:Name="HueKnob" Width="14" Height="14" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" Color="Black" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <DockPanel Margin="0,10,0,0">
                        <Border x:Name="Preview" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource StrokeBrush}" Margin="0,0,8,0" />
                        <Button x:Name="UseButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{ctl:T 'Use'}" Padding="12,6"
                                Margin="8,0,0,0" Click="Use_Click" />
                        <Border x:Name="CodeBox" Background="{DynamicResource Surface2Brush}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                            <TextBox x:Name="Code" Style="{StaticResource InlineEdit}" FontFamily="Cascadia Mono, Consolas" MaxLength="7"
                                     TextChanged="Code_Changed" KeyDown="Code_KeyDown" AutomationProperties.Name="{ctl:T 'Color code'}" />
                        </Border>
                    </DockPanel>
                </StackPanel>

                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Default'}" Padding="11,5" FontSize="12" Click="Default_Click" />
                    <TextBlock x:Name="DefaultText" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </ctl:SmoothBorder>
    </Popup>
</UserControl>
