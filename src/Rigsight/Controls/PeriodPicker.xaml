<UserControl x:Class="Rigsight.Controls.PeriodPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             x:Name="Root">
    <!-- [Day · Week · Month · Year · All time · Custom]  ‹ This month ▾ ›   The same on every page that looks back in time. -->
    <StackPanel x:Name="Bar" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource SegmentHost}">
            <StackPanel x:Name="UnitButtons" Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T Day}" Tag="Day" Checked="Unit_Checked" />
                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T Week}" Tag="Week" Checked="Unit_Checked" />
                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T Month}" Tag="Month" Checked="Unit_Checked" />
                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T Year}" Tag="Year" Checked="Unit_Checked" />
                <RadioButton x:Name="AllButton" Style="{StaticResource Segment}" Content="{ctl:T 'All time'}" Tag="All" Checked="Unit_Checked" />
                <RadioButton x:Name="CustomButton" Style="{StaticResource Segment}" Content="{ctl:T Custom}" Tag="Custom" Checked="Unit_Checked" />
            </StackPanel>
        </Border>
        <ctl:DatePager x:Name="Pager" Margin="12,0,0,0"
                       Date="{Binding Anchor, ElementName=Root, Mode=TwoWay}" MinDate="{Binding MinDate, ElementName=Root}" />
        <!-- The period picked is still being read (a year of history takes a moment). It takes no room of its own, so
             nothing moves when it shows. -->
        <ctl:Spinner x:Name="Busy" Margin="10,0,-22,0" Visibility="Collapsed" />

        <!-- Custom: from a date and hour to another (whole hours: history per app is kept by the hour). -->
        <ctl:RangeEditor x:Name="Editor" />
    </StackPanel>
</UserControl>
