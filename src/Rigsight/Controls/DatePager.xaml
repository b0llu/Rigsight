<UserControl x:Class="Rigsight.Controls.DatePager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- ‹  [Yesterday ▾]  ›   The middle says which period is shown; clicking it opens a calendar. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="Previous_Click" ToolTip="Previous" AutomationProperties.Name="Previous"
                IsEnabled="{Binding CanGoPrevious, ElementName=Root}">
            <TextBlock Text="&#xE76B;" />
        </Button>
        <Button x:Name="LabelButton" Style="{StaticResource GhostButton}" Margin="4,0" MinWidth="118" Click="Label_Click"
                ToolTip="Pick a date" AutomationProperties.Name="Pick a date">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label, ElementName=Root}" />
                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="8,1,0,0" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="Next_Click" ToolTip="Next" AutomationProperties.Name="Next"
                IsEnabled="{Binding CanGoNext, ElementName=Root}">
            <TextBlock Text="&#xE76C;" />
        </Button>

        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=LabelButton}" Placement="Custom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10" Margin="0,0,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Calendar x:Name="Cal" SelectionMode="SingleDate" FirstDayOfWeek="Monday" SelectedDatesChanged="Cal_SelectedDatesChanged" />
                    <!-- Month ranges pick a month from a simple year grid (the calendar's own year view hides unavailable months). -->
                    <StackPanel x:Name="MonthPanel" Width="264" Visibility="Collapsed">
                        <DockPanel Margin="6,2,0,10">
                            <Button DockPanel.Dock="Right" x:Name="NextYear" Style="{StaticResource IconButton}" Click="NextYear_Click"
                                    ToolTip="Next year" AutomationProperties.Name="Next year">
                                <TextBlock Text="&#xE76C;" />
                            </Button>
                            <Button DockPanel.Dock="Right" x:Name="PreviousYear" Style="{StaticResource IconButton}" Click="PreviousYear_Click"
                                    ToolTip="Previous year" AutomationProperties.Name="Previous year">
                                <TextBlock Text="&#xE76B;" />
                            </Button>
                            <TextBlock x:Name="YearText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid x:Name="MonthGrid" Columns="4" Rows="3" />
                    </StackPanel>
                    <!-- Year ranges pick a year from the years with history. -->
                    <StackPanel x:Name="YearPanel" Width="264" Visibility="Collapsed">
                        <TextBlock Text="Pick a year" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="6,6,0,12" />
                        <UniformGrid x:Name="YearGrid" Columns="4" />
                    </StackPanel>
                    <DockPanel Margin="4,8,4,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Today" Click="Today_Click" />
                        <TextBlock x:Name="SinceText" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
