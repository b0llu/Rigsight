<UserControl x:Class="Rigsight.Controls.MetricTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <Border Style="{StaticResource Tile}" Margin="5"
            DataContext="{Binding RelativeSource={RelativeSource AncestorType=ctl:MetricTile}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
            <TextBlock Grid.Row="1" Text="{Binding Sensor.FormattedValue, FallbackValue='—'}" Style="{StaticResource TileValue}"
                       Foreground="{Binding ValueBrush}" />
            <TextBlock Grid.Row="2" Text="{Binding Sensor.MinMaxText}" ToolTip="Lowest and highest today" FontSize="11" Foreground="{StaticResource FaintBrush}"
                       Margin="0,1,0,0" />
            <ctl:Sparkline Grid.Row="3" Height="26" Margin="0,8,0,0" VerticalAlignment="Bottom"
                           Source="{Binding Sensor.History}" Version="{Binding Sensor.Version}"
                           Stroke="{Binding Accent}" Minimum="{Binding SparkMinimum}" Maximum="{Binding SparkMaximum}" />
        </Grid>
    </Border>
</UserControl>
