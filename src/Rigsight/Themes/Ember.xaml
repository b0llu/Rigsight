<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ember: the dark theme on warm brown, with an orange accent of its own. Readings keep the dark theme's colours.
         Swapped at runtime by ThemeManager, which also puts the accent into the Fluent keys below. -->
    <Color x:Key="BgColor">#140E0A</Color>
    <Color x:Key="SidebarColor">#110B08</Color>
    <Color x:Key="SurfaceColor">#1D140E</Color>
    <Color x:Key="Surface2Color">#2A1E15</Color>
    <Color x:Key="HoverColor">#3A2A1D</Color>
    <Color x:Key="StrokeColor">#32241A</Color>
    <Color x:Key="TextColor">#FFF6EE</Color>
    <Color x:Key="MutedColor">#CDB7A4</Color>
    <Color x:Key="FaintColor">#A18B79</Color>
    <Color x:Key="AccentColor">#FB923C</Color>
    <Color x:Key="OnAccentColor">#140E0A</Color>
    <Color x:Key="CpuColor">#5B8CFF</Color>
    <Color x:Key="GpuColor">#22D3EE</Color>
    <Color x:Key="WarmColor">#FBBF24</Color>
    <Color x:Key="HotColor">#F87171</Color>
    <Color x:Key="PurpleColor">#B18CFF</Color>
    <Color x:Key="OrangeColor">#FB923C</Color>
    <Color x:Key="CoolColor">#38BDF8</Color>
    <Color x:Key="GoodColor">#34D399</Color>
    <Color x:Key="PinkColor">#F472B6</Color>
    <Color x:Key="TooltipColor">#33241A</Color>
    <!-- Sky: the blue of a kind of thing (voltages, drives, the internet), apart from Cool, which says a temperature is low. -->
    <Color x:Key="SkyColor">#38BDF8</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="CpuBrush" Color="{StaticResource CpuColor}" />
    <SolidColorBrush x:Key="GpuBrush" Color="{StaticResource GpuColor}" />
    <SolidColorBrush x:Key="WarmBrush" Color="{StaticResource WarmColor}" />
    <SolidColorBrush x:Key="HotBrush" Color="{StaticResource HotColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="CoolBrush" Color="{StaticResource CoolColor}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="TooltipBrush" Color="{StaticResource TooltipColor}" />
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource SkyColor}" />
    <!-- Memory's bars, lines and badge: the accent, whichever it is. -->
    <SolidColorBrush x:Key="RamBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RamSoftBrush" Color="{StaticResource AccentColor}" Opacity="0.16" />
    <!-- The picked segment of a segmented choice: a shade, or the accent once one is picked. -->
    <SolidColorBrush x:Key="SegmentOnBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SegmentOnTextBrush" Color="{StaticResource TextColor}" />
    <!-- The thin bar under each app in the Apps list: quiet, or the accent once one is picked. -->
    <SolidColorBrush x:Key="ListBarBrush" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="CpuSoftBrush" Color="{StaticResource CpuColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="GpuSoftBrush" Color="{StaticResource GpuColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="GoodSoftBrush" Color="{StaticResource GoodColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="HotSoftBrush" Color="{StaticResource HotColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="WarmSoftBrush" Color="{StaticResource WarmColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="{StaticResource PurpleColor}" Opacity="0.16" />

    <!-- The Fluent controls (calendar, combo boxes, text boxes, sliders, check boxes) use the same monochrome accent. -->
    <Color x:Key="SystemAccentColor">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorPrimary">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorSecondary">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorTertiary">#A3A3A3</Color>
    <Color x:Key="SystemAccentColorLight1">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorLight2">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorDark1">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorDark2">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorDark3">#FFFFFF</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentColor}" Opacity="0.9" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentColor}" Opacity="0.8" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource OnAccentColor}" />
</ResourceDictionary>
