<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Rigsight.Converters">

    <!-- The colours live in Dark.xaml and Light.xaml (one of them is merged before this file). -->

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Fans page's icon (the icon font has no fan): four swept blades round a hub, filling the icon's square. Drawn
         in the colour of the text around it, like the font's icons; a new copy wherever it's used. -->
    <Grid x:Key="FanIcon" x:Shared="False" Width="16" Height="16">
        <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}">
            <Path.Data>
                <!-- Four even blades, each a gently curved teardrop, around a round hub. -->
                <GeometryGroup FillRule="Nonzero">
                <EllipseGeometry Center="8,8" RadiusX="2" RadiusY="2" />
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="0" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="90" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="180" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="270" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                </GeometryGroup>
            </Path.Data>
        </Path>
    </Grid>

    <!-- ── Motion ───────────────────────────────────────────────────────
         How long a control takes to show a change (hover, press, on/off): in on the quick side, back out a little slower.
         Only on a change: the states below are the controls' visual states, which don't animate a page as it opens.
         Set to nothing at startup when Windows' animation effects are off (see Services/Motion.cs). -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionNormal">0:0:0.2</Duration>
    <CubicEase x:Key="MotionEase" EasingMode="EaseOut" />

    <!-- ── Converters ──────────────────────────────────────────────────── -->
    <conv:TempToBrushConverter x:Key="TempBrush" />
    <conv:TrayTextConverter x:Key="TrayText" />
    <conv:TrayBrushConverter x:Key="TrayBrush" />
    <conv:EqualsConverter x:Key="Equals" />
    <conv:NavIconConverter x:Key="NavIcon" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsVis" />
    <conv:VisibilityConverter x:Key="Vis" />
    <conv:TempDisplayConverter x:Key="TempDisplay" />
    <conv:ScaleConverter x:Key="Scale" />
    <conv:DurationConverter x:Key="Duration" />
    <conv:TempShortConverter x:Key="TempShort" />
    <conv:MegabytesConverter x:Key="Megabytes" />
    <conv:BytesConverter x:Key="Bytes" />
    <conv:IconConverter x:Key="ExeIcon" />
    <conv:CategoryBrushConverter x:Key="CategoryBrush" />
    <conv:CategoryLabelConverter x:Key="CategoryLabel" />
    <conv:InitialConverter x:Key="Initial" />
    <conv:ToneBrushConverter x:Key="ToneBrush" />
    <conv:SeverityBrushConverter x:Key="SeverityBrush" />
    <conv:FractionConverter x:Key="Fraction" />
    <conv:ResourceBrushConverter x:Key="ResourceBrush" />
    <conv:KindBrushConverter x:Key="KindBrush" />

    <!-- ── Selectable list rows (Apps page) ───────────────────────────── -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- Rows change shade at once: lists can hold hundreds of rows and refresh every few seconds (Memory),
                         so they keep the lightest template (no layers or states to animate). -->
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,0,0,2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A scroll viewer whose bar sits in its own gutter beside the content (the Fluent bar is drawn on top of it). -->
    <Style x:Key="GutterScroll" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="8,0,0,0" Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <!-- Only the rows on screen are built, however long the list; smooth pixel scrolling. -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Style="{StaticResource GutterScroll}" Padding="0" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown items: Windows' own (Fluent) look, but the whole row takes the mouse. Fluent's leaves the row's
         background empty, so only the text itself could be hovered or clicked (a quick click beside a name did nothing). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="3,2,3,0" />
        <Setter Property="Padding" Value="10,8,8,8" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="ContentBorder" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Border.CornerRadius}"
                                Margin="{TemplateBinding Margin}" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter x:Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                <Rectangle x:Name="ActiveRectangle" RadiusX="2" RadiusY="2" Fill="{DynamicResource ComboBoxItemPillFillBrush}" Width="3" Height="16"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelected}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource ComboBoxItemForegroundSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of filter chips that wraps (the Apps page's categories): one picked at a time, shaded while picked. -->
    <Style x:Key="FilterChip" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Focusable (a list item is only picked by a click once it takes focus), without the dotted focus box. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="13" Padding="10,4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterChip}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AppIcon" TargetType="Image">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Text ────────────────────────────────────────────────────────── -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Surfaces ────────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ── Sidebar navigation ──────────────────────────────────────────── -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- The shade fades in on hover and stays while selected; the accent bar grows from its middle when
                         the page is picked and shrinks away when another is. -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" GeneratedEasingFunction="{StaticResource MotionEase}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Opacity="0" />
                        <Border x:Name="Selected" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <!-- The label fills the row, so an item can put something at its right edge (Settings' attention dot). -->
                                <DockPanel>
                                    <!-- An icon-font character, or a drawn icon (see FanIcon) where the font has none. -->
                                    <ContentPresenter DockPanel.Dock="Left" Content="{TemplateBinding Tag}" VerticalAlignment="Center"
                                                      TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="16"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextElement.FontSize="14" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Segmented control (group of RadioButtons inside a SegmentHost) ── -->
    <Style x:Key="SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- The picked segment's shade fades across from the one before. -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" GeneratedEasingFunction="{StaticResource MotionEase}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Selected" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Buttons ─────────────────────────────────────────────────────── -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The hover shade fades in over the button's own colour; a press dims it a touch. -->
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" />
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="9" Opacity="0" />
                        <ContentPresenter Margin="14,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Small text action ("Details", "Copy report"): quiet until hovered. -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="9,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The main action (white in dark mode, black in light): on hover it keeps its colour and dims a little, so
         its text stays readable (the ghost hover's grey would put black text on dark grey). Buttons that turn into
         the main action through a trigger use this template too. -->
    <ControlTemplate x:Key="AccentButtonTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="14,8">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05" />
                        <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.86" Duration="0" /></Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0" /></Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
        <!-- The Fluent theme gives TextBlocks their own font, so glyph content must ask for the icon font explicitly. -->
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        <!-- Not focusable: focus jumping away from a row that just disappeared would scroll the page. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="13" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle switch (CheckBox) ────────────────────────────────────── -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Switched: the knob slides across while the track fills with the accent colour. -->
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" GeneratedEasingFunction="{StaticResource MotionEase}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid DockPanel.Dock="Right" Width="42" Height="22" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource HoverBrush}" />
                            <Border x:Name="TrackOn" CornerRadius="11" Background="{DynamicResource AccentBrush}" Opacity="0" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Progress bar ────────────────────────────────────────────────── -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource HoverBrush}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Inline rename box ───────────────────────────────────────────── -->
    <Style x:Key="InlineEdit" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="6" Padding="5,2">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Search box ──────────────────────────────────────────────────── -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="10" Padding="10,7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13"
                                       Foreground="{DynamicResource FaintBrush}" Margin="0,0,8,0" />
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource FaintBrush}"
                                           VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TooltipBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    </Style>
    <!-- ── Crash card (Reports and Crashes pages) ─────────────────────── -->
    <DataTemplate x:Key="CrashTemplate">
        <Border CornerRadius="12" Background="{DynamicResource Surface2Brush}" Padding="16,14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource WarmSoftBrush}" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" Foreground="{DynamicResource WarmBrush}" />
                        <Image Source="{Binding IconPath, Converter={StaticResource ExeIcon}}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <Border CornerRadius="6" Padding="7,2" Margin="10,0,0,0" Background="{DynamicResource WarmSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarmBrush}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Reason}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <Run Text="What to try: " FontWeight="SemiBold" Foreground="{DynamicResource GpuBrush}" /><Run Text="{Binding Advice, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding TempsText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                               Visibility="{Binding TempsText, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding TechnicalText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding TechnicalText, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
