<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Rigsight.Converters"
                    xmlns:ctl="clr-namespace:Rigsight.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- The colours live in Dark.xaml and Light.xaml (one of them is merged before this file). -->

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Network page's icon: the font's Ethernet screen, which fills its square more than the other pages' icons, drawn a
         size smaller in the same 16-pixel slot so it sits as large as they do. -->
    <Grid x:Key="NetworkIcon" x:Shared="False" Width="16" Height="16">
        <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <!-- The Fans page's icon (the icon font has no fan): four swept blades round a hub, filling the icon's square. Drawn
         in the colour of the text around it, like the font's icons; a new copy wherever it's used. -->
    <Grid x:Key="FanIcon" x:Shared="False" Width="16" Height="16">
        <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}">
            <Path.Data>
                <!-- Four even blades, each a gently curved teardrop, around a round hub. -->
                <GeometryGroup FillRule="Nonzero">
                <EllipseGeometry Center="8,8" RadiusX="2" RadiusY="2" />
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="0" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="90" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="180" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                <PathGeometry Figures="M8.54,6.50 L8.81,6.23 L9.10,5.99 L9.39,5.79 L9.68,5.61 L9.96,5.45 L10.24,5.30 L10.50,5.17 L10.76,5.04 L11.01,4.91 L11.25,4.77 L11.49,4.62 L11.72,4.45 L11.93,4.19 L12.13,3.85 L12.32,3.33 L12.35,2.02 L12.35,2.01 L11.50,0.96 L10.85,0.77 L10.24,0.79 L9.68,0.95 L9.19,1.23 L8.75,1.57 L8.36,1.97 L8.02,2.40 L7.74,2.87 L7.53,3.35 L7.37,3.86 L7.28,4.37 L7.25,4.88 L7.27,5.37 L7.34,5.85 L7.46,6.30 Z">
                    <PathGeometry.Transform><RotateTransform Angle="270" CenterX="8" CenterY="8" /></PathGeometry.Transform>
                </PathGeometry>
                </GeometryGroup>
            </Path.Data>
        </Path>
    </Grid>

    <!-- ── Motion ───────────────────────────────────────────────────────
         How long a control takes to show a change (hover, press, on/off): in on the quick side, back out a little slower.
         Only on a change: the states below are the controls' visual states, which don't animate a page as it opens.
         Set to nothing at startup when Windows' animation effects are off (see Services/Motion.cs). -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionNormal">0:0:0.2</Duration>
    <CubicEase x:Key="MotionEase" EasingMode="EaseOut" />

    <!-- ── Converters ──────────────────────────────────────────────────── -->
    <conv:TempToBrushConverter x:Key="TempBrush" />
    <conv:ScaledTempBrushConverter x:Key="ScaledTempBrush" />
    <conv:TrayTextConverter x:Key="TrayText" />
    <conv:TrayBrushConverter x:Key="TrayBrush" />
    <conv:EqualsConverter x:Key="Equals" />
    <conv:TimeFormatConverter x:Key="TimeFormat" />
    <conv:NavIconConverter x:Key="NavIcon" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsVis" />
    <conv:VisibilityConverter x:Key="Vis" />
    <conv:ScaleConverter x:Key="Scale" />
    <conv:DurationConverter x:Key="Duration" />
    <conv:TempShortConverter x:Key="TempShort" />
    <conv:MegabytesConverter x:Key="Megabytes" />
    <conv:BytesConverter x:Key="Bytes" />
    <conv:IconConverter x:Key="ExeIcon" />
    <conv:CategoryBrushConverter x:Key="CategoryBrush" />
    <conv:CategoryLabelConverter x:Key="CategoryLabel" />
    <conv:InitialConverter x:Key="Initial" />
    <conv:ToneBrushConverter x:Key="ToneBrush" />
    <conv:SeverityBrushConverter x:Key="SeverityBrush" />
    <conv:SureBrushConverter x:Key="SureBrush" />
    <conv:FractionConverter x:Key="Fraction" />
    <conv:ResourceBrushConverter x:Key="ResourceBrush" />
    <conv:InsightBrushConverter x:Key="InsightBrush" />
    <conv:DataSizeConverter x:Key="DataSize" />
    <conv:KindBrushConverter x:Key="KindBrush" />
    <conv:ShareStarConverter x:Key="ShareStar" />

    <!-- ── Selectable list rows (Apps page) ───────────────────────────── -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- Rows change shade at once: lists can hold hundreds of rows and refresh every few seconds (Memory),
                         so they keep the lightest template (no layers or states to animate). -->
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,0,0,2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- How wide a page's content gets: on a window wider than this (maximised on a large screen) the page is this wide
         and centred, so a row's name and its figure aren't a screen apart. PageFrame is the same with the page's side
         margins, for a page that holds a narrower column at its left (Settings). -->
    <sys:Double x:Key="PageWidth">1560</sys:Double>
    <sys:Double x:Key="PageFrame">1624</sys:Double>
    <!-- A scroll viewer whose bar sits in its own gutter beside the content (the Fluent bar is drawn on top of it). -->
    <Style x:Key="GutterScroll" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="8,0,0,0" Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <!-- Only the rows on screen are built, however long the list; smooth pixel scrolling. -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Style="{StaticResource GutterScroll}" Padding="0" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list filling a card (Card or RowCard, 12 px in from its sides): its scrollbar, when it has one, sits in the
         card's right margin, so the rows keep their width whether it scrolls or not. At its end the wheel scrolls the page. -->
    <Style x:Key="CardScroll" TargetType="ScrollViewer" BasedOn="{StaticResource GutterScroll}">
        <Setter Property="ctl:WheelChain.Enabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,0,-11,0" Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CardList" TargetType="ListBox" BasedOn="{StaticResource PlainList}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Style="{StaticResource CardScroll}" Padding="0" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown items: Windows' own (Fluent) look, but the whole row takes the mouse. Fluent's leaves the row's
         background empty, so only the text itself could be hovered or clicked (a quick click beside a name did nothing). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="3,2,3,0" />
        <Setter Property="Padding" Value="10,8,8,8" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="ContentBorder" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Border.CornerRadius}"
                                Margin="{TemplateBinding Margin}" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter x:Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                <Rectangle x:Name="ActiveRectangle" RadiusX="2" RadiusY="2" Fill="{DynamicResource ComboBoxItemPillFillBrush}" Width="3" Height="16"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelected}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource ComboBoxItemForegroundSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of filter chips that wraps (the Apps page's categories): one picked at a time, shaded while picked. -->
    <Style x:Key="FilterChip" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Focusable (a list item is only picked by a click once it takes focus), without the dotted focus box. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="13" Padding="10,4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterChip}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Text beside an icon (the alignment rule, WORDING.md): the icon sits at the top of its row and the text is centred
         in the row, so one line sits on the icon's middle and several lines start level with its top. Every list of
         icon-and-text rows is built on this, so no page can drift: the icon goes in Header, the text in Content, the
         gap between them in Padding. -->
    <Style x:Key="IconRow" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="13,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <DockPanel Background="{TemplateBinding Background}">
                        <ContentPresenter DockPanel.Dock="Left" ContentSource="Header" VerticalAlignment="Top" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 30 by 30 square an icon of an IconRow sits in. -->
    <Style x:Key="IconBox" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    </Style>

    <Style x:Key="AppIcon" TargetType="Image">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Text ────────────────────────────────────────────────────────── -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!-- Muted, not faint: a small label in the faint grey took effort to read on a black card. -->
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Surfaces ────────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ── Sidebar navigation ──────────────────────────────────────────── -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <!-- The text brightens in step with the shade behind it (see NavInk), not at once by a trigger. -->
        <Setter Property="ctl:NavInk.Follows" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- The shade fades in on hover and stays while selected; the accent bar grows from its middle when
                         the page is picked and shrinks away when another is. -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" GeneratedEasingFunction="{StaticResource MotionEase}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Opacity="0" />
                        <Border x:Name="Selected" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <!-- The label fills the row, so an item can put something at its right edge (Settings' attention dot). -->
                                <DockPanel>
                                    <!-- An icon-font character, or a drawn icon (see FanIcon) where the font has none. -->
                                    <ContentPresenter DockPanel.Dock="Left" Content="{TemplateBinding Tag}" VerticalAlignment="Center"
                                                      TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="16"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextElement.FontSize="14" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An on/off chip: a reading on the Overlay page, a file in the Export box. -->
    <Style x:Key="MetricChip" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <ctl:SmoothBorder x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="9" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"
                                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" />
                        </StackPanel>
                    </ctl:SmoothBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Segmented control (group of RadioButtons inside a SegmentHost) ── -->
    <Style x:Key="SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <!-- The text changes in step with the shade behind it (see NavInk): under the pointer, and when picked. -->
        <Setter Property="ctl:NavInk.Follows" Value="True" />
        <Setter Property="ctl:NavInk.Checked" Value="SegmentOnTextBrush" />
        <!-- The picked shade says where the keyboard is: Windows' own outline doesn't follow the rounded shape. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- The picked segment's shade fades across from the one before. -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" GeneratedEasingFunction="{StaticResource MotionEase}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Selected" Background="{DynamicResource SegmentOnBrush}" CornerRadius="7" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Buttons ─────────────────────────────────────────────────────── -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The hover shade fades in over the button's own colour; a press dims it a touch. -->
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" />
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="9" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A page's Export button, the last in its title row: the page's own Export box (ShellViewModel.ExportPage). -->
    <Style x:Key="PageExportButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Command" Value="{Binding DataContext.ExportPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="AutomationProperties.Name" Value="{ctl:T 'Export this page'}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{ctl:T Export}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A button on a Surface2 tile (Buy on a pack): it rests at the hover shade, so its own hover is a lift of the text colour. -->
    <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" />
                        <Border x:Name="Hover" Background="{DynamicResource TextBrush}" CornerRadius="9" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Small text action ("Details", "Copy report"): quiet until hovered. -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <!-- The text brightens and dims in step with the shade behind it (see NavInk): set by a trigger it changed at
             once while the shade was still fading, and the two out of step looked like a stutter. -->
        <Setter Property="ctl:NavInk.Follows" Value="True" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="9,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The main action (white in dark mode, black in light): on hover it keeps its colour and dims a little, so
         its text stays readable (the ghost hover's grey would put black text on dark grey). Buttons that turn into
         the main action through a trigger use this template too. -->
    <ControlTemplate x:Key="AccentButtonTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="14,8">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05" />
                        <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.86" Duration="0" /></Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0" /></Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
        <!-- The Fluent theme gives TextBlocks their own font, so glyph content must ask for the icon font explicitly. -->
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        <!-- Not focusable: focus jumping away from a row that just disappeared would scroll the page. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="13" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle switch (CheckBox) ────────────────────────────────────── -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Switched: the knob slides across while the track fills with the accent colour. -->
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" GeneratedEasingFunction="{StaticResource MotionEase}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid DockPanel.Dock="Right" Width="42" Height="22" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource HoverBrush}" />
                            <Border x:Name="TrackOn" CornerRadius="11" Background="{DynamicResource AccentBrush}" Opacity="0" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Progress bar ────────────────────────────────────────────────── -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource HoverBrush}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Inline rename box ───────────────────────────────────────────── -->
    <Style x:Key="InlineEdit" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="6" Padding="5,2">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Search box ──────────────────────────────────────────────────── -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="10" Padding="10,7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13"
                                       Foreground="{DynamicResource FaintBrush}" Margin="0,0,8,0" />
                            <!-- Typed, and about to be searched for (see Debounce). Its place is kept by the grid, so the text
                                 doesn't move when it shows. -->
                            <Grid DockPanel.Dock="Right" Width="12" Margin="8,0,0,0">
                                <!-- Drawn here, not the Spinner control: inside this template that one held the page up for
                                     seconds each time it was opened (measured; the cause wasn't found). -->
                                <Path x:Name="Pending" Width="12" Height="12" VerticalAlignment="Center" Visibility="Collapsed"
                                      Data="M 6,0.75 A 5.25,5.25 0 1 1 0.75,6" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource FaintBrush}"
                                           VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ctl:Debounce.IsPending" Value="True">
                            <Setter TargetName="Pending" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PendingSpin">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pending" Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PendingSpin" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A box to type a value in (an address, a key): the search box's look without its magnifier. Typing in it only
         lifts its edge a little; Windows' own box drew a bright line under it that stayed after Connect. -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,7">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldPassword" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,7">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TooltipBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    </Style>
    <!-- A whole row that opens: quiet until hovered. -->
    <!-- A list row that opens something: nothing behind it until the pointer is on it, and its content takes the row's
         whole width (GhostButton centres its content, so a row made of one had to be told its width). -->
    <!-- A row in a list that picks something (Ask's History, Settings › Ask RigSight's model lists): its padding and background
         are its own (FlatRowButton takes neither), so a row can be marked as the picked one; the hover shade sits over it. -->
    <Style x:Key="PickRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" />
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FlatRowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="9" Opacity="0" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="{StaticResource MotionFast}" />
                                    <VisualTransition GeneratedDuration="{StaticResource MotionNormal}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" />
                        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="12" Opacity="0" />
                        <ContentPresenter />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── A crash as a row (Reports): what it was, what most likely happened and how sure that is. It opens the
         crash's own case on the Crashes page. ── -->
    <DataTemplate x:Key="CrashTemplate">
        <Button Style="{StaticResource RowButton}" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="12,0,0,12" />
                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" VerticalAlignment="Center" Margin="14,0,0,0"
                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                    <Grid>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                        <Image Source="{Binding IconPath, Converter={StaticResource ExeIcon}}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Margin="14,11,12,11" VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Style="{StaticResource Chip}" Margin="0,1,6,1"
                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                            <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Bold" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,1,6,1" Background="{Binding Sure, Converter={StaticResource SureBrush}, ConverterParameter=soft}"
                                Visibility="{Binding HasFinding, Converter={StaticResource Vis}}" ToolTip="{ctl:T 'How sure RigSight is of what happened, by what it rests on'}">
                            <TextBlock Text="{Binding Chip}" FontSize="10" FontWeight="Bold" Foreground="{Binding Sure, Converter={StaticResource SureBrush}}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Line}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="14,0,16,0" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
