<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- System.Drawing is used to pull icons out of .exe files. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Rigsight</RootNamespace>
    <AssemblyName>Rigsight</AssemblyName>
    <AssemblyTitle>RigSight</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\Rigsight.ico</ApplicationIcon>
    <OutDir>$(SharedBinDir)</OutDir>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.Main (it sets the GC's allocation area before the runtime starts; see Program.cs). -->
    <StartupObject>Rigsight.Program</StartupObject>
    <!-- WPF0001: Fluent ThemeMode is experimental. WFO0003: WinForms DPI advice (not applicable to WPF). -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\Rigsight.ico" Link="Assets\Rigsight.ico" />
    <Resource Include="..\..\assets\Rigsight.png" Link="Assets\Rigsight.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licences of what Rigsight includes, installed next to it (Settings > About opens it). -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rigsight.Core\Rigsight.Core.csproj" />
  </ItemGroup>

  <!-- The agent's own taskbar drawing, so the Taskbar page previews exactly what the taskbar will show (at its real
       height, in each reading's style and size). In the app these sit in Rigsight.TaskbarDrawing (see RIGSIGHT_APP). -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);RIGSIGHT_APP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Rigsight.Agent\Ui\TrayReading.cs" Link="TaskbarDrawing\TrayReading.cs" />
    <Compile Include="..\Rigsight.Agent\Ui\StripComposer.cs" Link="TaskbarDrawing\StripComposer.cs" />
    <Compile Include="..\Rigsight.Agent\Widgets\WidgetRenderer.Strip.cs" Link="TaskbarDrawing\WidgetRenderer.Strip.cs" />
    <Compile Include="..\Rigsight.Agent\Widgets\WidgetRenderer.Tray.cs" Link="TaskbarDrawing\WidgetRenderer.Tray.cs" />
    <Compile Include="..\Rigsight.Agent\Widgets\DirectWriteText.cs" Link="TaskbarDrawing\DirectWriteText.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rigsight.Tests" />
  </ItemGroup>

</Project>
