<UserControl x:Class="Rigsight.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:m="clr-namespace:Rigsight.Models">
    <UserControl.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,0">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding SetAllExpandedCommand}" CommandParameter="False" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0" />
                        <TextBlock Text="Collapse all" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding SetAllExpandedCommand}" CommandParameter="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0" />
                        <TextBlock Text="Expand all" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="All sensors" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding HiddenHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <DockPanel DockPanel.Dock="Top" Margin="0,18,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                        Visibility="{Binding HiddenCount, Converter={StaticResource Vis}}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center"
                          ToolTip="Hidden sensors appear dimmed; click their eye icon to bring them back.">
                    <TextBlock Text="{Binding ShowHiddenText}" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                </CheckBox>
                <Button Style="{StaticResource GhostButton}" Content="Unhide all" Command="{Binding UnhideAllCommand}" Margin="12,0,0,0" />
            </StackPanel>
            <TextBox DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Tag="Search sensors…" Width="240"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="All"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="Temperatures"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Temperature}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="Load"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Load}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="Fans"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Fan}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="Power"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Power}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="Clocks"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Clock}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="Voltages"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Voltage}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- One flat, virtualized list: only the rows on screen are built, the rest as you scroll.
             Each card is a header item, its sensor rows, and an end item, drawn so they join up. -->
        <ItemsControl x:Name="SensorList" ItemsSource="{Binding SensorRows}" AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter Margin="0,0,0,32" />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
                <!-- Card top: clickable title (collapses/expands) and, when open, the column headings -->
                <DataTemplate DataType="{x:Type m:HardwareNode}">
                    <ctl:SmoothBorder x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1,1,1,0" CornerRadius="16,16,0,0" Padding="20,16,20,0">
                        <StackPanel>
                            <Border Background="Transparent" Cursor="Hand" Margin="-8,-6,-8,-6" Padding="8,6" CornerRadius="10"
                                    MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_Click"
                                    ToolTip="Click to collapse or expand. Drag to change the order.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock x:Name="Chevron" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Badge}" Background="{Binding Type, Converter={StaticResource KindBrush}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}" Foreground="{Binding Type, Converter={StaticResource KindBrush}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="12,0,0,3" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Grid x:Name="Columns" Margin="0,20,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="SENSOR" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="2" Text="LAST MINUTE" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="3" Text="VALUE" Style="{StaticResource ColHeader}" />
                                <TextBlock Grid.Column="4" Text="MIN" Style="{StaticResource ColHeader}" ToolTip="Lowest today, since midnight" />
                                <TextBlock Grid.Column="5" Text="MAX" Style="{StaticResource ColHeader}" ToolTip="Highest today, since midnight" />
                                <TextBlock Grid.Column="6" Text="AVG" Style="{StaticResource ColHeader}" ToolTip="Average since you opened this window" />
                            </Grid>
                        </StackPanel>
                    </ctl:SmoothBorder>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                            <Setter TargetName="Columns" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBeingMoved}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                        </DataTrigger>
                        <!-- While a group is being dragged, every group is just its header. -->
                        <DataTrigger Binding="{Binding DataContext.IsReordering, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                            <Setter TargetName="Columns" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <!-- Card bottom -->
                <DataTemplate DataType="{x:Type m:SensorGroupEnd}">
                    <ctl:SmoothBorder x:Name="Card" Height="16" Margin="0,0,0,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1,0,1,1" CornerRadius="0,0,16,16" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Owner.IsBeingMoved}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <!-- One sensor -->
                <DataTemplate DataType="{x:Type m:SensorItem}">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1,0,1,0" Padding="20,0">
                        <Border x:Name="Row" CornerRadius="8" Padding="0,3" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Badge}" Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=soft}"
                                        HorizontalAlignment="Left" Padding="6,2" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold"
                                               Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                </Border>
                                <TextBox Grid.Column="1" Style="{StaticResource InlineEdit}"
                                         Text="{Binding Label, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{Binding Name}" KeyDown="RenameBox_KeyDown" />
                                <ctl:Sparkline Grid.Column="2" Height="22" Margin="12,0"
                                               Source="{Binding History}" Version="{Binding Version}"
                                               Stroke="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                <TextBlock Grid.Column="3" Text="{Binding FormattedValue}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Temperature">
                                                    <Setter Property="Foreground" Value="{Binding Value, Converter={StaticResource TempBrush}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding FormattedMin}" Style="{StaticResource Num}" />
                                <TextBlock Grid.Column="5" Text="{Binding FormattedMax}" Style="{StaticResource Num}" />
                                <TextBlock Grid.Column="6" Text="{Binding FormattedAverage}" Style="{StaticResource Num}" />
                                <Button Grid.Column="7" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Hide / show this sensor">
                                    <TextBlock x:Name="EyeGlyph" Text="&#xE7B3;" />
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            <Setter TargetName="EyeGlyph" Property="Text" Value="&#xED1A;" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </DockPanel>
</UserControl>
