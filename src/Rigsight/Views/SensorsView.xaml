<UserControl x:Class="Rigsight.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:svc="clr-namespace:Rigsight.Services"
             xmlns:m="clr-namespace:Rigsight.Models"
             xmlns:core="clr-namespace:Rigsight.Core;assembly=Rigsight.Core"
             xmlns:vm="clr-namespace:Rigsight.ViewModels"
             xmlns:v="clr-namespace:Rigsight.Views">
    <UserControl.Resources>
        <!-- This page, for the rows' triggers and buttons: a recycled row is out of the page while it changes kind, so they don't
             look for the page above them (1.23.0). Set in the constructor. -->
        <ctl:Proxy x:Key="View" />
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Body}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <!-- A narrow window drops columns, not their right ends: first the lowest, highest and average (and each card's
             count), then the last minute's line. The cells have the widths and their columns are Auto, so a dropped one
             takes no room and the heading row stays in step with the rows. -->
        <Style x:Key="Stat" TargetType="TextBlock" BasedOn="{StaticResource Num}">
            <Setter Property="Width" Value="76" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.ShowStats, Source={StaticResource View}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatHeader" TargetType="TextBlock" BasedOn="{StaticResource ColHeader}">
            <Setter Property="Width" Value="76" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.ShowStats, Source={StaticResource View}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WithStats" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.ShowStats, Source={StaticResource View}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WithSpark" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.ShowSpark, Source={StaticResource View}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,0" MaxWidth="{StaticResource PageWidth}">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding SetAllExpandedCommand}" CommandParameter="False" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Margin="0,0,8,0" />
                        <TextBlock Text="{ctl:T 'Collapse all'}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding SetAllExpandedCommand}" CommandParameter="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Margin="0,0,8,0" />
                        <TextBlock Text="{ctl:T 'Expand all'}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- The page's own question for the AI (mock-up board 5). -->
            <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'Anything unusual?'}" CommandParameter="{x:Static svc:PageAsks.Sensors}" AutomationProperties.Name="{ctl:T 'Anything unusual?'}" />
            <TextBlock Text="{ctl:T 'All sensors'}" Style="{StaticResource H1}" />
        </DockPanel>

        <!-- Filters -->
        <DockPanel DockPanel.Dock="Top" Margin="0,18,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                        Visibility="{Binding HiddenCount, Converter={StaticResource Vis}}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center"
                          ToolTip="{ctl:T 'Hidden sensors appear dimmed; click their eye icon to bring them back.'}">
                    <TextBlock Text="{Binding ShowHiddenText}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource TextBrush}" />
                </CheckBox>
                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Unhide all'}" Command="{Binding UnhideAllCommand}" Margin="12,0,0,0" />
            </StackPanel>
            <TextBox DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search sensors…'}" Width="240"
                     ctl:Debounce.Text="{Binding SearchText}" />
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="{ctl:T All}"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="{ctl:T Temperatures}"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Temperature}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="{ctl:T Load}"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Load}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="{ctl:T Fans}"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Fan}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="{ctl:T Power}"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Power}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="{ctl:T Clocks}"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Clock}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TypeFilter" Content="{ctl:T Voltages}"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Equals}, ConverterParameter=Voltage}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding SensorsEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,28,0,0"
                   Visibility="{Binding SensorsEmptyText, Converter={StaticResource Vis}}" />

        <!-- One flat, virtualized list: only the rows on screen are built, the rest as you scroll.
             Each card is a header item, its sensor rows, and an end item, drawn so they join up. Rows are recycled
             (1.23.0): a row leaving the screen is handed the next item (RowList lets go of an item of another kind
             first). It scrolls with Windows' own wheel, no glide, and its last-minute lines wait while it scrolls
             (Sparkline.Hold): a fast spin of the wheel lagged with rows built new on every frame. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ctl:RowList x:Name="SensorList" ItemsSource="{Binding SensorRows}" AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="List_ScrollChanged">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <!-- The scrollbar has its own strip beside the cards: laid over them, it covered their right edge. -->
                        <ScrollViewer Style="{StaticResource GutterScroll}" Padding="0" CanContentScroll="True" ctl:SmoothWheel.Plain="True">
                            <ItemsPresenter Margin="0,0,0,32" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <!-- Card top: clickable title (collapses/expands) and, when open, the column headings -->
                    <DataTemplate DataType="{x:Type m:HardwareNode}">
                        <ctl:SmoothBorder x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="16,16,0,0" Padding="20,16,20,0">
                            <StackPanel>
                                <Border Background="Transparent" Cursor="Hand" Margin="-8,-6,-8,-6" Padding="8,6" CornerRadius="{x:Static ctl:Corner.Control}"
                                        MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_Click"
                                        ToolTip="{ctl:T 'Click to collapse or expand. Drag to change the order.'}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Right" Style="{StaticResource WithStats}">
                                            <TextBlock Text="{Binding Summary}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="12,0,0,4" />
                                        </Grid>
                                        <!-- What the part is doing, in two or three readings: a folded card still says something. -->
                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Keys}" Focusable="False" VerticalAlignment="Center" Margin="0,0,0,3">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:HardwareKey}">
                                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Field}" Padding="9,3" Margin="6,0,0,0"
                                                            Visibility="{Binding IsShown, Converter={StaticResource Vis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Value" Text="{Binding Sensor.ShortValue}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                                       Visibility="{Binding Sensor, Converter={StaticResource Vis}}" ToolTip="{Binding Sensor.ChargeTip}" />
                                                            <!-- A wireless device that says it's charging: a bolt in the number's colour; full on power: "Full" (1.22.0). -->
                                                            <TextBlock x:Name="Bolt" Text="&#xE945;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" Margin="3,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{Binding Foreground, ElementName=Value}" ToolTip="{Binding Sensor.ChargeTip}"
                                                                       Visibility="{Binding Sensor.ShowsBolt, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                                                            <TextBlock Text="{x:Static m:SensorItem.FullWord}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                       ToolTip="{Binding Sensor.ChargeTip}" Visibility="{Binding Sensor.ShowsFull, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                                                            <TextBlock Text="{Binding Label}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding Label, Converter={StaticResource Vis}}" />
                                                            <TextBlock Text="{Binding Text}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource TextBrush}"
                                                                       Visibility="{Binding Text, Converter={StaticResource Vis}}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Sensor.HasTempScale}" Value="True">
                                                            <Setter TargetName="Value" Property="Foreground">
                                                                <Setter.Value>
                                                                    <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                                        <Binding Path="Sensor.Value" />
                                                                        <Binding Path="Sensor.TempScale" />
                                                                    </MultiBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <!-- A wireless device's battery: green, amber at 15% or less, red at 5% or less. -->
                                                        <DataTrigger Binding="{Binding Sensor.Kind}" Value="{x:Static core:SensorKind.Battery}">
                                                            <Setter TargetName="Value" Property="Foreground" Value="{Binding Sensor.Value, Converter={StaticResource BatteryBrush}}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="Chevron" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Background="{Binding Type, Converter={StaticResource KindBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeText}" Foreground="{Binding Type, Converter={StaticResource KindBrush}}" />
                                        </Border>
                                        <TextBlock Text="{Binding ShownName}" Style="{StaticResource H2}" Margin="12,0,0,3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ctl:TrimmedText.ToolTip="True" />
                                    </DockPanel>
                                </Border>
                                <Grid x:Name="Columns" Margin="0,20,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Static ctl:KindTag.Column}" />
                                        <ColumnDefinition Width="*" MinWidth="{x:Static ctl:KindTag.NameMinWidth}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{ctl:T SENSOR}" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                    <Grid Grid.Column="2" Width="92" Style="{StaticResource WithSpark}">
                                        <TextBlock Text="{ctl:T 'LAST MINUTE'}" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{ctl:T VALUE}" Style="{StaticResource ColHeader}" />
                                    <TextBlock Grid.Column="4" Text="{ctl:T LOWEST}" Style="{StaticResource StatHeader}" ToolTip="{ctl:T 'Lowest today, since midnight'}" />
                                    <TextBlock Grid.Column="5" Text="{ctl:T HIGHEST}" Style="{StaticResource StatHeader}" ToolTip="{ctl:T 'Highest today, since midnight'}" />
                                    <TextBlock Grid.Column="6" Text="{ctl:T AVERAGE}" Style="{StaticResource StatHeader}" ToolTip="{ctl:T 'Average since you opened this window'}" />
                                </Grid>
                            </StackPanel>
                        </ctl:SmoothBorder>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                <Setter TargetName="Columns" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBeingMoved}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                            </DataTrigger>
                            <!-- While a group is being dragged, every group is just its header. -->
                            <DataTrigger Binding="{Binding Data.DataContext.IsReordering, Source={StaticResource View}}" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                <Setter TargetName="Columns" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- Card bottom -->
                    <DataTemplate DataType="{x:Type m:SensorGroupEnd}">
                        <ctl:SmoothBorder x:Name="Card" Height="16" Margin="0,0,0,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1,0,1,1" CornerRadius="0,0,16,16" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Owner.IsBeingMoved}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- A wireless device with its battery alone (1.22.0, the mock-up's B): one card and no table, since there's one
                         sensor. The device's words on the left (drag them to move the card), under them its lowest, highest
                         and average; on the right what the battery did lately, its level big in its colour, the eye and the menu. -->
                    <DataTemplate DataType="{x:Type m:DeviceCard}">
                        <ctl:SmoothBorder x:Name="Card" Margin="0,0,0,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                          BorderThickness="1" CornerRadius="16" Padding="20,14,14,14">
                            <DockPanel>
                                <StackPanel x:Name="Right" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding Battery}">
                                    <TextBlock Text="{Binding BatteryTrend}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                               Margin="0,0,18,0" Visibility="{Binding BatteryTrend, Converter={StaticResource Vis}}"
                                               ToolTip="{ctl:T 'What the battery did in the last 10 minutes'}" />
                                    <StackPanel Orientation="Horizontal" MinWidth="84" VerticalAlignment="Center" ToolTip="{Binding ChargeTip}">
                                        <TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S16}" VerticalAlignment="Center" Margin="0,1,7,0"
                                                   Foreground="{Binding Value, Converter={StaticResource BatteryBrush}}" />
                                        <TextBlock x:Name="Level" Text="{Binding ShortValue}" FontSize="{x:Static ctl:TextSize.Figure}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Value, Converter={StaticResource BatteryBrush}}" />
                                        <!-- Charging: a bolt in the level's colour; full on power: "Full" in grey. -->
                                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, ElementName=Level}" Visibility="{Binding ShowsBolt, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{x:Static m:SensorItem.FullWord}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Visibility="{Binding ShowsFull, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Margin="12,0,0,0" Width="36"
                                            Command="{Binding Data.DataContext.ToggleHiddenCommand, Source={StaticResource View}}"
                                            CommandParameter="{Binding}" ToolTip="{ctl:T 'Hide / show this sensor'}">
                                        <TextBlock x:Name="EyeGlyph" Text="&#xE7B3;" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Click="More_Click"
                                            ToolTip="{ctl:T 'Show it on the taskbar, the overlay, a widget or a dashboard'}" AutomationProperties.Name="{ctl:T More}">
                                        <TextBlock Text="&#xE712;" />
                                    </Button>
                                </StackPanel>
                                <Border x:Name="Left" Background="Transparent" DataContext="{Binding Node}" Margin="-8,-6,12,-6" Padding="8,6" CornerRadius="{x:Static ctl:Corner.Control}"
                                        MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Card_MouseUp"
                                        ToolTip="{ctl:T 'Drag to change the order.'}">
                                    <StackPanel>
                                        <!-- The tag, the name, then how it's reached right after the name (a long name ends in "…" first). -->
                                        <DockPanel LastChildFill="False">
                                            <Border Style="{StaticResource Badge}" Background="{Binding Type, Converter={StaticResource KindBrush}, ConverterParameter=soft}">
                                                <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeText}" Foreground="{Binding Type, Converter={StaticResource KindBrush}}" />
                                            </Border>
                                            <TextBlock Text="{Binding ShownName}" Style="{StaticResource H2}" Margin="12,0,0,3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ctl:TrimmedText.ToolTip="True" />
                                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Field}" Padding="9,3" Margin="10,0,0,0"
                                                    VerticalAlignment="Center" Visibility="{Binding ViaShown, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding ViaShown}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource TextBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DataContext.Battery.BatteryStats, ElementName=Card}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource FaintBrush}"
                                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding DataContext.Battery.BatteryStats, ElementName=Card, Converter={StaticResource Vis}}"
                                                   ToolTip="{ctl:T 'Lowest and highest today, average since you opened this window'}" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </ctl:SmoothBorder>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Node.IsBeingMoved}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Battery.IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Battery.IsHidden}" Value="True">
                                <Setter TargetName="Left" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Right" Property="Opacity" Value="0.45" />
                                <Setter TargetName="EyeGlyph" Property="Text" Value="&#xED1A;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- One sensor -->
                    <DataTemplate DataType="{x:Type m:SensorItem}">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1,0,1,0" Padding="20,0">
                            <Border x:Name="Row" CornerRadius="{x:Static ctl:Corner.Field}" Padding="0,3" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Static ctl:KindTag.Column}" />
                                        <ColumnDefinition Width="*" MinWidth="{x:Static ctl:KindTag.NameMinWidth}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Badge}" Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=soft}"
                                            HorizontalAlignment="Left" Padding="{x:Static ctl:KindTag.Padding}" MaxWidth="{x:Static ctl:KindTag.Width}" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="{x:Static ctl:TextSize.Tiny}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                    </Border>
                                    <!-- Its name, as plain text that looks like the rename box at rest; a click puts the box itself in its
                                         place until the rename is done (see Name_MouseDown), so no row carries a box of its own. -->
                                    <Border x:Name="NameShown" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                            CornerRadius="{x:Static ctl:Corner.Small}" Padding="5,2" VerticalAlignment="Center" Cursor="IBeam"
                                            ToolTip="{Binding NameTip}" MouseLeftButtonDown="Name_MouseDown">
                                        <TextBlock Text="{Binding Label}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource TextBrush}" Margin="2,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Grid Grid.Column="2" Width="92" Style="{StaticResource WithSpark}">
                                        <ctl:Sparkline Height="22" Margin="12,0"
                                                       Source="{Binding History}" Version="{Binding Version}" Kind="{Binding Kind}"
                                                       Stroke="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding ChargeTip}">
                                    <TextBlock x:Name="RowValue" Text="{Binding FormattedValue}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Style.Triggers>
                                                    <!-- Coloured by its own part's steps; a fixed limit stays plain. -->
                                                    <DataTrigger Binding="{Binding HasTempScale}" Value="True">
                                                        <Setter Property="Foreground">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                                    <Binding Path="Value" />
                                                                    <Binding Path="TempScale" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SensorKind.Battery}">
                                                        <Setter Property="Foreground" Value="{Binding Value, Converter={StaticResource BatteryBrush}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- A wireless device that says it's charging: a bolt in the number's colour; full on power: "Full" in grey (1.22.0). -->
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" Margin="4,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, ElementName=RowValue}" Visibility="{Binding ShowsBolt, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{x:Static m:SensorItem.FullWord}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding ShowsFull, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding FormattedMin}" Style="{StaticResource Stat}" />
                                    <TextBlock Grid.Column="5" Text="{Binding FormattedMax}" Style="{StaticResource Stat}" />
                                    <TextBlock Grid.Column="6" Text="{Binding FormattedAverage}" Style="{StaticResource Stat}" />
                                    <Button Grid.Column="7" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                            Command="{Binding Data.DataContext.ToggleHiddenCommand, Source={StaticResource View}}"
                                            CommandParameter="{Binding}" ToolTip="{ctl:T 'Hide / show this sensor'}">
                                        <TextBlock x:Name="EyeGlyph" Text="&#xE7B3;" />
                                    </Button>
                                    <!-- Where it is shown, copying its value, hiding it. -->
                                    <Button Grid.Column="8" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="More_Click"
                                            ToolTip="{ctl:T 'Show it on the taskbar, the overlay, a widget or a dashboard'}" AutomationProperties.Name="{ctl:T More}">
                                        <TextBlock Text="&#xE712;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                            <Trigger SourceName="NameShown" Property="IsMouseOver" Value="True">
                                <Setter TargetName="NameShown" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                <Setter TargetName="EyeGlyph" Property="Text" Value="&#xED1A;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ctl:RowList>

            <!-- What stands out right now, read from every sensor: nothing to pick. A line jumps to its sensor in the list. -->
            <!-- As tall as what it says and never taller than the window: past that it scrolls by itself (it ran off the
                 window's foot, and the fans and the power under them couldn't be reached). -->
            <ctl:SmoothBorder x:Name="Pane" Grid.Column="1" Width="302" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="18,0,0,24" AutomationProperties.Name="{ctl:T 'Right now'}">
                <ctl:SmoothBorder.Resources>
                    <DataTemplate DataType="{x:Type vm:GlanceRow}">
                        <Button Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Cursor="Hand" FocusVisualStyle="{StaticResource FocusRingWide}" HorizontalAlignment="Stretch" ToolTip="{ctl:T 'Show it in the list'}"
                                AutomationProperties.Name="{Binding Sensor.DisplayName}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" CornerRadius="{x:Static ctl:Corner.Field}" Padding="8,6" Margin="-8,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="Value" DockPanel.Dock="Right" Text="{Binding Sensor.FormattedValue}" FontSize="{x:Static ctl:TextSize.BodyPlus}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding Sensor.DisplayName}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Note}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                            <Grid Height="4" Margin="0,5,0,0" Visibility="{Binding HasBar, Converter={StaticResource Vis}}">
                                                <Border CornerRadius="{x:Static ctl:Corner.Bar}" Background="{DynamicResource Surface2Brush}" />
                                                <ctl:BarPair x:Name="Bar" DownShare="{Binding Bar, Converter={StaticResource Scale}, ConverterParameter=100}" UpShare="0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Sensor.HasTempScale}" Value="True">
                                            <Setter TargetName="Value" Property="Foreground">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                        <Binding Path="Sensor.Value" />
                                                        <Binding Path="Sensor.TempScale" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                    <!-- The bar's strip is always this wide, shown or not, so the rows sit 20 from both edges of the card
                         either way (it came and went, and the right side was 6 against the left's 20 on a short window). -->
                    <Style x:Key="PaneScroll" TargetType="ScrollViewer" BasedOn="{StaticResource GutterScroll}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" />
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" HorizontalAlignment="Center" Orientation="Vertical"
                                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="GlanceTitle" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Margin" Value="0,18,0,4" />
                    </Style>
                </ctl:SmoothBorder.Resources>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{ctl:T 'Right now'}" Style="{StaticResource H2}" />
                    <!-- Its scrollbar has its own strip in the card's right padding (laid over the rows, it sat on the figures). The
                         scroller reaches 8 into the left padding and the rows step 8 back in, so a row's hover shade, which
                         stands 8 out on each side, isn't cut off at its left. -->
                    <ScrollViewer Style="{StaticResource PaneScroll}" Margin="-8,0,-20,0" ctl:WheelChain.Enabled="True">
                <StackPanel Margin="8,0">
                    <ctl:Spinner Late="True" Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,40,0,26"
                                 Visibility="{Binding ReadingsPending, Converter={StaticResource Vis}}" />
                    <StackPanel Visibility="{Binding Warmest.Count, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{ctl:T 'nearest its limit'}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            <TextBlock Text="{ctl:T WARMEST}" Style="{StaticResource GlanceTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Warmest}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Hardest.Count, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'WORKING HARDEST'}" Style="{StaticResource GlanceTitle}" />
                        <ItemsControl ItemsSource="{Binding Hardest}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding FastestFans.Count, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T FANS}" Style="{StaticResource GlanceTitle}" />
                        <ItemsControl ItemsSource="{Binding FastestFans}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding PowerDraw.Count, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PowerNote}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            <TextBlock Text="{ctl:T 'DRAWING POWER'}" Style="{StaticResource GlanceTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PowerDraw}" Focusable="False" />
                    </StackPanel>
                </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ctl:SmoothBorder>
        </Grid>
    </DockPanel>
</UserControl>
