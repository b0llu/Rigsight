<UserControl x:Class="Rigsight.Views.InstructionsBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <ControlTemplate x:Key="TextArea" TargetType="TextBox">
            <Border x:Name="Bd" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <!-- The full instructions for Ollama or my own key, opened from Settings › Ask RigSight › How it answers (approved mock-up
         2026-10-24): a warning that their text replaces RigSight's, then one text at a time with Yours / RigSight's tabs so
         the box they type in keeps the whole width, then what RigSight always keeps. Shrinks with a small window. -->
    <ctl:SmoothBorder MaxWidth="860" Margin="24" Padding="24,20,24,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                      AutomationProperties.Name="{ctl:T 'Edit the full instructions'}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CancelCommand}" VerticalAlignment="Top"
                        ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="{ctl:T 'Cancel'}">
                    <TextBlock Text="&#xE8BB;" FontSize="11" />
                </Button>
                <StackPanel>
                    <TextBlock Text="{ctl:T 'Edit the full instructions'}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding ModeName}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- What changes when they write their own: said once, before the box. -->
            <ctl:SmoothBorder DockPanel.Dock="Top" CornerRadius="10" Background="{DynamicResource WarmSoftBrush}" Padding="14,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{ctl:T 'Your text replaces RigSight\'s own instructions'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{ctl:T 'Answers may get less accurate, and RigSight\'s later improvements to them won\'t reach you. For tone, length or language, use How it answers instead.'}"
                               FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </ctl:SmoothBorder>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Go back to RigSight\'s'}" Command="{Binding GoBackCommand}"
                            Visibility="{Binding HasOwn, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Cancel'}" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Save my instructions'}" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- What can't be written away: the rules RigSight adds after any text. -->
            <ctl:SmoothBorder DockPanel.Dock="Bottom" CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="14,10" Margin="0,12,0,0">
                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
                    <Run Text="{ctl:T 'Always kept, whatever you write here.'}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <Run Text="{ctl:T 'RigSight still checks your PC\'s records before it answers, only says what they show, never sends what you\'ve turned off, and keeps its sources, number cards and buttons.'}" />
                </TextBlock>
            </ctl:SmoothBorder>

            <DockPanel DockPanel.Dock="Top" Margin="0,14,0,8">
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="InstructionsTab" Content="{ctl:T 'Yours'}"
                                     IsChecked="{Binding ShowingRigSights, Converter={StaticResource Equals}, ConverterParameter=False}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="InstructionsTab" Content="{ctl:T 'RigSight\'s (read only)'}"
                                     IsChecked="{Binding ShowingRigSights, Converter={StaticResource Equals}, ConverterParameter=True}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{ctl:T 'Open RigSight\'s to compare; yours stays as you left it.'}" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>

            <Grid Height="330">
                <TextBox x:Name="Box" Template="{StaticResource TextArea}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}" SpellCheck.IsEnabled="False" AutomationProperties.Name="{ctl:T 'Your instructions'}"
                         Visibility="{Binding ShowingYours, Converter={StaticResource Vis}}" />
                <TextBox Template="{StaticResource TextArea}" Text="{Binding RigSightText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}" AutomationProperties.Name="{ctl:T 'RigSight\'s instructions'}"
                         Visibility="{Binding ShowingRigSights, Converter={StaticResource Vis}}" />
            </Grid>
        </DockPanel>
    </ctl:SmoothBorder>
</UserControl>
