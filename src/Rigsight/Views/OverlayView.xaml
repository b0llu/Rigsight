<UserControl x:Class="Rigsight.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="90" />
        </Style>

        <!-- An on/off chip for one reading. -->
        <Style x:Key="MetricChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{StaticResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="9" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"
                                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Game overlay" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Intro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,18" />

            <!-- Only when fullscreen games can't show the overlay -->
            <Border Background="{StaticResource WarmSoftBrush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,18"
                    Visibility="{Binding ShowRtssWarning, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Margin="0,1,12,0"
                               Foreground="{StaticResource WarmBrush}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding RtssTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WarmBrush}" />
                        <TextBlock Text="{Binding RtssStatus}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding CanInstallRtss, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource AccentButton}" Content="Install RivaTuner" Command="{Binding InstallRtssCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Download from Guru3D" Margin="8,0,0,0" Command="{Binding OpenRtssDownloadCommand}" />
                        </StackPanel>
                        <Button Style="{StaticResource AccentButton}" Content="Start RivaTuner" Command="{Binding StartRtssCommand}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Visibility="{Binding CanStartRtss, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Shortcut and preview -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}">
                            <StackPanel>
                                <TextBlock Text="Keyboard shortcut" Style="{StaticResource H2}" />
                                <TextBlock Text="Shows and hides the overlay, even while a game has focus." Style="{StaticResource Muted}"
                                           FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" IsEnabled="{Binding Enabled}">
                            <Button Focusable="False" Command="{Binding StartRecordingCommand}" Click="OnRecordClick"
                                    AutomationProperties.Name="Change shortcut" ToolTip="Click, then press the new shortcut">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="14,8" MinWidth="170" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding RecordText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Reset" Margin="8,0,0,0" Command="{Binding ResetHotkeyCommand}"
                                    ToolTip="Go back to Alt+Shift+O" />
                        </StackPanel>
                        <TextBlock Text="{Binding RecordHint}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding RecordHint, Converter={StaticResource Vis}}" />

                        <Border Background="{StaticResource WarmSoftBrush}" CornerRadius="9" Padding="12,8" Margin="0,12,0,0"
                                Visibility="{Binding HotkeyTaken, Converter={StaticResource Vis}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource WarmBrush}"
                                       Text="Another program already uses this shortcut, so Rigsight can't hear it. Pick a different one." />
                        </Border>

                        <Button Style="{StaticResource AccentButton}" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                HorizontalAlignment="Left" Margin="0,18,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="12" MinHeight="170" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3A2F4F" Offset="0" />
                                <GradientStop Color="#1E3B45" Offset="0.55" />
                                <GradientStop Color="#40372A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock Text="Preview appears when the agent is running" Style="{StaticResource Muted}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Preview, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <!-- Drawn at twice the size for sharpness; shown at its real size, in the chosen corner. -->
                            <Viewbox StretchDirection="DownOnly" Margin="14">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Corner}" Value="TopRight">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Corner}" Value="BottomLeft">
                                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Corner}" Value="BottomRight">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Image Source="{Binding Preview}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                    </Image.LayoutTransform>
                                </Image>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- What it shows -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="What it shows" Style="{StaticResource H2}" />
                    <TextBlock Text="Pick the readings you want. Fewer is easier to read at a glance. Game readings appear while a game is running; RivaTuner measures them." Style="{StaticResource Muted}"
                               FontSize="12.5" Margin="0,2,0,14" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource OptionLabel}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource MetricChip}" Content="{Binding Label}" IsChecked="{Binding IsOn}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Look -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Look" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="CORNER" Style="{StaticResource OptionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Top left" GroupName="corner"
                                             IsChecked="{Binding Corner, Converter={StaticResource Equals}, ConverterParameter=TopLeft}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Top right" GroupName="corner"
                                             IsChecked="{Binding Corner, Converter={StaticResource Equals}, ConverterParameter=TopRight}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Bottom left" GroupName="corner"
                                             IsChecked="{Binding Corner, Converter={StaticResource Equals}, ConverterParameter=BottomLeft}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Bottom right" GroupName="corner"
                                             IsChecked="{Binding Corner, Converter={StaticResource Equals}, ConverterParameter=BottomRight}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="LAYOUT" Style="{StaticResource OptionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Rows" GroupName="layout"
                                             IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=Rows}" />
                                <RadioButton Style="{StaticResource Segment}" Content="One line" GroupName="layout"
                                             IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=Line}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="SIZE" Style="{StaticResource OptionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="S" GroupName="size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=0.8}" />
                                <RadioButton Style="{StaticResource Segment}" Content="M" GroupName="size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=1}" />
                                <RadioButton Style="{StaticResource Segment}" Content="L" GroupName="size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=1.25}" />
                                <RadioButton Style="{StaticResource Segment}" Content="XL" GroupName="size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=1.5}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <DockPanel Margin="0,4" MaxWidth="520" HorizontalAlignment="Left" Width="520">
                        <TextBlock Text="OPACITY" Style="{StaticResource OptionLabel}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityPercent, StringFormat='{}{0:0}%'}" Width="44" TextAlignment="Right"
                                   Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <Slider Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding OpacityPercent}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- RivaTuner is ours to drive -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16" Margin="0,1,12,0"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Rigsight controls the overlay in RivaTuner too" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="In exclusive-fullscreen games the overlay is drawn by RivaTuner Statistics Server; everywhere else (the desktop, windowed and borderless games) Rigsight draws it itself. Either way it uses the readings, corner, size and opacity you pick here, so there's no need to change anything in RivaTuner. Please don't change RivaTuner's On-Screen Display settings (turning it off, its rendering mode or text shadow): that can hide or break the overlay in games." />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="A game that was already open when RivaTuner started needs a restart. Rigsight itself never hooks into games, so it's safe with anti-cheat." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
