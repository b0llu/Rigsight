<UserControl x:Class="Rigsight.Views.FansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:core="clr-namespace:Rigsight.Core;assembly=Rigsight.Core"
             x:Name="Page">
    <UserControl.Resources>
        <!-- The list's rows under where each fan is: the graphics card, a cooler, the motherboard (in that order). -->
        <CollectionViewSource x:Key="Grouped" Source="{Binding Fans}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Place" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="TileBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="9,0" />
        </Style>
        <Style x:Key="TileBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Fact" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A card in a row of cards: as tall as the tallest beside it. -->
        <Style x:Key="RowCard" TargetType="ctl:SmoothBorder" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="9,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <TextBlock Text="Fans" Style="{StaticResource H1}" />
            <TextBlock Text="How your fans are doing, what makes them spin, and how quiet your PC stays." Style="{StaticResource Muted}" Margin="0,4,0,14" />
            <!-- The period the whole page shows (the live readings and "Fans: All OK" are always now). -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <ctl:PeriodPicker Unit="{Binding Unit}" Anchor="{Binding Anchor}" MinDate="{Binding FirstDay}" AllowAll="False" AllowCustom="False"
                                  CustomFrom="{Binding CustomFrom}" CustomTo="{Binding CustomTo}" />
                <TextBlock Text="{Binding RangeNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="No fan speeds reported. Most motherboards share them only with the agent running as admin."
                       Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Visibility="{Binding HasFans, Converter={StaticResource Vis}, ConverterParameter=Invert}" />

            <StackPanel Visibility="{Binding HasFans, Converter={StaticResource Vis}}">
                <!-- ── The answers first: four even tiles ── -->
                <UniformGrid Rows="1" Margin="-9,0,-9,18">
                    <Border Style="{StaticResource TileBox}">
                        <StackPanel>
                            <TextBlock Text="FANS" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding StatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TileBig}">
                                        <Setter Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusOk}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBox}">
                        <StackPanel>
                            <TextBlock Text="{Binding QuietLabel}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding QuietText}" Style="{StaticResource TileBig}" />
                            <TextBlock Text="{Binding QuietNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBox}">
                        <StackPanel>
                            <TextBlock Text="MADE THEM WORK HARDEST" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding HardestApp}" Style="{StaticResource TileBig}" ctl:TrimmedText.ToolTip="True" />
                            <TextBlock Text="{Binding HardestNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBox}">
                        <StackPanel>
                            <TextBlock Text="FASTEST" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding FastestText}" Style="{StaticResource TileBig}" />
                            <TextBlock Text="{Binding FastestNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ── The fans and the picked one: side by side, the same height ── -->
                <Grid Margin="-9,0,-9,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="318" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Every fan, slim rows: exactly as tall as the details beside it, scrolling inside when a PC has more fans
                         than fit (five or twenty, the row stays the same). -->
                    <ctl:SmoothBorder Style="{StaticResource RowCard}" Padding="12,14" VerticalAlignment="Top"
                                      Height="{Binding ActualHeight, ElementName=DetailCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding EmptyHeadersText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"
                                       Margin="10,8,10,0" Visibility="{Binding EmptyHeadersText, Converter={StaticResource Vis}}" />
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Source={StaticResource Grouped}}"
                                     SelectedItem="{Binding Selected}" AutomationProperties.Name="Fans">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="10,10,0,6" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding Series[0].Brush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                                <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NeedsLook}" Value="True">
                                                <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource HotBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </ctl:SmoothBorder>

                    <!-- The picked fan (or a graphics card's fans): its name, speed now and three facts -->
                    <ctl:SmoothBorder x:Name="DetailCard" Grid.Column="1" Style="{StaticResource RowCard}" VerticalAlignment="Top"
                                      Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <StackPanel DataContext="{Binding Selected}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Spinning">
                                                    <Setter Property="Background" Value="{DynamicResource GpuSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="StoppedHot">
                                                    <Setter Property="Background" Value="{DynamicResource HotSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Spinning">
                                                        <Setter Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="StoppedHot">
                                                        <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Grid>
                                    <!-- One fan: click its name to rename it (it shows everywhere). A card's fans: their own names below. -->
                                    <TextBox Style="{StaticResource InlineEdit}" FontSize="18" FontWeight="SemiBold" Margin="-5,0,0,0"
                                             Text="{Binding Sensor.Label, UpdateSourceTrigger=LostFocus}" KeyDown="Rename_KeyDown"
                                             ToolTip="Click to rename this fan (the name shows everywhere)"
                                             Visibility="{Binding IsGroup, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="18"
                                               Visibility="{Binding IsGroup, Converter={StaticResource Vis}}" />
                                </Grid>
                            </DockPanel>
                            <TextBlock Text="{Binding Place}" Style="{StaticResource Caption}" Margin="0,2,0,12" />

                            <TextBlock Text="{Binding ValueText}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding Sensor.MinMaxText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"
                                       ToolTip="Slowest and fastest today" Visibility="{Binding IsGroup, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <!-- A card's fans, each with its speed. -->
                            <ItemsControl ItemsSource="{Binding Series}" Margin="0,6,0,0" Visibility="{Binding IsGroup, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Sensor.DisplayName}" Margin="8,0,6,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Sensor.FormattedValue}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The period's warning about this fan, as the insights put it. -->
                            <Border CornerRadius="10" Padding="12,10" Margin="0,14,0,0" Visibility="{Binding HasAlert, Converter={StaticResource Vis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlertIsHot}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HotSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Alert}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                            </Border>

                            <!-- Six facts, two rows of three. -->
                            <ItemsControl ItemsSource="{Binding Detail.Facts}" Margin="-5,12,-5,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Fact}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource TileNote}" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource FactValue}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource TileNote}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:SmoothBorder>
                </Grid>

                <!-- ── Its speed, full width like Temperature history: over the period, and at each temperature ── -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,18" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <Grid DataContext="{Binding Selected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- A day: minute by minute. A week, a month: each day's average and fastest. A year: each month's. -->
                        <StackPanel Visibility="{Binding DataContext.IsDay, ElementName=Page, Converter={StaticResource Vis}}">
                            <TextBlock Text="SPEED THROUGH THE DAY" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <ctl:LineChart Height="220" Kind="{x:Static core:SensorKind.Fan}" WindowSeconds="0"
                                           Day="{Binding DataContext.DayOfChart, ElementName=Page}"
                                           Series="{Binding DataContext.ChartSeries, ElementName=Page}"
                                           Version="{Binding DataContext.Live.Tick, ElementName=Page}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding DataContext.IsDay, ElementName=Page, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Series[0].Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="average" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="5,0,10,0" />
                                    <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource HoverBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="fastest" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0" />
                                </StackPanel>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Text" Value="SPEED EACH DAY" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail.Monthly}" Value="True">
                                                    <Setter Property="Text" Value="SPEED EACH MONTH" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <ctl:FanDaysChart Height="220" Days="{Binding Detail.Days}" Monthly="{Binding Detail.Monthly}" Brush="{Binding Series[0].Brush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Detail.CurveTitle}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <ctl:FanCurveChart Height="220" Dots="{Binding Detail.Dots}" Bins="{Binding Detail.Bins}" Line="{Binding Detail.Line}" LineLabel="{Binding Detail.LineLabel}"
                                               SilentBelow="{Binding Detail.SilentBelow}" Brush="{Binding Series[0].Brush}" />
                        </StackPanel>
                    </Grid>
                </ctl:SmoothBorder>

                <!-- ── Two even cards: whichever of these the fan and the period have ── -->
                <UniformGrid Rows="1" Margin="-9,0" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <!-- A year: its speed at one temperature month by month (falling bars: a slower fan). -->
                    <ctl:SmoothBorder Style="{StaticResource RowCard}" Visibility="{Binding Selected.Detail.HasTrend, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Detail.TrendTitle}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <TextBlock Text="The same heat each month: lower bars mean a slower fan." Style="{StaticResource TileNote}" Margin="0,0,0,10" />
                            <ctl:FanDaysChart Height="180" Days="{Binding Selected.Detail.Trend}" Monthly="True" ValueLabel="{Binding Selected.Detail.TrendLabel}"
                                              Brush="{Binding Selected.Series[0].Brush}" />
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- The apps that make it spin -->
                    <ctl:SmoothBorder Style="{StaticResource RowCard}" Visibility="{Binding Selected.Detail.HasApps, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="{Binding Detail.AppsTitle}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Detail.Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" ctl:TrimmedText.ToolTip="True" />
                                            <ProgressBar x:Name="Bar" Grid.Column="1" Style="{StaticResource Bar}" Height="8" Margin="12,0" VerticalAlignment="Center"
                                                         Value="{Binding Share, Mode=OneWay}"
                                                         Foreground="{Binding DataContext.Series[0].Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding RpmText}" Style="{StaticResource Body}" FontWeight="SemiBold" TextAlignment="Right" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Dim}" Value="True">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- A fan at a set speed: what a curve would do for it. -->
                    <ctl:SmoothBorder Style="{StaticResource RowCard}" Visibility="{Binding Selected.Detail.IsSteady, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="A SET SPEED" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <TextBlock Text="This fan turns at the same speed whatever runs and however hot things get."
                                       FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="For a quieter PC at rest and more airflow in games, give it a fan curve in your BIOS."
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- The period, for all the fans: its loudest hour, day or month, and a card's zero-rpm fans starting and resting. -->
                    <ctl:SmoothBorder Style="{StaticResource RowCard}" Visibility="{Binding HasToday, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PeriodCaption}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding LoudestHour, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding LoudestLabel}" Style="{StaticResource TileNote}" />
                                <TextBlock Text="{Binding LoudestHour}" Style="{StaticResource FactValue}" />
                                <TextBlock Text="{Binding LoudestNote}" Style="{StaticResource TileNote}" Visibility="{Binding LoudestNote, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding StartsText, Converter={StaticResource Vis}}">
                                <TextBlock Text="GPU fans started up" Style="{StaticResource TileNote}" />
                                <TextBlock Text="{Binding StartsText}" Style="{StaticResource FactValue}" />
                                <TextBlock Text="{Binding StartsNote}" Style="{StaticResource TileNote}" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SilentText, Converter={StaticResource Vis}}">
                                <TextBlock Text="Longest silent stretch" Style="{StaticResource TileNote}" />
                                <TextBlock Text="{Binding SilentText}" Style="{StaticResource FactValue}" />
                                <TextBlock Text="{Binding SilentNote}" Style="{StaticResource TileNote}" />
                            </StackPanel>
                        </StackPanel>
                    </ctl:SmoothBorder>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
