<UserControl x:Class="Rigsight.Views.FansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:core="clr-namespace:Rigsight.Core;assembly=Rigsight.Core">
    <UserControl.Resources>
        <!-- The list's rows under where each fan is: the graphics card, a cooler, the motherboard (in that order). -->
        <CollectionViewSource x:Key="Grouped" Source="{Binding Fans}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Place" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="TileBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="TileBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Fact" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <TextBlock Text="Fans" Style="{StaticResource H1}" />
            <TextBlock Text="How your fans are doing, what makes them spin, and how quiet your PC stays." Style="{StaticResource Muted}" Margin="0,4,0,18" />

            <TextBlock Text="No fan speeds reported. Most motherboards share them only with the agent running as admin."
                       Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Visibility="{Binding HasFans, Converter={StaticResource Vis}, ConverterParameter=Invert}" />

            <StackPanel Visibility="{Binding HasFans, Converter={StaticResource Vis}}">
                <!-- Today at a glance: the answers first. -->
                <UniformGrid Rows="1" Margin="-6,0,-6,12">
                    <Border Style="{StaticResource TileBox}">
                        <StackPanel>
                            <TextBlock Text="FANS" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding StatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TileBig}">
                                        <Setter Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusOk}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBox}" Visibility="{Binding QuietText, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="QUIET TIME" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding QuietText}" Style="{StaticResource TileBig}" />
                            <TextBlock Text="{Binding QuietNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBox}" Visibility="{Binding HardestApp, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="MADE THEM WORK HARDEST" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding HardestApp}" Style="{StaticResource TileBig}" ctl:TrimmedText.ToolTip="True" />
                            <TextBlock Text="{Binding HardestNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBox}" Visibility="{Binding FastestText, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="FASTEST TODAY" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding FastestText}" Style="{StaticResource TileBig}" />
                            <TextBlock Text="{Binding FastestNote}" Style="{StaticResource TileNote}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Every fan, slim rows: however many a PC has, they fit without scrolling past big blocks. -->
                    <ctl:SmoothBorder Style="{StaticResource Card}" Padding="12,14" VerticalAlignment="Top">
                        <StackPanel>
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Source={StaticResource Grouped}}"
                                     SelectedItem="{Binding Selected}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Fans">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="10,10,0,6" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding Series[0].Brush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                                <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NeedsLook}" Value="True">
                                                <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource HotBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding EmptyHeadersText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"
                                       Margin="10,10,10,0" Visibility="{Binding EmptyHeadersText, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- The picked fan (or a graphics card's fans) -->
                    <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                                      Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <StackPanel DataContext="{Binding Selected}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Spinning">
                                                    <Setter Property="Background" Value="{DynamicResource GpuSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="StoppedHot">
                                                    <Setter Property="Background" Value="{DynamicResource HotSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Spinning">
                                                        <Setter Property="Foreground" Value="{DynamicResource GpuBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="StoppedHot">
                                                        <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Grid>
                                    <!-- One fan: click its name to rename it (it shows everywhere). A card's fans: their own names below. -->
                                    <TextBox Style="{StaticResource InlineEdit}" FontSize="18" FontWeight="SemiBold" Margin="-5,0,0,0"
                                             Text="{Binding Sensor.Label, UpdateSourceTrigger=LostFocus}" KeyDown="Rename_KeyDown"
                                             ToolTip="Click to rename this fan (the name shows everywhere)"
                                             Visibility="{Binding IsGroup, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="18"
                                               Visibility="{Binding IsGroup, Converter={StaticResource Vis}}" />
                                </Grid>
                            </DockPanel>
                            <TextBlock Text="{Binding Place}" Style="{StaticResource Caption}" Margin="0,2,0,14" />

                            <TextBlock Text="{Binding ValueText}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding Sensor.MinMaxText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"
                                       ToolTip="Slowest and fastest today" Visibility="{Binding IsGroup, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <!-- A card's fans, each with its speed. -->
                            <ItemsControl ItemsSource="{Binding Series}" Margin="0,6,0,0" Visibility="{Binding IsGroup, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Sensor.DisplayName}" Margin="8,0,6,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Sensor.FormattedValue}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Today's warning about this fan, as the day's insights put it. -->
                            <Border CornerRadius="10" Padding="12,10" Margin="0,14,0,0" Visibility="{Binding HasAlert, Converter={StaticResource Vis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlertIsHot}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HotSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Alert}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                            </Border>

                            <!-- Three facts -->
                            <UniformGrid Rows="1" Margin="-5,12,-5,0">
                                <Border Style="{StaticResource Fact}">
                                    <StackPanel>
                                        <TextBlock Text="Follows" Style="{StaticResource TileNote}" />
                                        <TextBlock Text="{Binding Detail.FollowsValue}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,2" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail.FollowsNote}" Style="{StaticResource TileNote}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Fact}">
                                    <StackPanel>
                                        <TextBlock Text="Stood still today" Style="{StaticResource TileNote}" />
                                        <TextBlock Text="{Binding Detail.StillValue}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
                                        <TextBlock Text="{Binding Detail.StillNote}" Style="{StaticResource TileNote}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Fact}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.ThirdLabel}" Style="{StaticResource TileNote}" />
                                        <TextBlock Text="{Binding Detail.ThirdValue}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
                                        <TextBlock Text="{Binding Detail.ThirdNote}" Style="{StaticResource TileNote}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Speed through the day, and at each temperature -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SPEED TODAY" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                    <ctl:LineChart Height="200" Kind="{x:Static core:SensorKind.Fan}" WindowSeconds="0"
                                                   Series="{Binding DataContext.ChartSeries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Version="{Binding DataContext.Live.Tick, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Detail.CurveTitle}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                    <ctl:FanCurveChart Height="200" Points="{Binding Detail.Points}" Line="{Binding Detail.Line}" LineLabel="{Binding Detail.LineLabel}"
                                                       SilentBelow="{Binding Detail.SilentBelow}" Brush="{Binding Series[0].Brush}" />
                                </StackPanel>
                            </Grid>

                            <!-- The apps that make it spin -->
                            <StackPanel Margin="0,18,0,0" Visibility="{Binding Detail.HasApps, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Detail.AppsTitle}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Detail.Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" ctl:TrimmedText.ToolTip="True" />
                                                <ProgressBar x:Name="Bar" Grid.Column="1" Style="{StaticResource Bar}" Height="8" Margin="12,0" VerticalAlignment="Center"
                                                             Value="{Binding Share, Mode=OneWay}"
                                                             Foreground="{Binding DataContext.Series[0].Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding RpmText}" Style="{StaticResource Body}" FontWeight="SemiBold" TextAlignment="Right" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Dim}" Value="True">
                                                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Detail.AppsNote}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding Detail.HasAppsNote, Converter={StaticResource Vis}}" />
                            </StackPanel>

                            <!-- A fan at a set speed: what a curve would do for it. -->
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0"
                                    Visibility="{Binding Detail.IsSteady, Converter={StaticResource Vis}}">
                                <TextBlock Text="It holds one speed. For a quieter PC at rest and more airflow in games, give it a fan curve in your BIOS."
                                           FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ctl:SmoothBorder>
                </Grid>

                <!-- The longer view: a bar a day. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Selected.Series[0].Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="average" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="6,0,14,0" />
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource HoverBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="fastest" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.Detail.DaysTitle}" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <ctl:FanDaysChart Height="140" Days="{Binding Selected.Detail.Days}" Brush="{Binding Selected.Series[0].Brush}" />
                    </StackPanel>
                </ctl:SmoothBorder>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
