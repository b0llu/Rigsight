<UserControl x:Class="Rigsight.Views.WidgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:svc="clr-namespace:Rigsight.Services">
    <UserControl.Resources>
        <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="90" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <!-- Behind the widget pictures: a stand-in for a wallpaper, so see-through widgets show as they would. -->
        <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A3350" Offset="0" />
            <GradientStop Color="#1B3A36" Offset="1" />
        </LinearGradientBrush>

        <!-- One widget on the page: its picture, name, switch and an Edit button; outlined while it's in the editor. -->
        <DataTemplate x:Key="WidgetCardTemplate">
            <ctl:SmoothBorder Width="250" Margin="0,0,14,14" Padding="14" CornerRadius="16" BorderThickness="1"
                              Background="{DynamicResource SurfaceBrush}">
                <ctl:SmoothBorder.Style>
                    <Style TargetType="ctl:SmoothBorder">
                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:SmoothBorder.Style>
                <StackPanel>
                    <Border Height="100" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Backdrop}">
                        <Grid>
                            <TextBlock Text="{ctl:T 'Preview appears when the agent is running'}" Style="{StaticResource Muted}" FontSize="11.5"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Preview, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <Image Source="{Binding Preview}" Stretch="Uniform" StretchDirection="DownOnly" Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,12,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Show {0}'}" ToolTip="{ctl:T 'Show it on the desktop'}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Height="34" Margin="0,4,0,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Edit'}" Command="{Binding EditCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            AutomationProperties.Name="{Binding Title, StringFormat='Edit {0}'}" />
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The widgets -->
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding CreateCommand}" VerticalAlignment="Top"
                            Margin="16,4,0,0" AutomationProperties.Name="Create widget">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
                            <TextBlock Text="{ctl:T 'Create widget'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- The page's own question for the AI (mock-up board 5). -->
                    <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'Which widgets suit me?'}" CommandParameter="{x:Static svc:PageAsks.Widgets}" AutomationProperties.Name="{ctl:T 'Which widgets suit me?'}" />
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Desktop widgets'}" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{ctl:T 'Small readouts that sit on your desktop, always up to date. Drag one anywhere, or lock it so clicks pass straight through.'}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{ctl:T 'BUILT IN'}" Style="{StaticResource Section}" Margin="0,22,0,10" />
                <ScrollViewer x:Name="BuiltInRow" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="BuiltInRow_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding BuiltIn}" ItemTemplate="{StaticResource WidgetCardTemplate}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{ctl:T 'YOUR WIDGETS'}" Style="{StaticResource Section}" Margin="0,18,0,10" />
                <ItemsControl ItemsSource="{Binding Custom}" ItemTemplate="{StaticResource WidgetCardTemplate}"
                              Visibility="{Binding HasCustom, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ctl:SmoothBorder Style="{StaticResource Card}" Visibility="{Binding HasCustom, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Create widget'}" Command="{Binding CreateCommand}"
                                VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Make your own'}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{ctl:T 'Pick a layout and the readings you want, like frame rate, temperatures, loads, or any sensor on your PC.'}" />
                        </StackPanel>
                    </DockPanel>
                </ctl:SmoothBorder>
            </StackPanel>
        </ScrollViewer>

        <!-- Over the page while the editor is open: dims it a little; a click on it closes the editor. -->
        <Border x:Name="EditorScrim" Background="#000000" Opacity="0" Visibility="Collapsed" MouseLeftButtonDown="EditorScrim_MouseLeftButtonDown" />

        <!-- The editor: a sheet over the page that slides in from the right (see the code-behind). -->
        <!-- The editor's shadow on an empty box of its own behind it, sliding with it (the same transform): an effect on the
             editor itself drew all its text without ClearType, softer than the rest of the app. -->
        <Border Width="430" HorizontalAlignment="Right" Background="{DynamicResource SidebarBrush}" IsHitTestVisible="False"
                Visibility="{Binding Visibility, ElementName=EditorPanel}" RenderTransform="{Binding RenderTransform, ElementName=EditorPanel}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Border x:Name="EditorPanel" Width="430" HorizontalAlignment="Right" Visibility="Collapsed"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource SidebarBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="EditorSlide" X="430" />
            </Border.RenderTransform>
            <ScrollViewer x:Name="EditorContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          DataContext="{Binding Editing}">
                <StackPanel Margin="22,22,22,26">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="Close the editor"
                                Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Height="150" CornerRadius="12" ClipToBounds="True" Background="{StaticResource Backdrop}" Margin="0,16,0,0">
                        <Image Source="{Binding Preview}" Stretch="Uniform" StretchDirection="DownOnly" Margin="14"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- The user's own: name and layout -->
                    <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'NAME'}" Style="{StaticResource Section}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" MaxLength="40" AutomationProperties.Name="Widget name" />
                        <TextBlock Text="{ctl:T 'LAYOUT'}" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Bar'}" GroupName="editor-layout"
                                             IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=Bar}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Tiles'}" GroupName="editor-layout"
                                             IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=Tiles}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Gauges'}" GroupName="editor-layout"
                                             IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=Gauges}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Graph'}" GroupName="editor-layout"
                                             IsChecked="{Binding Layout, Converter={StaticResource Equals}, ConverterParameter=Graph}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Readings -->
                    <StackPanel Visibility="{Binding HasReadings, Converter={StaticResource Vis}}">
                        <DockPanel Margin="0,20,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemsCount}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{ctl:T 'READINGS'}" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <!-- Above the readings: adding one grows the list below it, so the field and its open list stay put.
                             The reading picker: one search field for the usual readings and every sensor. Typing opens the list,
                             chips narrow it to a part, a click adds a line at once and the list stays open for the next. It floats
                             over the editor (nothing moves). -->
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="PickBox" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Add a reading… type to search'}" Height="36"
                                     ctl:Debounce.Text="{Binding PickerText}" AutomationProperties.Name="Add a reading"
                                     GotKeyboardFocus="PickBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="PickBox_MouseDown" PreviewKeyDown="PickBox_KeyDown"
                                     LostKeyboardFocus="PickBox_LostKeyboardFocus" TextChanged="PickBox_TextChanged" />
                            <Popup x:Name="PickPopup" PlacementTarget="{Binding ElementName=PickBox}" Placement="Bottom" VerticalOffset="6" StaysOpen="True"
                                   PreviewKeyDown="PickPopup_KeyDown" LostKeyboardFocus="PickBox_LostKeyboardFocus"
                                   AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding PickerOpen, Mode=TwoWay}">
                                <!-- As wide as the field above it; the popup is 8 px wider and taller for the shadow. -->
                                <Border Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="0,10,0,6" Margin="0,0,8,8" Width="{Binding ActualWidth, ElementName=PickBox}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                                    </Border.Effect>
                                    <DockPanel>
                                        <!-- Chips: a part each, with how many there are to add under what's typed. -->
                                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PickerChips}" Margin="10,0,10,8" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Focusable="False" Cursor="Hand" Margin="0,0,6,6" AutomationProperties.Name="{Binding Name}"
                                                            Visibility="{Binding IsShown, Converter={StaticResource Vis}}"
                                                            Command="{Binding DataContext.PickChipCommand, ElementName=PickBox}" CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" CornerRadius="11" Padding="10,3">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                                        <TextBlock x:Name="Count" Text="{Binding Count}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}"
                                                                                   Margin="6,1,0,0" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                                        <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource StrokeBrush}" />
                                        <TextBlock DockPanel.Dock="Bottom" Text="{ctl:T 'Click to add · Enter adds the first · Esc to close'}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="14,6,14,0" />
                                        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource StrokeBrush}" />
                                        <Grid>
                                                <ItemsControl x:Name="PickScroll" ItemsSource="{Binding PickerOptions}" Margin="6,4" Focusable="False" MaxHeight="340"
                                                              Visibility="{Binding PickerEmpty, Converter={StaticResource Vis}, ConverterParameter=Invert}"
                                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                                    <ItemsControl.Template>
                                                        <ControlTemplate TargetType="ItemsControl">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                                                                <ItemsPresenter />
                                                            </ScrollViewer>
                                                        </ControlTemplate>
                                                    </ItemsControl.Template>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Header}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" Margin="8,10,8,4"
                                                                           Visibility="{Binding HasHeader, Converter={StaticResource Vis}}" />
                                                                <Button Cursor="Hand" Focusable="False" IsEnabled="{Binding CanAdd}" AutomationProperties.Name="{Binding Name}"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Command="{Binding DataContext.PickOptionCommand, ElementName=PickBox}" CommandParameter="{Binding}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,6" HorizontalAlignment="Stretch">
                                                                                <DockPanel>
                                                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                                             Fill="{Binding DotBrush, Converter={StaticResource ResourceBrush}}" />
                                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Side}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                                                               VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                                                                                    <StackPanel VerticalAlignment="Center">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                                                                                   Visibility="{Binding HasSource, Converter={StaticResource Vis}}" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                                                                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            <!-- Nothing to show: says so, and where else there's a match. -->
                                            <StackPanel Margin="16,24,16,22" HorizontalAlignment="Center" Visibility="{Binding PickerEmpty, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding PickerEmptyText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                                <TextBlock Text="{Binding PickerEmptyHint}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" Visibility="{Binding PickerEmptyHint, Converter={StaticResource Vis}}" />
                                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Search all groups'}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                                        Command="{Binding SearchAllCommand}" Visibility="{Binding CanSearchAll, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Move up'}" AutomationProperties.Name="Move up"
                                                        Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE70E;" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Move down'}" AutomationProperties.Name="Move down"
                                                        Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE70D;" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Remove from the widget'}" AutomationProperties.Name="Remove"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE711;" />
                                                </Button>
                                            </StackPanel>
                                            <!-- Short name on the widget: typed over its usual one, which shows as the hint. -->
                                            <Grid DockPanel.Dock="Right" Width="110" Margin="10,0,6,0" VerticalAlignment="Center">
                                                <TextBox x:Name="LabelBox" Text="{Binding Label, UpdateSourceTrigger=LostFocus}" MaxLength="18" FontSize="12"
                                                         ToolTip="{ctl:T 'Short name on the widget (up to 18 letters). Leave empty for the usual one.'}" />
                                                <TextBlock Text="{ctl:T 'Short name'}" FontSize="12" Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False"
                                                           Margin="11,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=LabelBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                                                <!-- Kept for another layout: greyed, with why. -->
                                                <TextBlock Text="{Binding NotShownText}" FontSize="11" Foreground="{DynamicResource WarmBrush}"
                                                           Visibility="{Binding NotShown, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Reset to default'}" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Visibility="{Binding CanReset, Converter={StaticResource Vis}}" ToolTip="{ctl:T 'Back to this widget\'s own readings'}" />
                    </StackPanel>

                    <!-- Look -->
                    <TextBlock Text="{ctl:T 'LOOK'}" Style="{StaticResource Section}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="{ctl:T 'THEME'}" Style="{StaticResource OptionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Dark'}" GroupName="editor-theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Grey'}" GroupName="editor-theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Grey}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Light'}" GroupName="editor-theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'System'}" GroupName="editor-theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="{ctl:T 'COLORS'}" Style="{StaticResource OptionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Color'}" GroupName="editor-colors"
                                             IsChecked="{Binding Colors, Converter={StaticResource Equals}, ConverterParameter=Color}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Grayscale'}" GroupName="editor-colors"
                                             IsChecked="{Binding Colors, Converter={StaticResource Equals}, ConverterParameter=Grayscale}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="{ctl:T 'SIZE'}" Style="{StaticResource OptionLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="S" GroupName="editor-size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=0.8}" />
                                <RadioButton Style="{StaticResource Segment}" Content="M" GroupName="editor-size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=1}" />
                                <RadioButton Style="{StaticResource Segment}" Content="L" GroupName="editor-size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=1.25}" />
                                <RadioButton Style="{StaticResource Segment}" Content="XL" GroupName="editor-size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=1.5}" />
                                <RadioButton Style="{StaticResource Segment}" Content="2XL" GroupName="editor-size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=2}" />
                                <RadioButton Style="{StaticResource Segment}" Content="3XL" GroupName="editor-size"
                                             IsChecked="{Binding Scale, Converter={StaticResource Equals}, ConverterParameter=2.5}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <DockPanel Margin="0,4" ToolTip="{ctl:T 'The panel behind the readings. At 0% only the readings show, with a soft shadow so they stay readable.'}">
                        <TextBlock Text="{ctl:T 'BACKGROUND'}" Style="{StaticResource OptionLabel}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundPercent, StringFormat='{}{0:0}%'}" Width="44" TextAlignment="Right"
                                   Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding BackgroundPercent}" AutomationProperties.Name="Background" />
                    </DockPanel>
                    <DockPanel Margin="0,4" ToolTip="{ctl:T 'The readings themselves, with their numbers, labels, gauges and charts.'}">
                        <TextBlock Text="{ctl:T 'CONTENT'}" Style="{StaticResource OptionLabel}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ContentPercent, StringFormat='{}{0:0}%'}" Width="44" TextAlignment="Right"
                                   Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding ContentPercent}" AutomationProperties.Name="Content" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Locked}" Margin="0,8,0,0">
                        <TextBlock Text="{ctl:T 'Lock in place (click-through)'}" Style="{StaticResource Body}" />
                    </CheckBox>

                    <!-- The user's own: copy or remove -->
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Duplicate'}" Command="{Binding DuplicateCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Delete widget'}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"
                                Foreground="{DynamicResource HotBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
