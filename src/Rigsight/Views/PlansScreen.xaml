<UserControl x:Class="Rigsight.Views.PlansScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:views="clr-namespace:Rigsight.Views">
    <UserControl.Resources>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- RigSight AI's plans over the whole window (the mock-up approved 2026-10-23): your plan first when you have one, the
         three plans side by side with the same lines in each, every plan's web search, the page by page list on request,
         and how paying works. Back (or Esc) returns to where it was opened. DataContext: PlansViewModel. -->
    <Grid Background="{DynamicResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel MaxWidth="1060" Margin="32,18,32,40">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{ctl:T 'Payments by Lemon Squeezy'}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{ctl:T 'Back'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'Back'}" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Subheading}" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                <!-- Your plan -->
                <ctl:SmoothBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="22,18"
                                  Margin="0,0,0,24" Visibility="{Binding IsPaid, Converter={StaticResource Vis}}">
                    <views:PlanDetails />
                </ctl:SmoothBorder>

                <TextBlock Text="{Binding Problem}" FontSize="13" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,14"
                           Visibility="{Binding HasProblem, Converter={StaticResource Vis}}" />
                <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,0,0,16" MaxWidth="560"
                                  Visibility="{Binding Waiting, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Cancel'}" Command="{Binding StopWaitingCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <ctl:Spinner DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Waiting for your plan…'}" FontSize="13" />
                            <TextBlock Text="{ctl:T 'Finish paying in your browser. Your plan turns on here by itself.'}" Style="{StaticResource Small}" />
                        </StackPanel>
                    </DockPanel>
                </ctl:SmoothBorder>

                <!-- The plans, the same lines in each -->
                <ItemsControl ItemsSource="{Binding Columns}" Focusable="False" Margin="0,0,-14,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10,14,0">
                                <ctl:SmoothBorder x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                  CornerRadius="14" Padding="22,22,22,20" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding For}" Style="{StaticResource Small}" Margin="0,2,0,14" MinHeight="36" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Price}" FontSize="32" FontWeight="SemiBold" />
                                            <TextBlock Text="{ctl:T 'a month'}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="6,0,0,6"
                                                       Visibility="{Binding Monthly, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <Grid Margin="0,16,0,18" MinHeight="38">
                                            <Button x:Name="Get" Style="{StaticResource GhostButton}" Content="{Binding BuyText}" HorizontalAlignment="Stretch" Padding="14,10" FontSize="14"
                                                    Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanBuy, Converter={StaticResource Vis}}" />
                                            <Button x:Name="Switch" Style="{StaticResource GhostButton}" Content="{Binding SwitchText}" HorizontalAlignment="Stretch" Padding="14,10" FontSize="14"
                                                    Command="{Binding DataContext.AskSwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanSwitch, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding NothingText}" Style="{StaticResource Small}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Visibility="{Binding ShowNothing, Converter={StaticResource Vis}}" />
                                            <ctl:SmoothBorder CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="14,10" Visibility="{Binding ShowMine, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding MineText}" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                                            </ctl:SmoothBorder>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,16" />
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="15" Width="22" Margin="0,2,4,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Questions}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding QuestionsWhen}" Style="{StaticResource Small}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15" Width="22" Margin="0,2,4,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="{ctl:T 'Checks the web'}" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{ctl:T 'Looks up your exact parts, drivers and games: known problems, fixes, safe temperatures'}" Style="{StaticResource Small}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18,0,14" />
                                        <TextBlock Text="{ctl:T 'ANSWERS BACK UP WHAT THEY SAY WITH'}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,10" />
                                        <TextBlock Text="{Binding Everything}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding HasEverything, Converter={StaticResource Vis}}" />
                                        <ItemsControl ItemsSource="{Binding Uses}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Width="20" Margin="0,3,0,0" VerticalAlignment="Top" Foreground="{DynamicResource MutedBrush}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding From}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ctl:SmoothBorder>
                                <!-- The badge sits on the card's top edge: the plan to pick, or the one you're on -->
                                <Border x:Name="Badge" CornerRadius="6" Padding="9,2" Margin="22,-10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                    <TextBlock x:Name="BadgeText" Text="{ctl:T 'Best value'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBest}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Get" Property="Style" Value="{StaticResource AccentButton}" />
                                    <Setter TargetName="Switch" Property="Style" Value="{StaticResource AccentButton}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                    <Setter TargetName="BadgeText" Property="Text" Value="{ctl:T 'Your plan'}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Every plan checks the web -->
                <ctl:SmoothBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{ctl:T 'Every plan checks the web'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{ctl:T 'Your records say what happened. The web says what it means for your exact parts. Answers show the pages they used.'}" Style="{StaticResource Small}" Margin="0,6,0,0" />
                        </StackPanel>
                        <UniformGrid Grid.Column="2" Rows="1">
                            <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T '“Is 88°C OK for my GPU?”'}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WebExampleHeat}" Style="{StaticResource Small}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ctl:SmoothBorder>
                            <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T '“Why does my game crash?”'}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{ctl:T 'Checks whether others hit the same crash with your driver, and what fixed it.'}" Style="{StaticResource Small}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ctl:SmoothBorder>
                            <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T '“Should I update my BIOS?”'}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{ctl:T 'Reads what the newer BIOS for your board fixes.'}" Style="{StaticResource Small}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ctl:SmoothBorder>
                        </UniformGrid>
                    </Grid>
                </ctl:SmoothBorder>

                <!-- Page by page, on request -->
                <Button Style="{StaticResource GhostButton}" Content="{Binding CompareText}" Command="{Binding CompareCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <ctl:SmoothBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Margin="0,14,0,0"
                                  Visibility="{Binding Comparing, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <Grid Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{ctl:T 'What answers can use, page by page'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Columns[0].Name}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Columns[1].Name}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Columns[2].Name}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CompareRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Page}" FontSize="13.5" />
                                                <TextBlock Text="{Binding What}" Style="{StaticResource Small}" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Free, Converter={StaticResource Vis}}" />
                                            <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Middle, Converter={StaticResource Vis}}" />
                                            <TextBlock Grid.Column="3" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Top, Converter={StaticResource Vis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- How paying works -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal" Margin="10,2">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{ctl:T 'Paid monthly, by card or PayPal'}" Style="{StaticResource Small}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,2">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{ctl:T 'Cancel any time in RigSight'}" Style="{StaticResource Small}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,2">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{ctl:T 'After cancelling, it works until the month you paid for ends'}" Style="{StaticResource Small}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,2">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{ctl:T 'Your chats stay on this PC whatever the plan'}" Style="{StaticResource Small}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
