<UserControl x:Class="Rigsight.Views.TemperaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <TextBlock Text="Temperatures" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource Muted}" Margin="0,4,0,20" />

            <!-- CPU + GPU -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource CpuSoftBrush}">
                                <TextBlock Text="CPU" Style="{StaticResource BadgeText}" Foreground="{DynamicResource CpuBrush}" />
                            </Border>
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource H2}" Margin="12,0,0,0" />
                        </DockPanel>

                        <!-- A standard account: the CPU's temperature, power and clock can't be read. Said once, at the card's
                             foot; the card itself shows what is read, its load and its threads. -->
                        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding StandardAccount, Converter={StaticResource Vis}}">
                            <!-- A DockPanel, so the sentence is held to the card's width and wraps on a narrow window (in a
                                 horizontal StackPanel it ran past the edge and was cut). -->
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,3,9,0" VerticalAlignment="Top" />
                                <TextBlock Text="Temperature, power and clock speed need admin rights on this PC." Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Visibility="{Binding StandardAccount, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding CpuThreads.Count, Converter={StaticResource Vis}}">
                            <TextBlock Text="LOAD PER THREAD" Style="{StaticResource Caption}" Margin="5,0,0,8" />
                            <ItemsControl ItemsSource="{Binding CpuThreads}" Margin="5,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="40" Margin="2,0" CornerRadius="4" Background="{DynamicResource Surface2Brush}" ToolTip="{Binding FormattedValue}">
                                            <Border VerticalAlignment="Bottom" CornerRadius="4" Background="{DynamicResource CpuBrush}"
                                                    Height="{Binding Value, Converter={StaticResource Scale}, ConverterParameter=0.4}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>

                        <Grid>
                        <!-- A standard account: the gauge is the load, and the threads take the place of the tiles that
                             would have nothing to show. -->
                        <ctl:SideOrStack Visibility="{Binding StandardAccount, Converter={StaticResource Vis}}">
                            <Grid Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ctl:ArcGauge Value="{Binding CpuLoad.Value}" Maximum="100" Thickness="13" Brush="{DynamicResource CpuBrush}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CpuLoad.Value, StringFormat='{}{0:0}%', FallbackValue='—', TargetNullValue='—'}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource CpuBrush}" />
                                    <TextBlock Text="LOAD" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CpuLoad.MinMaxText}" ToolTip="Lowest and highest today" FontSize="11" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="LOAD PER THREAD" Style="{StaticResource Caption}" Margin="4,0,0,10" />
                                <ItemsControl ItemsSource="{Binding CpuThreads}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="96" Margin="4" CornerRadius="5" Background="{DynamicResource Surface2Brush}" ToolTip="{Binding FormattedValue}">
                                                <Border VerticalAlignment="Bottom" CornerRadius="5" Background="{DynamicResource CpuBrush}"
                                                        Height="{Binding Value, Converter={StaticResource Scale}, ConverterParameter=0.96}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ctl:SideOrStack>

                        <!-- The gauge beside its tiles; above them where the card is too narrow for both (see SideOrStack). -->
                        <ctl:SideOrStack Visibility="{Binding StandardAccount, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <Grid Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ctl:ArcGauge Value="{Binding CpuTemp.Value}" Maximum="100" Thickness="13"
                                              Brush="{Binding CpuTemp.Value, Converter={StaticResource TempBrush}}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CpuTemp.ShortValue, FallbackValue='—'}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{Binding CpuTemp.Value, Converter={StaticResource TempBrush}}" />
                                    <TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CpuTemp.MinMaxText}" ToolTip="Lowest and highest today" FontSize="11" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2">
                                <ctl:MetricTile Label="LOAD" Sensor="{Binding CpuLoad}" Accent="{DynamicResource CpuBrush}" SparkMinimum="0" SparkMaximum="100" />
                                <ctl:MetricTile Label="POWER" Sensor="{Binding CpuPower}" Accent="{DynamicResource CpuBrush}" />
                                <ctl:MetricTile Label="AVERAGE CLOCK" Sensor="{Binding CpuClock}" Accent="{DynamicResource CpuBrush}" />
                                <ctl:MetricTile Label="CORE VOLTAGE" Sensor="{Binding CpuVoltage}" Accent="{DynamicResource CpuBrush}" />
                            </UniformGrid>
                        </ctl:SideOrStack>
                        </Grid>
                    </DockPanel>
                </ctl:SmoothBorder>

                <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <!-- Several GPUs (a processor's graphics and a card, or two cards): switch between them, at the row's right end. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,-6,0" VerticalAlignment="Center" ToolTip="{Binding GpuPositionText}"
                                        Visibility="{Binding HasSeveralGpus, Converter={StaticResource Vis}}">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding PreviousGpuCommand}" AutomationProperties.Name="Previous GPU">
                                    <TextBlock Text="&#xE76B;" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding NextGpuCommand}" AutomationProperties.Name="Next GPU">
                                    <TextBlock Text="&#xE76C;" />
                                </Button>
                            </StackPanel>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource GpuSoftBrush}">
                                <TextBlock Text="GPU" Style="{StaticResource BadgeText}" Foreground="{DynamicResource GpuBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedGpu.Name, FallbackValue=GPU}" Style="{StaticResource H2}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="5,14,5,0" Visibility="{Binding SelectedGpu.HasVram, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedGpu.VramText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="VIDEO MEMORY" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource Bar}" Height="8" Foreground="{DynamicResource GpuBrush}"
                                         Value="{Binding SelectedGpu.VramPercent, Mode=OneWay, FallbackValue=0}" />
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedGpu.Clock.FormattedValue, FallbackValue='—'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="CORE CLOCK" Style="{StaticResource Caption}" />
                            </DockPanel>
                        </StackPanel>

                        <!-- The gauge beside its tiles; above them where the card is too narrow for both (see SideOrStack). -->
                        <ctl:SideOrStack>
                            <Grid Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ctl:ArcGauge Value="{Binding SelectedGpu.Temp.Value}" Maximum="100" Thickness="13"
                                              Brush="{Binding SelectedGpu.Temp.Value, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedGpu.Temp.ShortValue, FallbackValue='—'}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{Binding SelectedGpu.Temp.Value, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                    <TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedGpu.Temp.MinMaxText}" ToolTip="Lowest and highest today" FontSize="11" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2">
                                <ctl:MetricTile Label="LOAD" Sensor="{Binding SelectedGpu.Load}" Accent="{DynamicResource GpuBrush}" SparkMinimum="0" SparkMaximum="100" />
                                <ctl:MetricTile Label="POWER" Sensor="{Binding SelectedGpu.Power}" Accent="{DynamicResource GpuBrush}" />
                                <ctl:MetricTile Label="HOT SPOT" Sensor="{Binding SelectedGpu.HotSpot}" Accent="{DynamicResource GpuBrush}"
                                                ValueBrush="{Binding SelectedGpu.HotSpot.Value, Converter={StaticResource TempBrush}, ConverterParameter='50,80,95'}" />
                                <ctl:MetricTile Label="MEMORY JUNCTION" Sensor="{Binding SelectedGpu.MemJunction}" Accent="{DynamicResource GpuBrush}"
                                                ValueBrush="{Binding SelectedGpu.MemJunction.Value, Converter={StaticResource TempBrush}, ConverterParameter='55,85,100'}" />
                            </UniformGrid>
                        </ctl:SideOrStack>
                    </DockPanel>
                </ctl:SmoothBorder>
            </Grid>

            <!-- History -->
            <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <!-- One row of controls at the right, as on every page: what the line is, then the period last. The
                             period's button opens the range menu (every range up to now, then Custom range…); the arrows
                             step back from today, the last 7 days, 30 days or 12 months by their own length. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- What the line is, from an hour up (under that every reading is drawn): a short spike is in a minute's
                             highest and hardly moves its average. -->
                        <!-- Hidden, not gone, on the 5 minute view: its place is kept, so the chart doesn't jump when it comes and goes. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanChartPlot}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding ChartPlotLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ChartPlot" Content="Average"
                                                 IsChecked="{Binding ChartPlot, Converter={StaticResource Equals}, ConverterParameter=Avg}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ChartPlot" Content="Highest"
                                                 IsChecked="{Binding ChartPlot, Converter={StaticResource Equals}, ConverterParameter=High}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ChartPlot" Content="Lowest"
                                                 IsChecked="{Binding ChartPlot, Converter={StaticResource Equals}, ConverterParameter=Low}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ctl:DatePager x:Name="ChartPager" Label="{Binding ChartDayLabel}" Date="{Binding ChartDay}" MinDate="{Binding ChartHistoryStart}"
                                       CanGoPrevious="{Binding CanChartPreviousDay}" CanGoNext="{Binding CanChartNextDay}"
                                       PreviousCommand="{Binding ChartPreviousDayCommand}" NextCommand="{Binding ChartNextDayCommand}"
                                       LabelText="Pick a range" />
                        <ctl:RangeEditor x:Name="ChartRangeEditor" />
                        <!-- The range menu: a line each, the one shown ticked. It floats over the card (nothing moves). -->
                        <Popup x:Name="RangeMenu" PlacementTarget="{Binding ElementName=ChartPager}" Placement="Custom" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade" Closed="RangeMenu_Closed">
                            <Border Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="6" MinWidth="210" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                                </Border.Effect>
                                <StackPanel Button.Click="RangeMenu_Click">
                                    <StackPanel.Resources>
                                        <!-- A line of the menu: a tick on the range shown, then its words. -->
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter Property="Command" Value="{Binding PickChartRangeCommand}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                            <DockPanel>
                                                                <TextBlock x:Name="Tick" DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12"
                                                                           Foreground="{DynamicResource AccentBrush}" Width="16" TextAlignment="Center" Visibility="Hidden" />
                                                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.FontSize="13"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                            <!-- The tick: Tag holds a true or false (a plain "True" here would be text, never equal to it). -->
                                                            <Trigger Property="Tag">
                                                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="MenuRule" TargetType="Border">
                                            <Setter Property="Height" Value="1" />
                                            <Setter Property="Margin" Value="4,5" />
                                            <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button Content="Last 5 minutes" CommandParameter="300"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=300}" />
                                    <Button Content="Last hour" CommandParameter="3600"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=3600}" />
                                    <Button Content="Last 6 hours" CommandParameter="21600"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=21600}" />
                                    <Button Content="Last 24 hours" CommandParameter="86400"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=86400}" />
                                    <Border Style="{StaticResource MenuRule}" />
                                    <Button Content="Today" CommandParameter="0"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=0}" />
                                    <Button Content="Last 7 days" CommandParameter="604800"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=604800}" />
                                    <Button Content="Last 30 days" CommandParameter="2592000"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=2592000}" />
                                    <Button Content="Last 12 months" CommandParameter="31536000"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=31536000}" />
                                    <Border Style="{StaticResource MenuRule}" />
                                    <Button Content="Custom range…" CommandParameter="-1"
                                            Tag="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=-1}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        </StackPanel>
                        <!-- Zoomed in (a drag across the graph): the stretch shown and the way back to the period picked. They
                             sit after the title, in the room before the pickers; the button keeps its place while hidden. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="History" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ZoomText, ElementName=HistoryChart}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="16,0,10,0" />
                            <Button Command="{Binding ResetZoomCommand, ElementName=HistoryChart}" AutomationProperties.Name="{Binding ResetText, ElementName=HistoryChart}"
                                    VerticalAlignment="Center" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsZoomed, ElementName=HistoryChart}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ResetText, ElementName=HistoryChart}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <!-- From an hour up the legend says of each line what the choice on the right makes the graph's points:
                         its average over the time shown, or its highest (lowest) in it and when, with that word in front.
                         On the five minutes there is no choice, and the legend only names the lines. -->
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ChartLegendLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding CanChartPlot, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding TempSeries}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Margin="8,0,6,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="Peak" Text="{Binding PeakText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />
                                    <TextBlock x:Name="When" Text="{Binding PeakWhen}" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource FaintBrush}" Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CanChartPlot, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter TargetName="Peak" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="When" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </DockPanel>
                    <ctl:LineChart x:Name="HistoryChart" ctl:Roomy.Height="230" Series="{Binding TempSeries}" Version="{Binding Tick}" WindowSeconds="{Binding ChartWindowSeconds}" Day="{Binding ChartDay}"
                                   CustomFrom="{Binding ChartCustomFrom}" CustomTo="{Binding ChartCustomTo}"
                                   Plot="{Binding ChartPlot}" GapReason="{Binding ChartGapReason}" CanZoom="True" />
                </DockPanel>
            </ctl:SmoothBorder>

            <!-- Drives, and the motherboard, right under the graph (fans have their own page): two cards side by side, one
                 above the other on a narrow window, and one across the row when only it has readings (see CardPair). -->
            <ctl:CardPair Margin="0,18,0,0" Visibility="{Binding HasPartTemps, Converter={StaticResource Vis}}">
                <!-- A row a drive, against its own limit: a drive at 45° may be fine or near its limit, and the bar says which. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Visibility="{Binding HasDriveTemps, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock DockPanel.Dock="Right" Text="Now, against each drive's limit" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Drives" Style="{StaticResource H2}" />
                        </DockPanel>
                        <!-- The card is as tall as the board's beside it: the rows share that height evenly, instead of
                             leaving an empty space under the last drive. -->
                        <ItemsControl ItemsSource="{Binding DriveTemps}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,10">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Sensor.ShortValue, FallbackValue='—'}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                        <Binding Path="Sensor.Value" />
                                                        <Binding Path="Steps" />
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <!-- The reading on a bar to a little past the limit, with a mark at the limit. -->
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,7">
                                                <ProgressBar Style="{StaticResource Bar}" Height="6" Maximum="{Binding Top}"
                                                             Value="{Binding Sensor.Value, Mode=OneWay, FallbackValue=0, TargetNullValue=0}">
                                                    <ProgressBar.Foreground>
                                                        <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                            <Binding Path="Sensor.Value" />
                                                            <Binding Path="Steps" />
                                                        </MultiBinding>
                                                    </ProgressBar.Foreground>
                                                </ProgressBar>
                                                <Grid IsHitTestVisible="False">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding LimitWidth}" />
                                                        <ColumnDefinition Width="{Binding AboveLimitWidth}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="1" HorizontalAlignment="Left" Width="2" Margin="-1,-3,0,-3" CornerRadius="1" Background="{DynamicResource MutedBrush}" />
                                                </Grid>
                                            </Grid>
                                            <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding LimitText}" ToolTip="{Binding LimitTip}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="12,0,0,0" />
                                                <TextBlock Text="{Binding Sensor.RangeText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- A line between drives: none above the first. -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </ctl:SmoothBorder>

                <!-- The board's sensors as tiles, grouped by the chip they're read from and named as All sensors names it:
                     two chips each have a "Temperature #1". Every tile shows (no box to scroll): a PC has a dozen at most. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Visibility="{Binding HasBoardTemps, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="Now, against today's range" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Motherboard" Style="{StaticResource H2}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding BoardChips}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Group" Margin="0,18,0,0">
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ChipCaps}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Board}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding HasBoard, Converter={StaticResource Vis}}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <!-- Narrower than the page's other tiles: three across in half the row. -->
                                                    <ctl:TileWrap MinTileWidth="150" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Tile}">
                                                        <StackPanel>
                                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Sensor.ShortValue, FallbackValue='—'}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0">
                                                                <TextBlock.Foreground>
                                                                    <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                                        <Binding Path="Sensor.Value" />
                                                                        <Binding Path="Steps" />
                                                                    </MultiBinding>
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                            <ProgressBar Style="{StaticResource Bar}" Height="4" Margin="0,7,0,5" Maximum="100" Value="{Binding Sensor.RangeShare, Mode=OneWay}">
                                                                <ProgressBar.Foreground>
                                                                    <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                                        <Binding Path="Sensor.Value" />
                                                                        <Binding Path="Steps" />
                                                                    </MultiBinding>
                                                                </ProgressBar.Foreground>
                                                            </ProgressBar>
                                                            <TextBlock Text="{Binding Sensor.RangeText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Group" Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>
            </ctl:CardPair>

            <!-- Neither has readings (the agent has no admin rights, or the PC gives none): one card across the row says so
                 instead of the cards going, which read as the drives' temperatures having been taken off the page. -->
            <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasPartTemps, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="Motherboard and drives" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <TextBlock Text="No motherboard or drive temperatures are being read right now. They need the background agent to run with admin rights."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,2" />
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- The week by hour, and each chip at rest over the last month. -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="Each box is an hour's average" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Warmest hours this week" Style="{StaticResource H2}" />
                        </DockPanel>
                        <ctl:HeatGrid Height="170" Hours="{Binding HeatWeek}" AutomationProperties.Name="The last seven days, hour by hour" />
                    </DockPanel>
                </ctl:SmoothBorder>
                <!-- Idle and settled: the same load every day, so what changes is the room and the cooling. One line a
                     chip: its figure, its usual, and its last month drawn beside them. -->
                <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="At rest, last 30 days" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Bottom" Text="Idle and settled. A flat line means the cooling is holding; a slow climb is dust or old paste. A warmer room raises these too."
                                   FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <ItemsControl ItemsSource="{Binding Rest}" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="Auto" MinWidth="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Part}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TodayText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Today, Converter={StaticResource TempBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding UsualText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <ctl:TrendLine Grid.Column="3" Height="34" Values="{Binding Days}" Tips="{Binding Tips}" Stroke="{Binding Brush, Converter={StaticResource ResourceBrush}}"
                                                       Visibility="{Binding HasLine, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </ctl:SmoothBorder>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>