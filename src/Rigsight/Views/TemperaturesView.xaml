<UserControl x:Class="Rigsight.Views.TemperaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <TextBlock Text="Temperatures" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource Muted}" Margin="0,4,0,20" />

            <!-- CPU + GPU -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource CpuSoftBrush}">
                                <TextBlock Text="CPU" Style="{StaticResource BadgeText}" Foreground="{DynamicResource CpuBrush}" />
                            </Border>
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource H2}" Margin="12,0,0,0" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="{Binding CpuThreads.Count, Converter={StaticResource Vis}}">
                            <TextBlock Text="LOAD PER THREAD" Style="{StaticResource Caption}" Margin="5,0,0,8" />
                            <ItemsControl ItemsSource="{Binding CpuThreads}" Margin="5,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="40" Margin="2,0" CornerRadius="4" Background="{DynamicResource Surface2Brush}" ToolTip="{Binding FormattedValue}">
                                            <Border VerticalAlignment="Bottom" CornerRadius="4" Background="{DynamicResource CpuBrush}"
                                                    Height="{Binding Value, Converter={StaticResource Scale}, ConverterParameter=0.4}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- The gauge beside its tiles; above them where the card is too narrow for both (see SideOrStack). -->
                        <ctl:SideOrStack>
                            <Grid Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ctl:ArcGauge Value="{Binding CpuTemp.Value}" Maximum="100" Thickness="13"
                                              Brush="{Binding CpuTemp.Value, Converter={StaticResource TempBrush}}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CpuTemp.ShortValue, FallbackValue='—'}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{Binding CpuTemp.Value, Converter={StaticResource TempBrush}}" />
                                    <TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CpuTemp.MinMaxText}" ToolTip="Lowest and highest today" FontSize="11" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2">
                                <ctl:MetricTile Label="LOAD" Sensor="{Binding CpuLoad}" Accent="{DynamicResource CpuBrush}" SparkMinimum="0" SparkMaximum="100" />
                                <ctl:MetricTile Label="POWER" Sensor="{Binding CpuPower}" Accent="{DynamicResource CpuBrush}" />
                                <ctl:MetricTile Label="AVG CLOCK" Sensor="{Binding CpuClock}" Accent="{DynamicResource CpuBrush}" />
                                <ctl:MetricTile Label="CORE VOLTAGE" Sensor="{Binding CpuVoltage}" Accent="{DynamicResource CpuBrush}" />
                            </UniformGrid>
                        </ctl:SideOrStack>
                    </DockPanel>
                </ctl:SmoothBorder>

                <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <!-- Several GPUs (a processor's graphics and a card, or two cards): switch between them, at the row's right end. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,-6,0" VerticalAlignment="Center" ToolTip="{Binding GpuPositionText}"
                                        Visibility="{Binding HasSeveralGpus, Converter={StaticResource Vis}}">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding PreviousGpuCommand}" AutomationProperties.Name="Previous GPU">
                                    <TextBlock Text="&#xE76B;" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding NextGpuCommand}" AutomationProperties.Name="Next GPU">
                                    <TextBlock Text="&#xE76C;" />
                                </Button>
                            </StackPanel>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource GpuSoftBrush}">
                                <TextBlock Text="GPU" Style="{StaticResource BadgeText}" Foreground="{DynamicResource GpuBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedGpu.Name, FallbackValue=GPU}" Style="{StaticResource H2}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="5,14,5,0" Visibility="{Binding SelectedGpu.HasVram, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedGpu.VramText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="VIDEO MEMORY" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource Bar}" Height="8" Foreground="{DynamicResource GpuBrush}"
                                         Value="{Binding SelectedGpu.VramPercent, Mode=OneWay, FallbackValue=0}" />
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedGpu.Clock.FormattedValue, FallbackValue='—'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="CORE CLOCK" Style="{StaticResource Caption}" />
                            </DockPanel>
                        </StackPanel>

                        <!-- The gauge beside its tiles; above them where the card is too narrow for both (see SideOrStack). -->
                        <ctl:SideOrStack>
                            <Grid Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ctl:ArcGauge Value="{Binding SelectedGpu.Temp.Value}" Maximum="100" Thickness="13"
                                              Brush="{Binding SelectedGpu.Temp.Value, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedGpu.Temp.ShortValue, FallbackValue='—'}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{Binding SelectedGpu.Temp.Value, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                    <TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedGpu.Temp.MinMaxText}" ToolTip="Lowest and highest today" FontSize="11" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2">
                                <ctl:MetricTile Label="LOAD" Sensor="{Binding SelectedGpu.Load}" Accent="{DynamicResource GpuBrush}" SparkMinimum="0" SparkMaximum="100" />
                                <ctl:MetricTile Label="POWER" Sensor="{Binding SelectedGpu.Power}" Accent="{DynamicResource GpuBrush}" />
                                <ctl:MetricTile Label="HOT SPOT" Sensor="{Binding SelectedGpu.HotSpot}" Accent="{DynamicResource GpuBrush}"
                                                ValueBrush="{Binding SelectedGpu.HotSpot.Value, Converter={StaticResource TempBrush}, ConverterParameter='50,80,95'}" />
                                <ctl:MetricTile Label="MEMORY JUNCTION" Sensor="{Binding SelectedGpu.MemJunction}" Accent="{DynamicResource GpuBrush}"
                                                ValueBrush="{Binding SelectedGpu.MemJunction.Value, Converter={StaticResource TempBrush}, ConverterParameter='55,85,100'}" />
                            </UniformGrid>
                        </ctl:SideOrStack>
                    </DockPanel>
                </ctl:SmoothBorder>
            </Grid>

            <!-- History -->
            <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <!-- The day (week, month) picker sits left of the ranges, so picking one doesn't move them. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ctl:DatePager Margin="0,0,10,0" Label="{Binding ChartDayLabel}" Date="{Binding ChartDay}" MinDate="{Binding ChartHistoryStart}"
                                       CanGoPrevious="{Binding CanChartPreviousDay}" CanGoNext="{Binding CanChartNextDay}"
                                       PreviousCommand="{Binding ChartPreviousDayCommand}" NextCommand="{Binding ChartNextDayCommand}"
                                       PickMonth="{Binding IsChartMonth}" PickYear="{Binding IsChartYear}"
                                       Visibility="{Binding IsChartPaged, Converter={StaticResource Vis}}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="5 min"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=300}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="1 hour"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=3600}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="6 hours"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=21600}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="24 hours"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=86400}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="Day" ToolTip="One day: today, yesterday or any earlier date"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=0}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="Week" ToolTip="One week, hour by hour: this week or any earlier one"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=604800}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="Month" ToolTip="One month, hour by hour: this month or any earlier one"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=2592000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartWindow" Content="Year" ToolTip="One year, day by day: this year or any earlier one"
                                             IsChecked="{Binding ChartWindowSeconds, Converter={StaticResource Equals}, ConverterParameter=31536000}" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <TextBlock Text="History" Style="{StaticResource H2}" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <!-- What the line is, from an hour up (under that every reading is drawn): a short spike is in a minute's
                         highest and hardly moves its average. -->
                    <!-- Hidden, not gone, on the 5 minute view: its place is kept, so the chart doesn't jump when it comes and goes. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanChartPlot}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ChartPlotLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartPlot" Content="Average"
                                             IsChecked="{Binding ChartPlot, Converter={StaticResource Equals}, ConverterParameter=Avg}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartPlot" Content="Highest"
                                             IsChecked="{Binding ChartPlot, Converter={StaticResource Equals}, ConverterParameter=High}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChartPlot" Content="Lowest"
                                             IsChecked="{Binding ChartPlot, Converter={StaticResource Equals}, ConverterParameter=Low}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- From an hour up the legend says of each line what the choice on the right makes the graph's points:
                         its average over the time shown, or its highest (lowest) in it and when, with that word in front.
                         On the five minutes there is no choice, and the legend only names the lines. -->
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ChartLegendLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding CanChartPlot, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding TempSeries}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Margin="8,0,6,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="Peak" Text="{Binding PeakText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />
                                    <TextBlock x:Name="When" Text="{Binding PeakWhen}" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource FaintBrush}" Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CanChartPlot, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter TargetName="Peak" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="When" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </DockPanel>
                    <ctl:LineChart ctl:Roomy.Height="230" Series="{Binding TempSeries}" Version="{Binding Tick}" WindowSeconds="{Binding ChartWindowSeconds}" Day="{Binding ChartDay}"
                                   Plot="{Binding ChartPlot}" GapReason="{Binding ChartGapReason}" />
                </DockPanel>
            </ctl:SmoothBorder>

            <!-- Motherboard and drives, right under the graph (fans have their own page): a tile each, as many across as fit, the rest on more
                 rows; past three rows the box scrolls. -->
            <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,18,12,16">
                <StackPanel>
                    <DockPanel Margin="0,0,8,12">
                        <TextBlock DockPanel.Dock="Right" Text="Now, against today's range" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Motherboard and drives" Style="{StaticResource H2}" />
                    </DockPanel>
                    <!-- None to show (the agent has no admin rights, or the PC gives none): the card says so instead of going,
                         which read as the drives' temperatures having been taken off the page. -->
                    <TextBlock Text="No motherboard or drive temperatures are being read right now. They need the background agent to run with admin rights."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,8,2"
                               Visibility="{Binding HasPartTemps, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    <ScrollViewer Style="{StaticResource CardScroll}" Padding="0" VerticalScrollBarVisibility="Auto" MaxHeight="286"
                                  Visibility="{Binding HasPartTemps, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding PartTemps}" Focusable="False" Margin="0,0,8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:TileWrap />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel>
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Sensor.ShortValue, FallbackValue='—'}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0">
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                        <Binding Path="Sensor.Value" />
                                                        <Binding Path="Steps" />
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <ProgressBar Style="{StaticResource Bar}" Height="4" Margin="0,7,0,5" Maximum="100" Value="{Binding Sensor.RangeShare, Mode=OneWay}">
                                                <ProgressBar.Foreground>
                                                    <MultiBinding Converter="{StaticResource ScaledTempBrush}">
                                                        <Binding Path="Sensor.Value" />
                                                        <Binding Path="Steps" />
                                                    </MultiBinding>
                                                </ProgressBar.Foreground>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding Sensor.RangeText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="SSDs are happiest below about 60°C, hard drives below 50°C. A sensor can be renamed on the All sensors page."
                               FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,10,8,0"
                               Visibility="{Binding HasPartTemps, Converter={StaticResource Vis}}" />
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- The week by hour, and each chip at rest over the last month. -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="Each box is an hour's average" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Warmest hours this week" Style="{StaticResource H2}" />
                        </DockPanel>
                        <ctl:HeatGrid Height="170" Hours="{Binding HeatWeek}" AutomationProperties.Name="The last seven days, hour by hour" />
                    </DockPanel>
                </ctl:SmoothBorder>
                <!-- Idle and settled: the same load every day, so what changes is the room and the cooling. One line a
                     chip: its figure, its usual, and its last month drawn beside them. -->
                <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="At rest, last 30 days" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Bottom" Text="Idle and settled. A flat line means the cooling is holding; a slow climb is dust or old paste. A warmer room raises these too."
                                   FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <ItemsControl ItemsSource="{Binding Rest}" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="Auto" MinWidth="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Part}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TodayText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Today, Converter={StaticResource TempBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding UsualText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <ctl:TrendLine Grid.Column="3" Height="34" Values="{Binding Days}" Tips="{Binding Tips}" Stroke="{Binding Brush, Converter={StaticResource ResourceBrush}}"
                                                       Visibility="{Binding HasLine, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </ctl:SmoothBorder>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>