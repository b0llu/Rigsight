<UserControl x:Class="Rigsight.Views.UsualBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <!-- A line: a row (name, usual or what it has so far, an arrow when its page shows more), a need line over grey
             rows, or a sentence. One template, the parts shown by what the line is. -->
        <DataTemplate x:Key="Line">
            <Grid>
                <!-- The need line: what each grey row under it needs. -->
                <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Detail}"
                           TextWrapping="Wrap" Margin="0,10,0,2" Visibility="{Binding IsNeed, Converter={StaticResource Vis}}" />
                <!-- A sentence. -->
                <StackPanel Visibility="{Binding IsNote, Converter={StaticResource Vis}}" Margin="0,6,0,2">
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Body}" TextWrapping="Wrap"
                               ToolTip="{Binding Tip}" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,2" Content="{ctl:T 'Restart with admin'}"
                            Command="{Binding DataContext.RestartAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding NeedsAdmin, Converter={StaticResource Vis}}" />
                </StackPanel>
                <!-- A row. -->
                <Button Style="{StaticResource FlatRowButton}" Margin="-8,0" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Text}"
                        ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding IsRow, Converter={StaticResource Vis}}"
                        Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <DockPanel Margin="8,5">
                        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource FaintBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" Width="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" VerticalAlignment="Top" Margin="14,0,0,0" Typography.NumeralAlignment="Tabular">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dim}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dim}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,2" Content="{ctl:T 'Restart with admin'}"
                                    Command="{Binding DataContext.RestartAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Your usual: a panel at the right over the page, which stays readable behind a light dim (the user, 2026-11-20:
         the box in the middle with tiles and an icon on every row felt heavy). Fades in, no slide. -->
    <Border x:Name="Panel" Width="480" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" AutomationProperties.Name="{ctl:T 'Your usual'}">
        <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="22,20,16,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" VerticalAlignment="Top"
                            ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="{ctl:T 'Close Your usual'}">
                        <TextBlock Text="&#xE8BB;" FontSize="{x:Static ctl:IconSize.S11}" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Your usual'}" FontSize="{x:Static ctl:TextSize.DialogTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Since}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" Margin="0,1,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Facts, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ctl:Spinner DockPanel.Dock="Top" Late="True" Width="20" Height="20" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,40"
                         Visibility="{Binding Loading, Converter={StaticResource Vis}}" />

            <!-- The rows' hover shade reaches 8 px past their text on each side: that room is inside the scroll area (its
                 padding is 8 px less, the list 8 px in), or the area would clip the shade at its edge. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="14,0,14,22">
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" Margin="8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- A thin line between parts, so each reads as its own (the user, 2026-11-20). -->
                            <Border BorderBrush="{DynamicResource StrokeBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0,1,0,0" />
                                        <Setter Property="Margin" Value="0,18,0,0" />
                                        <Setter Property="Padding" Value="0,16,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding First}" Value="True">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Margin" Value="0,14,0,0" />
                                                <Setter Property="Padding" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S13}" VerticalAlignment="Center"
                                                   Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource Line}" Focusable="False" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
