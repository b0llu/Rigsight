<UserControl x:Class="Rigsight.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <!-- The box over an app's bar, in the look of the charts' hover boxes: what the bar and its mark stand for. -->
        <Style x:Key="BarTip" TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="14,10,14,11" MinWidth="176">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,7" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MemText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="18,0,0,0" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource PurpleBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Now" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0" Visibility="{Binding HasUsual, Converter={StaticResource Vis}}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsualText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="18,0,0,0" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Usually" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" />
                                </DockPanel>
                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,7,0,0"
                                        Visibility="{Binding IsOver, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding OverText}" FontSize="12.5" Foreground="{DynamicResource WarmBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The mark on an app's bar at its usual: a bar of its own over the first, of which only the end shows. -->
        <Style x:Key="UsualMark" TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Width="2" CornerRadius="1" HorizontalAlignment="Right" Background="{DynamicResource MutedBrush}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- The live list takes what the window has left under the cards above it, but never less than its MinHeight (it
         was down to a few rows on a small window): then the page scrolls. Its height is set in the code-behind, from
         the height given here: with none to start from, the list was first laid out with every app's row at once
         (the page's first opening took three times the processor time). -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="Layout" Margin="32,26,32,24" MaxWidth="{StaticResource PageWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Memory" Style="{StaticResource H1}" />
            <TextBlock Text="What's using your RAM right now, and which apps used the most today." Style="{StaticResource Muted}" Margin="0,4,0,18" />
        </StackPanel>

        <!-- Overview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Laid out like the CPU and GPU cards on the Temperatures page. -->
            <ctl:SmoothBorder Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource PurpleSoftBrush}">
                            <TextBlock Text="RAM" Style="{StaticResource BadgeText}" Foreground="{DynamicResource PurpleBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Live.RamTotalText, StringFormat='{}{0} of memory'}" Style="{StaticResource H2}" Margin="12,0,0,0" />
                    </DockPanel>

                    <!-- How it's split: apps, compressed, free. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="5,14,5,0">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Live.RamText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="BREAKDOWN" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="{DynamicResource Surface2Brush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Live.MemAppsWidth}" />
                                    <ColumnDefinition Width="{Binding Live.MemCompressedWidth}" />
                                    <ColumnDefinition Width="{Binding Live.MemFreeWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource PurpleBrush}" CornerRadius="4,0,0,4" />
                                <Border Grid.Column="1" Background="{DynamicResource PurpleBrush}" Opacity="0.45" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PurpleBrush}" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="6,0,16,0">
                                <Run Text="Apps" /> <Run Text="{Binding Live.MemAppsText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                            </TextBlock>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PurpleBrush}" Opacity="0.45" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="6,0,16,0"
                                       ToolTip="Memory apps aren't using right now, squeezed by Windows so more fits in your RAM. Task Manager calls it Memory Compression.">
                                <Run Text="Compressed" /> <Run Text="{Binding Live.Compressed.FormattedValue, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                            </TextBlock>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0">
                                <Run Text="Free" /> <Run Text="{Binding Live.RamAvailable.FormattedValue, Mode=OneWay, FallbackValue='—'}" Foreground="{DynamicResource TextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- The gauge beside its tiles; above them where the card is too narrow for both (see SideOrStack). -->
                    <ctl:SideOrStack>
                        <Grid Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Coloured by how full the memory is, on the steps the sidebar's figure uses: amber from 75%, red from 90%. -->
                            <ctl:ArcGauge Value="{Binding Live.RamLoad.Value}" Maximum="100" Thickness="13"
                                          Brush="{Binding Live.RamLoad.Value, Converter={StaticResource TempBrush}, ConverterParameter='0,75,90'}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Live.RamLoad.ShortValue, FallbackValue='—'}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{Binding Live.RamLoad.Value, Converter={StaticResource TempBrush}, ConverterParameter='0,75,90'}" />
                                <TextBlock Text="IN USE" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Live.RamLoad.MinMaxText}" ToolTip="Lowest and highest today" FontSize="11" Foreground="{DynamicResource FaintBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="2">
                            <ctl:MetricTile Label="IN USE" Sensor="{Binding Live.RamUsed}" Accent="{DynamicResource PurpleBrush}" />
                            <ctl:MetricTile Label="FREE" Sensor="{Binding Live.RamAvailable}" Accent="{DynamicResource PurpleBrush}" />
                            <ctl:MetricTile Label="COMPRESSED" Sensor="{Binding Live.Compressed}" Accent="{DynamicResource PurpleBrush}"
                                            ToolTip="Memory apps aren't using right now, squeezed by Windows so more fits in your RAM. Task Manager calls it Memory Compression." />
                            <ctl:MetricTile Label="VIRTUAL MEMORY" Sensor="{Binding Live.VirtualLoad}" Accent="{DynamicResource PurpleBrush}" SparkMinimum="0" SparkMaximum="100"
                                            ToolTip="How much of Windows' memory limit (your RAM plus the page file) is promised to apps." />
                        </UniformGrid>
                    </ctl:SideOrStack>
                </DockPanel>
            </ctl:SmoothBorder>
            <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Today's biggest memory users" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <!-- Rows share the peak/avg column widths, so every bar starts and ends at the same place. -->
                    <ItemsControl ItemsSource="{Binding TodayTop}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <!-- The name gives way (cut with a tooltip); the peak and average always show in full. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="3*" MinWidth="60" />
                                        <ColumnDefinition Width="2*" MinWidth="40" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Peak" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Avg" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="20" Height="20" HorizontalAlignment="Left" />
                                    <TextBlock ctl:TrimmedText.ToolTip="True" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="2" Style="{StaticResource Bar}" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource PurpleBrush}"
                                                 Maximum="{Binding DataContext.TodayMemoryMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{Binding MemMax, Mode=OneWay, TargetNullValue=0}" />
                                    <!-- Each phrase starts at the same place in every row ("peak 5.8 GB", "peak 886 MB"). -->
                                    <TextBlock Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center">
                                        <Run Text="peak" /> <Run Text="{Binding MemMax, Converter={StaticResource Megabytes}, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Run Text="avg" /> <Run Text="{Binding MemAvg, Converter={StaticResource Megabytes}, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Collecting data — check back in a few minutes." Style="{StaticResource Muted}"
                               Visibility="{Binding ShowCollecting, Converter={StaticResource Vis}}" />
                    <ctl:Spinner Late="True" Width="22" Height="22" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,110,0,0"
                                 Visibility="{Binding Ready, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                </StackPanel>
            </ctl:SmoothBorder>
        </Grid>

        <!-- Worth a look: what stands out about the apps' memory right now. Left out, gap and all, with nothing to say.
             As many cards side by side as the page has room for (set in the code-behind); each has its own gap on the
             right, which the row gives back at its end. -->
        <ItemsControl x:Name="NotesRow" Grid.Row="2" ItemsSource="{Binding Notes}" Margin="0,0,-18,0" Focusable="False"
                      Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" VerticalAlignment="Top" Loaded="NotesPanel_Loaded" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ctl:SmoothBorder Style="{StaticResource Card}" Padding="18,14,18,15" Margin="0,18,18,0">
                        <StackPanel>
                            <TextBlock x:Name="Kind" Text="{Binding Caption}" Style="{StaticResource Caption}" />
                            <!-- What it is about comes first: led by the figure, a card read as being about all the memory. -->
                            <DockPanel Margin="0,7,0,6">
                                <TextBlock x:Name="Figure" DockPanel.Dock="Right" Text="{Binding Figure}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Style="{StaticResource AppIcon}" Width="22" Height="22" Margin="0,0,10,0"
                                       Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" />
                                <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ctl:SmoothBorder>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsWarm}" Value="True">
                            <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                            <Setter TargetName="Figure" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Live list -->
        <ctl:SmoothBorder Grid.Row="3" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,16,12,12" x:Name="LiveCard" MinHeight="440" Height="440">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Only apps with windows" FontSize="12.5"
                              IsChecked="{Binding Live.OnlyWindowedApps}" />
                    <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Tag="Search apps…" Width="220" Margin="0,-4,18,-4" VerticalAlignment="Center"
                             AutomationProperties.Name="Search the apps using memory" ctl:Debounce.Text="{Binding Live.ProcSearch}" />
                    <TextBlock Text="Using memory right now" Style="{StaticResource H2}" />
                </DockPanel>
                <!-- Its right edge is set in the code-behind, to where the rows' figures end: the list's scrollbar takes room from
                     the rows that a fixed margin here could only guess at (the heading sat to the right of its figures). The
                     columns are the rows' own, so each heading ends where its figures do. -->
                <Grid x:Name="LiveHead" DockPanel.Dock="Top" Margin="0,0,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="APP" Style="{StaticResource Caption}" Margin="62,0,0,0" />
                    <TextBlock Grid.Column="2" Text="NOW" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="USUAL" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="Nothing running matches" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,28,0,0"
                           Visibility="{Binding Live.NoProcsMatch, Converter={StaticResource Vis}}" />
                <!-- An app with more than one process opens (click) to list each of them underneath. -->
                <Grid>
                <!-- The list arrives from the agent a moment after the window opens: the box says it's on its way. -->
                <ctl:Spinner Late="True" Width="22" Height="22" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,40"
                             Visibility="{Binding Live.AppsPending, Converter={StaticResource Vis}}" />
                <ListBox x:Name="LiveList" Style="{StaticResource PlainList}" ItemsSource="{Binding Live.ProcsView}" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,8,0">
                                <Grid Background="Transparent" MouseLeftButtonUp="App_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <Grid Width="20" VerticalAlignment="Center">
                                            <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden" />
                                            <!-- Turns while the processes are on their way -->
                                            <Path x:Name="Spinner" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                                  Data="M 5,0.75 A 4.25,4.25 0 1 1 0.75,5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <Image Source="{Binding Icon}" Style="{StaticResource AppIcon}" Width="22" Height="22" />
                                        <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" />
                                            <TextBlock x:Name="Sub" Text="{Binding SubText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- The bar is thin: the whole height of the row over it brings up its box. -->
                                    <Grid Grid.Column="1" Margin="8,0" Background="Transparent" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                        <Grid.ToolTip>
                                            <ToolTip Style="{StaticResource BarTip}" />
                                        </Grid.ToolTip>
                                        <ProgressBar Style="{StaticResource Bar}" VerticalAlignment="Center" Maximum="100"
                                                     Value="{Binding Bar, Mode=OneWay}" Foreground="{DynamicResource PurpleBrush}" />
                                        <ProgressBar Style="{StaticResource UsualMark}" VerticalAlignment="Center" Value="{Binding Mark, Mode=OneWay}"
                                                     Visibility="{Binding HasUsual, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <TextBlock x:Name="Now" Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding UsualText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Children}" Margin="0,6,0,0" Visibility="{Binding ShowChildren, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Spans the bar's column too: window titles can be long. -->
                                                <TextBlock Grid.ColumnSpan="2" Margin="54,0,16,0" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}">
                                                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding PidText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource FaintBrush}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <!-- Amber says how the reading is doing: well above the app's usual, or growing hour after hour. -->
                                <DataTrigger Binding="{Binding IsOver}" Value="True">
                                    <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGrowing}" Value="True">
                                    <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanExpand}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Spin">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Spin" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </DockPanel>
        </ctl:SmoothBorder>
    </Grid>
    </ScrollViewer>
</UserControl>
