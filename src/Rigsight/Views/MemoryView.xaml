<UserControl x:Class="Rigsight.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Memory" Style="{StaticResource H1}" />
            <TextBlock Text="What's using your RAM right now, and which apps used the most today." Style="{StaticResource Muted}" Margin="0,4,0,18" />
        </StackPanel>

        <!-- Overview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ctl:SmoothBorder Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="160" Height="160" VerticalAlignment="Center">
                        <ctl:ArcGauge Value="{Binding Live.RamLoad.Value}" Maximum="100" Thickness="12" Brush="{DynamicResource PurpleBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Live.RamLoad.ShortValue, FallbackValue='—'}" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="IN USE" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <!-- The card is as tall as today's list beside it: the chart takes the height that's left. -->
                    <DockPanel Grid.Column="1" Margin="22,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="System memory" Style="{StaticResource H2}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Live.RamText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}">
                            <Run Text="Available:" /> <Run Text="{Binding Live.RamAvailable.FormattedValue, Mode=OneWay, FallbackValue='—'}" Foreground="{DynamicResource TextBrush}" />
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}"
                                   ToolTip="Memory apps aren't using right now, squeezed by Windows so more fits in your RAM. Shown as Memory Compression in Task Manager.">
                            <Run Text="Compressed:" /> <Run Text="{Binding Live.CompressedText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Bottom" Text="LAST 10 MINUTES" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <ctl:Sparkline MinHeight="44" Margin="0,14,0,0" Source="{Binding Live.RamLoad.History}" Version="{Binding Live.RamLoad.Version}"
                                       Stroke="{DynamicResource PurpleBrush}" Minimum="0" Maximum="100" WindowSeconds="600" />
                    </DockPanel>
                </Grid>
            </ctl:SmoothBorder>
            <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Today's biggest memory users" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <!-- Rows share the peak/avg column widths, so every bar starts and ends at the same place. -->
                    <ItemsControl ItemsSource="{Binding TodayTop}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <!-- The name gives way (cut with a tooltip); the peak and average always show in full. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="3*" MinWidth="60" />
                                        <ColumnDefinition Width="2*" MinWidth="40" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Peak" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Avg" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="20" Height="20" HorizontalAlignment="Left" />
                                    <TextBlock ctl:TrimmedText.ToolTip="True" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="2" Style="{StaticResource Bar}" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource PurpleBrush}"
                                                 Maximum="{Binding DataContext.TodayMemoryMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{Binding MemMax, Mode=OneWay, TargetNullValue=0}" />
                                    <!-- Each phrase starts at the same place in every row ("peak 5.8 GB", "peak 886 MB"). -->
                                    <TextBlock Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center">
                                        <Run Text="peak" /> <Run Text="{Binding MemMax, Converter={StaticResource Megabytes}, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Run Text="avg" /> <Run Text="{Binding MemAvg, Converter={StaticResource Megabytes}, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Collecting data — check back in a few minutes." Style="{StaticResource Muted}"
                               Visibility="{Binding TodayTop.Count, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                </StackPanel>
            </ctl:SmoothBorder>
        </Grid>

        <!-- Live list -->
        <ctl:SmoothBorder Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,16,12,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Only apps with windows" FontSize="12.5"
                              IsChecked="{Binding Live.OnlyWindowedApps}" />
                    <TextBlock Text="Using memory right now" Style="{StaticResource H2}" />
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="APP" Style="{StaticResource Caption}" Margin="62,0,0,0" />
                    <TextBlock Grid.Column="2" Text="MEMORY" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="CPU" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <!-- An app with more than one process opens (click) to list each of them underneath. -->
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Live.ProcsView}" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,8,0">
                                <Grid Background="Transparent" MouseLeftButtonUp="App_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Width="20" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" Visibility="Hidden" />
                                        <Image Source="{Binding Icon}" Style="{StaticResource AppIcon}" Width="22" Height="22" />
                                        <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" VerticalAlignment="Center" Margin="8,0" Maximum="100"
                                                 Value="{Binding MemShare, Mode=OneWay}" Foreground="{DynamicResource PurpleBrush}"
                                                 ToolTip="{Binding MemShareText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding CpuText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl x:Name="Children" ItemsSource="{Binding Children}" Margin="0,6,0,0" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Spans the bar's column too: window titles can be long. -->
                                                <TextBlock Grid.ColumnSpan="2" Margin="54,0,16,0" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}">
                                                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding PidText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource FaintBrush}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding CpuText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CanExpand}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                    <Setter TargetName="Children" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ctl:SmoothBorder>
    </Grid>
</UserControl>
