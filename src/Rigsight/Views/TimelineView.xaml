<UserControl x:Class="Rigsight.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Rigsight.Views"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             x:Name="Page">
    <UserControl.Resources>
        <Style x:Key="PanelHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A day or a month in the calendar: lit when something happened in it. -->
        <Style x:Key="CalendarCell" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" />
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAny}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAny}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One line under a day. Most are a plain change (kept light: a long list builds hundreds of them); a problem has
             its way to the Crashes page; a change with more to it shows what was different after, or the updates folded into it. -->
        <DataTemplate x:Key="PlainEntry">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="Line" Grid.Column="2" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKey}" Value="True">
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A game's update: its line, and the way to the game (its plays before and since). -->
        <DataTemplate x:Key="GameEntry">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="2" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" /><Run Text="   " /><Hyperlink Focusable="False" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                        Command="{Binding DataContext.OpenGameCommand, ElementName=Page}" CommandParameter="{Binding}"><Run Text="{ctl:T 'Open game'}" /></Hyperlink>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProblemEntry">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{Binding IconBrush, Converter={StaticResource ResourceBrush}}" />
                <TextBlock Grid.Column="2" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}">
                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Hyperlink Focusable="False" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"
                        Command="{Binding DataContext.OpenCrashesCommand, ElementName=Page}" CommandParameter="{Binding}"><Run Text="{Binding OpenText, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RichEntry">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="Line" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <Button Style="{StaticResource ActionButton}" Content="{Binding ToggleText}" HorizontalAlignment="Left" Margin="-9,2,0,0"
                            Command="{Binding DataContext.ToggleVersionsCommand, ElementName=Page}" CommandParameter="{Binding}"
                            Visibility="{Binding HasChildren, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Children}" Margin="0,2,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2">
                                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKey}" Value="True">
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A big change that made something better or worse: its line, and under it a card with what, how sure, the
             readings before and since, and the way into the whole of it. Only such a change has one; every other line
             stays as it was. -->
        <DataTemplate x:Key="ResultEntry">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12"
                            Padding="16,14" Margin="0,8,0,4" AutomationProperties.Name="{Binding Result.Headline}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" VerticalAlignment="Top" Margin="0,0,12,0"
                                        Background="{Binding ResultBrush, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding ResultIcon}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding ResultBrush, Converter={StaticResource ResourceBrush}}" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Top" Margin="12,1,0,0"
                                        Background="{Binding ResultSure, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding Result.Chip}" FontSize="10" FontWeight="Bold" Foreground="{Binding ResultSure, Converter={StaticResource SureBrush}}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Result.Headline}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Result.Context}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ResultPairs}" Margin="42,10,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12.5" Margin="0,0,28,4" Foreground="{DynamicResource MutedBrush}">
                                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Before, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run
                                                Text="  →  " Foreground="{DynamicResource FaintBrush}" /><Run Text="{Binding After, Mode=OneWay}" FontWeight="SemiBold"
                                                Foreground="{Binding AfterBrush, Converter={StaticResource ResourceBrush}}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="42,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Open'}" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenResultCommand, ElementName=Page}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{ctl:T 'Open this change\'s before and after'}" />
                                <TextBlock Text="{Binding Result.Why}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <views:TimelineEntryTemplates x:Key="EntryTemplates" Plain="{StaticResource PlainEntry}" Problem="{StaticResource ProblemEntry}" Rich="{StaticResource RichEntry}"
                                      Result="{StaticResource ResultEntry}" Game="{StaticResource GameEntry}" />

        <!-- A day: its dot on the line that runs down the list, its name, and its lines. -->
        <DataTemplate x:Key="DayTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Month}" Style="{StaticResource PanelHead}" Margin="34,6,0,10"
                           Visibility="{Binding Month, Converter={StaticResource Vis}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="1" HorizontalAlignment="Left" Margin="6,18,0,-2" Background="{DynamicResource StrokeBrush}" />
                    <Ellipse Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"
                             Fill="{Binding NodeBrush, Converter={StaticResource ResourceBrush}}" />
                    <StackPanel Grid.Column="1" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding SubTitle}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,1" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}" ItemTemplateSelector="{StaticResource EntryTemplates}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="32,26,32,0" MaxWidth="{StaticResource PageWidth}" Visibility="{Binding IsChangeOpen, Converter={StaticResource Vis}, ConverterParameter=Invert}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <!-- How many, since when: at the title's right. At the end of the row below it slid under the search box on a small window. -->
            <Button Style="{StaticResource PageExportButton}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource FaintBrush}" FontSize="12.5" VerticalAlignment="Bottom" Margin="16,0,0,1" />
            <StackPanel>
                <TextBlock Text="{ctl:T 'Timeline'}" Style="{StaticResource H1}" />
                <TextBlock Text="{ctl:T 'What was installed, updated, removed or switched on this PC, day by day.'}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- What to show -->
        <DockPanel Grid.Row="1" Margin="0,16,0,0" Height="36">
            <!-- The PC is looked over every ten minutes; this looks now. It turns while that's going on. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                    Command="{Binding RefreshCommand}" ToolTip="{ctl:T 'Look for new changes now'}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="12" Margin="0,0,8,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center"
                                   Visibility="{Binding IsRefreshing, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <ctl:Spinner Visibility="{Binding IsRefreshing, Converter={StaticResource Vis}}" />
                    </Grid>
                    <TextBlock Text="{ctl:T 'Refresh'}" />
                </StackPanel>
            </Button>
            <ComboBox AutomationProperties.Name="{ctl:T 'Show'}" ToolTip="{ctl:T 'Show one kind of change'}" MinWidth="190" VerticalAlignment="Center"
                      ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Label" />
            <TextBlock Text="{ctl:T 'Group'}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="22,0,10,0" VerticalAlignment="Center" />
            <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="TimelineUpdates" Content="{ctl:T 'By day'}"
                                 ToolTip="{ctl:T 'Day by day: three or more app updates on a day are one line'}"
                                 IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Day}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TimelineUpdates" Content="{ctl:T 'By month'}"
                                 ToolTip="{ctl:T 'A row a month: each kind of change in it is one line'}"
                                 IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Month}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TimelineUpdates" Content="{ctl:T 'Off'}" ToolTip="{ctl:T 'Day by day, every change on its own line'}"
                                 IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Each}" />
                </StackPanel>
            </Border>
            <TextBox Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search changes…'}" Width="220" Margin="22,0,0,0" VerticalAlignment="Center"
                     AutomationProperties.Name="{ctl:T 'Search the timeline'}" ctl:Debounce.Text="{Binding Search}" HorizontalAlignment="Left" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="252" />
            </Grid.ColumnDefinitions>

            <!-- The days, newest first; older ones are built as the list is scrolled. -->
            <ScrollViewer x:Name="Scroller" Style="{StaticResource GutterScroll}" ScrollChanged="Scroller_ScrollChanged">
                <StackPanel Margin="2,2,0,24">
                    <ItemsControl x:Name="List" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayTemplate}" />
                    <ctl:Spinner Late="True" Width="22" Height="22" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,150,0,0"
                                 Visibility="{Binding Loaded, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    <StackPanel HorizontalAlignment="Center" Margin="0,48,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" Style="{StaticResource GutterScroll}">
                <StackPanel Margin="0,0,0,24">
                    <!-- Jump to a day: one month, or (a click on its name) the year's months. -->
                    <TextBlock Text="{ctl:T 'JUMP TO A DAY'}" Style="{StaticResource PanelHead}" />
                    <DockPanel Margin="-6,0,-6,4">
                        <Button DockPanel.Dock="Left" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                                AutomationProperties.Name="{ctl:T 'Earlier'}">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="11" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}"
                                AutomationProperties.Name="{ctl:T 'Later'}">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Margin="0" HorizontalAlignment="Center" Command="{Binding ZoomOutCommand}" ToolTip="{ctl:T 'Pick a month'}">
                            <TextBlock Text="{Binding CalendarTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        </Button>
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsYearView, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <ItemsControl ItemsSource="{Binding Weekdays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding CalendarCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Cell" Style="{StaticResource CalendarCell}" Height="34" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.PickDayCommand, ElementName=Page}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Border x:Name="Today" BorderBrush="{DynamicResource FaintBrush}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" />
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                            <Ellipse Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                     Fill="{Binding DotBrush, Converter={StaticResource ResourceBrush}}"
                                                     Visibility="{Binding HasAny, Converter={StaticResource Vis}}" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Today" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Day}" Value="{x:Null}">
                                            <Setter TargetName="Cell" Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding CalendarMonths}" Visibility="{Binding IsYearView, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Cell" Style="{StaticResource CalendarCell}" Height="46" Margin="2" AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.PickMonthCommand, ElementName=Page}" CommandParameter="{Binding}">
                                    <Grid>
                                        <Border x:Name="Current" BorderBrush="{DynamicResource FaintBrush}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Current" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,10,0,0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource CpuBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'Something changed'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,14,0" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource HotBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'A problem'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" />
                    </WrapPanel>

                    <!-- This PC now -->
                    <StackPanel Margin="0,26,0,0" Visibility="{Binding Now.Count, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'THIS PC NOW'}" Style="{StaticResource PanelHead}" />
                        <ItemsControl ItemsSource="{Binding Now}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" />
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Value}" FontSize="13" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Since}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Right"
                                                       Visibility="{Binding Since, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- What its last change made better or worse, where it did: the panel's whole width, so it reads in one line. -->
                                    <TextBlock FontSize="11.5" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="0,-2,0,4"
                                               Visibility="{Binding ResultText, Converter={StaticResource Vis}}">
                                        <Hyperlink Focusable="False" Foreground="{Binding ResultBrush, Converter={StaticResource ResourceBrush}}"
                                                   Command="{Binding DataContext.OpenNowResultCommand, ElementName=Page}" CommandParameter="{Binding}"><Run Text="{Binding ResultText, Mode=OneWay}" /></Hyperlink>
                                    </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- An opened change: what it made better or worse, every reading before and since, day by day, how sure, the problems
         counted, and (a graphics driver) the drivers before it. In place of the list until Back. -->
    <Grid Visibility="{Binding IsChangeOpen, Converter={StaticResource Vis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Padding="32,18,32,10">
            <DockPanel MaxWidth="{StaticResource PageWidth}">
                <Button DockPanel.Dock="Left" Style="{StaticResource ActionButton}" Margin="-9,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="{ctl:T 'Back to Timeline'}"
                        Command="{Binding CloseChangeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'Timeline'}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Margin="0,0,-9,0" VerticalAlignment="Center"
                        Command="{Binding CopyChangeCommand}"
                        ToolTip="{ctl:T 'Copies the whole before and after (what changed, every reading, how sure, and your PC\'s hardware) to paste into a forum post or support request'}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{ctl:T 'Copy report'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Copied}" Value="True">
                                        <Setter Property="Text" Value="{ctl:T 'Copied'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="ChangeScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,4,32,32" MaxWidth="{StaticResource PageWidth}" DataContext="{Binding Opened}">

                <!-- What it made better or worse, and how sure: the headline, what changed and when under it, the chip.
                     What to try only where it matters. -->
                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center" Margin="0,0,16,0"
                                    Background="{Binding ToneBrush, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding ToneBrush, Converter={StaticResource ResourceBrush}}" />
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="10,4" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Background="{Binding Sure, Converter={StaticResource SureBrush}, ConverterParameter=soft}" ToolTip="{Binding SureHint}">
                                <TextBlock Text="{Binding Chip}" FontSize="11" FontWeight="Bold" Foreground="{Binding Sure, Converter={StaticResource SureBrush}}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Under}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0"
                                Visibility="{Binding HasAdvice, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Top" Margin="2,2,12,0" />
                                <TextBlock DockPanel.Dock="Left" Text="{ctl:T 'What to try'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding Advice}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Every reading compared: before, since, and what the difference means. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'Before and since'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{ctl:T 'BEFORE'}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding SinceHead}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{ctl:T 'WHAT IT MEANS'}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="24,0,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                           Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock x:Name="Was" Grid.Column="1" Text="{Binding Before}" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="Now" Grid.Column="2" Text="{Binding After}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="Means" Grid.Column="3" Text="{Binding Meaning}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="24,1,0,0" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Worse">
                                            <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            <Setter TargetName="Means" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Better">
                                            <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            <Setter TargetName="Means" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Counted}" Value="False">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Setter TargetName="Label" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                            <Setter TargetName="Now" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="Was" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Each time you played: the two averages big, then every day of play before and since on one scale, so it
                     shows whether it was every time or one odd evening (the room and the problems are in the table above).
                     Only when a temperature moved. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding HasPlayChart, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Result.TempLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'Each time you played'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding BeforeDaysText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding BeforeTempText}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Bottom" Margin="0,0,20,10" />
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding AfterDaysText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding AfterTempText}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding PlayBrush, Converter={StaticResource ResourceBrush}}" />
                            </StackPanel>
                            <Border CornerRadius="6" Padding="8,3" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                    Background="{Binding PlayBrush, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                <TextBlock Text="{Binding DiffText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding PlayBrush, Converter={StaticResource ResourceBrush}}" />
                            </Border>
                        </WrapPanel>
                        <ctl:ChangeChart Days="{Binding ChartDays}" ChangeDay="{Binding Day}" Before="{Binding Result.TempBefore}" After="{Binding Result.TempAfter}"
                                         AfterName="{Binding AfterName}" Worse="{Binding PlayHotter}" TempLabel="{Binding Result.TempLabel}"
                                         AutomationProperties.Name="{ctl:T 'Each time you played, before and since'}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- How sure, and the problems counted -->
                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctl:SmoothBorder Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'How sure'}" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <HeaderedContentControl Style="{StaticResource IconRow}" Margin="0,12,0,0" Padding="12,0,0,0">
                                            <HeaderedContentControl.Header>
                                                <Border Style="{StaticResource IconBox}" Background="{Binding Brush, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                                                </Border>
                                            </HeaderedContentControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:SmoothBorder>
                    <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProblemsCount}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{ctl:T 'Problems counted'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Open'}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                        Command="{Binding DataContext.OpenProblemCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Width="132" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Side}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{ctl:T 'None on either side.'}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" Visibility="{Binding HasProblems, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </ctl:SmoothBorder>
                </Grid>

                <!-- A graphics driver: the drivers before it, each with what it did where it made a difference. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding HasDrivers, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'This driver and earlier ones'}" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Drivers}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Dates}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBlock x:Name="Version" DockPanel.Dock="Left" Text="{Binding Version}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Width="150" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding Result, Converter={StaticResource Vis}}">
                                                <Hyperlink x:Name="Link" Focusable="False" Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}"
                                                           Command="{Binding DataContext.OpenDriverCommand, ElementName=Page}" CommandParameter="{Binding}"><Run Text="{Binding Result, Mode=OneWay}" /></Hyperlink>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsThis}" Value="True">
                                            <Setter TargetName="Version" Property="Text" Value="{Binding VersionThis}" />
                                            <Setter TargetName="Link" Property="TextDecorations" Value="{x:Null}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
