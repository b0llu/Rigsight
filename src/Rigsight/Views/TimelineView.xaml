<UserControl x:Class="Rigsight.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Rigsight.Views"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:svc="clr-namespace:Rigsight.Services"
             xmlns:models="clr-namespace:Rigsight.Models"
             x:Name="Page">
    <UserControl.Resources>
        <Style x:Key="PanelHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A day or a month in the calendar: lit when something happened in it. -->
        <Style x:Key="CalendarCell" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Small}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{x:Static ctl:Corner.Choice}" />
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="{x:Static ctl:Corner.Choice}" Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAny}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAny}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A line that opens something (a driver mark, a game, a crash): the whole line is one button, lit on hover and on
             keyboard focus, with an arrow at its end (the user, 2026-11-24: "any type of interaction that can have a click
             can have the whole row covered"). It reaches a little past the line's edges so the light has room. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <!-- Past the line on the left only: the list clips at its right edge, which cut the light's corner off there. -->
            <Setter Property="Margin" Value="-10,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="{x:Static ctl:Corner.Choice}" Opacity="0" />
                            <ContentPresenter Margin="10,5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One line under a day. Most are a plain change (kept light: a long list builds hundreds of them); a problem has
             its way to the Crashes page; a change with more to it shows what was different after, or the updates folded into it. -->
        <DataTemplate x:Key="PlainEntry">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{Binding IconBrush, Converter={StaticResource ResourceBrush}}" />
                <TextBlock x:Name="Line" Grid.Column="2" FontSize="{x:Static ctl:TextSize.Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
                <!-- A muted line under it (a stretch of sound dropouts' possible cause): only on the few lines that have one. -->
                <TextBlock x:Name="Note" Grid.Row="1" Grid.Column="2" Text="{Binding Note}" FontSize="{x:Static ctl:TextSize.Small}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKey}" Value="True">
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNote}" Value="True">
                    <Setter TargetName="Note" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A game's update: the whole line opens the game (its plays before and since). -->
        <DataTemplate x:Key="GameEntry">
            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenGameCommand, ElementName=Page}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{ctl:T 'Open game'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" VerticalAlignment="Top" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Grid.Column="2" FontSize="{x:Static ctl:TextSize.Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Top" Margin="12,4,0,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A problem: the whole line opens it (its own case, or the Crashes page on its day). -->
        <DataTemplate x:Key="ProblemEntry">
            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenCrashesCommand, ElementName=Page}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding OpenText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" VerticalAlignment="Top" Margin="0,2,0,0"
                               Foreground="{Binding IconBrush, Converter={StaticResource ResourceBrush}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                    <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Top" Margin="12,4,0,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A kind in the Fold list: a tick box (the accent when ticked, as in the Export box) and its name, lit on hover. -->
        <Style x:Key="FoldCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <ctl:SmoothBorder x:Name="Bd" Background="Transparent" CornerRadius="{x:Static ctl:Corner.Field}" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="{x:Static ctl:Corner.Chip}" BorderThickness="1" BorderBrush="{DynamicResource FaintBrush}"
                                        VerticalAlignment="Center" Margin="0,0,11,0">
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource OnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ctl:SmoothBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line inside a folded one: lit on hover only when it opens something (a crash, a driver mark, a game). -->
        <Style x:Key="SubRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="{x:Static ctl:Corner.Choice}" Opacity="0" />
                            <ContentPresenter Margin="10,3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lines folded into one (by day the kinds ticked under Fold, by month each kind of change). The whole line opens
             and closes it, with an arrow at its end that turns (approved mock-up, 2026-11-25: no "Show all" link under it).
             Open, each line is under it at its own time, a thin thread of the kind's colour running down from its icon;
             those that open something are lit on hover and have an arrow of their own. A long list scrolls in a box of
             its own, about fifteen lines high, and hands the wheel back to the page at its ends. -->
        <DataTemplate x:Key="RichEntry">
            <StackPanel>
                <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.ToggleVersionsCommand, ElementName=Page}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding SpokenName}" AutomationProperties.HelpText="{Binding ToggleText}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" VerticalAlignment="Top" Margin="0,2,0,0"
                                   Foreground="{Binding IconBrush, Converter={StaticResource ResourceBrush}}" />
                        <TextBlock x:Name="Line" Grid.Column="2" FontSize="{x:Static ctl:TextSize.Body}" TextWrapping="Wrap" Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}">
                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                        <TextBlock x:Name="Chevron" Grid.Column="3" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Top" Margin="12,4,0,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Button>
                <ScrollViewer Style="{StaticResource CardScroll}" MaxHeight="352" Margin="-10,0,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Children}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Row" Style="{StaticResource SubRow}" Command="{Binding DataContext.OpenChildCommand, ElementName=Page}" CommandParameter="{Binding}"
                                        IsHitTestVisible="{Binding CanOpen}" Focusable="{Binding CanOpen}" AutomationProperties.Name="{Binding SpokenName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                                        <!-- The thread: a faint line down the icon's column with a dot at each line, in the kind's colour. -->
                                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="6.5,-3,0,-3" Opacity="0.35"
                                                Background="{Binding IconBrush, Converter={StaticResource ResourceBrush}}" />
                                        <Ellipse Grid.Column="1" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,6,0,0" Opacity="0.8"
                                                 Fill="{Binding IconBrush, Converter={StaticResource ResourceBrush}}" />
                                        <TextBlock x:Name="SubLine" Grid.Column="2" FontSize="{x:Static ctl:TextSize.Small}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">
                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" />
                                        </TextBlock>
                                        <TextBlock x:Name="Go" Grid.Column="3" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Top" Margin="12,3,0,0" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                                        <Setter TargetName="SubLine" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKey}" Value="True">
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <!-- The arrow turns to point up while the line is open. -->
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A big change that made something better or worse: its line, and under it a card with what, how sure, the
             readings before and since, and the way into the whole of it. Only such a change has one; every other line
             stays as it was. -->
        <DataTemplate x:Key="ResultEntry">
            <Grid Margin="0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTip}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="2" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
                    <!-- The card (approved mock-up B, 2026-11-24): one button that opens the whole before and after, its
                         figures in a soft panel, how sure in words under them, the AI question a quiet link. No row lines
                         and no chip: "it looked chunky", "the lines look odd" (the user). From the time's column, under the
                         line, and only as wide as it needs ("the space there is a bit weird", the user 2026-11-24). -->
                    <Button Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,4" Cursor="Hand" Focusable="True" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" MaxWidth="820"
                            AutomationProperties.Name="{Binding Result.Headline}"
                            Command="{Binding DataContext.OpenResultCommand, ElementName=Page}" CommandParameter="{Binding}" ToolTip="{ctl:T 'Open this change\'s before and after'}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{x:Static ctl:Corner.Tile}" />
                                    <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="{x:Static ctl:Corner.Tile}" Opacity="0" Margin="1" />
                                    <ContentPresenter Margin="16,14,16,12" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Opacity" Value="0.6" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Hover" Property="Opacity" Value="0.6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Top" Margin="12,5,0,0" />
                                <TextBlock Text="{Binding Result.Headline}" FontSize="{x:Static ctl:TextSize.Heading}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Result.Context}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Choice}" Padding="14,11" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding CardFigures}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,34,0">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,3" />
                                                <TextBlock FontSize="{x:Static ctl:TextSize.Figure}" FontWeight="SemiBold">
                                                    <Run x:Name="Was" Text="{Binding Was, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontWeight="Medium" /><Run x:Name="Arrow" Text="  →  " Foreground="{DynamicResource FaintBrush}" FontWeight="Normal"
                                                        FontSize="{x:Static ctl:TextSize.Body}" /><Run Text="{Binding Now, Mode=OneWay}" Foreground="{Binding NowBrush, Converter={StaticResource ResourceBrush}}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Sub}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"
                                                           Visibility="{Binding HasSub, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasWas}" Value="False">
                                                    <Setter TargetName="Was" Property="Text" Value="" />
                                                    <Setter TargetName="Arrow" Property="Text" Value="" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <DockPanel Margin="0,11,0,0">
                                <!-- Worse since the change: ask whether it's why (hidden while the AI is off). -->
                                <Button DockPanel.Dock="Right" Style="{StaticResource AiLink}" Content="{Binding ResultAskText}" CommandParameter="{Binding ResultAsk}"
                                        AutomationProperties.Name="{Binding ResultAskText}" VerticalAlignment="Center" Margin="12,-3,-6,-3" />
                                <TextBlock FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <Run Text="{Binding SureHead, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text="{Binding SureRest, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Button>
            </Grid>
        </DataTemplate>

        <!-- A driver keeping the CPU busy much longer than usual (issue #15 follow-up, approved mock-up 2026-11-24): the
             whole line is one button that opens what happened in place, with a hover of its own and an arrow at the end. -->
        <DataTemplate x:Key="DelayEntry">
            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenDelayCommand, ElementName=Page}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{ctl:T 'Open what happened'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" VerticalAlignment="Top" Margin="0,2,0,0"
                               Foreground="{Binding IconBrush, Converter={StaticResource ResourceBrush}}" />
                    <TextBlock Grid.Column="2" FontSize="{x:Static ctl:TextSize.Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Top" Margin="12,4,0,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <views:TimelineEntryTemplates x:Key="EntryTemplates" Plain="{StaticResource PlainEntry}" Problem="{StaticResource ProblemEntry}" Rich="{StaticResource RichEntry}"
                                      Result="{StaticResource ResultEntry}" Game="{StaticResource GameEntry}" Delay="{StaticResource DelayEntry}" />

        <!-- A day: its dot on the line that runs down the list, its name, and its lines. -->
        <DataTemplate x:Key="DayTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Month}" Style="{StaticResource PanelHead}" Margin="34,6,0,10"
                           Visibility="{Binding Month, Converter={StaticResource Vis}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="1" HorizontalAlignment="Left" Margin="6,18,0,-2" Background="{DynamicResource StrokeBrush}" />
                    <Ellipse Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"
                             Fill="{Binding NodeBrush, Converter={StaticResource ResourceBrush}}" />
                    <StackPanel Grid.Column="1" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Title}" FontSize="{x:Static ctl:TextSize.Heading}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding SubTitle}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,1" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}" ItemTemplateSelector="{StaticResource EntryTemplates}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="32,26,32,0" MaxWidth="{StaticResource PageWidth}" Visibility="{Binding IsListShown, Converter={StaticResource Vis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <!-- How many, since when: at the title's right. At the end of the row below it slid under the search box on a small window. -->
            <Button Style="{StaticResource PageExportButton}" />
            <!-- The page's own question for the AI (mock-up board 5), left of Export. -->
            <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'Did a change hurt?'}" CommandParameter="{x:Static svc:PageAsks.Timeline}" AutomationProperties.Name="{ctl:T 'Did a change hurt?'}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Detail}" VerticalAlignment="Bottom" Margin="16,0,0,1" />
            <StackPanel>
                <TextBlock Text="{ctl:T 'Timeline'}" Style="{StaticResource H1}" />
                <TextBlock Text="{ctl:T 'What was installed, updated, removed or switched on this PC, day by day.'}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- What to show -->
        <DockPanel Grid.Row="1" Margin="0,16,0,0" Height="36">
            <!-- The PC is looked over every ten minutes; this looks now. It turns while that's going on. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                    Command="{Binding RefreshCommand}" ToolTip="{ctl:T 'Look for new changes now'}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="12" Margin="0,0,8,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" HorizontalAlignment="Center"
                                   Visibility="{Binding IsRefreshing, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <ctl:Spinner Visibility="{Binding IsRefreshing, Converter={StaticResource Vis}}" />
                    </Grid>
                    <TextBlock Text="{ctl:T 'Refresh'}" />
                </StackPanel>
            </Button>
            <ComboBox AutomationProperties.Name="{ctl:T 'Show'}" ToolTip="{ctl:T 'Show one kind of change'}" MinWidth="190" VerticalAlignment="Center"
                      ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Label" MaxDropDownHeight="700" />
            <TextBlock Text="{ctl:T 'Group'}" Foreground="{DynamicResource MutedBrush}" FontSize="{x:Static ctl:TextSize.Detail}" Margin="22,0,10,0" VerticalAlignment="Center" />
            <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="TimelineUpdates" Content="{ctl:T 'By day'}"
                                 ToolTip="{ctl:T 'Day by day, with the kinds ticked under Fold as one line'}"
                                 IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Day}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TimelineUpdates" Content="{ctl:T 'By month'}"
                                 ToolTip="{ctl:T 'A row a month, with each kind of change in it as one line'}"
                                 IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Month}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="TimelineUpdates" Content="{ctl:T 'Off'}" ToolTip="{ctl:T 'Day by day, every change on its own line'}"
                                 IsChecked="{Binding Grouping, Converter={StaticResource Equals}, ConverterParameter=Each}" />
                </StackPanel>
            </Border>
            <!-- Which kinds fold into one line on a day (the user, 2026-11-26): a short list floating under the button,
                 each tick taking effect at once and kept for good; it takes no room on the page. "1 of 6" beside the
                 word while not every kind is ticked. -->
            <Button x:Name="FoldButton" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="10,0,0,0" Click="FoldButton_Click"
                    ToolTip="{ctl:T 'Which kinds fold into one line on a day'}" AutomationProperties.Name="{ctl:T 'Fold'}" AutomationProperties.HelpText="{Binding FoldText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{ctl:T 'Fold'}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FoldText}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Small}" Margin="6,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasFoldText, Converter={StaticResource Vis}}" />
                    <TextBlock x:Name="FoldChevron" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                               Margin="8,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Popup x:Name="FoldPop" PlacementTarget="{Binding ElementName=FoldButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade" Opened="FoldPop_Opened" Closed="FoldPop_Closed">
                <ctl:SmoothBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{x:Static ctl:Corner.Control}"
                                  Padding="5" Margin="0,0,8,8" MinWidth="236" PreviewKeyDown="FoldPop_KeyDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <ItemsControl ItemsSource="{Binding FoldChoices}" Focusable="False" AutomationProperties.Name="{ctl:T 'Fold'}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource FoldCheck}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctl:SmoothBorder>
            </Popup>
            <TextBox Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search changes…'}" Width="220" Margin="22,0,0,0" VerticalAlignment="Center"
                     AutomationProperties.Name="{ctl:T 'Search the timeline'}" ctl:Debounce.Text="{Binding Search}" HorizontalAlignment="Left" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="252" />
            </Grid.ColumnDefinitions>

            <!-- The days, newest first; older ones are built as the list is scrolled. -->
            <ScrollViewer x:Name="Scroller" Style="{StaticResource GutterScroll}" ScrollChanged="Scroller_ScrollChanged">
                <StackPanel Margin="2,2,0,24">
                    <ItemsControl x:Name="List" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayTemplate}" />
                    <ctl:Spinner Late="True" Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,150,0,0"
                                 Visibility="{Binding Loaded, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    <StackPanel HorizontalAlignment="Center" Margin="0,48,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S30}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 6 px of room each side, given back inside: the month's arrows sit 6 px out to line up with the days, and
                 the scroller cut their hover square at its edges (2026-11-13). -->
            <ScrollViewer Grid.Column="2" Style="{StaticResource GutterScroll}" Margin="-6,0,-6,0">
                <StackPanel Margin="6,0,6,24">
                    <!-- Jump to a day: one month, or (a click on its name) the year's months. -->
                    <TextBlock Text="{ctl:T 'JUMP TO A DAY'}" Style="{StaticResource PanelHead}" />
                    <DockPanel Margin="-6,0,-6,4">
                        <Button DockPanel.Dock="Left" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                                AutomationProperties.Name="{ctl:T 'Earlier'}">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}"
                                AutomationProperties.Name="{ctl:T 'Later'}">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" />
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Margin="0" HorizontalAlignment="Center" Command="{Binding ZoomOutCommand}" ToolTip="{ctl:T 'Pick a month'}">
                            <TextBlock Text="{Binding CalendarTitle}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        </Button>
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsYearView, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <ItemsControl ItemsSource="{Binding Weekdays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="{x:Static ctl:TextSize.MiniPlus}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding CalendarCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Cell" Style="{StaticResource CalendarCell}" Height="34" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.PickDayCommand, ElementName=Page}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Border x:Name="Today" BorderBrush="{DynamicResource FaintBrush}" BorderThickness="1" CornerRadius="{x:Static ctl:Corner.Choice}" Visibility="Collapsed" />
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                            <Ellipse Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                     Fill="{Binding DotBrush, Converter={StaticResource ResourceBrush}}"
                                                     Visibility="{Binding HasAny, Converter={StaticResource Vis}}" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Today" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Day}" Value="{x:Null}">
                                            <Setter TargetName="Cell" Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding CalendarMonths}" Visibility="{Binding IsYearView, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Cell" Style="{StaticResource CalendarCell}" Height="46" Margin="2" AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.PickMonthCommand, ElementName=Page}" CommandParameter="{Binding}">
                                    <Grid>
                                        <Border x:Name="Current" BorderBrush="{DynamicResource FaintBrush}" BorderThickness="1" CornerRadius="{x:Static ctl:Corner.Choice}" Visibility="Collapsed" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" FontSize="{x:Static ctl:TextSize.MiniPlus}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Current" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,10,0,0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource CpuBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'Something changed'}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource MutedBrush}" Margin="6,0,14,0" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource HotBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'A problem'}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" />
                    </WrapPanel>

                    <!-- This PC now -->
                    <StackPanel Margin="0,26,0,0" Visibility="{Binding Now.Count, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'THIS PC NOW'}" Style="{StaticResource PanelHead}" />
                        <ItemsControl ItemsSource="{Binding Now}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" />
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Value}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Since}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Right"
                                                       Visibility="{Binding Since, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- What its last change made better or worse, where it did: the panel's whole width, so it reads in one line. -->
                                    <TextBlock FontSize="{x:Static ctl:TextSize.Label}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="0,-2,0,4"
                                               Visibility="{Binding ResultText, Converter={StaticResource Vis}}">
                                        <Hyperlink Focusable="False" Foreground="{Binding ResultBrush, Converter={StaticResource ResourceBrush}}"
                                                   Command="{Binding DataContext.OpenNowResultCommand, ElementName=Page}" CommandParameter="{Binding}"><Run Text="{Binding ResultText, Mode=OneWay}" /></Hyperlink>
                                    </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- An opened change: what it made better or worse, every reading before and since, day by day, how sure, the problems
         counted, and (a graphics driver) the drivers before it. In place of the list until Back. -->
    <!-- Built the first time a change is opened (as Settings' tabs): over a third of the page, hidden until then, was
         built and bound on every first visit (2026-11-13). Its scroller is found when it loads (Change_Loaded). -->
    <ctl:LazyTab Shown="{Binding IsChangeOpen}"><ctl:LazyTab.Body><DataTemplate>
    <Grid Loaded="Change_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Padding="32,18,32,10">
            <DockPanel MaxWidth="{StaticResource PageWidth}">
                <Button DockPanel.Dock="Left" Style="{StaticResource ActionButton}" Margin="-9,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="{ctl:T 'Back to Timeline'}"
                        Command="{Binding CloseChangeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'Timeline'}" FontSize="{x:Static ctl:TextSize.Body}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Margin="0,0,-9,0" VerticalAlignment="Center"
                        Command="{Binding CopyChangeCommand}"
                        ToolTip="{ctl:T 'Copies the whole before and after (what changed, every reading, how sure, and your PC\'s hardware) to paste into a forum post or support request'}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{ctl:T 'Copy report'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Copied}" Value="True">
                                        <Setter Property="Text" Value="{ctl:T 'Copied'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="ChangeScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,4,32,32" MaxWidth="{StaticResource PageWidth}" DataContext="{Binding Opened}">

                <!-- What it made better or worse, and how sure: the headline, what changed and when under it, the chip.
                     What to try only where it matters. -->
                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="{x:Static ctl:Corner.Tile}" VerticalAlignment="Center" Margin="0,0,16,0"
                                    Background="{Binding ToneBrush, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S20}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding ToneBrush, Converter={StaticResource ResourceBrush}}" />
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="10,4" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Background="{Binding Sure, Converter={StaticResource SureBrush}, ConverterParameter=soft}" ToolTip="{Binding SureHint}">
                                <TextBlock Text="{Binding Chip}" FontSize="{x:Static ctl:TextSize.Caption}" FontWeight="Bold" Foreground="{Binding Sure, Converter={StaticResource SureBrush}}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Headline}" FontSize="{x:Static ctl:TextSize.Figure}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Under}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0"
                                Visibility="{Binding HasAdvice, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Top" Margin="2,2,12,0" />
                                <TextBlock DockPanel.Dock="Left" Text="{ctl:T 'What to try'}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding Advice}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Every reading compared: before, since, and what the difference means. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'Before and since'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{ctl:T 'BEFORE'}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding SinceHead}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{ctl:T 'WHAT IT MEANS'}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="24,0,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                           Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock x:Name="Was" Grid.Column="1" Text="{Binding Before}" FontSize="{x:Static ctl:TextSize.Lead}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="Now" Grid.Column="2" Text="{Binding After}" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="Means" Grid.Column="3" Text="{Binding Meaning}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="24,1,0,0" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Worse">
                                            <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            <Setter TargetName="Means" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Better">
                                            <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            <Setter TargetName="Means" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Counted}" Value="False">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Setter TargetName="Label" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                            <Setter TargetName="Now" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="Was" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Each time you played: the two averages big, then every day of play before and since on one scale, so it
                     shows whether it was every time or one odd evening (the room and the problems are in the table above).
                     Only when a temperature moved. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding HasPlayChart, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Result.TempLabel}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'Each time you played'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding BeforeDaysText}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding BeforeTempText}" FontSize="{x:Static ctl:TextSize.DisplayLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S16}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Bottom" Margin="0,0,20,10" />
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding AfterDaysText}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding AfterTempText}" FontSize="{x:Static ctl:TextSize.DisplayLarge}" FontWeight="SemiBold" Foreground="{Binding PlayBrush, Converter={StaticResource ResourceBrush}}" />
                            </StackPanel>
                            <Border CornerRadius="{x:Static ctl:Corner.Small}" Padding="8,3" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                    Background="{Binding PlayBrush, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                <TextBlock Text="{Binding DiffText}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{Binding PlayBrush, Converter={StaticResource ResourceBrush}}" />
                            </Border>
                        </WrapPanel>
                        <ctl:ChangeChart Days="{Binding ChartDays}" ChangeDay="{Binding Day}" Before="{Binding Result.TempBefore}" After="{Binding Result.TempAfter}"
                                         AfterName="{Binding AfterName}" Worse="{Binding PlayHotter}" TempLabel="{Binding Result.TempLabel}"
                                         AutomationProperties.Name="{ctl:T 'Each time you played, before and since'}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- How sure, and the problems counted -->
                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctl:SmoothBorder Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'How sure'}" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <HeaderedContentControl Style="{StaticResource IconRow}" Margin="0,12,0,0" Padding="12,0,0,0">
                                            <HeaderedContentControl.Header>
                                                <Border Style="{StaticResource IconBox}" Background="{Binding Brush, Converter={StaticResource SureBrush}, ConverterParameter=soft}">
                                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S13}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                                                </Border>
                                            </HeaderedContentControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="{x:Static ctl:TextSize.BodyPlus}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:SmoothBorder>
                    <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProblemsCount}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" />
                                <TextBlock Text="{ctl:T 'Problems counted'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Open'}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                        Command="{Binding DataContext.OpenProblemCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Width="132" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Side}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{ctl:T 'None on either side.'}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" Visibility="{Binding HasProblems, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </ctl:SmoothBorder>
                </Grid>

                <!-- A graphics driver: the drivers before it, each with what it did where it made a difference. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding HasDrivers, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'This driver and earlier ones'}" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Drivers}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Dates}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBlock x:Name="Version" DockPanel.Dock="Left" Text="{Binding Version}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Width="150" VerticalAlignment="Center" />
                                            <TextBlock FontSize="{x:Static ctl:TextSize.Detail}" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding Result, Converter={StaticResource Vis}}">
                                                <Hyperlink x:Name="Link" Focusable="False" Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}"
                                                           Command="{Binding DataContext.OpenDriverCommand, ElementName=Page}" CommandParameter="{Binding}"><Run Text="{Binding Result, Mode=OneWay}" /></Hyperlink>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsThis}" Value="True">
                                            <Setter TargetName="Version" Property="Text" Value="{Binding VersionThis}" />
                                            <Setter TargetName="Link" Property="TextDecorations" Value="{x:Null}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </DataTemplate></ctl:LazyTab.Body></ctl:LazyTab>

    </Grid>
</UserControl>
