<UserControl x:Class="Rigsight.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>
        <Style x:Key="Term" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,5,12,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,40" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Guide" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource P}" Margin="0,6,0,18"
                       Text="Rigsight quietly keeps track of your PC through the day — which apps you use, how hard they push your hardware, and anything that goes wrong — then turns it into simple reports. Here's exactly what it does and doesn't do." />

            <!-- Every feature, in one place -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Everything Rigsight does" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource P}" Text="A quick tour of every feature and where to find it." Margin="0,0,0,10" />
                    <UniformGrid Columns="3" Margin="-6,0">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource Tile}">
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="Padding" Value="16,14" />
                            </Style>
                            <Style x:Key="F" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                        </UniformGrid.Resources>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="YOUR DAY" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource F}" Text="• Home: today so far, highlights and yesterday's recap" />
                                <TextBlock Style="{StaticResource F}" Text="• Reports: day, week and month, with a minute-by-minute timeline" />
                                <TextBlock Style="{StaticResource F}" Text="• Time per app: in use, in the background, minimized, away" />
                                <TextBlock Style="{StaticResource F}" Text="• Sessions and automatic game detection" />
                                <TextBlock Style="{StaticResource F}" Text="• Plain-language insights and comparisons with previous days" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="APPS" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource F}" Text="• Which app ran your CPU and GPU hottest, with peaks and voltages" />
                                <TextBlock Style="{StaticResource F}" Text="• Per-app memory and CPU use, 14-day history, recent sessions" />
                                <TextBlock Style="{StaticResource F}" Text="• Sort by most used, hottest, most memory or most background time" />
                                <TextBlock Style="{StaticResource F}" Text="• Rename apps, change their category, or stop tracking them" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="CRASHES" Style="{StaticResource Caption}" Foreground="{StaticResource WarmBrush}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource F}" Text="• App and game crashes, freezes, GPU driver resets" />
                                <TextBlock Style="{StaticResource F}" Text="• Blue screens and sudden shutdowns (including while asleep)" />
                                <TextBlock Style="{StaticResource F}" Text="• Likely cause, what to try, and temperatures just before" />
                                <TextBlock Style="{StaticResource F}" Text="• Patterns across repeated crashes; filter apps vs PC problems" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="HARDWARE" Style="{StaticResource Caption}" Foreground="{StaticResource GpuBrush}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource F}" Text="• Temperatures: CPU, GPU (hot spot, memory), motherboard, drives, fans, with today's lows and highs and up to 24 hours of history" />
                                <TextBlock Style="{StaticResource F}" Text="• Memory: RAM use and live per-app memory" />
                                <TextBlock Style="{StaticResource F}" Text="• Storage: space, weekly growth, health, cleanup ideas, folder map" />
                                <TextBlock Style="{StaticResource F}" Text="• All sensors: every reading with min/max/avg, search, rename, hide, collapse" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="ON YOUR DESKTOP" Style="{StaticResource Caption}" Foreground="{StaticResource GpuBrush}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource F}" Text="• Six widgets: Compact, Slim bar, Gauges, Now playing, Today, Graph" />
                                <TextBlock Style="{StaticResource F}" Text="• Themes, sizes, opacity, click-through lock" />
                                <TextBlock Style="{StaticResource F}" Text="• Game overlay: press Alt+Shift+O in any game for FPS, 1% lows and live readings" />
                                <TextBlock Style="{StaticResource F}" Text="• Tray icon with a health dot, quick menu, pause tracking" />
                                <TextBlock Style="{StaticResource F}" Text="• Notification cards: daily recap, game summaries, alerts, crashes" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="YOUR CONTROL" Style="{StaticResource Caption}" Foreground="{StaticResource PurpleBrush}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource F}" Text="• Dashboards: build your own from tiles, drag and resize them freely" />
                                <TextBlock Style="{StaticResource F}" Text="• Alert limits, quiet while gaming, notification style and previews" />
                                <TextBlock Style="{StaticResource F}" Text="• Tracking sensitivity: away time and sampling speed" />
                                <TextBlock Style="{StaticResource F}" Text="• Privacy: excluded apps, pause, data retention, clear history" />
                                <TextBlock Style="{StaticResource F}" Text="• Export to CSV, °C/°F, start with Windows" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <!-- Two parts -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Two parts: a tiny tracker and this window" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Tile}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="BACKGROUND AGENT" Style="{StaticResource Caption}" Foreground="{StaticResource GpuBrush}" />
                                    <TextBlock Style="{StaticResource P}"
                                               Text="Starts when you sign in and runs all day. It reads your temperatures, notices which app is in front, and saves a small summary once a minute. It also runs the tray icon, the desktop widgets, the game overlay and notifications. It uses about 0.02% of your CPU — you won't feel it, even mid-game." />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Tile}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="THE RIGSIGHT APP" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Style="{StaticResource P}"
                                               Text="The window you're looking at. It shows live readings and your history, and closes completely when you close it — nothing extra keeps running. Open it any time from the tray icon or the Start menu." />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource P}"
                                   Text="The agent needs administrator rights once (Windows asks the first time) because CPU temperatures, fan speeds and voltages live in hardware that normal apps can't read. After that it starts with Windows without asking again." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- What gets tracked -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="How your time is counted" Style="{StaticResource SectionTitle}" />
                        <DockPanel><TextBlock Text="In use" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="The app is in front and you're at the PC (you've touched the keyboard or mouse in the last few minutes, or it's a fullscreen game or video)." /></DockPanel>
                        <DockPanel><TextBlock Text="Background" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="The app has a window open on screen, but something else is in front." /></DockPanel>
                        <DockPanel><TextBlock Text="Minimized" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="All of the app's windows are minimized to the taskbar." /></DockPanel>
                        <DockPanel><TextBlock Text="Away" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="The PC is on but nobody's using it — no input for a while (5 minutes by default, change it in Settings), or the PC is locked." /></DockPanel>
                        <DockPanel><TextBlock Text="Desktop" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="Looking at the desktop, taskbar, Start menu or search counts as using your PC, but not as using any app." /></DockPanel>
                        <DockPanel><TextBlock Text="Sessions" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="A stretch of using one app. Quick switches (like checking Discord mid-game) don't break a session; it ends when you close the app or leave it for a while." /></DockPanel>
                        <DockPanel><TextBlock Text="Games" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="Recognised automatically from Steam, Epic, Riot and other game folders, or when an app runs fullscreen with heavy GPU use. You can change any app's category on the Apps page." /></DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Temps per app -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Which app heats up your PC" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource P}"
                                   Text="Every couple of seconds Rigsight notes the CPU and GPU temperature, power and voltage, and credits them to the app you're using at that moment. That's how reports can say things like “Dota 2 ran your GPU the hottest” or “the hottest moment was 9:42 PM while playing Elden Ring”." />
                        <TextBlock Style="{StaticResource P}"
                                   Text="Apps running in the background still count toward memory and CPU use, but temperatures are only credited to the app in front — that's the one you were actually doing something with." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Reports & notifications -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Reports and notifications" Style="{StaticResource SectionTitle}" />
                        <DockPanel><TextBlock Text="Daily recap" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="The first time you use your PC each day, a small card summarises yesterday. The full recap is on the Reports page." /></DockPanel>
                        <DockPanel><TextBlock Text="Session summary" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="When you close a game you played for 15+ minutes: how long, and how hot it got. If the game crashed, there's no summary (unless you turn on crash notifications)." /></DockPanel>
                        <DockPanel><TextBlock Text="Temperature alerts" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="Only when something stays above your limit for a while — brief spikes are ignored, and alerts are spaced out." /></DockPanel>
                        <DockPanel><TextBlock Text="Quiet while gaming" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="While a fullscreen game or video is in front, recaps and summaries wait until you're done. Temperature alerts still come through." /></DockPanel>
                        <TextBlock Style="{StaticResource P}" Text="See exactly what each one looks like with the Preview buttons in Settings → Notifications." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Crashes -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource WarmBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Crashes, explained" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource P}"
                                   Text="Windows already records every app crash, graphics driver reset, blue screen and sudden shutdown — but buried in Event Viewer in cryptic codes. Rigsight reads those records and translates them: what crashed, the most likely cause (for example the graphics driver, an overlay, the game itself, or unstable hardware settings), and what to try. It also shows how hot your CPU and GPU were just before, and spots patterns across repeated crashes." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tray & widgets -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xF246;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Tray icon and widgets" Style="{StaticResource SectionTitle}" />
                        <DockPanel><TextBlock Text="Tray dot" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="Green: everything's cool. Amber: something is within 12° of your alert limit. Red: at or over a limit. Hover for exact temperatures; click to open Rigsight; right-click for widgets, the overlay, pausing and quitting." /></DockPanel>
                        <DockPanel><TextBlock Text="Widgets" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="Small always-on-top readouts. Drag them anywhere, right-click for options, hover for the close button." /></DockPanel>
                        <DockPanel><TextBlock Text="Overlay" Style="{StaticResource Term}" /><TextBlock Style="{StaticResource P}" Text="A compact readout for games. Press its shortcut (Alt+Shift+O unless you change it) to show or hide it; it never takes focus and clicks pass through it. Games in exclusive fullscreen hide every window, so there Rigsight hands the readings to RivaTuner Statistics Server (free), which draws them inside the game. The installer offers it and Rigsight keeps it running. Rigsight itself never hooks into games, so it’s safe with anti-cheat." /></DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Privacy and your data" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource P}"
                                   Text="Everything stays on this PC, in a small database in your AppData folder (roughly 150 KB per day). Rigsight never records window titles, website addresses, what you type, or what's on screen — only which program is in front and how your hardware is doing." />
                        <TextBlock Style="{StaticResource P}"
                                   Text="You can stop any app from being recorded (Apps page or Settings → Privacy), pause tracking from the tray, choose how long history is kept, export it, or clear it all in Settings." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- FAQ -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Good to know" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource P}"><Run Text="How do I stop Rigsight completely? " FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="Right-click the tray icon → Quit Rigsight. To stop it starting with Windows, turn off Settings → Start with Windows." /></TextBlock>
                        <TextBlock Style="{StaticResource P}"><Run Text="Why do weekly and monthly reports look short? " FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="They only include days since Rigsight started tracking; they fill up over time." /></TextBlock>
                        <TextBlock Style="{StaticResource P}"><Run Text="Why is a sensor missing or showing a dash? " FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="Not every motherboard reports everything, and CPU and board sensors need the agent to have admin rights. Unlabelled motherboard sensors (like “Temperature #3”) can be renamed on the All sensors page." /></TextBlock>
                        <TextBlock Style="{StaticResource P}"><Run Text="Does it slow down games? " FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="No. The agent wakes about once a second for a fraction of a millisecond, runs at low priority, and uses NVIDIA's lightweight monitoring interface while this window is closed." /></TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
