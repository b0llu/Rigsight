<UserControl x:Class="Rigsight.Views.PageExportBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <!-- One thing to save: a tick box, its name, what the file holds, and about how big it is. -->
        <Style x:Key="ItemCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <ctl:SmoothBorder x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9,12,10">
                            <DockPanel>
                                <Border x:Name="Box" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                                        BorderBrush="{DynamicResource FaintBrush}" VerticalAlignment="Top" Margin="0,1,12,0">
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="12,2,0,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding About}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ctl:SmoothBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="Row">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <!-- A page's own Export box: what that page shows, for its period, narrowed the way it is. Opened from the page's Export button. -->
    <ctl:SmoothBorder Width="640" Margin="24" Padding="24,20,24,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16"
                      AutomationProperties.Name="{Binding Title}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" VerticalAlignment="Top"
                        ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="Close the export">
                    <TextBlock Text="&#xE8BB;" FontSize="11" />
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Past four things the list scrolls in a box of its own height, with how many are picked above it. -->
            <DockPanel Margin="2,14,2,4" Visibility="{Binding ManyItems, Converter={StaticResource Vis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="{Binding PickAllText}" Command="{Binding PickAllCommand}"
                        IsEnabled="{Binding CanChange}" Margin="0" />
                <TextBlock Text="{Binding PickedText}" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
            </DockPanel>
            <Border BorderBrush="{DynamicResource StrokeBrush}" Margin="-12,12,-12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ManyItems}" Value="True">
                                <Setter Property="BorderThickness" Value="0,1" />
                                <Setter Property="Margin" Value="-12,4,-12,10" />
                                <Setter Property="Padding" Value="0,6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ManyItems}" Value="True">
                                    <Setter Property="MaxHeight" Value="272" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" AutomationProperties.Name="What to export">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ItemCheck}" IsChecked="{Binding IsOn}" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}"
                                          IsEnabled="{Binding DataContext.CanChange, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- What the page narrows to: one of a few (segments), or any of several (chips). -->
            <ItemsControl ItemsSource="{Binding Scopes}" Focusable="False" IsEnabled="{Binding CanChange}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" />
                            <DockPanel Margin="0,14,0,14" Visibility="{Binding IsSingle, Converter={StaticResource Vis}}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <ItemsControl ItemsSource="{Binding Options}" ItemsPanel="{StaticResource Row}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsOn}"
                                                             GroupName="{Binding DataContext.GroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             MaxWidth="220" AutomationProperties.Name="{Binding Label}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding WordsText}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Margin="0,14,0,6" Visibility="{Binding IsMulti, Converter={StaticResource Vis}}">
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="{Binding AllText}" Command="{Binding PickAllCommand}" Margin="0"
                                            Visibility="{Binding HasMany, Converter={StaticResource Vis}}" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <Run Text=" · " Foreground="{DynamicResource MutedBrush}" FontSize="12.5" />
                                        <Run Text="{Binding WordsText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" />
                                    </TextBlock>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Options}" ItemsPanel="{StaticResource Wrap}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource MetricChip}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                                             Fill="{Binding Dot, Converter={StaticResource ResourceBrush}}" Visibility="{Binding HasDot, Converter={StaticResource Vis}}" />
                                                    <TextBlock Text="{Binding Label}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="{DynamicResource StrokeBrush}" />
            <!-- The page's own periods, set to the one it shows; Custom opens a calendar floating under the buttons. -->
            <DockPanel Margin="0,14,0,14" IsEnabled="{Binding CanChange}">
                <Border x:Name="PeriodHost" DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ItemsControl ItemsSource="{Binding Periods}" ItemsPanel="{StaticResource Row}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                             PreviewMouseLeftButtonUp="Period_Click" PreviewKeyDown="Period_Key" AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{ctl:T 'Period'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
            <Popup x:Name="RangePopup" PlacementTarget="{Binding ElementName=PeriodHost}" Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <ctl:SmoothBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                  CornerRadius="12" Padding="10" Margin="0,0,8,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Calendar x:Name="Cal" SelectionMode="SingleRange" FirstDayOfWeek="Monday" AutomationProperties.Name="Days to export" />
                        <TextBlock x:Name="RangeHint" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,2,8,4" />
                    </StackPanel>
                </ctl:SmoothBorder>
            </Popup>

            <Border Height="1" Background="{DynamicResource StrokeBrush}" />
            <!-- Text laid out to be read as it is, or files for a spreadsheet (the same choice as the full Export box). -->
            <DockPanel Margin="0,14,0,14" IsEnabled="{Binding CanChange}">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="PageExportFormat" Content="{ctl:T 'Text'}" IsChecked="{Binding AsText}" AutomationProperties.Name="Text files" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="PageExportFormat" Content="{ctl:T 'Spreadsheet (CSV)'}" IsChecked="{Binding AsCsv}" AutomationProperties.Name="Spreadsheet files" />
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{ctl:T 'Format'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding FormatText}" Style="{StaticResource Muted}" FontSize="12.5" />
                </StackPanel>
            </DockPanel>

            <Border Height="1" Background="{DynamicResource StrokeBrush}" />
            <DockPanel Margin="0,14,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Change…'}" Command="{Binding ChangeFolderCommand}" IsEnabled="{Binding CanChange}"
                        VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Change the folder" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{ctl:T 'Save to'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Border Height="1" Background="{DynamicResource StrokeBrush}" />
            <DockPanel Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Cancel'}" Command="{Binding CloseCommand}" IsEnabled="{Binding CanChange}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" IsDefault="True" AutomationProperties.Name="Export the files">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Margin="0,0,8,0">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center"
                                           Visibility="{Binding IsBusy, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                <ctl:Spinner Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                            </Grid>
                            <TextBlock Text="{ctl:T 'Export'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Error, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource HotBrush}" FontSize="12.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                               Visibility="{Binding Error, Converter={StaticResource Vis}}" />
                </Grid>
            </DockPanel>
        </StackPanel>
    </ctl:SmoothBorder>
</UserControl>
