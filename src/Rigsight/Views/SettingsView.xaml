<UserControl x:Class="Rigsight.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,16,0" />
        </Style>
        <!-- An accent swatch: a dot in the colour, ringed while picked. -->
        <Style x:Key="Swatch" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <!-- Focusable: a list item is only picked by a click once it takes focus. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="28" Height="28" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse x:Name="Dot" Width="18" Height="18" Fill="{Binding Brush}" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="4,26,0,8" />
        </Style>

        <!-- ── The sidebar editor ── -->

        <!-- A page's grip: six dots. Dragged, it moves the page to any place in any group; focused, the arrow keys do
             the same (see the code-behind). -->
        <GeometryGroup x:Key="GripDots">
            <EllipseGeometry Center="5.5,3.5" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="10.5,3.5" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="5.5,8" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="10.5,8" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="5.5,12.5" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="10.5,12.5" RadiusX="1.2" RadiusY="1.2" />
        </GeometryGroup>
        <Style x:Key="Grip" TargetType="Thumb">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <Path Width="16" Height="16" Data="{StaticResource GripDots}" Fill="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A name to type over: a plain line of text until pointed at or typed in. Emptied, it shows the built-in name
             (its Tag) faintly, which is what the sidebar goes back to. -->
        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MaxLength" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="5,3">
                            <Grid>
                                <!-- A page that keeps its own name shows it here, as readable as a typed one; faint only while the box is being typed in. -->
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center" Margin="2,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FaintBrush}" />
                                <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One page: grip, name, show switch. The whole row is shaded while pointed at, with room at its sides. -->
        <DataTemplate x:Key="SidebarRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Margin="-10,0" Padding="4,2,10,2">
                <DockPanel>
                    <Thumb DockPanel.Dock="Left" Style="{StaticResource Grip}"
                           AutomationProperties.Name="{Binding Title, StringFormat='Move {0}: drag it, or use the arrow keys'}"
                           DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" PreviewKeyDown="Grip_PreviewKeyDown" />
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsShown}" IsEnabled="{Binding CanHide}"
                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat='Show {0}'}" />
                    <TextBox x:Name="PageName" Style="{StaticResource NameBox}" Margin="2,0,0,0" Tag="{Binding BuiltInTitle}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding BuiltInTitle, StringFormat='Name of {0}'}" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsShown}" Value="False">
                    <Setter TargetName="PageName" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One group: its heading (name and switch) where it has one, its pages, and a box to drop a page in once
             every page has been moved out. A line parts it from the group above. -->
        <DataTemplate x:Key="SidebarGroup">
            <StackPanel>
                <StackPanel Visibility="{Binding HasHeading, Converter={StaticResource Vis}}">
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,10" />
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowHeading}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding BuiltInName, StringFormat='Show the {0} heading'}">
                            <TextBlock Text="Heading" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </CheckBox>
                        <TextBox Style="{StaticResource NameBox}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}"
                                 CharacterCasing="Upper" Margin="-6,0,0,0" Tag="{Binding BuiltInHeading}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding BuiltInName, StringFormat='Name of the {0} heading'}" />
                    </DockPanel>
                </StackPanel>
                <ItemsControl x:Name="Pages" ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource SidebarRow}" Focusable="False" />
                <Grid x:Name="DropBox" Margin="0,2" Visibility="{Binding ShowDropBox, Converter={StaticResource Vis}}">
                    <Rectangle x:Name="DropEdge" RadiusX="6" RadiusY="6" StrokeThickness="1" StrokeDashArray="3 3" Stroke="{DynamicResource StrokeBrush}" />
                    <TextBlock Text="Drag a page here" FontSize="12.5" Foreground="{DynamicResource FaintBrush}" Margin="10,8" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- On a wide window the page is centred like the others, and this column is at its left. -->
        <Grid MaxWidth="{StaticResource PageFrame}">
        <StackPanel Margin="32,26,32,40" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource Vis}}" />

            <!-- General -->
            <TextBlock Text="GENERAL" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Unit" Content="°C"
                                             IsChecked="{Binding UseFahrenheit, Converter={StaticResource Equals}, ConverterParameter=False}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Unit" Content="°F"
                                             IsChecked="{Binding UseFahrenheit, Converter={StaticResource Equals}, ConverterParameter=True}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Temperature unit" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox DockPanel.Dock="Right" Width="190" VerticalAlignment="Center" ItemsSource="{Binding StartPageOptions}"
                                  DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding StartPage}" />
                        <TextBlock Text="Open Rigsight on" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Margin="0,10">
                        <TextBlock Text="Start with Windows" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Live" Content="0.5 s"
                                             IsChecked="{Binding LiveRefreshMs, Converter={StaticResource Equals}, ConverterParameter=500}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Live" Content="1 s"
                                             IsChecked="{Binding LiveRefreshMs, Converter={StaticResource Equals}, ConverterParameter=1000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Live" Content="2 s"
                                             IsChecked="{Binding LiveRefreshMs, Converter={StaticResource Equals}, ConverterParameter=2000}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Live refresh rate" Style="{StaticResource Title}" />
                            <TextBlock Text="While this window is open." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- Appearance -->
            <TextBlock Text="APPEARANCE" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Dark"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=dark}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Grey"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=grey}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Light"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=light}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="System"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=system}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Theme" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource Swatch}" VerticalAlignment="Center"
                                 AutomationProperties.Name="Accent colour" ItemsSource="{Binding AccentOptions}" SelectedValuePath="Key" SelectedValue="{Binding Accent}" />
                        <TextBlock Text="Accent colour" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- The sidebar: its editor slides in from the right (below). What is hidden is said here, when anything is. -->
                    <DockPanel Style="{StaticResource Row}" DataContext="{Binding Sidebar}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Edit" Command="{Binding EditCommand}"
                                VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Edit the sidebar" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sidebar" Style="{StaticResource Title}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HiddenSummary}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding HiddenSummary, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- Tracking -->
            <TextBlock Text="TRACKING" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Pause 1 hour" Command="{Binding PauseCommand}" CommandParameter="60"
                                    Visibility="{Binding IsPaused, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <Button Style="{StaticResource GhostButton}" Content="Pause until resumed" Command="{Binding PauseCommand}" CommandParameter="-1" Margin="8,0,0,0"
                                    Visibility="{Binding IsPaused, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <Button Style="{StaticResource AccentButton}" Content="Resume" Command="{Binding ResumeCommand}"
                                    Visibility="{Binding IsPaused, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pause tracking" Style="{StaticResource Title}" />
                            <TextBlock Text="{Binding PauseText}" Style="{StaticResource Hint}" Visibility="{Binding PauseText, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="2 min" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=2}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="5 min" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="10 min" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="15 min" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=15}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Count me as away after" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FullscreenCountsAsActive}" Margin="0,10">
                        <TextBlock Text="Fullscreen apps count as in use" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Proc" Content="5 s" IsChecked="{Binding ProcessIntervalSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Proc" Content="10 s" IsChecked="{Binding ProcessIntervalSeconds, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Proc" Content="30 s" IsChecked="{Binding ProcessIntervalSeconds, Converter={StaticResource Equals}, ConverterParameter=30}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Per-app CPU and memory sampling" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- Sensors: outlined, with a dot by its title, while something here needs a look; Settings opens with it centred. -->
            <StackPanel ctl:Attention.Section="sensors">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SENSORS" Style="{StaticResource Section}" />
                <!-- Same top and bottom margins as the section title, so the dot sits on its line. -->
                <Ellipse Width="7" Height="7" Margin="8,26,0,8" VerticalAlignment="Center" Fill="{DynamicResource WarmBrush}"
                         Visibility="{Binding SensorsNeedAttention, Converter={StaticResource Vis}}" />
            </StackPanel>
            <ctl:SmoothBorder Padding="20,8">
                <ctl:SmoothBorder.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SensorsNeedAttention}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:SmoothBorder.Style>
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="1 s" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=1000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="2 s" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=2000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="5 s" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=5000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="10 s" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=10000}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Background sensor sampling" Style="{StaticResource Title}" />
                            <TextBlock Text="While this window is closed." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding YieldToHardwareApps}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="Step aside for RGB and fan apps" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,16,0"
                                       Text="While iCUE, Gigabyte Control Center, Armoury Crate or a similar app is running, the hardware it controls isn't read, so the two never talk to it at once." />
                        </StackPanel>
                    </CheckBox>
                    <!-- What's being left out right now: information, outside the switch so clicking it doesn't flip it. "Got it"
                         acknowledges it (so does changing the switch); until then Settings is pointed at. -->
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding SensorPausedText, Converter={StaticResource Vis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Got it" Command="{Binding AcknowledgePausedCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Got it, sensors left out for other apps"
                                Visibility="{Binding ShowPausedGotIt, Converter={StaticResource Vis}}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SensorPausedText}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>
                    <!-- A separate matter from the switch above: the last hardware check went wrong, so the risky parts are
                         skipped whatever the switch says. "Try again" clears only this. -->
                    <Border Visibility="{Binding SensorSkippedText, Converter={StaticResource Vis}}" Margin="0,4,0,12" Padding="14,12"
                            CornerRadius="10" Background="{DynamicResource WarmSoftBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Try again" Command="{Binding RetrySensorsCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Try reading all sensors again" />
                            <!-- The hardware is being read again: a few seconds. -->
                            <ctl:Spinner DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="{Binding IsRetryingSensors, Converter={StaticResource Vis}}" />
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarmBrush}"
                                       VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="Some sensors are off after a problem" Style="{StaticResource Title}" />
                                <TextBlock Text="{Binding SensorSkippedText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Privacy -->
            <TextBlock Text="PRIVACY" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Apps that are never recorded" Style="{StaticResource Title}" />
                    <Border Height="10" />
                    <ItemsControl ItemsSource="{Binding ExcludedApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="10,3,4,3" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="6,0,0,0" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveExcludedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE711;" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <ComboBox Width="260" IsEditable="True" ItemsSource="{Binding KnownApps}" Text="{Binding AppToExclude, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource GhostButton}" Content="Don't track" Command="{Binding AddExcludedCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- Notifications -->
            <TextBlock Text="NOTIFICATIONS" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DailyRecap}" Margin="0,10">
                        <TextBlock Text="Daily recap" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SessionSummaries}" Margin="0,10">
                        <TextBlock Text="Game session summaries" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding SessionSummaries}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="5 min" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="15 min" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=15}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="30 min" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="1 hour" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=60}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Only for sessions longer than" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CrashNotifications}" Margin="0,10">
                        <TextBlock Text="Crash alerts" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AlertsEnabled}" Margin="0,10">
                        <TextBlock Text="Temperature alerts" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <StackPanel IsEnabled="{Binding AlertsEnabled}">
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuLimitText}" Width="56" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Slider DockPanel.Dock="Right" Width="280" Minimum="60" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CpuLimit}" VerticalAlignment="Center" />
                            <TextBlock Text="CPU limit" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GpuLimitText}" Width="56" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Slider DockPanel.Dock="Right" Width="280" Minimum="60" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GpuLimit}" VerticalAlignment="Center" />
                            <TextBlock Text="GPU limit" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HotSpotLimitText}" Width="56" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Slider DockPanel.Dock="Right" Width="280" Minimum="70" Maximum="110" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HotSpotLimit}" VerticalAlignment="Center" />
                            <TextBlock Text="GPU hot spot limit" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="5 s" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="10 s" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="30 s" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="60 s" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Only alert if it lasts" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="5 min" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="10 min" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="30 min" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="1 hour" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="At most one alert every" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="NStyle" Content="Rigsight cards" IsChecked="{Binding NotificationStyle, Converter={StaticResource Equals}, ConverterParameter=Card}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="NStyle" Content="Windows notifications" IsChecked="{Binding NotificationStyle, Converter={StaticResource Equals}, ConverterParameter=Windows}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Style" Style="{StaticResource Title}" />
                            <TextBlock Text="Windows notifications also stay in the notification center." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding NotificationStyle, Converter={StaticResource Equals}, ConverterParameter=Card}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="CardSec" Content="5 s" IsChecked="{Binding CardSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CardSec" Content="8 s" IsChecked="{Binding CardSeconds, Converter={StaticResource Equals}, ConverterParameter=8}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CardSec" Content="15 s" IsChecked="{Binding CardSeconds, Converter={StaticResource Equals}, ConverterParameter=15}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Cards stay on screen for" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding QuietDuringFullscreen}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="Stay quiet while I'm gaming" Style="{StaticResource Title}" />
                            <TextBlock Text="Temperature alerts still come through." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="Daily recap" Command="{Binding PreviewCommand}" CommandParameter="recap" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Game session" Command="{Binding PreviewCommand}" CommandParameter="session" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Temperature alert" Command="{Binding PreviewCommand}" CommandParameter="alert" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Crash" Command="{Binding PreviewCommand}" CommandParameter="crash" />
                        </StackPanel>
                        <TextBlock Text="Preview" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- History -->
            <TextBlock Text="HISTORY" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="3 months" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=90}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="1 year" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=365}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="2 years" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=730}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="Forever" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=0}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Keep history for" Style="{StaticResource Title}" />
                            <TextBlock Text="About 25 MB a year." Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding TrackingSince}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Visibility="{Binding TrackingSince, Converter={StaticResource Vis}}" />
                    <WrapPanel Margin="0,10,0,12">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center"
                                               Visibility="{Binding IsExporting, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <ctl:Spinner Visibility="{Binding IsExporting, Converter={StaticResource Vis}}" />
                                </Grid>
                                <TextBlock Text="Export app usage (CSV)" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Open data folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource HotBrush}"
                                               Visibility="{Binding IsClearing, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <ctl:Spinner Visibility="{Binding IsClearing, Converter={StaticResource Vis}}" />
                                </Grid>
                                <TextBlock Text="Clear all history…" Foreground="{DynamicResource HotBrush}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- Updates -->
            <TextBlock Text="UPDATES" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Spinner Margin="0,0,12,0" Visibility="{Binding Update.IsBusy, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="Download page" Command="{Binding Update.OpenDownloadPageCommand}" Margin="0,0,8,0"
                                    ToolTip="Get the latest installer from the Rigsight website"
                                    Visibility="{Binding Update.ShowFailed, Converter={StaticResource Vis}}" />
                            <Button Command="{Binding Update.ActionCommand}" Content="{Binding Update.ActionText}" MinWidth="150"
                                    AutomationProperties.Name="{Binding Update.ActionText}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Update.ActionIsPrimary}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Update.IsBusy}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}">
                                <Run Text="Rigsight" /> <Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Update.StatusText}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate}" Margin="0,10">
                        <TextBlock Text="Update automatically" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- About -->
            <TextBlock Text="ABOUT" Style="{StaticResource Section}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Quit…" Command="{Binding QuitAgentCommand}"
                                VerticalAlignment="Center" AutomationProperties.Name="Quit background agent" />
                        <StackPanel>
                            <TextBlock Text="Background agent" Style="{StaticResource Title}" />
                            <TextBlock Text="Records your history and runs the widgets, overlay and notifications." Style="{StaticResource Hint}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,16,0" Foreground="{DynamicResource WarmBrush}"
                                       Text="It's running without admin rights, so CPU and motherboard sensors are unavailable. Restart it from the tray or the sidebar."
                                       Visibility="{Binding AgentIsAdmin, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="See all updates"
                                Command="{Binding DataContext.WhatsNew.SeeAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="See all updates" />
                        <TextBlock Text="What's new" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding ReportBugText}" Command="{Binding ReportBugCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="118" AutomationProperties.Name="Report a bug" />
                        <StackPanel>
                            <TextBlock Text="Report a bug" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Opens a form in your browser. Rigsight itself sends nothing." />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <!-- The button itself says "Copied" for a moment: no line of text appears under the row. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding CopyLogsText}" Command="{Binding CopyProblemReportCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="118" AutomationProperties.Name="Copy logs" />
                        <StackPanel>
                            <TextBlock Text="Logs" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Rigsight's recent log, with its version and your hardware, to paste into the bug form or wherever you ask for help." />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <!-- Buy Me a Coffee's own yellow, the same in every theme. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Background="#FFDD00" Foreground="#000000" Content="Buy me a coffee" Command="{Binding SupportCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Buy me a coffee" />
                        <StackPanel>
                            <TextBlock Text="Support Rigsight" Style="{StaticResource Title}" />
                            <TextBlock Text="Rigsight is free and made by one person." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="View" Command="{Binding OpenNoticesCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="View open-source notices" />
                        <StackPanel>
                            <TextBlock Text="Open-source notices" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Licences of everything Rigsight includes." />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,10">
                        <TextBlock Text="Hardware readings" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="From LibreHardwareMonitor (MPL-2.0), with low-level access through the PawnIO driver. NVIDIA readings in the background use NVML for minimal overhead." />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>
        </StackPanel>
        </Grid>
    </ScrollViewer>

        <!-- Over the page while the sidebar editor is open: dims it a little; a click on it closes the editor. -->
        <Border x:Name="EditorScrim" Background="#000000" Opacity="0" Visibility="Collapsed" MouseLeftButtonDown="EditorScrim_MouseLeftButtonDown" />

        <!-- The sidebar editor: a sheet over the page that slides in from the right, as a widget's editor does (see the
             code-behind). Every change shows in the sidebar at once; the x, Esc or a click on the page closes it. -->
        <Border x:Name="EditorPanel" Width="430" HorizontalAlignment="Right" Visibility="Collapsed" DataContext="{Binding Sidebar}"
                Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource SidebarBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="EditorSlide" X="430" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="22,22,22,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Close" AutomationProperties.Name="Close the editor"
                            Command="{Binding CloseEditorCommand}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE711;" />
                    </Button>
                    <TextBlock Text="Sidebar" Style="{StaticResource H2}" />
                </DockPanel>
                <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <!-- The line showing where a dragged page will land is drawn over the rows, and scrolls with them. -->
                    <Grid x:Name="EditorRows" Margin="22,0,22,26">
                        <ItemsControl x:Name="EditorGroups" ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SidebarGroup}" Focusable="False" />
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="DropLine" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
