<UserControl x:Class="Rigsight.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:views="clr-namespace:Rigsight.Views">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,16,0" />
        </Style>
        <!-- An accent swatch: a dot in the colour, ringed while picked. -->
        <Style x:Key="Swatch" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <!-- Focusable: a list item is only picked by a click once it takes focus. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="28" Height="28" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse x:Name="Dot" Width="18" Height="18" Fill="{Binding Brush}" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Settings → Rewind: a switch as a tile (a coloured icon, its name and a short line, a tick), so a few of them
             sit side by side instead of one tall row each. Off: the icon greys and the name dims. -->
        <Style x:Key="RewindTile" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <ctl:SmoothBorder x:Name="Bd" CornerRadius="8" Padding="12,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <DockPanel>
                                <Border x:Name="Tick" DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center" Margin="10,0,0,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource FaintBrush}">
                                    <TextBlock x:Name="TickMark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnAccentBrush}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter x:Name="Body" VerticalAlignment="Center" />
                            </DockPanel>
                        </ctl:SmoothBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TickMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.5" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A heading inside a tab that holds two groups (Privacy under Tracking, Updates and About): bold and white. -->
        <Style x:Key="SubHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="2,24,0,10" />
        </Style>
        <!-- A tab of the page: its name, with the accent under it while picked. The weight never changes, so the row
             doesn't shift when another is picked. -->
        <Style x:Key="SettingsTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsTab" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="14,9,14,11">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="Line" Height="2" CornerRadius="1" Margin="14,0,14,-1" VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A box that opens a list under it (Settings › Ask RigSight's model): like a drop-down, its text on the left. -->
        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="32" CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="4,26,0,8" />
        </Style>

        <!-- ── The sidebar editor ── -->

        <!-- A page's grip: six dots. Dragged, it moves the page to any place in any group; focused, the arrow keys do
             the same (see the code-behind). -->
        <GeometryGroup x:Key="GripDots">
            <EllipseGeometry Center="5.5,3.5" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="10.5,3.5" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="5.5,8" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="10.5,8" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="5.5,12.5" RadiusX="1.2" RadiusY="1.2" />
            <EllipseGeometry Center="10.5,12.5" RadiusX="1.2" RadiusY="1.2" />
        </GeometryGroup>
        <Style x:Key="Grip" TargetType="Thumb">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <Path Width="16" Height="16" Data="{StaticResource GripDots}" Fill="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A name to type over: a plain line of text until pointed at or typed in. Emptied, it shows the built-in name
             (its Tag) faintly, which is what the sidebar goes back to. -->
        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MaxLength" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="5,3">
                            <Grid>
                                <!-- A page that keeps its own name shows it here, as readable as a typed one; faint only while the box is being typed in. -->
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center" Margin="2,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FaintBrush}" />
                                <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One page: grip, name, show switch. The whole row is shaded while pointed at, with room at its sides. -->
        <DataTemplate x:Key="SidebarRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Margin="-10,0" Padding="4,2,10,2">
                <DockPanel>
                    <Thumb DockPanel.Dock="Left" Style="{StaticResource Grip}"
                           AutomationProperties.Name="{Binding Title, StringFormat='Move {0}: drag it, or use the arrow keys'}"
                           DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" PreviewKeyDown="Grip_PreviewKeyDown" />
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsShown}" IsEnabled="{Binding CanHide}"
                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat='Show {0}'}" />
                    <TextBox x:Name="PageName" Style="{StaticResource NameBox}" Margin="2,0,0,0" Tag="{Binding BuiltInTitle}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding BuiltInTitle, StringFormat='Name of {0}'}" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsShown}" Value="False">
                    <Setter TargetName="PageName" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One group: its heading (name and switch) where it has one, its pages, and a box to drop a page in once
             every page has been moved out. A line parts it from the group above. -->
        <DataTemplate x:Key="SidebarGroup">
            <StackPanel>
                <StackPanel Visibility="{Binding HasHeading, Converter={StaticResource Vis}}">
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,10" />
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowHeading}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding BuiltInName, StringFormat='Show the {0} heading'}">
                            <TextBlock Text="{ctl:T 'Heading'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </CheckBox>
                        <TextBox Style="{StaticResource NameBox}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}"
                                 CharacterCasing="Upper" Margin="-6,0,0,0" Tag="{Binding BuiltInHeading}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding BuiltInName, StringFormat='Name of the {0} heading'}" />
                    </DockPanel>
                </StackPanel>
                <ItemsControl x:Name="Pages" ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource SidebarRow}" Focusable="False" />
                <Grid x:Name="DropBox" Margin="0,2" Visibility="{Binding ShowDropBox, Converter={StaticResource Vis}}">
                    <Rectangle x:Name="DropEdge" RadiusX="6" RadiusY="6" StrokeThickness="1" StrokeDashArray="3 3" Stroke="{DynamicResource StrokeBrush}" />
                    <TextBlock Text="{ctl:T 'Drag a page here'}" FontSize="12.5" Foreground="{DynamicResource FaintBrush}" Margin="10,8" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- On a wide window the page is centred like the others. -->
        <Grid MaxWidth="{StaticResource PageFrame}">
        <!-- A column up to 900 wide in the middle, as Overlay's (it sat at the left: the user, 2026-10-20), the same width
             on every tab: stretched to its most, not sized to the rows (a tab with short rows would shrink to them). -->
        <Grid Margin="32,26,32,40" MaxWidth="900">
        <StackPanel>
            <TextBlock Text="{ctl:T 'Settings'}" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource Vis}}" />

            <!-- The sections as tabs, so a setting is a click away, not a scroll: the tab's name is its section's title.
                 Privacy sits with Tracking and Updates with About, under their own bold headings. -->
            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,20">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'General'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=general}" />
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'Appearance'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=appearance}" />
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'Tracking'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=tracking}" />
                    <!-- A dot while something on Sensors needs a look. -->
                    <RadioButton Style="{StaticResource SettingsTab}" AutomationProperties.Name="Sensors" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=sensors}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ctl:T 'Sensors'}" />
                            <Ellipse Width="7" Height="7" Margin="8,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource WarmBrush}"
                                     Visibility="{Binding SensorsNeedAttention, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'Notifications'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=notifications}" />
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'Ask RigSight'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=ai}"
                                 Visibility="{Binding ShowAiTab, Converter={StaticResource Vis}}" />
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'History'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=history}" />
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'Rewind'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=rewind}" />
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'About'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=about}" />
                    <!-- Only on a standard account, where some readings can't be had. -->
                    <RadioButton Style="{StaticResource SettingsTab}" Content="{ctl:T 'Admin rights'}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=admin}"
                                 Visibility="{Binding StandardAccount, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <!-- General -->
            <StackPanel Visibility="{Binding IsGeneral, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <!-- Language: English is built in; another language is downloaded when picked (its size shows until
                         then), and RigSight then asks to open again in it. The list floats, so nothing moves. -->
                    <StackPanel DataContext="{Binding Language}">
                        <DockPanel Style="{StaticResource Row}">
                            <Grid DockPanel.Dock="Right" Width="190" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding Options}" SelectedValuePath="Code" SelectedValue="{Binding Chosen}"
                                          IsEnabled="{Binding CanPick}" AutomationProperties.Name="Language">
                                    <!-- The closed box: the language's name only. -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <!-- The open list: a tick on the one in use, and the size of a pack not downloaded yet. -->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="MinWidth" Value="260" />
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <Grid DockPanel.Dock="Left" Width="20">
                                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}" />
                                                            </Grid>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Note}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!-- Downloading: the app's spinner in the box, with the language being fetched. -->
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="12,0" IsHitTestVisible="False"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Spinner Width="14" Height="14" StrokeThickness="2" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TargetName}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{ctl:T 'Language'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- One statement, a real button at its end: ready to open again, or what went wrong and Try again. -->
                        <ctl:SmoothBorder Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14,10" Margin="0,-2,0,10"
                                          Visibility="{Binding ShowStatus, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource GoodBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsReady, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource WarmBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsWarning, Converter={StaticResource Vis}}" />
                                </Grid>
                                <!-- Ready: the main action (filled); a problem: Try again (quieter). -->
                                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding ActCommand}"
                                        VerticalAlignment="Center" Content="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}"
                                        Visibility="{Binding IsReady, Converter={StaticResource Vis}}" />
                                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding ActCommand}"
                                        VerticalAlignment="Center" AutomationProperties.Name="{Binding ActionText}"
                                        Visibility="{Binding IsWarning, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding ActionText}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ctl:SmoothBorder>
                    </StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Unit" Content="°C"
                                             IsChecked="{Binding UseFahrenheit, Converter={StaticResource Equals}, ConverterParameter=False}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Unit" Content="°F"
                                             IsChecked="{Binding UseFahrenheit, Converter={StaticResource Equals}, ConverterParameter=True}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Temperature unit'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- How times are written everywhere: as Windows does, or always 12-hour or 24-hour -->
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Clock" Content="{ctl:T 'As Windows'}"
                                             IsChecked="{Binding ClockStyle, Converter={StaticResource Equals}, ConverterParameter=Windows}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Clock" Content="{ctl:T '12-hour'}"
                                             IsChecked="{Binding ClockStyle, Converter={StaticResource Equals}, ConverterParameter=H12}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Clock" Content="{ctl:T '24-hour'}"
                                             IsChecked="{Binding ClockStyle, Converter={StaticResource Equals}, ConverterParameter=H24}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Clock'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox DockPanel.Dock="Right" Width="190" VerticalAlignment="Center" ItemsSource="{Binding StartPageOptions}"
                                  DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding StartPage}" />
                        <TextBlock Text="{ctl:T 'Open RigSight on'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Start with Windows'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Live" Content="{ctl:T '0.5 s'}"
                                             IsChecked="{Binding LiveRefreshMs, Converter={StaticResource Equals}, ConverterParameter=500}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Live" Content="{ctl:T '1 s'}"
                                             IsChecked="{Binding LiveRefreshMs, Converter={StaticResource Equals}, ConverterParameter=1000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Live" Content="{ctl:T '2 s'}"
                                             IsChecked="{Binding LiveRefreshMs, Converter={StaticResource Equals}, ConverterParameter=2000}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Live refresh rate'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'While this window is open.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Appearance -->
            <StackPanel Visibility="{Binding IsAppearance, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <!-- The themes as small pictures of the window in each: its background, text, a card and its accent. -->
                    <TextBlock Text="{ctl:T 'Theme'}" Style="{StaticResource Title}" Margin="0,10,0,10" />
                    <ListBox Style="{StaticResource ChipList}" AutomationProperties.Name="Theme" ItemsSource="{Binding ThemeOptions}"
                             SelectedValuePath="Key" SelectedValue="{Binding Theme}" Margin="-6,0,-6,4">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- One row, the cards sharing its width: none is left alone on a second line. -->
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <StackPanel Margin="6,0,6,10" Background="Transparent">
                                                <Grid>
                                                    <Border x:Name="Ring" CornerRadius="12" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Opacity="0" />
                                                    <Border Height="68" CornerRadius="10" Background="{Binding Bg}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                                        <Grid Margin="16,10,10,10">
                                                            <Border Width="3" Height="16" CornerRadius="2" Margin="-10,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding Accent}" />
                                                            <StackPanel>
                                                                <Border Height="5" Width="50" CornerRadius="3" HorizontalAlignment="Left" Background="{Binding Text}" />
                                                                <Border Height="5" Width="34" CornerRadius="3" HorizontalAlignment="Left" Background="{Binding Muted}" Margin="0,6,0,0" />
                                                                <Border Height="16" Width="72" CornerRadius="5" HorizontalAlignment="Left" Background="{Binding Card}" Margin="0,9,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Margin="2,7,0,0" Foreground="{TemplateBinding Foreground}" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <DockPanel Style="{StaticResource Row}">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource Swatch}" VerticalAlignment="Center"
                                 AutomationProperties.Name="Accent colour" ItemsSource="{Binding AccentOptions}" SelectedValuePath="Key" SelectedValue="{Binding Accent}" />
                        <TextBlock Text="{ctl:T 'Accent colour'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- Only once an accent is picked: from then on every part's colour is a shade of it, and this says
                         whether the colours that judge a reading follow it too. -->
                    <DockPanel Style="{StaticResource Row}" Visibility="{Binding AccentPicked, Converter={StaticResource Vis}}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="StatusColors" Content="{ctl:T 'Green, amber, red'}"
                                             IsChecked="{Binding KeepStatusColors, Converter={StaticResource Equals}, ConverterParameter=True}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="StatusColors" Content="{ctl:T 'Accent'}"
                                             IsChecked="{Binding KeepStatusColors, Converter={StaticResource Equals}, ConverterParameter=False}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Temperature and usage colours'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- The sidebar: its editor slides in from the right (below). What is hidden is said here, when anything is. -->
                    <DockPanel Style="{StaticResource Row}" DataContext="{Binding Sidebar}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Edit'}" Command="{Binding EditCommand}"
                                VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Edit the sidebar" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Sidebar'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HiddenSummary}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding HiddenSummary, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Tracking -->
            <StackPanel Visibility="{Binding IsTracking, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Pause 1 hour'}" Command="{Binding PauseCommand}" CommandParameter="60"
                                    Visibility="{Binding IsPaused, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Pause until resumed'}" Command="{Binding PauseCommand}" CommandParameter="-1" Margin="8,0,0,0"
                                    Visibility="{Binding IsPaused, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Resume'}" Command="{Binding ResumeCommand}"
                                    Visibility="{Binding IsPaused, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Pause tracking'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{Binding PauseText}" Style="{StaticResource Hint}" Visibility="{Binding PauseText, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="{ctl:T '2 min'}" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=2}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="{ctl:T '5 min'}" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="{ctl:T '10 min'}" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Idle" Content="{ctl:T '15 min'}" IsChecked="{Binding IdleMinutes, Converter={StaticResource Equals}, ConverterParameter=15}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Count me as away after'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FullscreenCountsAsActive}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Fullscreen apps count as in use'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Proc" Content="{ctl:T '5 s'}" IsChecked="{Binding ProcessIntervalSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Proc" Content="{ctl:T '10 s'}" IsChecked="{Binding ProcessIntervalSeconds, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Proc" Content="{ctl:T '30 s'}" IsChecked="{Binding ProcessIntervalSeconds, Converter={StaticResource Equals}, ConverterParameter=30}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Per-app CPU and memory sampling'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Sensors: outlined, with a dot by its title, while something here needs a look; Settings opens with it centred. -->
            <StackPanel ctl:Attention.Section="sensors" Visibility="{Binding IsSensors, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder Padding="20,8">
                <ctl:SmoothBorder.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SensorsNeedAttention}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:SmoothBorder.Style>
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="{ctl:T '1 s'}" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=1000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="{ctl:T '2 s'}" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=2000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="{ctl:T '5 s'}" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=5000}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Sensor" Content="{ctl:T '10 s'}" IsChecked="{Binding SensorIntervalMs, Converter={StaticResource Equals}, ConverterParameter=10000}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Background sensor sampling'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'While this window is closed.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding YieldToHardwareApps}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Step aside for RGB and fan apps'}" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,16,0"
                                       Text="{ctl:T 'While iCUE, Gigabyte Control Center, Armoury Crate or a similar app is running, the hardware it controls isn\'t read, so the two never talk to it at once.'}" />
                        </StackPanel>
                    </CheckBox>
                    <!-- What's being left out right now: information, outside the switch so clicking it doesn't flip it. "Got it"
                         acknowledges it (so does changing the switch); until then Settings is pointed at. -->
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding SensorPausedText, Converter={StaticResource Vis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Got it'}" Command="{Binding AcknowledgePausedCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Got it, sensors left out for other apps"
                                Visibility="{Binding ShowPausedGotIt, Converter={StaticResource Vis}}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SensorPausedText}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>
                    <!-- The driver CPU readings come through is missing, or installed and not running: said here with the
                         way out. "Install" has the agent fetch it (a spinner meanwhile); "Not now" only stops Settings
                         being pointed at. -->
                    <Border Visibility="{Binding DriverTitle, Converter={StaticResource Vis}}" Margin="0,4,0,12" Padding="14,12"
                            CornerRadius="10" Background="{DynamicResource WarmSoftBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{Binding DriverButtonText}" Command="{Binding InstallDriverCommand}"
                                    VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="Get the PawnIO driver"
                                    Visibility="{Binding IsInstallingDriver, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Not now'}" Command="{Binding DismissDriverCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Not now, leave the PawnIO driver"
                                    Visibility="{Binding ShowDriverNotNow, Converter={StaticResource Vis}}" />
                            <ctl:Spinner DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="{Binding IsInstallingDriver, Converter={StaticResource Vis}}" />
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarmBrush}"
                                       VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding DriverTitle}" Style="{StaticResource Title}" />
                                <TextBlock Text="{Binding DriverText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- A separate matter from the switch above: the last hardware check went wrong, so the risky parts are
                         skipped whatever the switch says. "Try again" clears only this. -->
                    <Border Visibility="{Binding SensorSkippedText, Converter={StaticResource Vis}}" Margin="0,4,0,12" Padding="14,12"
                            CornerRadius="10" Background="{DynamicResource WarmSoftBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Try again'}" Command="{Binding RetrySensorsCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Try reading all sensors again" />
                            <!-- The hardware is being read again: a few seconds. -->
                            <ctl:Spinner DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="{Binding IsRetryingSensors, Converter={StaticResource Vis}}" />
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarmBrush}"
                                       VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="{ctl:T 'Some sensors are off after a problem'}" Style="{StaticResource Title}" />
                                <TextBlock Text="{Binding SensorSkippedText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Privacy -->
            <StackPanel Visibility="{Binding IsTracking, Converter={StaticResource Vis}}">
            <TextBlock Text="{ctl:T 'Privacy'}" Style="{StaticResource SubHead}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="{ctl:T 'Apps that are never recorded'}" Style="{StaticResource Title}" />
                    <Border Height="10" />
                    <ItemsControl ItemsSource="{Binding ExcludedApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="10,3,4,3" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="6,0,0,0" ToolTip="{ctl:T 'Remove'}"
                                                Command="{Binding DataContext.RemoveExcludedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE711;" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <ComboBox Width="260" IsEditable="True" ItemsSource="{Binding KnownApps}" Text="{Binding AppToExclude, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Don\'t track'}" Command="{Binding AddExcludedCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Notifications -->
            <StackPanel Visibility="{Binding IsNotifications, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DailyRecap}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Daily recap'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SessionSummaries}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Game session summaries'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding SessionSummaries}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="{ctl:T '5 min'}" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="{ctl:T '15 min'}" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=15}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="{ctl:T '30 min'}" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SessMin" Content="{ctl:T '1 hour'}" IsChecked="{Binding SessionSummaryMinMinutes, Converter={StaticResource Equals}, ConverterParameter=60}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Only for sessions longer than'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CrashNotifications}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Crash alerts'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AlertsEnabled}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Temperature alerts'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <StackPanel IsEnabled="{Binding AlertsEnabled}">
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuLimitText}" Width="56" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Slider DockPanel.Dock="Right" Width="280" Minimum="60" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CpuLimit}" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'CPU limit'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GpuLimitText}" Width="56" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Slider DockPanel.Dock="Right" Width="280" Minimum="60" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GpuLimit}" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'GPU limit'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HotSpotLimitText}" Width="56" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Slider DockPanel.Dock="Right" Width="280" Minimum="70" Maximum="110" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HotSpotLimit}" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'GPU hot spot limit'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="{ctl:T '5 s'}" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="{ctl:T '10 s'}" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="{ctl:T '30 s'}" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Sustain" Content="{ctl:T '60 s'}" IsChecked="{Binding SustainSeconds, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ctl:T 'Only alert if it lasts'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="{ctl:T '5 min'}" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="{ctl:T '10 min'}" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="{ctl:T '30 min'}" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Cool" Content="{ctl:T '1 hour'}" IsChecked="{Binding CooldownMinutes, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ctl:T 'At most one alert every'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="NStyle" Content="{ctl:T 'RigSight cards'}" IsChecked="{Binding NotificationStyle, Converter={StaticResource Equals}, ConverterParameter=Card}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="NStyle" Content="{ctl:T 'Windows notifications'}" IsChecked="{Binding NotificationStyle, Converter={StaticResource Equals}, ConverterParameter=Windows}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Style'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Windows notifications also stay in the notification center.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding NotificationStyle, Converter={StaticResource Equals}, ConverterParameter=Card}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="CardSec" Content="{ctl:T '5 s'}" IsChecked="{Binding CardSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CardSec" Content="{ctl:T '8 s'}" IsChecked="{Binding CardSeconds, Converter={StaticResource Equals}, ConverterParameter=8}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CardSec" Content="{ctl:T '15 s'}" IsChecked="{Binding CardSeconds, Converter={StaticResource Equals}, ConverterParameter=15}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Cards stay on screen for'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding QuietDuringFullscreen}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Stay quiet while I\'m gaming'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Temperature alerts still come through.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Daily recap'}" Command="{Binding PreviewCommand}" CommandParameter="recap" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Game session'}" Command="{Binding PreviewCommand}" CommandParameter="session" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Temperature alert'}" Command="{Binding PreviewCommand}" CommandParameter="alert" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Crash'}" Command="{Binding PreviewCommand}" CommandParameter="crash" />
                        </StackPanel>
                        <TextBlock Text="{ctl:T 'Preview'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- AI: how the helper answers, each way's own settings, what it may send, and its button. Laid out as drawn in
                 the approved mock-up (2026-10-20). -->
            <StackPanel Visibility="{Binding DataContext.IsAi, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" DataContext="{Binding Ai}">
                <!-- The first visit: what the helper sends, as a warning to read, put away with its close button. -->
                <ctl:SmoothBorder CornerRadius="12" Padding="16,14,44,14" Margin="0,0,0,14" Background="{DynamicResource WarmSoftBrush}"
                                  BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1" AutomationProperties.Name="What the AI helper sends"
                                  Visibility="{Binding ShowSendingNote, Converter={StaticResource Vis}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'What the AI helper sends'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" />
                            <!-- Two sentences, no more (the wording audit of 2026-10-24: settings text only where it's needed, short). -->
                            <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Text="{ctl:T 'Your question and the records it needs, from the pages switched on below.'}" />
                                <Run Text="{Binding SendingWhere, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,-6,-34,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseSendingNoteCommand}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="{ctl:T 'Close'}">
                            <!-- Drawn, not a font glyph: a glyph's box never quite matches the cross, which sat off centre. -->
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stretch="None" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False" />
                        </Button>
                    </Grid>
                </ctl:SmoothBorder>

                <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                    <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="AiMode" Content="{ctl:T 'Off'}" IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=off}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="AiMode" Content="{ctl:T 'RigSight AI'}" IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=rigsight}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="AiMode" Content="{ctl:T 'My own key'}" IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=own}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="AiMode" Content="{ctl:T 'Ollama on my PC'}" IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=ollama}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'AI helper'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- My own key or Ollama: what they miss without RigSight AI, mostly web search, until closed. -->
                <ctl:SmoothBorder CornerRadius="12" Padding="16,14,44,14" Margin="0,14,0,0" Background="{DynamicResource WarmSoftBrush}"
                                  BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1" AutomationProperties.Name="Web search"
                                  Visibility="{Binding ShowWebNote, Converter={StaticResource Vis}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Web search comes with RigSight AI'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" />
                            <TextBlock Text="{ctl:T 'Answers can also check the web for known problems and fixes for your parts, drivers and games.'}"
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Switch to RigSight AI'}" Command="{Binding UseRigSightCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,-6,-34,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseWebNoteCommand}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="{ctl:T 'Close'}">
                            <!-- Drawn, not a font glyph: a glyph's box never quite matches the cross, which sat off centre. -->
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stretch="None" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False" />
                        </Button>
                    </Grid>
                </ctl:SmoothBorder>

                <!-- RigSight AI: your plan (Free with its week's count, or a paid one with everything about it up front: the
                     plans mock-up of 2026-10-23), then the licence key. Choosing and changing a plan opens the Plans screen. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0" Visibility="{Binding IsRigSight, Converter={StaticResource Vis}}"
                                  AutomationProperties.Name="Your RigSight AI plan">
                    <StackPanel>
                        <!-- Free -->
                        <DockPanel Visibility="{Binding Plans.IsFree, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{ctl:T 'See plans'}" Command="{Binding Plans.ShowCommand}"
                                    VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'Free'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border CornerRadius="9" Background="{DynamicResource Surface2Brush}" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding Plans.Known, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Plans.StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Plans.FreeWhen}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Plans.FreeWhen, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- A paid plan, or one given by support -->
                        <views:PlanDetails DataContext="{Binding Plans}" Visibility="{Binding IsPaid, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding Plans.Done}" FontSize="12.5" Foreground="{DynamicResource GoodBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Plans.Done, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding Plans.Problem}" FontSize="13" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Plans.HasProblem, Converter={StaticResource Vis}}" />
                        <!-- After Get: the app checks for the plan by itself -->
                        <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,12,0,0"
                                          Visibility="{Binding Plans.Waiting, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Cancel'}" Command="{Binding Plans.StopWaitingCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <ctl:Spinner DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{ctl:T 'Waiting for your plan…'}" FontSize="13" />
                                    <TextBlock Text="{ctl:T 'Finish paying in your browser; it turns on here by itself.'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </ctl:SmoothBorder>

                        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16,0,4" />
                        <!-- The licence key: typed in (from the receipt email) while none is here; shown, with Copy, once it is -->
                        <StackPanel Visibility="{Binding LicenceActive, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="260" Style="{StaticResource FieldBox}" FontFamily="Consolas" Text="{Binding LicenceKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ctl:T 'Licence key'}" />
                                    <ctl:Spinner Width="14" Height="14" Margin="10,0,0,0" Visibility="{Binding ActivateCommand.IsRunning, Converter={StaticResource Vis}}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Activate'}" Command="{Binding ActivateCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{ctl:T 'Licence key'}" Style="{StaticResource Title}" />
                                    <TextBlock Text="{ctl:T 'Bought on another PC or on the website? Type the key from your receipt.'}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6" Visibility="{Binding LicenceElsewhere, Converter={StaticResource Vis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding EmailSupportCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{ctl:T 'Email support'}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock FontSize="13" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{ctl:T 'This key is in use on another PC. To move it here, contact support with your key.'}" />
                            </DockPanel>
                        </StackPanel>
                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding LicenceActive, Converter={StaticResource Vis}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="10,0">
                                    <TextBlock Text="{Binding LicenceShown}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" />
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Copy'}" Command="{Binding CopyLicenceCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Licence key'}" Style="{StaticResource Title}" />
                                <TextBlock Text="{ctl:T 'Locked to this PC. Moving to a new PC? Contact support with your key.'}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Why the key can't be used here, or why the relay can't be reached -->
                        <DockPanel Margin="0,0,0,6" Visibility="{Binding HasLicenceProblem, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding EmailSupportCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding LicenceProblemNeedsSupport, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{ctl:T 'Email support'}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding LicenceProblem}" FontSize="13" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- My own key: the service, the key, and the models that service lists for it. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8" Margin="0,14,0,0" Visibility="{Binding IsOwnKey, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="280" ItemsSource="{Binding Services}" SelectedItem="{Binding Service}" AutomationProperties.Name="{ctl:T 'AI service'}" />
                            <TextBlock Text="{ctl:T 'AI service'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                            <TextBox DockPanel.Dock="Right" Width="280" Style="{StaticResource FieldBox}" Text="{Binding CustomAddress, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{ctl:T 'Address'}" />
                            <TextBlock Text="{ctl:T 'Address'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <PasswordBox Width="280" Style="{StaticResource FieldPassword}" AutomationProperties.Name="{ctl:T 'API key'}" PasswordChanged="ApiKey_Changed" />
                                <ctl:Spinner Width="14" Height="14" Margin="0,0,10,0" Visibility="{Binding TestKeyCommand.IsRunning, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Test'}" Command="{Binding TestKeyCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{ctl:T 'API key'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,0,6" Visibility="{Binding KeyChecked, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource GoodBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding KeyWorks}" FontSize="12.5" Foreground="{DynamicResource GoodBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding KeyProblem}" FontSize="12.5" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,-4,0,6"
                                   Visibility="{Binding HasKeyProblem, Converter={StaticResource Vis}}" />
                        <DockPanel Style="{StaticResource Row}">
                            <Grid DockPanel.Dock="Right" Width="360" VerticalAlignment="Center">
                                <Button x:Name="ModelButton" Style="{StaticResource PickerButton}" IsEnabled="{Binding KeyChecked}" Command="{Binding OpenModelsCommand}" AutomationProperties.Name="{ctl:T 'Model'}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                                <!-- The service's models, the tested ones first, with a search; floats so nothing moves. -->
                                <Popup IsOpen="{Binding IsPickingModel}" PlacementTarget="{Binding ElementName=ModelButton}" Placement="Bottom" StaysOpen="False"
                                       AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=ModelButton}" VerticalOffset="6" Opened="ModelPopup_Opened">
                                    <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="6">
                                        <DockPanel>
                                            <TextBox x:Name="ModelSearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search models'}" Margin="0,0,0,6"
                                                     AutomationProperties.Name="{ctl:T 'Search models'}" Text="{Binding ModelSearch, UpdateSourceTrigger=PropertyChanged}" />
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ModelGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Heading}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="8,8,8,4" />
                                                                <ItemsControl ItemsSource="{Binding Models}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource PickRow}" AutomationProperties.Name="{Binding Name}"
                                                                                    Command="{Binding DataContext.PickModelCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                                                                                <DockPanel>
                                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PriceText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                                                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                                </DockPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </ctl:SmoothBorder>
                                </Popup>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Model'}" Style="{StaticResource Title}" />
                                <TextBlock Text="{Binding ModelPrice}" Style="{StaticResource Hint}" Visibility="{Binding ModelPrice, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Ollama on my PC (approved mock-up 2026-10-24): where it runs, the models already on it (each saying if it can
                     be used), then three picked for this PC's graphics card that download through Ollama itself. -->
                <StackPanel Visibility="{Binding IsOllama, Converter={StaticResource Vis}}">
                    <StackPanel.Resources>
                        <Style x:Key="Caps" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                        <!-- A fit pill: good when the model fits the card, warm when it doesn't all fit. -->
                        <Style x:Key="FitPill" TargetType="Border">
                            <Setter Property="CornerRadius" Value="9" />
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FitIsGood}" Value="True"><Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="FitText" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FitIsGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- A button on the boxes below (already Surface2): one step lighter, so it reads as a button. -->
                        <Style x:Key="BoxButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Style>
                        <!-- Off (no Ollama answering, or another download running): dimmed, so it doesn't look pressable. -->
                        <Style x:Key="PickButton" TargetType="Button" BasedOn="{StaticResource BoxButton}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="CancelBox" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Background" Value="{DynamicResource HotSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style x:Key="InUse" TargetType="Border">
                            <Setter Property="CornerRadius" Value="9" />
                            <Setter Property="Padding" Value="10,3" />
                            <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <!-- The panel a pick's question and download sit in: set into the pick's box, so it reads as a step of its own. -->
                        <Style x:Key="PickStep" TargetType="ctl:SmoothBorder">
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="12,10" />
                        </Style>
                    </StackPanel.Resources>
                    <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8,20,16" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <!-- The address, Check again, and under them the line that answers them (approved mock-up 2026-10-24):
                                 starting where the box starts, an icon as well as a colour, and always one line tall so nothing moves. -->
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="280" Text="{Binding OllamaAddress, UpdateSourceTrigger=PropertyChanged, Delay=600}" AutomationProperties.Name="{ctl:T 'Ollama address'}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OllamaAddressBad}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Check again'}" Command="{Binding ConnectOllamaCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Height="20" Margin="2,6,0,0">
                                    <ctl:Spinner Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding LineChecking, Converter={StaticResource Vis}}" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding LineOk, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource WarmBrush}" Margin="0,0,7,0" VerticalAlignment="Center"
                                               Visibility="{Binding LineWarn, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding OllamaLine}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LineWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{ctl:T 'Ollama address'}" Style="{StaticResource Title}" VerticalAlignment="Top" Margin="0,8,0,0" />
                        </DockPanel>

                        <!-- A problem: what's wrong, how to fix it, and the one button that does. No models yet is a step left, so grey. -->
                        <ctl:SmoothBorder CornerRadius="10" Padding="14,11" Margin="0,2,0,4" Visibility="{Binding HasOllamaBox, Converter={StaticResource Vis}}">
                            <ctl:SmoothBorder.Style>
                                <Style TargetType="ctl:SmoothBorder">
                                    <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OllamaBoxCalm}" Value="True"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:SmoothBorder.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding OllamaBoxDoCommand}" VerticalAlignment="Center" Margin="14,0,0,0"
                                        Visibility="{Binding HasOllamaBoxAction, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OllamaBoxAction}" />
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" Visibility="{Binding OllamaBoxOpensWeb, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OllamaBoxTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OllamaBoxCalm}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding OllamaBoxText}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ctl:SmoothBorder>

                        <!-- The models already on Ollama, first: the one in use, the others with Use, and those that can't look things up saying so. -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasOllamaRows, Converter={StaticResource Vis}}">
                            <DockPanel Margin="0,0,0,8">
                                <!-- Many models: a search for them by name. -->
                                <TextBox DockPanel.Dock="Right" Width="220" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search your models'}"
                                         Text="{Binding OllamaSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ctl:T 'Search your models'}"
                                         Visibility="{Binding ManyOllamaRows, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{ctl:T 'ON YOUR OLLAMA'}" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- Each row 52 tall with 6 between: over three, the box is three and a half rows (200), so the
                                 fourth shows cut in half and the list reads as one that scrolls. -->
                            <ScrollViewer CanContentScroll="False">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource GutterScroll}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ManyOllamaRows}" Value="True"><Setter Property="Height" Value="200" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding OllamaShownRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="14,0" Margin="0,0,0,6" Height="52">
                                                <Grid>
                                                <!-- Remove asked: the question and its two buttons in the row's own place, so nothing moves. -->
                                                <DockPanel Visibility="{Binding AskingRemove, Converter={StaticResource Vis}}">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <ctl:Spinner Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding Removing, Converter={StaticResource Vis}}" />
                                                        <Button Style="{StaticResource CancelBox}" Content="{ctl:T 'Remove'}" Margin="0,0,8,0" AutomationProperties.Name="{ctl:T 'Remove it'}"
                                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource BoxButton}" Content="{ctl:T 'Cancel'}" AutomationProperties.Name="{ctl:T 'Keep it'}"
                                                                Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RemoveQuestion}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DockPanel Visibility="{Binding NotAsking, Converter={StaticResource Vis}}">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <Grid VerticalAlignment="Center">
                                                            <Border Style="{StaticResource InUse}" Visibility="{Binding InUse, Converter={StaticResource Vis}}">
                                                                <TextBlock Text="{ctl:T 'In use'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" />
                                                            </Border>
                                                            <Button Style="{StaticResource BoxButton}" Content="{ctl:T 'Use'}"
                                                                    Command="{Binding DataContext.UseOllamaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}"
                                                                    Visibility="{Binding CanUse, Converter={StaticResource Vis}}" />
                                                        </Grid>
                                                        <!-- Remove: an icon beside the main button, asked in the row first. -->
                                                        <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="{ctl:T 'Remove from Ollama'}" AutomationProperties.Name="{ctl:T 'Remove from Ollama'}"
                                                                Command="{Binding DataContext.AskRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="13" VerticalAlignment="Center">
                                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource FaintBrush}" /><Run Text="{Binding Size, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                                            </TextBlock>
                                                            <Border Style="{StaticResource FitPill}" Margin="10,0,0,0" Visibility="{Binding HasFit, Converter={StaticResource Vis}}"
                                                                    ToolTipService.InitialShowDelay="150" ToolTipService.IsEnabled="{Binding HasFitWhy}">
                                                                <Border.ToolTip><TextBlock Text="{Binding FitWhy}" MaxWidth="280" TextWrapping="Wrap" /></Border.ToolTip>
                                                                <TextBlock Text="{Binding Fit}" Style="{StaticResource FitText}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{ctl:T 'Can\'t look up your PC\'s records, so it can\'t be used here.'}" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding CanLookUp, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                </Grid>
                                            </ctl:SmoothBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{Binding RemoveProblem}" FontSize="12.5" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasRemoveProblem, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{ctl:T 'No model on your Ollama has that in its name.'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                       Visibility="{Binding NoOllamaMatch, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{ctl:T 'None of the models on your Ollama can look up records yet. Pick one below.'}" FontSize="12.5" Foreground="{DynamicResource WarmBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding NoneCanLookUp, Converter={StaticResource Vis}}" />
                        </StackPanel>

                    </StackPanel>
                    </ctl:SmoothBorder>

                    <!-- Models for this PC: a section of its own, as the page's others (approved mock-up 2026-10-24), with what
                         they were picked for and where downloads go under the heading. Best, smaller, bigger side by side;
                         Download asks first, then shows its progress in the same place. -->
                    <TextBlock Text="{Binding PicksHeading}" Style="{StaticResource SubHead}" />
                    <TextBlock Text="{Binding PicksLine}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,-6,0,10" />
                    <ctl:SmoothBorder Style="{StaticResource Card}" Padding="16">
                        <ItemsControl ItemsSource="{Binding Picks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" Margin="0,0,-10,0" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="14,12" Margin="0,0,10,0">
                                        <!-- The buttons docked at the bottom, so they line up across the three cards. -->
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                                <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,8"
                                                           Visibility="{Binding IsIdle, Converter={StaticResource Vis}}" />
                                                <!-- Idle: Download (or Use, or In use when it's on Ollama already) -->
                                                <Grid Visibility="{Binding IsIdle, Converter={StaticResource Vis}}">
                                                    <Button Style="{StaticResource PickButton}" HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.AskDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding NotOnOllama, Converter={StaticResource Vis}}">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.DownloadOff, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{ctl:T 'Download'}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DataContext.DownloadOffText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       Visibility="{Binding DataContext.DownloadOff, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Vis}}" />
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource BoxButton}" HorizontalAlignment="Stretch" Content="{ctl:T 'Use'}"
                                                            Command="{Binding DataContext.UseOllamaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Tag}"
                                                            Visibility="{Binding CanUse, Converter={StaticResource Vis}}" />
                                                    <Border Style="{StaticResource InUse}" HorizontalAlignment="Left" Visibility="{Binding InUse, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{ctl:T 'On your Ollama · in use'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" />
                                                    </Border>
                                                </Grid>
                                                <!-- Asked: the size, where it goes (the drive in bold) and how long, then Download N GB or Cancel -->
                                                <ctl:SmoothBorder Style="{StaticResource PickStep}" Visibility="{Binding IsAsking, Converter={StaticResource Vis}}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"><Span ctl:Md.Text="{Binding AskText}" /></TextBlock>
                                                        <WrapPanel>
                                                            <Button Style="{StaticResource AccentButton}" Content="{Binding ConfirmText}" Margin="0,0,8,0" AutomationProperties.Name="{ctl:T 'Start the download'}"
                                                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasRoom, Converter={StaticResource Vis}}" />
                                                            <Button Style="{StaticResource BoxButton}" Content="{ctl:T 'Cancel'}" AutomationProperties.Name="{ctl:T 'Don\'t download'}"
                                                                    Command="{Binding DataContext.CancelAskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </ctl:SmoothBorder>
                                                <!-- Downloading: the bar and how much, how fast, how long, with Cancel beside them -->
                                                <ctl:SmoothBorder Style="{StaticResource PickStep}" Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource BoxButton}" Content="{ctl:T 'Cancel'}" Padding="11,5" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                AutomationProperties.Name="{ctl:T 'Stop the download'}"
                                                                Command="{Binding DataContext.StopDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Grid Height="6" ClipToBounds="True">
                                                                <Border CornerRadius="3" Background="{DynamicResource StrokeBrush}" />
                                                                <Border CornerRadius="3" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress}" /></Border.RenderTransform>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </ctl:SmoothBorder>
                                                <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Visibility="{Binding HasProblem, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource FitPill}" Margin="8,0,0,0" Visibility="{Binding HasFit, Converter={StaticResource Vis}}"
                                                            ToolTipService.InitialShowDelay="150" ToolTipService.IsEnabled="{Binding HasFitWhy}">
                                                        <Border.ToolTip>
                                                            <TextBlock Text="{Binding FitWhy}" MaxWidth="280" TextWrapping="Wrap" />
                                                        </Border.ToolTip>
                                                        <TextBlock Text="{Binding FitText}" Style="{StaticResource FitText}" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="7,1">
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Tag}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Why}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ctl:SmoothBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ctl:SmoothBorder>
                </StackPanel>

                <!-- My own key or Ollama: How it answers (approved mock-up 2026-10-24). Length, tone, language and a few words about
                     them are added to RigSight's instructions, never in place of them; the full text stays behind "Edit the full
                     instructions". RigSight AI's live on the relay, so it has none. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8,20,16" Margin="0,14,0,0" Visibility="{Binding CanEditInstructions, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Reset to RigSight\'s'}" Command="{Binding ResetPreferencesCommand}"
                                    VerticalAlignment="Center" Visibility="{Binding PreferencesChanged, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{ctl:T 'How it answers'}" Style="{StaticResource Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AnswerLength" Content="{ctl:T 'Short'}" IsChecked="{Binding AnswerLength, Converter={StaticResource Equals}, ConverterParameter=short}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AnswerLength" Content="{ctl:T 'Normal'}" IsChecked="{Binding AnswerLength, Converter={StaticResource Equals}, ConverterParameter=normal}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AnswerLength" Content="{ctl:T 'Detailed'}" IsChecked="{Binding AnswerLength, Converter={StaticResource Equals}, ConverterParameter=detailed}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ctl:T 'Answer length'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AnswerTone" Content="{ctl:T 'Friendly'}" IsChecked="{Binding Tone, Converter={StaticResource Equals}, ConverterParameter=friendly}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AnswerTone" Content="{ctl:T 'Straight to the point'}" IsChecked="{Binding Tone, Converter={StaticResource Equals}, ConverterParameter=direct}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AnswerTone" Content="{ctl:T 'Technical'}" IsChecked="{Binding Tone, Converter={StaticResource Equals}, ConverterParameter=technical}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ctl:T 'Tone'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" ItemsSource="{Binding AnswerLanguages}" SelectedValuePath="Code"
                                      SelectedValue="{Binding AnswerLanguageCode}" DisplayMemberPath="Name" AutomationProperties.Name="{ctl:T 'Answer language'}" />
                            <TextBlock Text="{ctl:T 'Language'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{ctl:T 'About you and your PC'}" Style="{StaticResource Title}" Margin="0,10,0,8" />
                        <TextBox Style="{StaticResource FieldArea}" Height="104" MaxLength="{Binding AboutMax}" Text="{Binding AboutYou, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                 Tag="{ctl:T 'For example: I have a Ryzen 7 5800X3D and an RTX 3080 Ti, I mostly play CS2, and I\'m new to PC parts.'}"
                                 AutomationProperties.Name="{ctl:T 'About you and your PC'}" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AboutCount}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="12,0,0,0" />
                            <TextBlock Text="{ctl:T 'Added to RigSight\'s instructions; they never replace them.'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        </DockPanel>
                        <!-- After an update changed RigSight's own text while they use their own full text. -->
                        <ctl:SmoothBorder CornerRadius="10" Padding="14,12" Margin="0,14,0,0" Background="{DynamicResource WarmSoftBrush}" BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1"
                                          Visibility="{Binding InstructionsOutdated, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{ctl:T 'RigSight\'s instructions got better in this version'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{ctl:T 'You\'re still using your own, so you don\'t get the changes. Reset to use RigSight\'s new ones, or keep yours.'}"
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Reset to RigSight\'s'}" Command="{Binding ResetInstructionsCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Keep mine'}" Command="{Binding KeepInstructionsCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ctl:SmoothBorder>
                        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,14,0,12" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0"
                                        Visibility="{Binding HasOwnInstructions, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{ctl:T 'Yours'}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Edit the full instructions'}" Command="{Binding EditInstructionsCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding InstructionsNote}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- What answers can read: a tile for each page the plan opens (pressed to stop sending it), and one line for the
                     pages outside the plan, never a lock on each (the user, 2026-10-23). -->
                <TextBlock Text="{ctl:T 'What answers can read'}" Style="{StaticResource SubHead}" Visibility="{Binding IsOn, Converter={StaticResource Vis}}" />
                <Border Visibility="{Binding IsOn, Converter={StaticResource Vis}}">
                <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,16" DataContext="{Binding Pages}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OnText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Turn all on'}" Command="{Binding AllOnCommand}" Margin="10,0,0,0"
                                        Visibility="{Binding SomeOff, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <TextBlock Text="{ctl:T 'Press a page to stop sending it.'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,12,-8,0" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,8,8" Padding="12,10" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ctl:SmoothBorder x:Name="Box" CornerRadius="8" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                                                  Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}">
                                                    <DockPanel>
                                                        <Border x:Name="Tick" DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource TextBrush}" VerticalAlignment="Center">
                                                            <TextBlock x:Name="TickMark" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ContentControl x:Name="Glyph" Content="{Binding Glyph, Converter={StaticResource NavIcon}}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="18"
                                                                        VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Focusable="False" IsTabStop="False" />
                                                        <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="13" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </ctl:SmoothBorder>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                    <DataTrigger Binding="{Binding On}" Value="False">
                                                        <Setter TargetName="Box" Property="Background" Value="Transparent" />
                                                        <Setter TargetName="Tick" Property="Background" Value="Transparent" />
                                                        <Setter TargetName="Tick" Property="BorderBrush" Value="{DynamicResource FaintBrush}" />
                                                        <Setter TargetName="Tick" Property="BorderThickness" Value="1.5" />
                                                        <Setter TargetName="TickMark" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ctl:SmoothBorder CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Padding="12,10" Margin="0,2,0,0"
                                          Visibility="{Binding HasOutside, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'See plans'}" Command="{Binding SeePlansCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OutsideTitle}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OutsideList}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ctl:SmoothBorder>
                        <TextBlock Text="{ctl:T 'Never sent: your Windows user name, the names or contents of your files, your licence key. Folder names and sizes go only for a drive you press Scan for.'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ctl:SmoothBorder>
                </Border>

                <!-- The Ask button, its shortcut, and how long conversations stay. -->
                <TextBlock Text="{ctl:T 'Ask button and conversations'}" Style="{StaticResource SubHead}" Visibility="{Binding IsOn, Converter={StaticResource Vis}}" />
                <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8" Visibility="{Binding IsOn, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AskPlace" Content="{ctl:T 'Top bar'}" IsChecked="{Binding Place, Converter={StaticResource Equals}, ConverterParameter=top}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AskPlace" Content="{ctl:T 'Sidebar'}" IsChecked="{Binding Place, Converter={StaticResource Equals}, ConverterParameter=sidebar}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ctl:T 'Ask button'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="10,6" MinWidth="170">
                                    <TextBlock Text="{Binding Shortcut}" FontSize="13" Foreground="{DynamicResource FaintBrush}" />
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Set'}" Command="{Binding SetShortcutCommand}" Margin="8,0,0,0" AutomationProperties.Name="{ctl:T 'Set a shortcut'}" />
                            </StackPanel>
                            <TextBlock Text="{ctl:T 'Shortcut'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,4" />
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AskKeep" Content="{ctl:T '30 days'}" IsChecked="{Binding KeepConversationDays, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AskKeep" Content="{ctl:T '3 months'}" IsChecked="{Binding KeepConversationDays, Converter={StaticResource Equals}, ConverterParameter=90}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AskKeep" Content="{ctl:T '1 year'}" IsChecked="{Binding KeepConversationDays, Converter={StaticResource Equals}, ConverterParameter=365}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AskKeep" Content="{ctl:T 'Forever'}" IsChecked="{Binding KeepConversationDays, Converter={StaticResource Equals}, ConverterParameter=0}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ctl:T 'Keep conversations for'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ClearConversationsCommand}" AutomationProperties.Name="{ctl:T 'Clear all conversations'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource HotBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{ctl:T 'Clear all…'}" Foreground="{DynamicResource HotBrush}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{ctl:T 'Conversations'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ctl:SmoothBorder>
            </StackPanel>

            <!-- History -->
            <StackPanel Visibility="{Binding IsHistory, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="{ctl:T '3 months'}" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=90}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="{ctl:T '1 year'}" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=365}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="{ctl:T '2 years'}" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=730}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hist" Content="{ctl:T 'Forever'}" IsChecked="{Binding KeepHistoryDays, Converter={StaticResource Equals}, ConverterParameter=0}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Keep history for'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'About 25 MB a year.'}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding TrackingSince}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Visibility="{Binding TrackingSince, Converter={StaticResource Vis}}" />
                    <WrapPanel Margin="0,10,0,12">
                        <!-- Everything that can be saved as a file is in one box over the window (see ExportCard). -->
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}" Margin="0,0,8,8" AutomationProperties.Name="Export">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{ctl:T 'Export…'}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{ctl:T 'Open data folder'}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource HotBrush}"
                                               Visibility="{Binding IsClearing, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <ctl:Spinner Visibility="{Binding IsClearing, Converter={StaticResource Vis}}" />
                                </Grid>
                                <TextBlock Text="{ctl:T 'Clear all history…'}" Foreground="{DynamicResource HotBrush}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <!-- The history file: its health, a check or repair on request, and the damaged copies a repair kept. -->
                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,4" AutomationProperties.Name="History file">
                        <StackPanel>
                            <DockPanel>
                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Check now'}" Command="{Binding CheckHistoryCommand}"
                                            Visibility="{Binding HistoryDamaged, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Repair'}" Command="{Binding RepairHistoryCommand}" AutomationProperties.Name="Repair history"
                                            Visibility="{Binding HistoryDamaged, Converter={StaticResource Vis}}" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'History file'}" Style="{StaticResource Title}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <ctl:Spinner Width="12" Height="12" Margin="0,0,8,0" Visibility="{Binding HistoryChecking, Converter={StaticResource Vis}}" />
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarmBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Visibility="{Binding HistoryDamaged, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding HistoryLastRepair}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HistoryLastRepair, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding DamagedCopies}" Margin="0,10,0,0" Visibility="{Binding DamagedCopies, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Open folder'}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.OpenDataFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Delete'}" AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}"
                                                        Command="{Binding DataContext.DeleteDamagedCopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{ctl:T 'Damaged copy kept'}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Hint}"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Admin rights: only on a standard account. What can't be read there, and what each page shows instead. -->
            <StackPanel Visibility="{Binding IsAdminRights, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource CpuSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource CpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{ctl:T 'This is a standard account'}" Style="{StaticResource Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{ctl:T 'RigSight runs without admin rights here and never asks for a password. Everything it can read is recorded as usual.'}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DockPanel>
            </ctl:SmoothBorder>
            <TextBlock Text="{ctl:T 'OFF ON THIS ACCOUNT'}" Style="{StaticResource Caption}" Margin="2,22,0,10" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Off'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WarmSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource WarmBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'CPU temperature, power and clock speed'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Temperatures shows how busy the CPU is instead.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Off'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource GpuSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource GpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Motherboard fans, voltages and temperatures'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Fans still shows the graphics card\'s fans.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Off'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource GoodSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Drive health and drive temperature'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Storage still shows space and how fast it fills.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Off'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PurpleSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE839;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'Each app\'s internet use'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Network still shows the whole PC\'s use, local devices included.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8" Margin="0,16,0,0">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepUpdated}" Margin="0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ctl:T 'Update by itself'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                                <!-- How a PC updates for someone who can't install anything: asked often enough to answer in place. -->
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="8,1,0,0" VerticalAlignment="Center"
                                           Background="Transparent" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="360">
                                            <StackPanel>
                                                <TextBlock Text="{ctl:T 'How it updates without admin rights'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBlock TextWrapping="Wrap" Text="{ctl:T 'When an admin installed RigSight, setup left a small updater on this PC. Windows runs it when RigSight starts, with admin rights of its own. It downloads the new RigSight, checks that it is the real one, installs it and stops. Your account never gets admin rights.'}" />
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding KeepUpdatedHint}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>

            <!-- Rewind: the rewinds made (fixed height, scrolling inside), what is made, what goes in, how one is announced,
                 and what is never shown. Compact: tiles side by side, not a tall row for each switch. -->
            <StackPanel Visibility="{Binding IsRewind, Converter={StaticResource Vis}}">
            <StackPanel DataContext="{Binding Rewind}">
            <TextBlock Text="{ctl:T 'Your rewinds'}" Style="{StaticResource SubHead}" Margin="2,0,0,10" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="0" Height="250">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasEntries, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{Binding Hue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding WatchCommand}" Margin="0,0,6,0" AutomationProperties.Name="Watch">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" /><TextBlock Text="{ctl:T 'Watch'}" /></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding ShareCommand}" Margin="0,0,6,0" AutomationProperties.Name="Share">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" /><TextBlock Text="{ctl:T 'Share'}" /></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding RecreateCommand}" IsEnabled="{Binding CanRecreate}" Margin="0,0,6,0" AutomationProperties.Name="Recreate"
                                                        ToolTip="{ctl:T 'Made again with the settings below, in place of this one'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ctl:Spinner Width="12" Height="12" StrokeThickness="2" Margin="0,0,6,0" Visibility="{Binding Recreating, Converter={StaticResource Vis}}" />
                                                        <TextBlock Text="{ctl:T 'Recreate'}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove" ToolTip="{ctl:T 'Remove'}">
                                                    <TextBlock Text="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                    <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource CpuBrush}"
                                                             Visibility="{Binding IsNew, Converter={StaticResource Vis}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{ctl:T 'No rewinds yet. The first one is made when a month ends.'}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasEntries, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                </Grid>
            </ctl:SmoothBorder>

            <TextBlock Text="{ctl:T 'Rewinds to make'}" Style="{StaticResource SubHead}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding HistoryTooShort, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding HistoryNote}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </ctl:SmoothBorder>
            <UniformGrid Columns="4" Margin="0,0,-8,0">
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Month}" AutomationProperties.Name="Every month">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource CpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Every month'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Quarter}" IsEnabled="{Binding CanQuarter}" AutomationProperties.Name="Every 3 months">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource GpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Every 3 months'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Half}" IsEnabled="{Binding CanHalf}" AutomationProperties.Name="Every 6 months">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Every 6 months'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Year}" IsEnabled="{Binding CanYear}" AutomationProperties.Name="Every year">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Every year'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
            </UniformGrid>

            <TextBlock Text="{ctl:T 'What goes in'}" Style="{StaticResource SubHead}" Margin="2,16,0,10" />
            <UniformGrid Columns="3" Margin="0,0,-8,0">
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Time}" AutomationProperties.Name="Time on the PC">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource SkyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Time on the PC'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{ctl:T 'PC on for, busiest day'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Games}" AutomationProperties.Name="Games">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Games'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{ctl:T 'Most played, longest sitting'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Internet}" AutomationProperties.Name="Internet">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource CpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Internet'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{ctl:T 'What you downloaded'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Heat}" AutomationProperties.Name="How hot it got">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE9CA;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource GpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'How hot it got'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{ctl:T 'Hottest moments'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Changes}" AutomationProperties.Name="What changed">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource CpuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'What changed'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{ctl:T 'Drivers and apps'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource RewindTile}" IsChecked="{Binding Problems}" AutomationProperties.Name="Problems">
                    <DockPanel>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource HoverBrush}">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{ctl:T 'Problems'}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{ctl:T 'Crashes and shutdowns'}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
            </UniformGrid>

            <TextBlock Text="{ctl:T 'When one is ready'}" Style="{StaticResource SubHead}" Margin="2,16,0,10" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="16,2">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FullScreen}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Show it full screen when RigSight opens'}" Style="{StaticResource Title}" />
                    </CheckBox>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Notify}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Notification while RigSight is closed'}" Style="{StaticResource Title}" />
                    </CheckBox>
                </StackPanel>
            </ctl:SmoothBorder>

            <TextBlock Text="{ctl:T 'Never show in a rewind'}" Style="{StaticResource SubHead}" Margin="2,16,0,10" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <Grid>
                        <!-- The box is the search: clicked or typed in, the list opens under it and narrows as you type. -->
                        <TextBox x:Name="LeaveSearchBox" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search your games and apps…'}"
                                 AutomationProperties.Name="{ctl:T 'Search your games and apps'}" ctl:Debounce.Text="{Binding LeaveSearch}"
                                 GotKeyboardFocus="LeaveSearch_Focus" PreviewMouseLeftButtonUp="LeaveSearch_Open" PreviewKeyDown="LeaveSearch_Key" />
                        <!-- Floats over what is under it: nothing moves when it opens. Clicking the box itself doesn't close it. -->
                        <Popup x:Name="LeavePopup" IsOpen="{Binding IsPicking}" PlacementTarget="{Binding ElementName=LeaveSearchBox}" Placement="Bottom" StaysOpen="False"
                               AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=LeaveSearchBox}" MinWidth="420" VerticalOffset="6">
                            <ctl:SmoothBorder CornerRadius="8" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{ctl:T 'MOST USED THIS MONTH'}" Style="{StaticResource Caption}" Margin="8,4,8,4" />
                                    <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding LeaveOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="4,2" Height="36">
                                                        <Image DockPanel.Dock="Left" Source="{Binding Path, Converter={StaticResource ExeIcon}}" Width="22" Height="22" Margin="4,0,12,0" />
                                                        <Grid DockPanel.Dock="Right" Width="96">
                                                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Leave out'}" HorizontalAlignment="Right"
                                                                    Command="{Binding DataContext.LeaveOutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsLeftOut, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                            <TextBlock Text="{ctl:T 'Left out'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                       Visibility="{Binding IsLeftOut, Converter={StaticResource Vis}}" />
                                                        </Grid>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </ctl:SmoothBorder>
                        </Popup>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding LeftOut}" Margin="0,10,0,0" Visibility="{Binding HasLeftOut, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Background="{DynamicResource Surface2Brush}" Padding="4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Width="20" Height="20" Margin="2,0,8,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="4,0,0,0"
                                                Command="{Binding DataContext.ShowAgainCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Name}" ToolTip="{ctl:T 'Show it again'}">
                                            <TextBlock Text="&#xE711;" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{ctl:T 'Nothing left out. Any game or app you used can appear.'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="2,10,0,0"
                               Visibility="{Binding HasLeftOut, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>
            </StackPanel>

            <!-- Updates -->
            <StackPanel Visibility="{Binding IsAbout, Converter={StaticResource Vis}}">
            <TextBlock Text="{ctl:T 'Updates'}" Style="{StaticResource SubHead}" Margin="2,0,0,10" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Spinner Margin="0,0,12,0" Visibility="{Binding Update.IsBusy, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Download page'}" Command="{Binding Update.OpenDownloadPageCommand}" Margin="0,0,8,0"
                                    ToolTip="{ctl:T 'Get the latest installer from the RigSight website'}"
                                    Visibility="{Binding Update.ShowFailed, Converter={StaticResource Vis}}" />
                            <Button Command="{Binding Update.ActionCommand}" Content="{Binding Update.ActionText}" MinWidth="150"
                                    AutomationProperties.Name="{Binding Update.ActionText}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Update.ActionIsPrimary}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Update.IsBusy}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}">
                                <Run Text="RigSight" /> <Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Update.StatusText}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate}" Margin="0,10"
                              Visibility="{Binding StandardAccount, Converter={StaticResource Vis}, ConverterParameter=Invert}"
                              ToolTip="{ctl:T 'On: RigSight looks for a new version once a day and installs it. Off: it doesn\'t contact GitHub unless you press Check for updates.'}">
                        <TextBlock Text="{ctl:T 'Update automatically'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowWhatsNew}" Margin="0,10">
                        <TextBlock Text="{ctl:T 'Show What\'s new after an update'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </CheckBox>
                    <!-- A standard account can't install an update: whether the PC does it for them, set on the Admin rights tab. -->
                    <DockPanel Style="{StaticResource Row}" Visibility="{Binding StandardAccount, Converter={StaticResource Vis}}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KeepUpdatedWord}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Update by itself'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Changed on the Admin rights tab.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- An admin, on a PC set up for other people too: whether it stays up to date for them. -->
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepUpdated}" Margin="0,10"
                              Visibility="{Binding ShowKeepUpdatedForEveryone, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Keep RigSight updated for everyone on this PC'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Windows updates RigSight for every account on this PC, yours included, whatever the switch above says. Off removes the small updater.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- About -->
            <TextBlock Text="{ctl:T 'About'}" Style="{StaticResource SubHead}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Quit…'}" Command="{Binding QuitAgentCommand}"
                                VerticalAlignment="Center" AutomationProperties.Name="Quit background agent" />
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Background agent'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'Records your history and runs the widgets, overlay and notifications.'}" Style="{StaticResource Hint}" />
                            <!-- A warning with a way out for an admin; on a standard account a plain fact, with where to read more. -->
                            <TextBlock Margin="0,4,16,0" Visibility="{Binding AgentIsAdmin, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                        <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                        <Setter Property="Text" Value="{ctl:T 'It\'s running without admin rights, so CPU and motherboard sensors are unavailable. Restart it from the tray or the sidebar.'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StandardAccount}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                                <Setter Property="Text" Value="{ctl:T 'It runs without admin rights on this account. The Admin rights tab lists what that turns off.'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'See all updates'}"
                                Command="{Binding SeeAllUpdatesCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="See all updates" />
                        <TextBlock Text="{ctl:T 'What\'s new'}" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding ReportBugText}" Command="{Binding ReportBugCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="118" AutomationProperties.Name="Report a bug" />
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Report a bug'}" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="{ctl:T 'Opens a form in your browser. RigSight itself sends nothing.'}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- Contact support: Gmail in the browser, the email already written; the address shown, to copy by hand. -->
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Email support'}" Command="{Binding ContactSupportCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="118" AutomationProperties.Name="Email support" />
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Contact support'}" Style="{StaticResource Title}" />
                            <!-- The address as text that can be selected and copied by hand too. -->
                            <TextBox Text="{Binding SupportAddressText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                     Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0" AutomationProperties.Name="Support address" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <!-- The button itself says "Copied" for a moment: no line of text appears under the row. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding CopyLogsText}" Command="{Binding CopyProblemReportCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="118" AutomationProperties.Name="Copy logs" />
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Logs'}" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{ctl:T 'RigSight\'s recent log, with its version and your hardware, to paste into the bug form or wherever you ask for help.'}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <!-- Buy Me a Coffee's own yellow, the same in every theme. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Background="#FFDD00" Foreground="#000000" Content="{ctl:T 'Buy me a coffee'}" Command="{Binding SupportCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Buy me a coffee" />
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Support RigSight'}" Style="{StaticResource Title}" />
                            <TextBlock Text="{ctl:T 'RigSight is free and made by one person.'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'View'}" Command="{Binding OpenNoticesCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="View open-source notices" />
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Open-source notices'}" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="{ctl:T 'Licences of everything RigSight includes.'}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,10">
                        <TextBlock Text="{ctl:T 'Hardware readings'}" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{ctl:T 'From LibreHardwareMonitor (MPL-2.0), with low-level access through the PawnIO driver. NVIDIA readings in the background use NVML for minimal overhead.'}" />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            </StackPanel>
        </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>

        <!-- Over the page while the sidebar editor is open: dims it a little; a click on it closes the editor. -->
        <Border x:Name="EditorScrim" Background="#000000" Opacity="0" Visibility="Collapsed" MouseLeftButtonDown="EditorScrim_MouseLeftButtonDown" />

        <!-- The sidebar editor: a sheet over the page that slides in from the right, as a widget's editor does (see the
             code-behind). Every change shows in the sidebar at once; the x, Esc or a click on the page closes it. -->
        <!-- The editor's shadow on an empty box of its own behind it, sliding with it (the same transform): an effect on the
             editor itself drew all its text without ClearType, softer than the rest of the app. -->
        <Border Width="430" HorizontalAlignment="Right" Background="{DynamicResource SidebarBrush}" IsHitTestVisible="False"
                Visibility="{Binding Visibility, ElementName=EditorPanel}" RenderTransform="{Binding RenderTransform, ElementName=EditorPanel}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Border x:Name="EditorPanel" Width="430" HorizontalAlignment="Right" Visibility="Collapsed" DataContext="{Binding Sidebar}"
                Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource StrokeBrush}" Background="{DynamicResource SidebarBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="EditorSlide" X="430" />
            </Border.RenderTransform>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="22,22,22,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="Close the editor"
                            Command="{Binding CloseEditorCommand}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE711;" />
                    </Button>
                    <TextBlock Text="{ctl:T 'Sidebar'}" Style="{StaticResource H2}" />
                </DockPanel>
                <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <!-- The line showing where a dragged page will land is drawn over the rows, and scrolls with them. -->
                    <Grid x:Name="EditorRows" Margin="22,0,22,26">
                        <ItemsControl x:Name="EditorGroups" ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SidebarGroup}" Focusable="False" />
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="DropLine" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
