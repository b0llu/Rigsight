<UserControl x:Class="Rigsight.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <DockPanel Margin="0,0,0,18">
                <!-- Everything on the page again: drives, cleanup, and the open scan (after deleting something, say). -->
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Command="{Binding RefreshAllCommand}"
                        AutomationProperties.Name="{ctl:T Refresh}" ToolTip="{ctl:T 'Check the drives, the cleanup list and the scan again'}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="12" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center"
                                               Visibility="{Binding RefreshAllCommand.IsRunning, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <ctl:Spinner Visibility="{Binding RefreshAllCommand.IsRunning, Converter={StaticResource Vis}}" />
                                </Grid>
                        <TextBlock Text="{ctl:T Refresh}" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{ctl:T Storage}" Style="{StaticResource H1}" />
                    <TextBlock Text="{ctl:T 'How full your drives are, how fast they\'re filling up, and what\'s taking the space.'}"
                               Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Volumes -->
            <ItemsControl ItemsSource="{Binding Volumes}" Margin="-9,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctl:SmoothBorder Style="{StaticResource Card}" Margin="9">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Root}" AutomationProperties.Name="{Binding ScanName}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="{ctl:T 'See what\'s inside'}" />
                                        </StackPanel>
                                    </Button>
                                    <!-- While this drive is being scanned: it turns, with how far along -->
                                    <StackPanel x:Name="Scanning" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
                                        <TextBlock Text="{Binding ScanText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Path x:Name="Spinner" Width="12" Height="12" VerticalAlignment="Center"
                                              Data="M 6,0.75 A 5.25,5.25 0 1 1 0.75,6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- One flat colour, the accent (the bar style's own). -->
                                <ProgressBar Style="{StaticResource Bar}" Height="10" Margin="0,16,0,8" Value="{Binding UsedPercent, Mode=OneWay}" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Growth}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding FreeText}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </ctl:SmoothBorder>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter TargetName="Scanning" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Spin">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="RenderTransform.Angle"
                                                             From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Spin" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Physical drives -->
                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Drive health'}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Live.Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Tile}" Margin="0,5" Padding="16,14">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,2,0" Background="Transparent"
                                                        Visibility="{Binding HasHealth, Converter={StaticResource Vis}}" ToolTip="{Binding HealthToolTip}">
                                                <TextBlock Text="{Binding HealthText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                           Foreground="{Binding HealthBrush}" />
                                                <TextBlock Text="{ctl:T HEALTH}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <!-- In the middle of the tile's height, like the figure beside it (it sat at the top, with the room under it). -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,0,14,0"
                                                               Visibility="{Binding PowerOnHours, Converter={StaticResource Vis}}">
                                                        <Run Text="{ctl:T 'Powered on'}" /> <Run Text="{Binding PowerOnHours.Value, StringFormat='{}{0:N0} h', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                                                               Visibility="{Binding UsedSpace, Converter={StaticResource Vis}}">
                                                        <Run Text="{ctl:T Full}" /> <Run Text="{Binding UsedSpace.ShortValue, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SectorsText}" FontSize="11.5" Foreground="{Binding SectorsBrush}" Margin="0,3,0,0"
                                                           Visibility="{Binding SectorsText, Converter={StaticResource Vis}}" />
                                                <!-- Why it isn't green, in the colour of the figure beside it. -->
                                                <TextBlock Text="{Binding HealthReason}" FontSize="11.5" Foreground="{Binding HealthBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HealthReason, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The box stays on a standard account, so the person sees the feature is there and why it is empty. -->
                        <TextBlock TextWrapping="Wrap" Visibility="{Binding Live.Drives.Count, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Text" Value="Drive health appears once the agent is running with admin rights." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Live.StandardAccount}" Value="True">
                                            <Setter Property="Text" Value="Drive health needs admin rights on this PC." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Cleanup -->
                <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Space you could free'}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <!-- The shared loader until the list has been read the first time (the card stood empty while the drives
                             were read first); read again later, the page's Refresh button is what turns. -->
                        <ctl:Spinner Late="True" Width="20" Height="20" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,40,0,40"
                                     Visibility="{Binding CleanupRead, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding Cleanup}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.CleanupActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <!-- The word keeps its room while the spinner takes its place: the button doesn't change size. -->
                                            <Grid>
                                                <TextBlock x:Name="Word" Text="{Binding ActionText}" />
                                                <ctl:Spinner x:Name="Busy" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Busy}" Value="True">
                                            <Setter TargetName="Word" Property="Visibility" Value="Hidden" />
                                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{ctl:T 'Nothing here is deleted automatically: it shows where the space is, and you decide.'}"
                                   FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding CleanupRead, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </ctl:SmoothBorder>
            </Grid>

            <!-- Scanner -->
            <ctl:SmoothBorder x:Name="Scanner" Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <!-- One row, one height: the choice of view, then what can be done (they sat on two rows at three heights). -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SegmentHost}" Height="34" Margin="0,0,8,0" Visibility="{Binding ShowResult, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ScanView" Content="{ctl:T Map}"
                                                 IsChecked="{Binding ScanView, Converter={StaticResource Equals}, ConverterParameter=Map}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ScanView" Content="{ctl:T List}"
                                                 IsChecked="{Binding ScanView, Converter={StaticResource Equals}, ConverterParameter=List}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ScanView" Content="{ctl:T 'Largest files'}"
                                                 IsChecked="{Binding ScanView, Converter={StaticResource Equals}, ConverterParameter=Files}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Height="34" Margin="0,0,8,0" Command="{Binding RevealCommand}" CommandParameter="{Binding Current.Path}"
                                    Visibility="{Binding ShowResult, Converter={StaticResource Vis}}" ToolTip="{ctl:T 'Open the folder shown here in Explorer'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{ctl:T 'Open in Explorer'}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Height="34" Command="{Binding ChooseFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{ctl:T 'Scan a folder…'}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Height="34" Command="{Binding CancelScanCommand}" Content="{ctl:T Cancel}" Margin="8,0,0,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'What\'s taking up space'}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />

                    <TextBlock Text="{ctl:T 'Pick “See what\'s inside” on a drive above, or scan any folder. Scanning reads file sizes only and takes a few seconds to a minute.'}"
                               Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Visibility="{Binding Result, Converter={StaticResource Vis}, ConverterParameter=Invert}" />

                    <!-- Another drive or folder is being scanned: what was here would read as its contents. The box keeps its
                         size, so nothing below moves when the scan lands. -->
                    <Grid ctl:Roomy.Height="458" Visibility="{Binding ShowScanLoader, Converter={StaticResource Vis}}">
                        <ctl:Spinner Width="22" Height="22" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Visibility="{Binding ShowResult, Converter={StaticResource Vis}}">
                        <!-- Where the folders shown are. The largest files are of the whole scan, so there it says that. -->
                        <TextBlock Text="{Binding FilesTitle}" Style="{StaticResource Muted}" Height="28" Margin="0,0,0,10" Padding="0,6,0,0"
                                   Visibility="{Binding ScanView, Converter={StaticResource EqualsVis}, ConverterParameter=Files}" />
                        <DockPanel Height="28" Margin="0,0,0,10">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanView}" Value="Files">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip="{ctl:T 'Up one level'}">
                                <TextBlock Text="&#xE74A;" />
                            </Button>
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" Margin="8,0" AlternationCount="1000">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- One line: a deep path doesn't push the box below it down. -->
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- The arrow is between two folders: none before the first (there was one after the last). -->
                                            <TextBlock x:Name="Arrow" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="2,0" />
                                            <Button Style="{StaticResource IconButton}" Width="Auto" Padding="6,0"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="13" Margin="6,0" Foreground="{DynamicResource TextBrush}" />
                                            </Button>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Map -->
                        <ctl:Treemap x:Name="Map" ctl:Roomy.Height="420" Items="{Binding CurrentItems}"
                                     Visibility="{Binding ScanView, Converter={StaticResource EqualsVis}, ConverterParameter=Map}" />

                        <!-- List: a box of the map's height that scrolls, so a folder of two things and one of sixty take the
                             same room (the page jumped at every folder opened). A row takes its width from the box: told its
                             width by a binding, rows made while the list was hidden (on Largest files) had none, and the list
                             came back empty. -->
                        <ScrollViewer x:Name="ListBox" Style="{StaticResource CardScroll}" ctl:Roomy.Height="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding ScanView, Converter={StaticResource EqualsVis}, ConverterParameter=List}">
                        <ItemsControl ItemsSource="{Binding CurrentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- "Files in this folder" and "N smaller folders" have nothing to open: no hand, no shade. -->
                                    <Button Style="{StaticResource FlatRowButton}" Margin="0,1" IsEnabled="{Binding CanOpen}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Glyph" Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource WarmBrush}" Margin="12,0,0,0" />
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" Margin="8,0" />
                                            <ProgressBar Grid.Column="2" Style="{StaticResource Bar}" Value="{Binding Share, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding FilesText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <!-- Loose files, not a folder. -->
                                        <DataTrigger Binding="{Binding IsBucket}" Value="True">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7C3;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <!-- Largest files -->
                        <ScrollViewer Style="{StaticResource CardScroll}" ctl:Roomy.Height="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding ScanView, Converter={StaticResource EqualsVis}, ConverterParameter=Files}">
                        <ItemsControl ItemsSource="{Binding Result.LargestFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Show in Explorer'}"
                                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}">
                                            <TextBlock Text="&#xE8A7;" />
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <StackPanel>
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>
        </StackPanel>
    </ScrollViewer>
</UserControl>
