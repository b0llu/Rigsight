<UserControl x:Class="Rigsight.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <!-- The Storage page, rebuilt around finding what fills a drive (approved mock-up 2026-10-24): the drives as one row
         each, the fullest first; the scan second, a tab per drive, its list and map side by side; then what could be
         freed on the drive picked, and the disks' health. -->
    <UserControl.Resources>
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        </Style>
        <!-- A list row's share of its folder, as a shade behind it (no track). -->
        <Style x:Key="Shade" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="Transparent" />
                            <Border x:Name="PART_Indicator" Background="{DynamicResource Surface2Brush}" CornerRadius="6" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A tab (a drive above the scan, or above the cleanup list): picked, it takes the segment's shade. -->
        <Style x:Key="Tab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentOnBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SegmentOnTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One drive: a row of its own (letter, name, bar, how full, growth, Scan), about 44 tall. -->
        <DataTemplate x:Key="DriveRow">
            <Grid Margin="0,0,0,2" MinHeight="44" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="1.3*" MinWidth="120" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Surface2Brush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSub, Converter={StaticResource Vis}}" />
                </StackPanel>
                <Grid Grid.Column="2" Height="6" VerticalAlignment="Center" ClipToBounds="True">
                    <Border CornerRadius="3" Background="{DynamicResource Surface2Brush}" />
                    <ProgressBar Style="{StaticResource Bar}" Height="6" Value="{Binding UsedPercent, Mode=OneWay}" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding FullText}" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NearlyFull}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="4" Text="{Binding Growth}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Column="5" VerticalAlignment="Center" MinWidth="70">
                    <Button x:Name="ScanBtn" Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12" Content="{ctl:T Scan}" HorizontalAlignment="Right"
                            Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Root}" AutomationProperties.Name="{Binding ScanName}" />
                    <!-- While this drive is being scanned: how far along, and the shared spinner. -->
                    <StackPanel x:Name="Scanning" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <TextBlock Text="{Binding ScanText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ctl:Spinner Width="12" Height="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter TargetName="Scanning" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ScanBtn" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <DockPanel Margin="0,0,0,18">
                <Button Style="{StaticResource PageExportButton}" />
                <!-- Everything on the page again: drives, cleanup, and the open scan (after deleting something, say). -->
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Command="{Binding RefreshAllCommand}"
                        AutomationProperties.Name="{ctl:T Refresh}" ToolTip="{ctl:T 'Check the drives, the cleanup list and the scan again'}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="12" Margin="0,0,8,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center"
                                       Visibility="{Binding RefreshAllCommand.IsRunning, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <ctl:Spinner Visibility="{Binding RefreshAllCommand.IsRunning, Converter={StaticResource Vis}}" />
                        </Grid>
                        <TextBlock Text="{ctl:T Refresh}" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{ctl:T Storage}" Style="{StaticResource H1}" />
                    <TextBlock Text="{ctl:T 'Your drives, what fills them, and what you could free.'}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- 1. The drives: one row each, the fullest first; past five, "Show N more"; USB and network under them. -->
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="20,14,20,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DrivesSummary}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'DRIVES · FULLEST FIRST'}" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ShownVolumes}" ItemTemplate="{StaticResource DriveRow}" Focusable="False" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="10,4" FontSize="12" Margin="0,4,0,0"
                            Content="{Binding MoreDrivesText}" Command="{Binding ToggleDrivesCommand}" Visibility="{Binding HasMoreDrives, Converter={StaticResource Vis}}" />
                    <StackPanel Visibility="{Binding HasOtherVolumes, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'USB AND NETWORK'}" Style="{StaticResource Caps}" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding OtherVolumes}" ItemTemplate="{StaticResource DriveRow}" Focusable="False" />
                    </StackPanel>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- 2. What fills a drive: second on the page, a tab per drive, each drive's scan kept for the session. -->
            <ctl:SmoothBorder x:Name="Scanner" Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                            <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding DriveTabs}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Tab}" Content="{Binding Letter}" Tag="{Binding IsPicked}" AutomationProperties.Name="{Binding Title}"
                                                        Command="{Binding DataContext.PickDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Root}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource Tab}" Command="{Binding ChooseFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{ctl:T 'Pick a folder…'}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ctl:T 'What fills a drive'}" Style="{StaticResource H2}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding ShowResult, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12" Margin="8,0,0,0" Content="{ctl:T 'Scan again'}" Command="{Binding ScanAgainCommand}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                <Button Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12" Margin="8,0,0,0" Content="{ctl:T Cancel}" Command="{Binding CancelScanCommand}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Where the list and map are, and what can be done there. -->
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding ShowResult, Converter={StaticResource Vis}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{ctl:T Up}" />
                                </StackPanel>
                            </Button>
                            <Button Padding="10,5" FontSize="12" Command="{Binding ShowFilesCommand}" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="{ctl:T 'Largest files'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowingFiles}" Value="True"><Setter Property="Content" Value="{ctl:T 'Folders'}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Command="{Binding RevealCommand}" CommandParameter="{Binding Current.Path}"
                                    ToolTip="{ctl:T 'Open the folder shown here in Explorer'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'Open in Explorer'}" />
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- The path: every folder up to the one shown, cut short when deep (the start of a long path wraps away). -->
                        <TextBlock Text="{Binding FilesTitle}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowingFiles, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" AlternationCount="1000" ClipToBounds="True"
                                      Visibility="{Binding ShowingFiles, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Arrow" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource FaintBrush}" Margin="2,0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Width="Auto" Padding="4,0" MaxWidth="220"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="13" Margin="4,0" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- The box keeps one height whatever it holds, so nothing below moves. -->
                    <Grid ctl:Roomy.Height="420">
                        <!-- The drive picked isn't scanned yet. -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Visibility="{Binding ShowNotScanned, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding NotScannedText}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Command="{Binding ScanCommand}" CommandParameter="{Binding PickedRoot}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ScanPickedText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Scanning: how far, how much, where it is now, and Cancel. -->
                        <StackPanel VerticalAlignment="Center" Margin="40,0" Visibility="{Binding ShowScanLoader, Converter={StaticResource Vis}}">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ScanCounts}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding ScanPercent, StringFormat='{}{0:0}%', Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </DockPanel>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding ScanPercent, Mode=OneWay}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Content="{ctl:T Cancel}" Command="{Binding CancelScanCommand}" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding ScanFolder}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <!-- The list and the map side by side, linked: pointing at one lights the other. -->
                        <Grid Visibility="{Binding ShowResult, Converter={StaticResource Vis}}">
                            <Grid Visibility="{Binding ShowingFiles, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                    <ScrollViewer x:Name="ListBox" Style="{StaticResource GutterScroll}" CanContentScroll="False">
                                        <ItemsControl ItemsSource="{Binding CurrentItems}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FlatRowButton}" IsEnabled="{Binding CanOpen}" MouseEnter="Row_Enter" MouseLeave="Row_Leave"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Name}">
                                                        <Grid>
                                                            <!-- The row's share of the folder, as a shade behind it. -->
                                                            <ProgressBar Style="{StaticResource Shade}" Value="{Binding Share, Mode=OneWay}" />
                                                            <Border x:Name="HotLine" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" CornerRadius="6" Visibility="Collapsed" />
                                                            <Grid Margin="10,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="46" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="10" Height="10" CornerRadius="3" Background="{Binding KindBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                <TextBlock Grid.Column="1" ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Size, Converter={StaticResource Bytes}}" FontSize="12.5" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Share, StringFormat='{}{0:0}%'}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource FaintBrush}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsHot}" Value="True"><Setter TargetName="HotLine" Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <DockPanel Grid.Column="2">
                                    <!-- The key: only the kinds this folder has. -->
                                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Kinds}" Margin="0,8,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                                    <Border Width="9" Height="9" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ctl:Treemap x:Name="Map" Items="{Binding CurrentItems}" Hot="{Binding Hot}" />
                                </DockPanel>
                            </Grid>

                            <!-- Largest files of the whole scan. -->
                            <ScrollViewer Style="{StaticResource CardScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding ShowingFiles, Converter={StaticResource Vis}}">
                                <ItemsControl ItemsSource="{Binding Result.LargestFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,5">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Show in Explorer'}"
                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}">
                                                    <TextBlock Text="&#xE8A7;" />
                                                </Button>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="12,0" />
                                                <StackPanel>
                                                    <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" />
                                                    <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- 3. What could be freed on the drive picked, and the disks' health. -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Margin="12,0,0,0">
                                <ItemsControl ItemsSource="{Binding CleanupTabs}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Tab}" Content="{Binding Letter}" Tag="{Binding IsCleanupPicked}" AutomationProperties.Name="{Binding Title}"
                                                    Command="{Binding DataContext.PickCleanupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Root}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{Binding CleanupTitle}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- The shared loader until the list has been read the first time. -->
                        <ctl:Spinner Late="True" Width="20" Height="20" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,40,0,40"
                                     Visibility="{Binding CleanupRead, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding CleanupShown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.CleanupActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <!-- The word keeps its room while the spinner takes its place: the button doesn't change size. -->
                                                <Grid>
                                                    <TextBlock x:Name="Word" Text="{Binding ActionText}" />
                                                    <ctl:Spinner x:Name="Busy" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                </Grid>
                                            </Button>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Busy}" Value="True">
                                            <Setter TargetName="Word" Property="Visibility" Value="Hidden" />
                                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{ctl:T 'Nothing to free here that RigSight knows of.'}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding CleanupEmpty, Converter={StaticResource Vis}}" />
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding HasCleanupHint, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12" Content="{ctl:T Scan}" Command="{Binding ScanCleanupDriveCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding CleanupHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{ctl:T 'Nothing here is deleted automatically: it shows where the space is, and you decide.'}"
                                   FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding CleanupRead, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- The disks' health: a word for the state (Healthy, Early warning, Failing) in its colour, and why when it isn't healthy. -->
                <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Drive health'}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Live.Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8" Background="Transparent" ToolTip="{Binding HealthToolTip}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StateWord}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding HealthBrush}"
                                                       VerticalAlignment="Top" Margin="12,0,0,0" />
                                            <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{Binding HealthBrush}" VerticalAlignment="Top" Margin="0,6,8,0"
                                                     Visibility="{Binding HasHealth, Converter={StaticResource Vis}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                           Visibility="{Binding Details, Converter={StaticResource Vis}}" />
                                                <!-- Why it isn't healthy, in the colour of its dot (today's wording, kept). -->
                                                <TextBlock Text="{Binding HealthReason}" FontSize="11.5" Foreground="{Binding HealthBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HealthReason, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The box stays on a standard account, so the person sees the feature is there and why it is empty. -->
                        <TextBlock TextWrapping="Wrap" Visibility="{Binding Live.Drives.Count, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Text" Value="{ctl:T 'Drive health appears once the agent is running with admin rights.'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Live.StandardAccount}" Value="True">
                                            <Setter Property="Text" Value="{ctl:T 'Drive health needs admin rights on this PC.'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ctl:SmoothBorder>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
