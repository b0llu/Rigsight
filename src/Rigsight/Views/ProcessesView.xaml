<UserControl x:Class="Rigsight.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:svc="clr-namespace:Rigsight.Services">
    <UserControl.Resources>
        <!-- A row of this list: no shade of its own. The app's line and each of its processes take the pointer's shade
             themselves (below), so an opened app isn't one tall shaded block. As light as RowItem: nothing to animate. -->
        <Style x:Key="ProcItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Margin="0,0,0,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The figures: grey, and white and semi-bold in the column the list is sorted by. The only colour on this
             page is in the four totals. -->
        <Style x:Key="Fig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FigMemory" TargetType="TextBlock" BasedOn="{StaticResource Fig}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Memory">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FigCpu" TargetType="TextBlock" BasedOn="{StaticResource Fig}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Cpu">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FigInternet" TargetType="TextBlock" BasedOn="{StaticResource Fig}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Internet">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FigDisk" TargetType="TextBlock" BasedOn="{StaticResource Fig}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Disk">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FigLoad" TargetType="TextBlock" BasedOn="{StaticResource Fig}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Load">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- One step of the load's three: filled up to its level, in the figures' own grey (never a warning colour). -->
        <Style x:Key="LoadStep" TargetType="Rectangle">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="4" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="Margin" Value="2,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource StrokeBrush}" />
        </Style>

        <!-- A chart in an opened app's box: its caption, the chart, and the words under it. -->
        <Style x:Key="AxisWord" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        </Style>

        <!-- A column heading: a button that sorts. Its arrow says which way on the column sorted by; the rest show theirs
             under the pointer only (five ↕ in a row made the line busy). -->
        <Style x:Key="SortHead" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Command" Value="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding Key}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding SortName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="{Binding Label}" FontSize="{x:Static ctl:TextSize.Caption}" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="Arrow" Text="{Binding Arrow}" FontSize="{x:Static ctl:TextSize.Caption}" Margin="5,0,0,0" Foreground="{DynamicResource FaintBrush}" Opacity="0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- What opens under an app's row: one lighter box of what is on record about it (its facts, where its memory
             is, its memory through today), then each of its processes under their own heading. Built only for an app
             that is open (see the row's template), so the other rows stay as light as they were. -->
        <DataTemplate x:Key="OpenedApp">
            <StackPanel>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Control}" Margin="10,2,10,4" Padding="16,13,16,14">
                    <StackPanel>
                        <DockPanel>
                            <!-- The history is being read: the line says what it can meanwhile. -->
                            <ctl:Spinner DockPanel.Dock="Right" Late="True" Margin="12,0,0,0" VerticalAlignment="Top"
                                         Visibility="{Binding History.IsLoading, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                            <!-- Both charts and the CPU time fact over today or the days before, once CPU time is on record. -->
                            <Border x:Name="PeriodHost" DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Background="{DynamicResource SurfaceBrush}" Margin="12,-4,0,0" VerticalAlignment="Top"
                                    Visibility="{Binding History.HasCpu, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Today'}"
                                                 IsChecked="{Binding History.Period, Converter={StaticResource Equals}, ConverterParameter=Today}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Last 7 days'}"
                                                 IsChecked="{Binding History.Period, Converter={StaticResource Equals}, ConverterParameter=Week}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Last 30 days'}"
                                                 IsChecked="{Binding History.Period, Converter={StaticResource Equals}, ConverterParameter=Month}" />
                                    <!-- Custom (1.22.0): the same day calendar as the other pages, beside the segments; picked only once
                                         its days are, so a group of its own (the others stay lit while the calendar is open). -->
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T Custom}" GroupName="{Binding Exe, StringFormat='custom-{0}'}" Click="Custom_Click"
                                                 IsChecked="{Binding History.Period, Converter={StaticResource Equals}, ConverterParameter=Custom, Mode=OneWay}" />
                                    <Popup x:Name="RangePopup" PlacementTarget="{Binding ElementName=PeriodHost}" Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <ctl:SmoothBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                          CornerRadius="{x:Static ctl:Corner.Tile}" Padding="10" Margin="0,0,8,8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <Calendar x:Name="Cal" SelectionMode="SingleRange" FirstDayOfWeek="Monday" AutomationProperties.Name="{ctl:T 'Days to show'}" />
                                                <TextBlock x:Name="RangeHint" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" Margin="8,2,8,4" />
                                            </StackPanel>
                                        </ctl:SmoothBorder>
                                    </Popup>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding History.Facts}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,26,4" ToolTip="{Binding Tip}">
                                            <Run Text="{Binding Label, Mode=OneWay}" /> <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <!-- Where its memory is, then CPU and memory at 280 each (approved mock-up). With nothing to split, the two
                             charts share the whole row: no empty half beside them. -->
                        <Grid x:Name="Drawn" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition>
                                    <ColumnDefinition.Style>
                                        <Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" Value="*" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasShares}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ColumnDefinition.Style>
                                </ColumnDefinition>
                                <ColumnDefinition>
                                    <ColumnDefinition.Style>
                                        <Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" Value="Auto" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasShares}" Value="False"><Setter Property="Width" Value="*" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ColumnDefinition.Style>
                                </ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style x:Key="ChartColumn" TargetType="StackPanel">
                                    <Setter Property="Width" Value="280" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasShares}" Value="False"><Setter Property="Width" Value="NaN" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Resources>
                            <Grid x:Name="Charts" Grid.Column="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="36,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasShares}" Value="False"><Setter Property="Margin" Value="0" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="Cpu" Style="{StaticResource ChartColumn}"
                                            Visibility="{Binding History.HasCpuChart, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                    <!-- The caption, and the figure now at its right (approved mock-up, 2026-11-16). -->
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}"
                                                   Visibility="{Binding History.HasCpuNow, Converter={StaticResource Vis}, FallbackValue=Collapsed}"><Run Text="{Binding History.CpuNow, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" " /><Run Text="{ctl:T now}" /></TextBlock>
                                        <TextBlock Text="{Binding History.CpuCaption}" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                    <ctl:HourLine Height="56" Values="{Binding History.CpuValues}" Usual="{Binding History.CpuUsual}" Tips="{Binding History.CpuTips}"
                                                  Bars="{Binding History.IsDays}" Stroke="{DynamicResource CpuBrush}" Scale="{Binding History.CpuScale}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding History.AxisTo}" Style="{StaticResource AxisWord}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding History.AxisFrom}" Style="{StaticResource AxisWord}" />
                                        <TextBlock Text="{ctl:T 'Dashed line is its usual'}" Style="{StaticResource AxisWord}" HorizontalAlignment="Center"
                                                   Visibility="{Binding History.CpuUsual, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel x:Name="Today" Grid.Column="2" Style="{StaticResource ChartColumn}"
                                            Visibility="{Binding History.HasChart, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}"
                                                   Visibility="{Binding History.HasMemNow, Converter={StaticResource Vis}, FallbackValue=Collapsed}"><Run Text="{Binding History.MemNow, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" " /><Run Text="{ctl:T now}" /></TextBlock>
                                        <TextBlock Text="{Binding History.MemCaption}" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                    <ctl:HourLine Height="56" Values="{Binding History.MemValues}" Usual="{Binding History.MemUsual}" Tips="{Binding History.MemTips}"
                                                  Bars="{Binding History.IsDays}" Scale="Megabytes" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding History.AxisTo}" Style="{StaticResource AxisWord}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding History.AxisFrom}" Style="{StaticResource AxisWord}" />
                                        <TextBlock Text="{ctl:T 'Dashed line is its usual'}" Style="{StaticResource AxisWord}" HorizontalAlignment="Center"
                                                   Visibility="{Binding History.MemUsual, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="Split" Visibility="{Binding HasShares, Converter={StaticResource Vis}}">
                                <TextBlock Text="{ctl:T 'WHERE ITS MEMORY IS'}" Style="{StaticResource Caption}" Margin="0,0,0,9" />
                                <ctl:PartsBar Height="8" Parts="{Binding Shares}" />
                                <ItemsControl ItemsSource="{Binding Shares}" Focusable="False" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,26,4">
                                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,1,8,0"
                                                           Fill="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                                                <TextBlock FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- The list is set apart from the box by its own heading. -->
                <TextBlock Text="{Binding CountCaption}" Style="{StaticResource Caption}" Margin="46,8,0,4"
                           Visibility="{Binding ShowChildren, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Children}" Focusable="False" Visibility="{Binding ShowChildren, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Line" Background="Transparent" CornerRadius="{x:Static ctl:Corner.Field}" Padding="10,5" MouseRightButtonUp="Process_RightClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="36,1,0,0"
                                               Fill="{Binding KindBrush, Converter={StaticResource ResourceBrush}}"
                                               Visibility="{Binding HasKind, Converter={StaticResource Vis}}" />
                                    <TextBlock Grid.ColumnSpan="2" Margin="54,0,16,0" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}">
                                        <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding PidText, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Caption}" Foreground="{DynamicResource FaintBrush}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource FigMemory}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CpuCell}" Style="{StaticResource FigCpu}" />
                                    <TextBlock Grid.Column="5" Text="{Binding DiskCell}" Style="{StaticResource FigDisk}" />
                                    <Grid Grid.Column="7" Width="28" Height="24" HorizontalAlignment="Right">
                                        <Button x:Name="More" Style="{StaticResource IconButton}" Height="24" Click="ProcessMore_Click" Visibility="Hidden"
                                                ToolTip="{ctl:T 'More'}" AutomationProperties.Name="{Binding Label, StringFormat={ctl:T 'Actions for {0}'}}">
                                            <TextBlock Text="&#xE712;" />
                                        </Button>
                                        <ctl:Spinner HorizontalAlignment="Center" Visibility="{Binding IsEnding, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Line" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                    <Setter TargetName="More" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsEnding}" Value="True">
                                    <Setter TargetName="Line" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="More" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Nothing to split (most apps): the charts move to the left, where the split would be. -->
                <DataTrigger Binding="{Binding HasShares}" Value="False">
                    <Setter TargetName="Charts" Property="DockPanel.Dock" Value="Left" />
                    <Setter TargetName="Charts" Property="Margin" Value="0" />
                </DataTrigger>
                <!-- Nothing to draw: the facts alone, without the gap under them. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasShares}" Value="False" />
                        <Condition Binding="{Binding History.HasChart, FallbackValue=False}" Value="False" />
                        <Condition Binding="{Binding History.HasCpuChart, FallbackValue=False}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Drawn" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The list takes what the window has left under the totals, but never less than its MinHeight: then the page
             scrolls. Its height is set in the code-behind, from the height given here (as on the Memory page: with none
             to start from, the list was first laid out with every app's row at once). -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="Layout" Margin="32,26,32,24" MaxWidth="{StaticResource PageWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <!-- The page's own question for the AI (mock-up board 5). -->
                    <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'What is slowing my PC?'}" CommandParameter="{x:Static svc:PageAsks.Processes}" AutomationProperties.Name="{ctl:T 'What is slowing my PC?'}" />
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Processes'}" Style="{StaticResource H1}" />
                        <TextBlock Text="{ctl:T 'Everything running right now, and what each app is using.'}" Style="{StaticResource Muted}" Margin="0,4,0,18" />
                    </StackPanel>
                </DockPanel>

                <!-- The four totals: each sorts the list by its column. Their dot and their line are the page's only colour. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" Focusable="False" Margin="-7,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="7,0" Cursor="Hand" Focusable="False" CommandParameter="{Binding Key}" MinWidth="0" MinHeight="0" Padding="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.SortByTotalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.Name="{Binding SortName}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ctl:SmoothBorder x:Name="Bd" Style="{StaticResource Card}" Padding="18,14,18,12">
                                            <ContentPresenter />
                                        </ctl:SmoothBorder>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0" Fill="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Value, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Display}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Most}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    <!-- Across the whole foot of the tile, edge to edge (the margins undo the card's padding), and stretched
                                         over the readings there are: a page just opened showed a squiggle in one corner. -->
                                    <ctl:Sparkline Height="40" Margin="-18,10,-18,-12" Source="{Binding History}" Version="{Binding Version}" Kind="{Binding Kind}" Minimum="0" FitToData="True" FootRadius="15"
                                                   Stroke="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ctl:SmoothBorder Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,16,12,12" x:Name="LiveCard" MinHeight="440" Height="440">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,8,20">
                            <!-- With the filter on, how many of the apps running it shows, at the right of the row (mock-up 1.23.0). -->
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShownOfRunning}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="18,0,0,0" Visibility="{Binding OnlyWindowed, Converter={StaticResource Vis}}" />
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="{ctl:T 'Only apps with a window open'}" FontSize="{x:Static ctl:TextSize.Detail}" IsChecked="{Binding OnlyWindowed}" />
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search apps…'}" Width="220" Margin="0,-4,18,-4" VerticalAlignment="Center"
                                     AutomationProperties.Name="{ctl:T 'Search the running apps'}" ctl:Debounce.Text="{Binding Search}" />
                            <TextBlock Text="{ctl:T 'Running now'}" Style="{StaticResource H2}" />
                        </DockPanel>
                        <!-- Its right edge is set in the code-behind, to where the rows' figures end: the list's scrollbar takes
                             room from the rows that a fixed margin here could only guess at. -->
                        <Grid x:Name="LiveHead" DockPanel.Dock="Top" Margin="10,0,18,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SortHead}" DataContext="{Binding NameHeading}" HorizontalAlignment="Left" Margin="54,0,0,0" />
                            <!-- Not a sort: a plain heading, as the APP heading looks when it isn't the one sorted by. -->
                            <TextBlock Grid.Column="1" Text="{ctl:T 'CATEGORY'}" FontSize="{x:Static ctl:TextSize.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" />
                            <Button Grid.Column="2" Style="{StaticResource SortHead}" DataContext="{Binding MemoryHeading}" />
                            <Button Grid.Column="3" Style="{StaticResource SortHead}" DataContext="{Binding CpuHeading}" />
                            <Button Grid.Column="4" Style="{StaticResource SortHead}" DataContext="{Binding InternetHeading}" />
                            <Button Grid.Column="5" Style="{StaticResource SortHead}" DataContext="{Binding DiskHeading}" />
                            <Button Grid.Column="6" Style="{StaticResource SortHead}" DataContext="{Binding LoadHeading}" />
                        </Grid>
                        <!-- A rule between the headings and the rows: the first row's name sat right under "APP". -->
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,8,6" />
                        <TextBlock DockPanel.Dock="Top" Text="{ctl:T 'Nothing running matches'}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,28,0,0"
                                   Visibility="{Binding NoneMatch, Converter={StaticResource Vis}}" />
                        <Grid>
                            <!-- The list arrives from the agent a moment after the window opens: the box says it's on its way. -->
                            <ctl:Spinner Late="True" Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,40"
                                         Visibility="{Binding Live.AppsPending, Converter={StaticResource Vis}}" />
                            <!-- Click an app for its processes; right-click it, or its dots, for its menu; Ctrl+click picks several. -->
                            <ListBox x:Name="LiveList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ProcItem}" ItemsSource="{Binding Apps}"
                                     SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" KeyDown="List_KeyDown" AutomationProperties.Name="{ctl:T 'Running apps'}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel x:Name="Root" Margin="0,0,8,0">
                                            <Border x:Name="Head" Background="Transparent" CornerRadius="{x:Static ctl:Corner.Control}" Padding="10,8" MouseLeftButtonUp="App_Click" MouseRightButtonUp="App_RightClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="132" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <DockPanel>
                                                        <Grid Width="20" VerticalAlignment="Center">
                                                            <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                            <!-- Turns while the app's processes are on their way from the agent, as on Memory. -->
                                                            <ctl:Spinner x:Name="Opening" Width="10" Height="10" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                         Visibility="Collapsed" />
                                                        </Grid>
                                                        <Image Source="{Binding Icon}" Style="{StaticResource AppIcon}" Width="22" Height="22" />
                                                        <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" />
                                                            <TextBlock Text="{Binding CountText}" FontSize="{x:Static ctl:TextSize.Caption}" Foreground="{DynamicResource FaintBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <!-- Its kind: a dot in the kind's colour (as the Timeline colours kinds) and its name in grey. Changed from the row's menu. -->
                                                    <Border Grid.Column="1" Style="{StaticResource Chip}" Background="{DynamicResource HoverBrush}" Margin="0,0,8,0"
                                                            Visibility="{Binding Category, Converter={StaticResource Vis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryLabel}}" FontSize="{x:Static ctl:TextSize.Label}"
                                                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding MemText}" Style="{StaticResource FigMemory}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding CpuCell}" Style="{StaticResource FigCpu}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding NetCell}" Style="{StaticResource FigInternet}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding DiskCell}" Style="{StaticResource FigDisk}" />
                                                    <!-- Its load today: the word and its three steps, and what it comes from under the pointer. -->
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                                                                ToolTip="{Binding LoadTip}">
                                                        <TextBlock Text="{Binding LoadText}" Style="{StaticResource FigLoad}" />
                                                        <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                            <Rectangle x:Name="Step1" Style="{StaticResource LoadStep}" />
                                                            <Rectangle x:Name="Step2" Style="{StaticResource LoadStep}" />
                                                            <Rectangle x:Name="Step3" Style="{StaticResource LoadStep}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- The dots show on the row under the pointer, picked, or reached with the keyboard; a spinner in their place while it is being ended. -->
                                                    <Grid Grid.Column="7" Width="28" Height="28" HorizontalAlignment="Right">
                                                        <Button x:Name="More" Style="{StaticResource IconButton}" Click="AppMore_Click" Visibility="Hidden"
                                                                ToolTip="{ctl:T 'More'}" AutomationProperties.Name="{Binding Name, StringFormat={ctl:T 'Actions for {0}'}}">
                                                            <TextBlock Text="&#xE712;" />
                                                        </Button>
                                                        <ctl:Spinner HorizontalAlignment="Center" Visibility="{Binding IsEnding, Converter={StaticResource Vis}}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <!-- Nothing until the app is opened: then what is under it is built (see OpenedApp). -->
                                            <ContentControl x:Name="Under" Focusable="False" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                                <Setter TargetName="Under" Property="ContentTemplate" Value="{StaticResource OpenedApp}" />
                                                <Setter TargetName="Under" Property="Content" Value="{Binding}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                                                <Setter TargetName="Opening" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LoadSteps}" Value="1">
                                                <Setter TargetName="Steps" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Step1" Property="Fill" Value="{DynamicResource MutedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LoadSteps}" Value="2">
                                                <Setter TargetName="Steps" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Step1" Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                <Setter TargetName="Step2" Property="Fill" Value="{DynamicResource MutedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LoadSteps}" Value="3">
                                                <Setter TargetName="Steps" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Step1" Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                <Setter TargetName="Step2" Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                <Setter TargetName="Step3" Property="Fill" Value="{DynamicResource MutedBrush}" />
                                            </DataTrigger>
                                            <Trigger SourceName="Head" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Head" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter TargetName="More" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="More" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Head" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                <Setter TargetName="More" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEnding}" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                                <Setter TargetName="More" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </ctl:SmoothBorder>
            </Grid>
        </ScrollViewer>

        <!-- What just happened ("Ended Discord · 1.1 GB freed"), at the bottom of the page for a moment. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="16,10" CornerRadius="{x:Static ctl:Corner.Control}" IsHitTestVisible="False"
                Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                Visibility="{Binding Message, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" Foreground="{DynamicResource WarmBrush}" Margin="0,0,9,0"
                           Visibility="{Binding MessageWarns, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
