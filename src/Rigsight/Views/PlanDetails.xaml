<UserControl x:Class="Rigsight.Views.PlanDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <!-- A paid plan (or one given by support) with everything about it up front: today's questions, the next payment and
         Cancel, the card, receipts and Switch. Shown in Settings › AI and at the top of the Plans screen; DataContext is
         the PlansViewModel. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LeftToday}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding LeftLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PlanName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateIsWarning}" Value="True"><Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StateIsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
            <!-- Today's questions: the bar fills as they're used -->
            <Grid Height="6" Margin="0,14,0,6" ClipToBounds="True">
                <Border CornerRadius="3" Background="{DynamicResource Surface2Brush}" />
                <Border CornerRadius="3" Background="{DynamicResource TextBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding UsedPart}" /></Border.RenderTransform>
                </Border>
            </Grid>
            <TextBlock Text="{Binding UsedText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="2">
            <!-- Paid: next payment and cancel, card, receipts, switch -->
            <StackPanel Visibility="{Binding IsSubscription, Converter={StaticResource Vis}}">
                <DockPanel Margin="0,0,0,8" Visibility="{Binding HasNextPayment, Converter={StaticResource Vis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Cancel plan'}" Command="{Binding AskCancelCommand}"
                            VerticalAlignment="Center" Visibility="{Binding CanManage, Converter={StaticResource Vis}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{ctl:T 'Next payment'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding NextPayment}" FontSize="13.5" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,8" Visibility="{Binding IsEnding, Converter={StaticResource Vis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{Binding KeepText}" Command="{Binding KeepCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding EndingText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,0,0,8" Visibility="{Binding IsPastDue, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding PastDueText}" FontSize="12.5" Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap" />
                </DockPanel>
                <Border Height="1" Background="{DynamicResource StrokeBrush}" />
                <DockPanel Margin="0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ChangeCardCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ctl:T 'Change card'}" />
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{ctl:T 'Paid with'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding CardText}" FontSize="13.5" />
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource StrokeBrush}" />
                <DockPanel Margin="0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ReceiptsCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ctl:T 'See receipts'}" />
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{ctl:T 'Receipts'}" FontSize="13.5" VerticalAlignment="Center" />
                </DockPanel>
                <Border Height="1" Background="{DynamicResource StrokeBrush}" Visibility="{Binding CanSwitchPlan, Converter={StaticResource Vis}}" />
                <DockPanel Margin="0,8,0,0" Visibility="{Binding CanSwitchPlan, Converter={StaticResource Vis}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Compare plans'}" Command="{Binding ShowCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Content="{Binding SwitchText}" Command="{Binding AskSwitchCommand}" />
                    </StackPanel>
                    <TextBlock Text="{ctl:T 'Plan'}" FontSize="13.5" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
            <!-- Given by support: no payments, nothing to manage -->
            <StackPanel Visibility="{Binding IsGift, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding GiftText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'See plans'}" Command="{Binding ShowCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
