<UserControl x:Class="Rigsight.Views.PlanDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Cancel: the one button that ends something, in the warning colour and away from the rest. -->
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource HotSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <!-- A paid plan (or one given by support) with everything about it up front: the plan and today's questions, then the
         payments in one row and the buttons in another. Shown in Settings › AI and at the top of the
         Plans screen; DataContext is the PlansViewModel. -->
    <StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16,0,0,0">
                <TextBlock Text="{Binding LeftToday}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding LeftLabel}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PlanName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateIsWarning}" Value="True"><Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateIsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <!-- Today's questions: the bar fills as they're used -->
        <Grid Height="6" Margin="0,14,0,6" ClipToBounds="True">
            <Border CornerRadius="3" Background="{DynamicResource Surface2Brush}" />
            <Border CornerRadius="3" Background="{DynamicResource TextBrush}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="{Binding UsedPart}" /></Border.RenderTransform>
            </Border>
        </Grid>
        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Label}" />

        <!-- Cancelled (works until the end) or a failed payment: said in full, above the facts -->
        <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource WarmSoftBrush}" Padding="14,10" Margin="0,14,0,0"
                          Visibility="{Binding IsEnding, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{Binding KeepText}" Command="{Binding KeepCommand}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock Text="{Binding EndingText}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </ctl:SmoothBorder>
        <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource WarmSoftBrush}" Padding="14,10" Margin="0,14,0,0"
                          Visibility="{Binding IsPastDue, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding ChangeCardCommand}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{ctl:T 'Change card'}" />
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding PastDueText}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </ctl:SmoothBorder>

        <!-- Paid: the facts in one row, then the buttons in one row with Cancel set apart on the right (the plan box
             redesign, 2026-10-24: fewer boxes, real buttons). ↗ marks the two that open Lemon Squeezy's page. -->
        <StackPanel Visibility="{Binding IsSubscription, Converter={StaticResource Vis}}">
            <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="14,10" Margin="0,14,0,0">
                <UniformGrid Rows="1">
                    <StackPanel Margin="0,0,12,0" Visibility="{Binding HasNextPayment, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'Next payment'}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding NextPayment}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{ctl:T 'Paid with'}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding CardText}" Style="{StaticResource Value}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasLastPayment, Converter={StaticResource Vis}}">
                        <TextBlock Text="{ctl:T 'Last payment'}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding LastPayment}" Style="{StaticResource Value}" />
                    </StackPanel>
                </UniformGrid>
            </ctl:SmoothBorder>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CancelButton}" Content="{ctl:T 'Cancel plan'}" Command="{Binding AskCancelCommand}"
                        VerticalAlignment="Top" Margin="12,0,0,0" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}" />
                <WrapPanel>
                    <Button Style="{StaticResource AccentButton}" Content="{Binding SwitchText}" Command="{Binding AskSwitchCommand}" Margin="0,0,8,8"
                            Visibility="{Binding CanSwitchPlan, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Compare plans'}" Command="{Binding ShowCommand}" Margin="0,0,8,8"
                            Visibility="{Binding IsOpen, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    <!-- With a failed payment, the box above has the button: one Change card is enough. -->
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ChangeCardCommand}" Margin="0,0,8,8"
                            Visibility="{Binding IsPastDue, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ctl:T 'Change card'}" />
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ReceiptsCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ctl:T 'See receipts'}" />
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </StackPanel>

        <!-- Given by support: no payments, nothing to manage -->
        <DockPanel Margin="0,14,0,0" Visibility="{Binding IsGift, Converter={StaticResource Vis}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'See plans'}" Command="{Binding ShowCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="{Binding GiftText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</UserControl>
