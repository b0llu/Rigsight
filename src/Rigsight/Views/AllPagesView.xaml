<UserControl x:Class="Rigsight.Views.AllPagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <!-- All pages (approved mock-up 2026-11-24): every page under the sidebar's own headings, new pages first, each tile one
         line under its name (its figure right now, or what it's for) so the tiles in a row are the same height, and a switch
         that shows the page in the sidebar. A click anywhere else on a tile opens the page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <DockPanel Margin="0,0,0,18">
                <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Find a page'}" Width="300" VerticalAlignment="Center"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ctl:T 'Find a page'}" />
                <StackPanel>
                    <TextBlock Text="{ctl:T 'All pages'}" Style="{StaticResource H1}" />
                    <TextBlock Text="{ctl:T 'The switch shows a page in your sidebar, under its heading.'}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{ctl:T 'No page matches. Try another word, or ask about your PC at the top.'}" Style="{StaticResource Muted}"
                       Visibility="{Binding NothingFound, Converter={StaticResource Vis}}" />

            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock x:Name="Heading" Text="{Binding Heading}" Style="{StaticResource Caption}" Margin="2,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource TileColumns}}" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding OpenCommand}" Cursor="Hand" Margin="0,0,10,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Line}" ToolTipService.InitialShowDelay="600">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ctl:SmoothBorder x:Name="Bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                                      CornerRadius="{x:Static ctl:Corner.Tile}" Padding="14,12">
                                                        <ContentPresenter />
                                                    </ctl:SmoothBorder>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource IconBox}" VerticalAlignment="Center">
                                                    <ContentPresenter Content="{Binding Icon, Converter={StaticResource NavIcon}}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="{x:Static ctl:IconSize.S15}"
                                                                      TextElement.Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <ContentControl Template="{StaticResource NewTag}" Margin="8,0,0,0" Focusable="False"
                                                                        Visibility="{Binding IsNewPage, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                    <!-- One line, never two: a long one is cut short, with the whole of it on hover. -->
                                                    <TextBlock x:Name="Line" Text="{Binding Line}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsShown}" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{ctl:T 'Show in the sidebar'}" ToolTip="{ctl:T 'Show in the sidebar'}"
                                                          Visibility="{Binding CanHide, Converter={StaticResource Vis}}" />
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter TargetName="Heading" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
