<UserControl x:Class="Rigsight.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:local="clr-namespace:Rigsight.Views">
    <UserControl.Resources>
        <!-- The selected app's groups: a box a shade lighter than the card, its main figure, then label/value rows. -->
        <Style x:Key="GroupBox" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="GroupMain" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="GroupWord" TargetType="Run">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        </Style>
        <Style x:Key="GroupNote" TargetType="Run">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        </Style>
        <Style x:Key="GroupRowLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}" />
        <Style x:Key="GroupValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,24" MaxWidth="{StaticResource PageWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title, then a toolbar row: picking "Day" adds the date picker to the right without moving anything. -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="Apps" Style="{StaticResource H1}" />
            <TextBlock Text="How long you use each app, how long it sits in the background, and how hard it pushes your hardware."
                       Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Height="36" Margin="0,14,0,0">
                <ctl:PeriodPicker IsBusy="{Binding IsLoading}" Unit="{Binding Unit}" Anchor="{Binding Anchor}" MinDate="{Binding FirstDay}" CustomFrom="{Binding CustomFrom}" CustomTo="{Binding CustomTo}" />
                <TextBlock Text="{Binding RangeNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="30,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- App list -->
        <ctl:SmoothBorder Grid.Row="1" Style="{StaticResource Card}" Padding="12,14">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Search apps…" Margin="4,0,4,10"
                         ctl:Debounce.Text="{Binding Search}" />
                <!-- One row under the search: which category (a dot in its colour, as on Reports) and the order. -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox AutomationProperties.Name="Category" ToolTip="Show one kind of app"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Category, Converter={StaticResource CategoryBrush}}"
                                             Visibility="{Binding Category, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="2" AutomationProperties.Name="Sort by" ToolTip="Sort by" SelectedValuePath="Tag" SelectedValue="{Binding Sort}">
                        <ComboBoxItem Content="Most used" Tag="Active" />
                        <ComboBoxItem Content="Most in background" Tag="Background" />
                        <ComboBoxItem Content="Most internet use" Tag="Internet" />
                        <ComboBoxItem Content="Highest GPU peak" Tag="GpuTemp" />
                        <ComboBoxItem Content="Highest CPU peak" Tag="CpuTemp" />
                        <ComboBoxItem Content="Most memory" Tag="Memory" />
                        <ComboBoxItem Content="Most CPU use" Tag="Cpu" />
                    </ComboBox>
                </Grid>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The app's icon, or its first letter when it has none (so every row lines up). -->
                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="{DynamicResource Surface2Brush}"
                                            Visibility="{Binding Source, ElementName=RowIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding Stat.Name, Converter={StaticResource Initial}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image x:Name="RowIcon" Source="{Binding Stat.Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stat.Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Style="{StaticResource Bar}" Height="3" Margin="0,6,0,0" Value="{Binding Bar, Mode=OneWay}"
                                                 Foreground="{DynamicResource ListBarBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Metric}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ctl:SmoothBorder>

        <!-- Detail -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Style="{StaticResource GutterScroll}">
            <StackPanel>
                <ctl:Spinner Late="True" Width="22" Height="22" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,150,0,0"
                             Visibility="{Binding Ready, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                <ctl:SmoothBorder Style="{StaticResource Card}" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" />
                </ctl:SmoothBorder>

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <!-- Overview: who it is, then its time, its hardware and its internet use. -->
                    <ctl:SmoothBorder Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Selected.Name, Converter={StaticResource Initial}}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Source, ElementName=DetailIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                        <Image x:Name="DetailIcon" Source="{Binding Selected.Path, Converter={StaticResource ExeIcon}}" Width="36" Height="36"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource InlineEdit}" FontSize="20" FontWeight="SemiBold" Margin="-5,0,0,0"
                                             Text="{Binding SelectedAlias, UpdateSourceTrigger=LostFocus}" KeyDown="Rename_KeyDown"
                                             ToolTip="{Binding Selected.Path, StringFormat='{}Click to rename this app everywhere.&#x0a;{0}', TargetNullValue='Click to rename this app everywhere.'}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34" VerticalAlignment="Top"
                                        Click="More_Click" ToolTip="Category, tracking and file location" AutomationProperties.Name="More options">
                                    <TextBlock Text="&#xE712;" />
                                </Button>
                            </Grid>

                            <!-- Three groups side by side (one above the other on a narrow window), each the same parts in the
                                 same order: a caption, a main figure with a word after it, then its rows. -->
                            <local:GroupRow x:Name="Groups" Margin="0,20,0,0">
                                <Border Style="{StaticResource GroupBox}" AutomationProperties.Name="Time">
                                    <StackPanel>
                                        <TextBlock Text="TIME" Style="{StaticResource Caption}" />
                                        <TextBlock Style="{StaticResource GroupMain}">
                                            <Run Text="{Binding Selected.ActiveSec, Converter={StaticResource Duration}, Mode=OneWay}" /> <Run Text="active" Style="{StaticResource GroupWord}" />
                                        </TextBlock>
                                        <Border Style="{StaticResource GroupRowLine}" ToolTip="Open with a visible window while another app was in front">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}" Text="{Binding Selected.BackgroundSec, Converter={StaticResource Duration}}" />
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="In the background" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}" Text="{Binding Selected.MinimizedSec, Converter={StaticResource Duration}}" />
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="Minimized" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}" Text="{Binding Selected.LongestSessionSec, Converter={StaticResource Duration}, ConverterParameter=Dash}" />
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="Longest session" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}" ToolTip="Stretches of a minute or more in front">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}" Text="{Binding Selected.SessionCount}" />
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="Sessions" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GroupBox}" AutomationProperties.Name="Hardware">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="HARDWARE" /> <Run Text="while it was in front" FontWeight="Normal" Foreground="{DynamicResource FaintBrush}" />
                                        </TextBlock>
                                        <!-- Both peaks as equals, coloured by how warm they got (the GPU on its own scale, as everywhere). -->
                                        <TextBlock Style="{StaticResource GroupMain}">
                                            <Run Text="{Binding Selected.CpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.CpuTempMax, Converter={StaticResource TempBrush}}" /><Run Text=" · " Foreground="{DynamicResource FaintBrush}" /><Run Text="{Binding Selected.GpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" /> <Run Text="CPU · GPU peak" Style="{StaticResource GroupWord}" />
                                        </TextBlock>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}">
                                                    <Run Text="{Binding Selected.CpuTempAvg, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.CpuTempAvg, Converter={StaticResource TempBrush}}" /> <Run Text="average" Style="{StaticResource GroupNote}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="CPU temperature" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}">
                                                    <Run Text="{Binding Selected.GpuTempAvg, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.GpuTempAvg, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" /> <Run Text="average" Style="{StaticResource GroupNote}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="GPU temperature" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}">
                                                    <Run Text="{Binding Selected.CpuAvg, StringFormat='{}{0:0.0}%', TargetNullValue='—', Mode=OneWay}" /> <Run Text="average" Style="{StaticResource GroupNote}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="CPU use" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}">
                                                    <Run Text="{Binding Selected.MemMax, Converter={StaticResource Megabytes}, Mode=OneWay}" /> <Run Text="peak" Style="{StaticResource GroupNote}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="Memory" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GroupBox}" AutomationProperties.Name="Internet">
                                    <StackPanel>
                                        <TextBlock Text="INTERNET" Style="{StaticResource Caption}" />
                                        <TextBlock Style="{StaticResource GroupMain}">
                                            <Run Text="{Binding InternetMain, Mode=OneWay}" /> <Run Text="{Binding InternetWord, Mode=OneWay}" Style="{StaticResource GroupWord}" />
                                        </TextBlock>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}" Text="{Binding InternetDown}" />
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="Downloaded" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}" Text="{Binding InternetUp}" />
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="Uploaded" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRowLine}" ToolTip="Moved while another app was in front, or while nobody was at the PC">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource GroupValue}" Text="{Binding InternetBackground}" />
                                                <TextBlock Style="{StaticResource GroupLabel}" Text="In the background" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </local:GroupRow>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ctl:DailyBars ctl:Roomy.Height="170" Days="{Binding SelectedChart}" />
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding SelectedSessions.Count, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="Recent sessions" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <!-- When, how long, how warm: the last two are as wide as their widest (the same on every row), and
                                 the time has the rest. Two set widths cut the time off on a small window with room to spare beside it. -->
                            <ItemsControl ItemsSource="{Binding SelectedSessions}" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SessionLength" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SessionHeat" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Start, StringFormat='{}{0:ddd d MMM, h:mm tt}', Mode=OneWay}" /><Run Text=" – " Foreground="{DynamicResource FaintBrush}" /><Run Text="{Binding End, StringFormat='{}{0:h:mm tt}', Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="16,0,0,0" MinWidth="52" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="22,0,0,0">
                                                <Run Text="CPU" /> <Run Text="{Binding CpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding CpuTempMax, Converter={StaticResource TempBrush}}" /><Run Text="   GPU" /> <Run Text="{Binding GpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:SmoothBorder>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
