<UserControl x:Class="Rigsight.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title, then a toolbar row: picking "Day" adds the date picker to the right without moving anything. -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="Apps" Style="{StaticResource H1}" />
            <TextBlock Text="How long you use each app, how long it sits in the background, and how hard it pushes your hardware."
                       Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Height="36" Margin="0,14,0,0">
                <ctl:PeriodPicker Unit="{Binding Unit}" Anchor="{Binding Anchor}" MinDate="{Binding FirstDay}" />
                <TextBlock Text="{Binding RangeNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- App list -->
        <ctl:SmoothBorder Grid.Row="1" Style="{StaticResource Card}" Padding="12,14">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Search apps…" Margin="4,0,4,10"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <DockPanel DockPanel.Dock="Top" Margin="6,0,4,8">
                    <ComboBox DockPanel.Dock="Right" Width="170" SelectedValuePath="Tag" SelectedValue="{Binding Sort}">
                        <ComboBoxItem Content="Most used" Tag="Active" />
                        <ComboBoxItem Content="Most in background" Tag="Background" />
                        <ComboBoxItem Content="Hottest GPU" Tag="GpuTemp" />
                        <ComboBoxItem Content="Hottest CPU" Tag="CpuTemp" />
                        <ComboBoxItem Content="Most memory" Tag="Memory" />
                        <ComboBoxItem Content="Most CPU use" Tag="Cpu" />
                    </ComboBox>
                    <TextBlock Text="SORT BY" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The app's icon, or its first letter when it has none (so every row lines up). -->
                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="{DynamicResource Surface2Brush}"
                                            Visibility="{Binding Source, ElementName=RowIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding Stat.Name, Converter={StaticResource Initial}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image x:Name="RowIcon" Source="{Binding Stat.Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stat.Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Style="{StaticResource Bar}" Height="3" Margin="0,6,0,0" Value="{Binding Bar, Mode=OneWay}"
                                                 Foreground="{DynamicResource FaintBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Metric}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ctl:SmoothBorder>

        <!-- Detail -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Style="{StaticResource GutterScroll}">
            <StackPanel>
                <ctl:SmoothBorder Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                    <TextBlock Text="Nothing recorded yet for this period. Use your PC for a bit and come back." Style="{StaticResource Muted}" />
                </ctl:SmoothBorder>

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <!-- Overview: who it is, four headline figures, and the finer details in one quiet line. -->
                    <ctl:SmoothBorder Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Selected.Name, Converter={StaticResource Initial}}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Source, ElementName=DetailIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                        <Image x:Name="DetailIcon" Source="{Binding Selected.Path, Converter={StaticResource ExeIcon}}" Width="36" Height="36"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource InlineEdit}" FontSize="20" FontWeight="SemiBold" Margin="-5,0,0,0"
                                             Text="{Binding SelectedAlias, UpdateSourceTrigger=LostFocus}" KeyDown="Rename_KeyDown"
                                             ToolTip="{Binding Selected.Path, StringFormat='{}Click to rename this app everywhere.&#x0a;{0}', TargetNullValue='Click to rename this app everywhere.'}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34" VerticalAlignment="Top"
                                        Click="More_Click" ToolTip="Category, tracking and file location" AutomationProperties.Name="More options">
                                    <TextBlock Text="&#xE712;" />
                                </Button>
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel ToolTip="Open with a visible window while another app was in front">
                                    <TextBlock Text="IN BACKGROUND" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.BackgroundSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="LONGEST SESSION" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.LongestSessionSec, Converter={StaticResource Duration}, ConverterParameter=Dash}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel ToolTip="Stretches of a minute or more in front">
                                    <TextBlock Text="SESSIONS" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Selected.SessionCount}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </UniformGrid>

                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18,0,14" />
                            <WrapPanel>
                                <WrapPanel.Resources>
                                    <Style x:Key="Detail" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Margin" Value="0,2,28,2" />
                                    </Style>
                                </WrapPanel.Resources>
                                <TextBlock Style="{StaticResource Detail}">
                                    <Run Text="CPU" /> <Run Text="{Binding Selected.CpuTempAvg, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.CpuTempAvg, Converter={StaticResource TempBrush}}" /><Run Text=" avg · " /><Run Text="{Binding Selected.CpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.CpuTempMax, Converter={StaticResource TempBrush}}" /><Run Text=" peak" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Detail}">
                                    <Run Text="GPU" /> <Run Text="{Binding Selected.GpuTempAvg, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.GpuTempAvg, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" /><Run Text=" avg · " /><Run Text="{Binding Selected.GpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding Selected.GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" /><Run Text=" peak" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Detail}">
                                    <Run Text="Memory" /> <Run Text="{Binding Selected.MemMax, Converter={StaticResource Megabytes}, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" /><Run Text=" peak" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Detail}">
                                    <Run Text="CPU use" /> <Run Text="{Binding Selected.CpuAvg, StringFormat='{}{0:0.0}%', TargetNullValue='—', Mode=OneWay}" Foreground="{DynamicResource TextBrush}" /><Run Text=" avg" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Detail}">
                                    <Run Text="Minimized" /> <Run Text="{Binding Selected.MinimizedSec, Converter={StaticResource Duration}, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                                </TextBlock>
                            </WrapPanel>
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ctl:DailyBars Height="170" Days="{Binding SelectedChart}" />
                        </StackPanel>
                    </ctl:SmoothBorder>

                    <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding SelectedSessions.Count, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="Recent sessions" Style="{StaticResource H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding SelectedSessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Body}">
                                                <Run Text="{Binding Start, StringFormat='{}{0:ddd d MMM, h:mm tt}', Mode=OneWay}" /><Run Text=" – " Foreground="{DynamicResource FaintBrush}" /><Run Text="{Binding End, StringFormat='{}{0:h:mm tt}', Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Muted}" HorizontalAlignment="Right">
                                                <Run Text="CPU" /> <Run Text="{Binding CpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding CpuTempMax, Converter={StaticResource TempBrush}}" /><Run Text="   GPU" /> <Run Text="{Binding GpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:SmoothBorder>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
