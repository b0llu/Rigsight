<UserControl x:Class="Rigsight.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:svc="clr-namespace:Rigsight.Services"
             xmlns:views="clr-namespace:Rigsight.Views"
             x:Name="Page">
    <UserControl.Resources>
        <!-- A quiet link under the headline (the price): underlined text, lit under the pointer. -->
        <Style x:Key="QuietLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline" FontSize="{x:Static ctl:TextSize.Detail}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A label and its value in "How the CPU and GPU ran", a line under each. -->
        <DataTemplate x:Key="FactLine">
            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <DockPanel Margin="0,0,0,14">
                <Button Style="{StaticResource PageExportButton}" />
                <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'Where did the power go?'}" CommandParameter="{x:Static svc:PageAsks.Power}" AutomationProperties.Name="{ctl:T 'Where did the power go?'}" />
                <StackPanel>
                    <TextBlock Text="{ctl:T Power}" Style="{StaticResource H1}" />
                    <TextBlock Text="{ctl:T 'Where the CPU and GPU power went, and how that changed.'}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <ctl:PeriodPicker IsBusy="{Binding IsLoading}" Unit="{Binding Unit}" Anchor="{Binding Anchor}" MinDate="{Binding FirstDay}"
                                  CustomFrom="{Binding CustomFrom}" CustomTo="{Binding CustomTo}" />
                <TextBlock Text="{Binding RangeNote}" Foreground="{DynamicResource MutedBrush}" FontSize="{x:Static ctl:TextSize.Detail}" Margin="30,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ctl:Spinner Late="True" Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,150,0,0"
                         Visibility="{Binding ShowLoading, Converter={StaticResource Vis}}" />

            <!-- Nothing recorded, or no part reporting its power: one plain message. -->
            <ctl:SmoothBorder Style="{StaticResource Card}" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,30">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S28}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding EmptyNote}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </ctl:SmoothBorder>

            <StackPanel Visibility="{Binding ShowPage, Converter={StaticResource Vis}}">
                <!-- ── The headline: the energy, its parts, what it isn't, the price; beside it what changed and the games' share ── -->
                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding HeadCaption}" Style="{StaticResource Caption}" />
                            <TextBlock Margin="0,6,0,0">
                                <Run Text="{Binding HeadNumber, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Jumbo}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" kWh" FontSize="{x:Static ctl:TextSize.Lead}" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding PerDay}" Style="{StaticResource Muted}" Visibility="{Binding PerDay, Converter={StaticResource Vis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasBothParts, Converter={StaticResource Vis}}">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource CpuBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Muted}" Margin="0,0,16,0" />
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource GpuBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding GpuText}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Cursor="Help" ToolTipService.InitialShowDelay="150"
                                        ToolTip="{ctl:T 'Worked out from the power the CPU and the GPU report each minute. The rest of the PC (motherboard, drives, fans, screen) and the power supply\'s loss aren\'t measured, so a meter at the wall reads more.'}">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding NotWhole}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" MaxWidth="330" />
                            </StackPanel>
                            <!-- The price: a quiet link until one is given, then the estimated cost with Change. Its box floats beside it. -->
                            <Grid Margin="0,12,0,0">
                                <Button x:Name="AddPrice" Style="{StaticResource QuietLink}" Content="{ctl:T 'Add your electricity price'}" Command="{Binding OpenPriceCommand}" HorizontalAlignment="Left"
                                        Visibility="{Binding HasPrice, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasPrice, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding CostText}" FontSize="{x:Static ctl:TextSize.Detail}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" · " FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PriceText}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" · " FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="ChangePrice" Style="{StaticResource QuietLink}" Content="{ctl:T Change}" Command="{Binding OpenPriceCommand}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Popup IsOpen="{Binding PriceOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AddPrice}" Placement="Bottom" VerticalOffset="6"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="360" Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="1"
                                            CornerRadius="{x:Static ctl:Corner.Control}" Padding="16,14" Margin="0,0,8,8" AutomationProperties.Name="{ctl:T 'Electricity price'}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{ctl:T 'Electricity price'}" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <!-- Closed it says "₹ INR", short enough for every currency to fit; its list gives the full name
                                                     ("₹ INR, Indian Rupee"), each line as wide as it needs (the user, 2026-11-23: "₹ INR, India" was cut). -->
                                                <ComboBox x:Name="CurrencyBox" Width="{x:Static views:PowerView.CurrencyWidth}" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"
                                                          MaxDropDownHeight="320" AutomationProperties.Name="{ctl:T 'Currency'}" VerticalAlignment="Center">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="Words" Text="{Binding Text}" TextTrimming="None" />
                                                            <DataTemplate.Triggers>
                                                                <!-- Not in the list (no ComboBoxItem around it): the closed box. -->
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                                    <Setter TargetName="Words" Property="Text" Value="{Binding Short}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Style="{StaticResource FieldBox}" Width="110" Margin="8,0,8,0" Text="{Binding PriceInput, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{ctl:T 'Price per kWh'}" VerticalAlignment="Center" KeyDown="Price_KeyDown" />
                                                <TextBlock Text="{ctl:T 'per kWh'}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{ctl:T 'From your electricity bill. Include taxes to estimate your full cost.'}" FontSize="{x:Static ctl:TextSize.Small}"
                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                            <TextBlock Text="{ctl:T 'One price for every hour, used for every day shown.'}" FontSize="{x:Static ctl:TextSize.Small}"
                                                       Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <DockPanel Margin="0,14,0,0">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Content="{ctl:T 'Remove price'}" Command="{Binding RemovePriceCommand}"
                                                        Visibility="{Binding HasPrice, Converter={StaticResource Vis}}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource GhostButton}" Content="{ctl:T Cancel}" Command="{Binding CancelPriceCommand}" Margin="0,0,8,0" />
                                                    <Button Style="{StaticResource AccentButton}" Content="{ctl:T Save}" Command="{Binding SavePriceCommand}" IsEnabled="{Binding CanSavePrice}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <!-- What changed, with its reason; a game against its usual; a laptop's time on battery. One statement each. -->
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding ChangeText, Converter={StaticResource Vis}}">
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ChangeText}" FontSize="{x:Static ctl:TextSize.BodyPlus}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding GameLine, Converter={StaticResource Vis}}">
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7FC;" FontSize="{x:Static ctl:IconSize.S14}" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GameLineWarm}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding GameLine}" FontSize="{x:Static ctl:TextSize.BodyPlus}" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameLineWarm}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding BatteryLine, Converter={StaticResource Vis}}">
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding BatteryLine}" FontSize="{x:Static ctl:TextSize.BodyPlus}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- The games' share, set apart from the lines above: a bar and its two words. -->
                            <StackPanel Margin="0,4,0,0" Visibility="{Binding HasGames, Converter={StaticResource Vis}}">
                                <ProgressBar Style="{StaticResource Bar}" Height="8" Maximum="1" Value="{Binding GamesShare, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding GamesText}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,18,0" />
                                    <TextBlock Text="{Binding OtherText}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ctl:SmoothBorder>

                <!-- ── The chart ── -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding ChartHasCpu, Converter={StaticResource Vis}}">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource CpuBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{ctl:T CPU}" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding ChartHasGpu, Converter={StaticResource Vis}}">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource GpuBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{ctl:T GPU}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource H2}" />
                        </DockPanel>
                        <ctl:PowerChart Height="240" Margin="0,14,0,0" Slots="{Binding Slots}" IsLines="{Binding IsDay}" AutomationProperties.Name="{Binding ChartTitle}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- ── How the CPU and GPU ran, and what was in front ── -->
                <Grid Margin="-9,18,-9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctl:SmoothBorder Style="{StaticResource Card}" Margin="9,0">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'How the CPU and GPU ran'}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Chip}" Background="{DynamicResource CpuSoftBrush}">
                                            <TextBlock Text="{ctl:T CPU}" FontSize="{x:Static ctl:TextSize.Mini}" FontWeight="Bold" Foreground="{DynamicResource CpuBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding CpuFacts}" ItemTemplate="{StaticResource FactLine}" Focusable="False" />
                                    <TextBlock Text="{Binding CpuMissing}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding CpuMissing, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Chip}" Background="{DynamicResource GpuSoftBrush}">
                                            <TextBlock Text="{ctl:T GPU}" FontSize="{x:Static ctl:TextSize.Mini}" FontWeight="Bold" Foreground="{DynamicResource GpuBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding GpuFacts}" ItemTemplate="{StaticResource FactLine}" Focusable="False" />
                                    <TextBlock Text="{Binding GpuMissing}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding GpuMissing, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </ctl:SmoothBorder>
                    <ctl:SmoothBorder Grid.Column="1" Style="{StaticResource Card}" Margin="9,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{ctl:T 'What was in front'}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding AppsNote}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{ctl:T 'No app was in front.'}" Style="{StaticResource Muted}" Visibility="{Binding HasApps, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            <!-- A long list scrolls in a box of its own height. -->
                            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <!-- Room at the right for the scroll bar, so it never sits over the figures. -->
                                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6" ToolTip="{Binding Tip}" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" MaxWidth="190" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="20" Height="20" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center" ctl:TrimmedText.ToolTip="True" />
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <ProgressBar Grid.Column="3" Style="{StaticResource Bar}" Maximum="1" Value="{Binding Share, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Energy}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </ctl:SmoothBorder>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
