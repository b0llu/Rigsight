<UserControl x:Class="Rigsight.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Col" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <!-- Header -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Day"
                                         IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Day, Mode=OneWay}"
                                         Command="{Binding SetRangeCommand}" CommandParameter="Day" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Week"
                                         IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Week, Mode=OneWay}"
                                         Command="{Binding SetRangeCommand}" CommandParameter="Week" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Month"
                                         IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Month, Mode=OneWay}"
                                         Command="{Binding SetRangeCommand}" CommandParameter="Month" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding PreviousCommand}" ToolTip="Previous">
                        <TextBlock Text="&#xE76B;" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding GoTodayCommand}" Content="Today" Margin="4,0" />
                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding NextCommand}" ToolTip="Next"
                            IsEnabled="{Binding CanGoNext}">
                        <TextBlock Text="&#xE76C;" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding CoverageNote}" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,8,0,0"
                       Visibility="{Binding CoverageNote, Converter={StaticResource Vis}}" />

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasData, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" Margin="0,30">
                    <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing recorded for this period" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="Rigsight records while its background agent is running. Pick another period, or check back later."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource Vis}}">
                <!-- Headline numbers -->
                <UniformGrid Columns="6" Margin="-5,18,-5,0">
                    <Border Style="{StaticResource Tile}" Margin="5">
                        <StackPanel>
                            <TextBlock Text="ACTIVE" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Report.ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="5">
                        <StackPanel>
                            <TextBlock Text="PC ON" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Report.OnSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="5">
                        <StackPanel>
                            <TextBlock Text="AWAY" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Report.AwaySec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="5">
                        <StackPanel>
                            <TextBlock Text="CRASHES" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Crashes.Count}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="5">
                        <StackPanel>
                            <TextBlock Text="AVG CPU TEMP" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Report.CpuTempAvg, Converter={StaticResource TempShort}}" Style="{StaticResource StatValue}"
                                       Foreground="{Binding Report.CpuTempAvg, Converter={StaticResource TempBrush}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="5">
                        <StackPanel>
                            <TextBlock Text="AVG GPU TEMP" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Report.GpuTempAvg, Converter={StaticResource TempShort}}" Style="{StaticResource StatValue}"
                                       Foreground="{Binding Report.GpuTempAvg, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Timeline / daily bars -->
                <Border Style="{StaticResource Card}" Margin="0,13,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsDay, Converter={StaticResource Vis}}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource CpuBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,16,0" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource GpuBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="GPU" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" />
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="Your day, minute by minute" Style="{StaticResource H2}" Visibility="{Binding IsDay, Converter={StaticResource Vis}}" />
                                <TextBlock Text="Active time per day" Style="{StaticResource H2}" Visibility="{Binding IsMultiDay, Converter={StaticResource Vis}}" />
                            </Grid>
                        </DockPanel>
                        <ctl:DayTimeline Height="220" Segments="{Binding Report.Timeline}" Temps="{Binding Report.Temps}" Day="{Binding Report.From}"
                                         Visibility="{Binding IsDay, Converter={StaticResource Vis}}" />
                        <ctl:DailyBars Height="220" Days="{Binding Report.Days}" Visibility="{Binding IsMultiDay, Converter={StaticResource Vis}}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource FaintBrush}" Margin="40,10,0,0" TextWrapping="Wrap"
                                   Text="The strip shows the app in front, colored by category (faded = you were away); the lines below are CPU and GPU temperature. Hover anywhere for details."
                                   Visibility="{Binding IsDay, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <!-- Insights + hot moments -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="What stood out" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Report.Insights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,6">
                                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface2Brush}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center"
                                                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                       Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Hot moments" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Peaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" />
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding When, Mode=OneWay}" /><Run Text="{Binding App, Mode=OneWay, StringFormat='  ·  {0}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Apps -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowBackgroundApps}"
                                      Visibility="{Binding BackgroundOnlyCount, Converter={StaticResource Vis}}"
                                      ToolTip="Apps that were open in the background or minimized, but that you never actually switched to.">
                                <TextBlock Text="{Binding BackgroundToggleText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                            </CheckBox>
                            <StackPanel>
                                <TextBlock Text="Apps you used" Style="{StaticResource H2}" />
                                <TextBlock Text="Temperatures are averaged over the time each app was in front and in use." FontSize="12"
                                           Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="APP" Style="{StaticResource Caption}" Margin="44,0,0,0" />
                            <TextBlock Grid.Column="1" Text="IN USE" Style="{StaticResource Col}" ToolTip="In front and being used" />
                            <TextBlock Grid.Column="2" Text="BACKGROUND" Style="{StaticResource Col}" ToolTip="Open with a visible window, but another app was in front" />
                            <TextBlock Grid.Column="3" Text="MINIMIZED" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="4" Text="AVG CPU" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="5" Text="PEAK CPU" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="6" Text="AVG GPU" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="7" Text="PEAK GPU" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="8" Text="PEAK RAM" Style="{StaticResource Col}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="8" Padding="0,6" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel>
                                                <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" />
                                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Style="{StaticResource Chip}" Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=Soft}">
                                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryLabel}}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                        </Border>
                                                        <ProgressBar Style="{StaticResource Bar}" Height="4" Width="110" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                     Maximum="{Binding DataContext.MaxActive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                     Value="{Binding ActiveSec, Mode=OneWay}"
                                                                     Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ActiveSec, Converter={StaticResource Duration}, ConverterParameter=Dash}" Style="{StaticResource Cell}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding BackgroundSec, Converter={StaticResource Duration}, ConverterParameter=Dash}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="3" Text="{Binding MinimizedSec, Converter={StaticResource Duration}, ConverterParameter=Dash}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="4" Text="{Binding CpuTempAvg, Converter={StaticResource TempShort}}" Style="{StaticResource Cell}"
                                                       Foreground="{Binding CpuTempAvg, Converter={StaticResource TempBrush}}" />
                                            <TextBlock Grid.Column="5" Text="{Binding CpuTempMax, Converter={StaticResource TempShort}}" Style="{StaticResource Cell}"
                                                       Foreground="{Binding CpuTempMax, Converter={StaticResource TempBrush}}" />
                                            <TextBlock Grid.Column="6" Text="{Binding GpuTempAvg, Converter={StaticResource TempShort}}" Style="{StaticResource Cell}"
                                                       Foreground="{Binding GpuTempAvg, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                            <TextBlock Grid.Column="7" Text="{Binding GpuTempMax, Converter={StaticResource TempShort}}" Style="{StaticResource Cell}"
                                                       Foreground="{Binding GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                            <TextBlock Grid.Column="8" Text="{Binding MemMax, Converter={StaticResource Megabytes}}" Style="{StaticResource Cell}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Crashes -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding Crashes.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Crashes &amp; unexpected shutdowns" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Crashes}" ItemTemplate="{StaticResource CrashTemplate}" />
                    </StackPanel>
                </Border>

                <!-- Sessions -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding TopSessions.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Longest sessions" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding TopSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="24" Height="24" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="{StaticResource GpuSoftBrush}"
                                                    Visibility="{Binding IsGame, Converter={StaticResource Vis}}">
                                                <TextBlock Text="GAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GpuBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center">
                                            <Run Text="{Binding Start, StringFormat='{}{0:ddd h:mm tt}', Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding End, StringFormat='{}{0:h:mm tt}', Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Run Text="peak CPU" /> <Run Text="{Binding CpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding CpuTempMax, Converter={StaticResource TempBrush}}" /><Run Text="   GPU" /> <Run Text="{Binding GpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
