<UserControl x:Class="Rigsight.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:views="clr-namespace:Rigsight.Views">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.FigureLarge}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- The few words under a tile's figure: what it is set against. -->
        <Style x:Key="TileLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- A high of the period: what, when and with which app, and the figure. -->
        <DataTemplate x:Key="PeakLine">
            <DockPanel Margin="0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="{x:Static ctl:TextSize.Subtitle}" FontWeight="SemiBold"
                           Foreground="{Binding Brush}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" />
                    <TextBlock FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding When, Mode=OneWay}" /><Run Text="{Binding App, Mode=OneWay, StringFormat='  ·  {0}', TargetNullValue=''}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="Col" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="PageScroll_ScrollChanged">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <!-- Header -->
            <DockPanel>
                <Button Style="{StaticResource PageExportButton}" VerticalAlignment="Center" />
                <ctl:PeriodPicker DockPanel.Dock="Right" VerticalAlignment="Center" Unit="{Binding Range}" Anchor="{Binding Anchor}" MinDate="{Binding FirstDay}"
                                  CustomFrom="{Binding CustomFrom}" CustomTo="{Binding CustomTo}" />
                <!-- How the period went, asked of the AI (hidden while it's off, or with nothing to show). -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding ShowData, Converter={StaticResource Vis}}">
                    <Button Style="{StaticResource AiButton}" Content="{Binding ReportAskText}" CommandParameter="{Binding ReportAsk}" AutomationProperties.Name="{Binding ReportAskText}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding CoverageNote}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,8,0,0"
                       Visibility="{Binding CoverageNote, Converter={StaticResource Vis}}" />

            <!-- Empty state -->
            <ctl:Spinner Late="True" Width="{x:Static ctl:Spinner.PageSize}" Height="{x:Static ctl:Spinner.PageSize}" StrokeThickness="{x:Static ctl:Spinner.PageStroke}" HorizontalAlignment="Center" Margin="0,150,0,0"
                         Visibility="{Binding ShowLoading, Converter={StaticResource Vis}}" />
            <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,30">
                    <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S34}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="{ctl:T 'Pick another period to see its report.'}"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- The period's figures; while another period is read (past a moment), they stay under a dark cover with one
                 big ring in the middle of what's in view (issue #11, 2026-11-06: the user, "just show a big loader in center
                 while making background overlay blackish"). The title and the period picker stay clear above it. -->
            <Grid x:Name="DataArea">
            <!-- Figures count and bars slide only to another period's (see Motion). -->
            <StackPanel Visibility="{Binding ShowData, Converter={StaticResource Vis}}" ctl:Motion.Moves="{Binding FiguresMove}">
                <!-- The period's figures, each against something: its usual, the period before, what it is made of. -->
                <ctl:TileWrap Margin="0,18,0,0" MinTileWidth="190" Gap="10">
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'ACTIVE'}" Style="{StaticResource Caption}" />
                            <TextBlock ctl:CountUp.Text="{Binding Report.ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding ActiveLine}" Style="{StaticResource TileLine}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'IN GAMES'}" Style="{StaticResource Caption}" />
                            <TextBlock ctl:CountUp.Text="{Binding GamesText}" Style="{StaticResource StatValue}" />
                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding GamesLine}" Style="{StaticResource TileLine}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'INTERNET'}" Style="{StaticResource Caption}" />
                            <TextBlock ctl:CountUp.Text="{Binding InternetText}" Style="{StaticResource StatValue}" />
                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding InternetLine}" Style="{StaticResource TileLine}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Visibility="{Binding HasEnergy, Converter={StaticResource Vis}}"
                            ToolTip="{ctl:T 'Worked out from the power the CPU and the GPU report each minute. The screen, the drives and the rest of the PC aren\'t measured.'}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'ENERGY'}" Style="{StaticResource Caption}" />
                            <TextBlock ctl:CountUp.Text="{Binding EnergyText}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="{Binding EnergyParts}" Style="{StaticResource TileLine}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'PC PROBLEMS'}" Style="{StaticResource Caption}" />
                            <!-- Amber when more than usual, green with none, plain as usual (in the style: a colour set on the element would win over the trigger). -->
                            <TextBlock ctl:CountUp.Text="{Binding ProblemsText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProblemsTone}" Value="Warm">
                                                <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProblemsTone}" Value="Good">
                                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Up to three parts: two lines rather than cut short. -->
                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding ProblemsLine}" Style="{StaticResource TileLine}" TextWrapping="Wrap" MaxHeight="34" />
                        </StackPanel>
                    </Border>
                </ctl:TileWrap>

                <!-- Where the time went: a row for each kind of app, biggest first, every bar from the same edge (one bar cut into
                     pieces was hard to read past its first piece); its time, its share and its apps. A click shows that kind alone
                     on the days under it (mock-up FRqgRz6oR4PjbazDL4wt3x, option A). -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding HasTimeSplit, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" ctl:CountUp.Text="{Binding TimeSplitNote}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'Where the time went'}" Style="{StaticResource H2}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TimeRows}" Focusable="False" AutomationProperties.Name="Where the time went">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FlatRowButton}" Margin="-8,0" Command="{Binding DataContext.PickKindCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Part.Name}">
                                        <!-- Its own room inside the hover's background (FlatRowButton draws no padding): the dot sat on its edge. -->
                                        <Grid Margin="8,6">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dim}" Value="True">
                                                            <Setter Property="Opacity" Value="0.35" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="2*" MaxWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Rectangle Width="9" Height="9" RadiusX="2.5" RadiusY="2.5" VerticalAlignment="Center" Margin="0,1,9,0"
                                                           Fill="{Binding Part.Brush, Converter={StaticResource ResourceBrush}}" />
                                                <TextBlock Text="{Binding Part.Name}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Height="10" Minimum="0" Maximum="1" ctl:SmoothBar.Key="{Binding Part.Name}" ctl:SmoothBar.Value="{Binding Part.OfLargest, Mode=OneWay}"
                                                         Foreground="{Binding Part.Brush, Converter={StaticResource ResourceBrush}}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Part.Text}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Part.ShareText}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Part.Apps}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" Margin="18,0,0,0"
                                                       TextTrimming="CharacterEllipsis" ctl:TrimmedText.ToolTip="True" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Active time: an hour a bar on a day (0 to 60 minutes, with the usual for that weekday), a day a bar on a
                     week or a month, a month a bar on a year (issue #9, 2026-11-06). -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0">
                    <StackPanel>
                        <!-- The dashed line's name at the right, as the Temperatures card's key (2026-11-06, the user's pick: on
                             the line it found no free spot when every day was near the average, and sat on a bar). -->
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding Key, ElementName=ActiveBars, Converter={StaticResource Vis}}">
                                <Line X1="0" X2="17" Y1="0" Y2="0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeDashArray="5 4" VerticalAlignment="Center" Margin="0,1,7,0" />
                                <TextBlock Text="{Binding Key, ElementName=ActiveBars}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding BarsTitleShown}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ctl:DailyBars x:Name="ActiveBars" ctl:Roomy.Height="220" Days="{Binding Report.Days}" Only="{Binding PickedKinds}" ShowTemps="False"
                                       Usual="{Binding Report.UsualHours}" UsualName="{Binding UsualHoursName}" UsualDay="{Binding Report.UsualDay}"
                                       Linked="{Binding Hovered, ElementName=TempBars}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Temperatures: its own card under the bars, on the same columns, so the heat lines up with what was being done
                     (2026-11-06, mock-up ReK33EVbdKbsoarY7jwYXQ). Each bar a CPU and a GPU bar from lowest to highest with the
                     average across (mock-up Gvq1nXbE8Ubq4W1Q2CHzQb, A): all three figures show, so no Average / Highest /
                     Lowest switch. A column pointed at in either graph is lit in both. -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding HasPeriodTemps, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource CpuBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="6,0,16,0" VerticalAlignment="Center" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource GpuBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="GPU" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="6,0,16,0" VerticalAlignment="Center" />
                                <!-- The mark, as drawn: a bar from lowest to highest with a line across at the average. -->
                                <Grid Width="12" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Border Width="6" Height="14" CornerRadius="{x:Static ctl:Corner.Bar}" Background="{DynamicResource MutedBrush}" Opacity="0.4" />
                                    <Border Width="10" Height="2.4" CornerRadius="{x:Static ctl:Corner.Hairline}" Background="{DynamicResource MutedBrush}" />
                                </Grid>
                                <TextBlock Text="{ctl:T 'Lowest to highest, line at the average'}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TempsTitle}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ctl:PeriodTemps x:Name="TempBars" ctl:Roomy.Height="200" Days="{Binding Report.Days}" Linked="{Binding Hovered, ElementName=ActiveBars}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Against your usual: the period's temperatures, fans and problems beside what is normal for this PC. Only
                     what moved is coloured; the rest is said in grey. Not on a day (Home's PC health says that). -->
                <ctl:SmoothBorder x:Name="UsualCard" Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding HasUsual, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{ctl:T 'This PC\'s own history'}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" VerticalAlignment="Center" />
                            <TextBlock Text="{ctl:T 'Against your usual'}" Style="{StaticResource H2}" />
                        </DockPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{ctl:T 'WHAT'}" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="{Binding UsualNow}" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="{ctl:T 'YOUR USUAL'}" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="{ctl:T 'WHAT IT MEANS'}" Style="{StaticResource Caption}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding UsualRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" FontSize="{x:Static ctl:TextSize.Body}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="Now" Grid.Column="1" Text="{Binding Now}" Style="{StaticResource Body}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,14,0" />
                                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Usual}" Style="{StaticResource Body}" FontSize="{x:Static ctl:TextSize.Body}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding UsualDetail}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock x:Name="Means" Text="{Binding Means}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MeansDetail}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                           Visibility="{Binding MeansDetail, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Worse">
                                            <Setter TargetName="Means" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            <Setter TargetName="Means" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Better">
                                            <Setter TargetName="Means" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            <Setter TargetName="Means" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>


                <!-- Insights + hot moments -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ctl:SmoothBorder Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding InsightsTitle}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding ShownInsights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <HeaderedContentControl Style="{StaticResource IconRow}" Margin="0,6" Padding="14,0,0,0" ToolTip="{Binding DetailOrNull}">
                                            <HeaderedContentControl.Header>
                                                <Border Style="{StaticResource IconBox}">
                                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" HorizontalAlignment="Center"
                                                               Foreground="{Binding ., Converter={StaticResource InsightBrush}}" />
                                                </Border>
                                            </HeaderedContentControl.Header>
                                            <TextBlock Text="{Binding Text}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        </HeaderedContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:SmoothBorder>
                    <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{ctl:T 'Peaks'}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Peaks}" ItemTemplate="{StaticResource PeakLine}" Focusable="False" />
                        </StackPanel>
                    </ctl:SmoothBorder>
                </Grid>

                <!-- Apps -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowBackgroundApps}"
                                      Visibility="{Binding BackgroundOnlyCount, Converter={StaticResource Vis}}"
                                      ToolTip="{ctl:T 'Apps that were open in the background or minimized, but that you never actually switched to.'}">
                                <TextBlock Text="{Binding BackgroundToggleText}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" />
                            </CheckBox>
                            <StackPanel>
                                <TextBlock Text="{ctl:T 'Apps you used'}" Style="{StaticResource H2}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="10,0,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{ctl:T 'APP'}" Style="{StaticResource Caption}" Margin="44,0,0,0" />
                            <TextBlock Grid.Column="1" Text="{ctl:T 'IN USE'}" Style="{StaticResource Col}" ToolTip="{ctl:T 'In front and being used'}" />
                            <TextBlock Grid.Column="2" Text="{ctl:T 'BACKGROUND'}" Style="{StaticResource Col}" ToolTip="{ctl:T 'Open with a visible window, but another app was in front'}" />
                            <TextBlock Grid.Column="3" Text="{ctl:T 'CPU PEAK'}" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="4" Text="{ctl:T 'GPU PEAK'}" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="5" Text="{ctl:T 'MEMORY PEAK'}" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="6" Text="{ctl:T 'INTERNET'}" Style="{StaticResource Col}" ToolTip="{ctl:T 'Downloaded and uploaded'}" />
                        </Grid>
                        <!-- Every app, in a box of a set height that scrolls (a month can list hundreds; only the rows on screen are built). -->
                        <ItemsControl ItemsSource="{Binding Apps}" ctl:Roomy.MaxHeight="{x:Static views:ReportsView.AppsMaxHeight}" Focusable="False"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Apps you used">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer Style="{StaticResource CardScroll}" Padding="0" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="{x:Static ctl:Corner.Field}" Padding="10,6" Background="Transparent">
                                        <!-- What left the columns is still a pointer away. -->
                                        <Border.ToolTip>
                                            <TextBlock>
                                                <Run Text="{ctl:T 'Minimized'}" /> <Run Text="{Binding MinimizedSec, Converter={StaticResource Duration}, ConverterParameter=Dash, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{ctl:T 'Average CPU'}" /><Run Text=" " /><Run Text="{Binding CpuTempAvg, Converter={StaticResource TempShort}, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{ctl:T 'Average GPU'}" /><Run Text=" " /><Run Text="{Binding GpuTempAvg, Converter={StaticResource TempShort}, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.1*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel>
                                                <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" />
                                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=Soft}">
                                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryLabel}}" FontSize="{x:Static ctl:TextSize.MiniPlus}" FontWeight="SemiBold"
                                                                   Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ActiveSec, Converter={StaticResource Duration}, ConverterParameter=Dash}" Style="{StaticResource Cell}"
                                                       Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding BackgroundSec, Converter={StaticResource Duration}, ConverterParameter=Dash}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="3" Text="{Binding CpuTempMax, Converter={StaticResource TempShort}}" Style="{StaticResource Cell}"
                                                       Foreground="{Binding CpuTempMax, Converter={StaticResource TempBrush}}" />
                                            <TextBlock Grid.Column="4" Text="{Binding GpuTempMax, Converter={StaticResource TempShort}}" Style="{StaticResource Cell}"
                                                       Foreground="{Binding GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                            <TextBlock Grid.Column="5" Text="{Binding MemMax, Converter={StaticResource Megabytes}}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="6" Text="{Binding NetBytes, Converter={StaticResource DataSize}}" Style="{StaticResource Cell}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- What changed on the PC in the period (the Timeline has it all). -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasChangeCard, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="timeline"
                                    AutomationProperties.Name="Open the Timeline">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'Timeline'}" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{ctl:T 'What changed on the PC'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Changes}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,7,18,7">
                                        <Border Width="30" Height="30" CornerRadius="{x:Static ctl:Corner.Field}" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" HorizontalAlignment="Center"
                                                       Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                                        </Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Text}" Style="{StaticResource Body}" FontSize="{x:Static ctl:TextSize.BodyPlus}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Detail}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock FontSize="{x:Static ctl:TextSize.Small}" Visibility="{Binding Result, Converter={StaticResource Vis}}">
                                                    <Run Text="  ·  " Foreground="{DynamicResource FaintBrush}" /><Hyperlink Focusable="False"
                                                        Foreground="{Binding ResultBrush, Converter={StaticResource ResourceBrush}}"
                                                        Command="{Binding DataContext.OpenLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Run
                                                        Text="{Binding Result, Mode=OneWay}" /></Hyperlink>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
</DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AppChangesText}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" Margin="0,6,0,0"
                                   Visibility="{Binding HasAppChanges, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Crashes -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding Crashes.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Crashes &amp; sudden shut-offs'}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding CrashesShown}" ItemTemplate="{StaticResource CrashTemplate}" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                Content="{Binding MoreCrashesText}" Command="{Binding ShowMoreCrashesCommand}"
                                Visibility="{Binding HasMoreCrashes, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Sessions -->
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding TopSessions.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'Longest sessions'}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding TopSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A game's session opens the game on the Games page: the rest of its plays. -->
                                    <Button Style="{StaticResource FlatRowButton}" IsEnabled="{Binding IsGame}" Margin="-8,0" Padding="0"
                                            Command="{Binding DataContext.OpenGameRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Exe}">
                                    <Grid Margin="8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="24" Height="24" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="{DynamicResource GoodSoftBrush}"
                                                    Visibility="{Binding IsGame, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{ctl:T 'GAME'}" FontSize="{x:Static ctl:TextSize.Mini}" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center">
                                            <Run Text="{Binding Start, Converter={StaticResource TimeFormat}, ConverterParameter='ddd h:mm tt', Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding End, Converter={StaticResource TimeFormat}, ConverterParameter='h:mm tt', Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Run Text="{ctl:T 'CPU peak'}" /> <Run Text="{Binding CpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding CpuTempMax, Converter={StaticResource TempBrush}}" /><Run Text="   " /><Run Text="{ctl:T 'GPU peak'}" /> <Run Text="{Binding GpuTempMax, Converter={StaticResource TempShort}, Mode=OneWay}" Foreground="{Binding GpuTempMax, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                        </TextBlock>
                                    </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>
            </StackPanel>
            <Border x:Name="Cover" Background="{DynamicResource BgBrush}" Opacity="0" Visibility="Collapsed" Margin="-12,8,-12,0" />
            <Canvas x:Name="RingLayer" IsHitTestVisible="False" Visibility="Collapsed">
                <ctl:Spinner x:Name="PageRing" Width="{x:Static ctl:Spinner.PageSize}" Height="{x:Static ctl:Spinner.PageSize}" StrokeThickness="{x:Static ctl:Spinner.PageStroke}" />
            </Canvas>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
