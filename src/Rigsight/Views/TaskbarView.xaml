<UserControl x:Class="Rigsight.Views.TaskbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:conv="clr-namespace:Rigsight.Converters"
             xmlns:svc="clr-namespace:Rigsight.Services">
    <UserControl.Resources>
        <!-- Windows 11's taskbar, dark or light as the user has it, for the preview. -->
        <SolidColorBrush x:Key="BarDark" Color="#1C1C1C" />
        <SolidColorBrush x:Key="BarLight" Color="#EEEEEE" />

        <!-- The kind of reading, as on All sensors: sensors of one chip often share a name ("GPU Core"). -->
        <DataTemplate x:Key="KindBadge">
            <Border Style="{StaticResource Badge}" Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=soft}"
                    VerticalAlignment="Center" Padding="6,2" Width="44">
                <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
            </Border>
        </DataTemplate>

        <!-- A way to show the readings, as a card to pick: a small picture of it, its name and one line. -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <ctl:SmoothBorder x:Name="Bd" CornerRadius="12" Padding="16,14" BorderThickness="1.5"
                                          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                            <ContentPresenter />
                        </ctl:SmoothBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A common reading, added with one click. -->
        <Style x:Key="QuickChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ctl:SmoothBorder x:Name="Bd" CornerRadius="9" Padding="10,6,12,6" Background="{DynamicResource Surface2Brush}"
                                          BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </ctl:SmoothBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line in a floating list (a look, a sensor to add): lit on hover, outlined when it's the one in use (Tag "on"). -->
        <Style x:Key="ListChoice" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A segment that can't be picked now (a size the taskbar is too short for): still there, muted. -->
        <Style x:Key="SizeSegment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text on the preview's taskbar: white on dark, black on light. -->
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.TaskbarLight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Foreground" Value="#E6000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BarApp" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.TaskbarLight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Background" Value="#1F000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A reading in the list: what it is, its live value, its colours, how it shows, its order. -->
        <DataTemplate x:Key="ReadingRow">
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="12,9" Margin="0,0,0,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Move up'}" AutomationProperties.Name="Move up"
                                Command="{Binding DataContext.MoveSensorUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="&#xE70E;" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Move down'}" AutomationProperties.Name="Move down"
                                Command="{Binding DataContext.MoveSensorDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="&#xE70D;" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="{ctl:T 'Remove from the taskbar'}" AutomationProperties.Name="Remove"
                                Command="{Binding DataContext.RemoveSensorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="&#xE711;" />
                        </Button>
                    </StackPanel>
                    <!-- In two rows: a box of its own, or shared with the next -->
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="{ctl:T 'On its own'}" FontSize="12.5" Margin="18,0,4,0"
                              VerticalAlignment="Center" IsChecked="{Binding Alone}" AutomationProperties.Name="{Binding AloneName}"
                              Visibility="{Binding InBoxes, Converter={StaticResource Vis}}" />
                    <!-- How it shows: its picture as the taskbar draws it, and its style, look and size in words; the picker floating under it -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource SurfaceBrush}" Padding="5,4,10,4" Margin="16,0,0,0"
                            VerticalAlignment="Center" Click="Look_Click" MinWidth="170" AutomationProperties.Name="{Binding LookButtonName}"
                            Visibility="{Binding Found, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="64" Height="32" CornerRadius="5" Background="{Binding BarBrush}" Margin="0,0,9,0" ClipToBounds="True">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                                    <Image Source="{Binding Picture}" Stretch="None" SnapsToDevicePixels="True" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="{Binding ShowsAsText}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Its own colours: the number's, the name's and the tile's dots, a picker floating under it -->
                    <Button DockPanel.Dock="Right" Padding="10,6" Margin="16,0,0,0" VerticalAlignment="Center" Click="Colors_Click"
                            Background="{DynamicResource SurfaceBrush}" AutomationProperties.Name="{Binding ColorsName}"
                            IsEnabled="{Binding DataContext.Colored, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding Found, Converter={StaticResource Vis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding NumberDot}" Margin="0,0,3,0" />
                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Mark}" Margin="0,0,3,0" />
                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding TileDot}" BorderThickness="1" Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource StrokeBrush}" />
                            <TextBlock Text="{ctl:T 'Colors'}" FontSize="12.5" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="7,1,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- The live reading -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Sensor.FormattedValue, FallbackValue='—'}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />
                    <Rectangle DockPanel.Dock="Left" Width="3" Height="26" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Mark}" Margin="0,0,10,0"
                               ToolTip="{Binding PartLabel}" Visibility="{Binding Found, Converter={StaticResource Vis}}" />
                    <!-- Its own bindings see the sensor (its content), so whether the row's was found comes from the row -->
                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding Sensor}" ContentTemplate="{StaticResource KindBadge}" Margin="0,0,12,0"
                                      Visibility="{Binding DataContext.Found, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource Vis}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HardwareLine}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SizeNow}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding SizeNow, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- A narrow column, in the middle of a wide window (at the left of the frame it left half the window empty
             on one side only). -->
        <Grid MaxWidth="{StaticResource PageFrame}">
        <StackPanel Margin="32,26,32,32" MaxWidth="900">
            <DockPanel>
                <!-- The page's own question for the AI (mock-up board 5). -->
                <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'What should it show?'}" CommandParameter="{x:Static svc:PageAsks.Taskbar}" AutomationProperties.Name="{ctl:T 'What should it show?'}" />
                <TextBlock Text="{ctl:T 'Taskbar'}" Style="{StaticResource H1}" />
            </DockPanel>
            <TextBlock Text="{ctl:T 'Readings next to the clock, always in view. In color, each part has its own, and any reading can have its own colors too.'}"
                       Style="{StaticResource Muted}" Margin="0,4,0,20" TextWrapping="Wrap" />

            <!-- Preview: the corner of the taskbar, as the taskbar will draw it (the agent's own drawing, at its real height) -->
            <ctl:SmoothBorder Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <!-- Rounded as the card is inside its line (16 less 1), at the bottom too unless a note sits under it -->
                    <Border Padding="22,14" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource BarDark}" />
                                <Setter Property="CornerRadius" Value="15" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TaskbarLight}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BarLight}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowTrayNote}" Value="True">
                                        <Setter Property="CornerRadius" Value="15,15,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Height="{Binding BarHeight}">
                            <!-- The clock and the usual system icons -->
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                <TextBlock Text="12:30" Style="{StaticResource BarText}" FontSize="13" HorizontalAlignment="Right" />
                                <TextBlock Text="27-09-2026" Style="{StaticResource BarText}" FontSize="12" HorizontalAlignment="Right" Opacity="0.85" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.8">
                                <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Style="{StaticResource BarText}" Margin="12,0,0,0" />
                                <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Style="{StaticResource BarText}" Margin="12,0,0,0" />
                            </StackPanel>
                            <!-- Windows' arrow for its hidden icons, next to Wi-Fi; RigSight's readings sit left of it -->
                            <TextBlock DockPanel.Dock="Right" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Style="{StaticResource BarText}" VerticalAlignment="Center" Margin="0,0,0,0" Opacity="0.8" />
                            <!-- The readings, drawn as the taskbar draws them, pixel for pixel: next to the clock or at the left end -->
                            <Image Source="{Binding PreviewImage}" Stretch="None" SnapsToDevicePixels="True" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="{ctl:T 'The taskbar readings, as they will show'}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="DockPanel.Dock" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewOnLeft}" Value="True">
                                                <Setter Property="DockPanel.Dock" Value="Left" />
                                                <Setter Property="Margin" Value="-12,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- The middle of the taskbar, hinted: apps pinned there -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Style="{StaticResource BarApp}" />
                                <Border Style="{StaticResource BarApp}" />
                                <Border Style="{StaticResource BarApp}" />
                                <Border Style="{StaticResource BarApp}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Under the preview: Windows' own tray icons (Windows 10) can be hidden behind its arrow -->
                    <DockPanel Margin="22,14,22,16" Visibility="{Binding ShowTrayNote, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                   Text="{ctl:T 'Windows may tuck new icons behind the arrow next to the clock. Drag them out once and they stay in view.'}" />
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>
            <!-- A short taskbar (Windows' smaller buttons): the readings are on one line, as the preview shows -->
            <TextBlock Text="{Binding BarNote}" Style="{StaticResource Muted}" FontSize="12" Margin="4,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding BarNote, Converter={StaticResource Vis}}" />

            <!-- Every reading in one style: a strip, an icon each, an icon per part, or two rows (each reading can have its own too) -->
            <TextBlock Text="{ctl:T 'SET ALL TO'}" Style="{StaticResource Caption}" Margin="4,26,0,10" />
            <UniformGrid Columns="4" Margin="-6,0">
                <RadioButton Style="{StaticResource ModeCard}" GroupName="traymode" IsChecked="{Binding InStrip}" Margin="6,0" AutomationProperties.Name="In the taskbar">
                    <StackPanel>
                        <Border CornerRadius="7" Background="{StaticResource BarDark}" Padding="8,6" HorizontalAlignment="Left" Margin="0,0,0,12" Height="36">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="62°" Foreground="#34D399" FontFamily="Segoe UI Semibold" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="CPU" Foreground="#5B8CFF" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="35%" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="{ctl:T 'Load'}" Foreground="#5B8CFF" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="71°" Foreground="#FBBF24" FontFamily="Segoe UI Semibold" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="GPU" Foreground="#22D3EE" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'In the taskbar'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{ctl:T 'Each reading over a short name, like the clock, with a look of its own.'}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ModeCard}" GroupName="traymode" IsChecked="{Binding Separate}" Margin="6,0" AutomationProperties.Name="An icon each">
                    <StackPanel>
                        <Border CornerRadius="7" Background="{StaticResource BarDark}" Padding="8,8" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <ctl:TaskbarIconView Width="20" Height="20" Text1="62" Brush1="#34D399" Tile="#3D5B8CFF" Margin="0,0,6,0" />
                                <ctl:TaskbarIconView Width="20" Height="20" Text1="71" Brush1="#FBBF24" Tile="#3D22D3EE" Margin="0,0,6,0" />
                                <ctl:TaskbarIconView Width="20" Height="20" Text1="35" Brush1="White" Tile="#3D5B8CFF" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'An icon each'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{ctl:T 'Small icons in the taskbar, each on a tile in the color of its part.'}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ModeCard}" GroupName="traymode" IsChecked="{Binding Grouped}" Margin="6,0" AutomationProperties.Name="An icon per part">
                    <StackPanel>
                        <Border CornerRadius="7" Background="{StaticResource BarDark}" Padding="8,5" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <ctl:TaskbarIconView Width="26" Height="26" Text1="62" Brush1="#34D399" Text2="35" Brush2="White" Tile="#3D5B8CFF" Margin="0,0,6,0" />
                                <ctl:TaskbarIconView Width="26" Height="26" Text1="71" Brush1="#FBBF24" Text2="98" Brush2="White" Tile="#3D22D3EE" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'An icon per part'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{ctl:T 'Two readings stacked in each, the temperature on top. Takes the least room.'}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ModeCard}" GroupName="traymode" IsChecked="{Binding TwoRows}" Margin="6,0" AutomationProperties.Name="Two rows">
                    <StackPanel>
                        <Border CornerRadius="7" Background="{StaticResource BarDark}" Padding="5,0" HorizontalAlignment="Left" Margin="0,0,0,12" Height="36">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.LayoutTransform>
                                    <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                                </StackPanel.LayoutTransform>
                                <Border CornerRadius="4" Background="#14FFFFFF" Padding="5,3" Margin="0,0,4,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="15" />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="CPU" Foreground="#5B8CFF" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,5,1" />
                                        <TextBlock Grid.Column="1" Text="62°" Foreground="#34D399" FontFamily="Segoe UI Semibold" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Row="1" Text="{ctl:T 'Load'}" Foreground="#5B8CFF" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,5,1" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="35%" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                                <Border CornerRadius="4" Background="#14FFFFFF" Padding="5,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="15" />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="GPU" Foreground="#22D3EE" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,5,1" />
                                        <TextBlock Grid.Column="1" Text="71°" Foreground="#FBBF24" FontFamily="Segoe UI Semibold" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Row="1" Text="{ctl:T 'Load'}" Foreground="#22D3EE" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,5,1" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="98%" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{ctl:T 'Two rows'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{ctl:T 'Readings in boxes of two that you pick, the name beside the number.'}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
            <TextBlock Text="{Binding StripNote}" Style="{StaticResource Muted}" FontSize="12" Margin="4,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding StripNote, Converter={StaticResource Vis}}" />

            <!-- Colours, which end of the taskbar, tiles, for the strip how roomy, two rows' names, speeds' unit: side by side -->
            <WrapPanel Margin="0,26,0,0">
                <!-- The parts' colours, or grayscale -->
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="{ctl:T 'COLORS'}" Style="{StaticResource Caption}" Margin="4,0,0,10" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Color'}" GroupName="traycolors"
                                         IsChecked="{Binding Colors, Converter={StaticResource Equals}, ConverterParameter=Color}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Grayscale'}" GroupName="traycolors"
                                         IsChecked="{Binding Colors, Converter={StaticResource Equals}, ConverterParameter=Grayscale}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Where they sit, in any style: the taskbar's left end, or the right, next to the clock -->
                <StackPanel Margin="0,0,40,0" Visibility="{Binding ShowPlace, Converter={StaticResource Vis}}">
                    <TextBlock Text="{ctl:T 'PLACE'}" Style="{StaticResource Caption}" Margin="4,0,0,10" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Left'}" GroupName="trayside"
                                         IsChecked="{Binding SideText, Converter={StaticResource Equals}, ConverterParameter=Left}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Right'}" GroupName="trayside"
                                         IsChecked="{Binding SideText, Converter={StaticResource Equals}, ConverterParameter=Right}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Each reading on a tile, or on nothing -->
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="{Binding BackgroundCaption}" Style="{StaticResource Caption}" Margin="4,0,0,10" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'None'}" GroupName="traytiles"
                                         IsChecked="{Binding Background, Converter={StaticResource Equals}, ConverterParameter=None}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{Binding TilesWord}" GroupName="traytiles"
                                         IsChecked="{Binding Background, Converter={StaticResource Equals}, ConverterParameter=Tiles}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- How much room the strip takes -->
                <StackPanel Margin="0,0,40,0" Visibility="{Binding ShowWidth, Converter={StaticResource Vis}}">
                    <TextBlock Text="{ctl:T 'WIDTH'}" Style="{StaticResource Caption}" Margin="4,0,0,10" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Compact'}" GroupName="traywidth"
                                         IsChecked="{Binding WidthText, Converter={StaticResource Equals}, ConverterParameter=Compact}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Standard'}" GroupName="traywidth"
                                         IsChecked="{Binding WidthText, Converter={StaticResource Equals}, ConverterParameter=Standard}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Roomy'}" GroupName="traywidth"
                                         IsChecked="{Binding WidthText, Converter={StaticResource Equals}, ConverterParameter=Roomy}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Two rows' names: in full, or one letter -->
                <StackPanel Margin="0,0,40,0" Visibility="{Binding ShowNames, Converter={StaticResource Vis}}">
                    <TextBlock Text="{ctl:T 'NAMES'}" Style="{StaticResource Caption}" Margin="4,0,0,10" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{Binding FullNamesWord}" GroupName="traynames"
                                         IsChecked="{Binding NamesText, Converter={StaticResource Equals}, ConverterParameter=Full}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'One letter'}" GroupName="traynames"
                                         IsChecked="{Binding NamesText, Converter={StaticResource Equals}, ConverterParameter=Letter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Speeds in bytes or in bits, as internet plans say them -->
                <StackPanel Visibility="{Binding ShowSpeeds, Converter={StaticResource Vis}}">
                    <TextBlock Text="{ctl:T 'SPEEDS IN'}" Style="{StaticResource Caption}" Margin="4,0,0,10" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="MB/s" GroupName="trayspeeds"
                                         IsChecked="{Binding SpeedsText, Converter={StaticResource Equals}, ConverterParameter=Bytes}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Mbps" GroupName="trayspeeds"
                                         IsChecked="{Binding SpeedsText, Converter={StaticResource Equals}, ConverterParameter=Bits}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="{Binding SideNote}" Style="{StaticResource Muted}" FontSize="12" Margin="4,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding SideNote, Converter={StaticResource Vis}}" />

            <!-- What: the readings, in order, with adding at the top (search next to the title, the list floating under it) -->
            <DockPanel Margin="4,26,0,10">
                <Grid DockPanel.Dock="Right" Width="300">
                    <!-- The app's search box (its magnifier, its placeholder where the caret is, no box drawn inside it) -->
                    <TextBox x:Name="AddSearchText" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Add a reading…'}" Text="{Binding AddSearch, UpdateSourceTrigger=PropertyChanged}"
                             GotKeyboardFocus="AddBox_Focus" PreviewMouseLeftButtonUp="AddBox_Click" PreviewKeyDown="AddBox_KeyDown"
                             AutomationProperties.Name="{ctl:T 'Add a reading: search all sensors'}" />
                    <!-- The list: the common readings first, then every sensor by part; a click adds it and it stays open. Kept open by the
                         page, not by Windows (StaysOpen): opened while the box was being clicked, the box took the mouse back to place its
                         caret and Windows closed the list at once (it flashed), and a list that had lost the mouse missed clicks outside
                         it. It closes as the title bar's ask drop does: a click elsewhere in the window, another window, Esc, Tab, or the
                         page scrolling or going (see TaskbarView.xaml.cs). -->
                    <Popup x:Name="AddPop" PlacementTarget="{Binding ElementName=AddSearchText}" Placement="Bottom" VerticalOffset="6" StaysOpen="True"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <ctl:SmoothBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                          CornerRadius="12" Padding="8" Margin="0,0,8,8" Width="380">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Visibility="{Binding ShowCommon, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{ctl:T 'COMMON'}" Style="{StaticResource Caption}" Margin="6,6,0,8" />
                                    <ItemsControl ItemsSource="{Binding QuickPicks}" Focusable="False" Margin="4,0,0,2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource QuickChip}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label, StringFormat=Add {0}}"
                                                        Command="{Binding DataContext.AddQuickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="{ctl:T 'No sensor matches that. Try a part, like GPU, or a kind, like temp.'}" Style="{StaticResource Muted}" FontSize="12.5"
                                           Margin="8" TextWrapping="Wrap" Visibility="{Binding AddListEmpty, Converter={StaticResource Vis}}" />
                                <ItemsControl ItemsSource="{Binding AddList}" Focusable="False" MaxHeight="360" VirtualizingPanel.IsVirtualizing="True"
                                              ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer Style="{StaticResource CardScroll}" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding Heading}" Style="{StaticResource Caption}" Margin="6,10,0,4"
                                                           Visibility="{Binding IsHeading, Converter={StaticResource Vis}}" />
                                                <Button Style="{StaticResource ListChoice}" Padding="8,6" Visibility="{Binding IsHeading, Converter={StaticResource Vis}, ConverterParameter=Invert}"
                                                        IsEnabled="{Binding CanAdd}" AutomationProperties.Name="{Binding Sensor.DisplayName, StringFormat=Add {0}}"
                                                        Command="{Binding DataContext.AddReadingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Sensor}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Width="16"
                                                                   TextAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Sensor.FormattedValue, FallbackValue='—'}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Background="{Binding Sensor.Kind, Converter={StaticResource KindBrush}, ConverterParameter=soft}"
                                                                VerticalAlignment="Center" Padding="6,2" Width="44" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Sensor.Kind, Converter={StaticResource KindBrush}}" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Sensor.DisplayName}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Sensor.HardwareShown}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ctl:SmoothBorder>
                    </Popup>
                </Grid>
                <TextBlock Text="{ctl:T 'READINGS'}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </DockPanel>
            <ctl:SmoothBorder Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Readings waiting for room in "+N", as the agent says -->
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="12,9" Margin="0,0,0,10"
                            Visibility="{Binding WaitingText, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource WarmBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                            <TextBlock Text="{Binding WaitingText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Nothing yet -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,18" Visibility="{Binding HasSensors, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE75B;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'Nothing in the taskbar yet'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,10,0,2" />
                        <TextBlock Text="{ctl:T 'Add a reading with the search box above.'}" Style="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Sensors}" Focusable="False" ItemTemplate="{StaticResource ReadingRow}" />
                </StackPanel>
            </ctl:SmoothBorder>

            <!-- How a reading shows, floating next to its button: its style, its size, its look (a picture of each, as the
                 taskbar will draw it) and the reading its look comes from. Takes no room on the page. Its reading is given as
                 it opens (none before: the page's own would be looked in for a Name and Looks). -->
            <Popup x:Name="LookPop" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" DataContext="{x:Null}">
                <ctl:SmoothBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                  CornerRadius="12" Padding="14,12" Margin="0,0,8,8" Width="470">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,12" TextTrimming="CharacterEllipsis">
                            <Run Text="{ctl:T 'How it shows on the taskbar:'}" />
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        </TextBlock>

                        <TextBlock Text="{ctl:T 'STYLE'}" Style="{StaticResource Caption}" Margin="2,0,0,8" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'In the taskbar'}" GroupName="rowstyle"
                                             IsChecked="{Binding StyleText, Converter={StaticResource Equals}, ConverterParameter=Strip}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Two rows'}" GroupName="rowstyle"
                                             IsChecked="{Binding StyleText, Converter={StaticResource Equals}, ConverterParameter=TwoRows}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'An icon each'}" GroupName="rowstyle"
                                             IsChecked="{Binding StyleText, Converter={StaticResource Equals}, ConverterParameter=Icons}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'An icon per part'}" GroupName="rowstyle"
                                             IsChecked="{Binding StyleText, Converter={StaticResource Equals}, ConverterParameter=Grouped}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{ctl:T 'SIZE'}" Style="{StaticResource Caption}" Margin="2,16,0,8" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SizeSegment}" Content="{ctl:T 'Auto'}" GroupName="rowsize"
                                             IsChecked="{Binding SizeText, Converter={StaticResource Equals}, ConverterParameter=Auto}" />
                                <RadioButton Style="{StaticResource SizeSegment}" Content="{ctl:T 'Small'}" GroupName="rowsize" IsEnabled="{Binding CanSmall}"
                                             IsChecked="{Binding SizeText, Converter={StaticResource Equals}, ConverterParameter=Small}" />
                                <RadioButton Style="{StaticResource SizeSegment}" Content="{ctl:T 'Medium'}" GroupName="rowsize" IsEnabled="{Binding CanMedium}"
                                             IsChecked="{Binding SizeText, Converter={StaticResource Equals}, ConverterParameter=Medium}" />
                                <RadioButton Style="{StaticResource SizeSegment}" Content="{ctl:T 'Large'}" GroupName="rowsize" IsEnabled="{Binding CanLarge}"
                                             IsChecked="{Binding SizeText, Converter={StaticResource Equals}, ConverterParameter=Large}" />
                            </StackPanel>
                        </Border>
                        <!-- A size the taskbar is too short for: why, and where Windows changes it -->
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="12,9" Margin="0,10,0,0"
                                Visibility="{Binding SizeNote, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource SurfaceBrush}" Padding="10,5" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Content="{ctl:T 'Open taskbar settings'}" Click="OpenTaskbarSettings_Click"
                                        AutomationProperties.Name="{ctl:T 'Open taskbar settings'}" />
                                <TextBlock Text="{Binding SizeNote}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <StackPanel Visibility="{Binding HasLooks, Converter={StaticResource Vis}}">
                            <TextBlock Text="{ctl:T 'LOOK'}" Style="{StaticResource Caption}" Margin="2,16,0,8" />
                            <ItemsControl ItemsSource="{Binding Looks}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ListChoice}" Padding="4,6,4,7" Margin="0,0,6,6" Click="LookChoice_Click" Tag="{Binding Tag}"
                                                Command="{Binding Row.PickLookCommand}" CommandParameter="{Binding Look}" AutomationProperties.Name="{Binding Name}">
                                            <StackPanel>
                                                <Border Width="96" Height="52" CornerRadius="7" Background="{Binding Row.BarBrush}" ClipToBounds="True">
                                                    <Viewbox Stretch="Uniform" Margin="4,2" StretchDirection="DownOnly">
                                                        <Image Source="{Binding Picture}" Stretch="None" SnapsToDevicePixels="True" />
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Together: the look drawn from another reading of its part, the number its own -->
                        <StackPanel Visibility="{Binding ShowLookFrom, Converter={StaticResource Vis}}">
                            <TextBlock Text="{ctl:T 'DRAW THE LOOK FROM'}" Style="{StaticResource Caption}" Margin="2,10,0,8" />
                            <ItemsControl ItemsSource="{Binding LookFromChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ListChoice}" Padding="10,5" Margin="0,0,6,6" Tag="{Binding Tag}" Background="{DynamicResource Surface2Brush}"
                                                Command="{Binding Row.PickLookFromCommand}" CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ctl:SmoothBorder>
            </Popup>

            <!-- A reading's colours, floating next to its Colors button (takes no room on the page) -->
            <ctl:ColorPicker x:Name="ColorPick" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
