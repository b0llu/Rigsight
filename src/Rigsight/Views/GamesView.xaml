<UserControl x:Class="Rigsight.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:vm="clr-namespace:Rigsight.ViewModels"
             xmlns:svc="clr-namespace:Rigsight.Services"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <!-- The frame rate's own blue (not a part's colour), or the picked accent (Accents.Fps), and the Play button in it. -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource FpsBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFpsBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Lead}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="22,0" />
            <!-- Hovered, the blue brightens: the app's grey hover shade over it looked murky. -->
            <Style.Resources>
                <SolidColorBrush x:Key="HoverBrush" Color="#2EFFFFFF" />
            </Style.Resources>
            <Style.Triggers>
                <!-- The game is running: "Running", greyed, can't be pressed. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- An uninstall button while the game runs: dimmed and can't be pressed. -->
        <Style x:Key="OffWhenDisabled" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource OffWhenDisabled}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Body}" />
        </Style>
        <!-- A quiet line that opens something (the foot of the library, 1.23.0): muted, its text lit under the pointer. -->
        <Style x:Key="QuietLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="2,3" CornerRadius="{x:Static ctl:Corner.Tag}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A label over the banner. -->
        <!-- A figure over the banner: plain text on the banner's own dark fade, spaced apart. A see-through bubble behind
             each read as a dark smudge (WPF can't blur what's under it the way the mock-up did). -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="CornerRadius" Value="{x:Static ctl:Corner.Small}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KvLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,7" />
        </Style>
        <!-- The game's icon in one rounded square, the same for every game without a picture. -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- A figure over the banner: one line of text on a small solid box, so it stands out from the art behind. -->
        <DataTemplate x:Key="PillTemplate">
            <Border Style="{StaticResource Pill}">
                <TextBlock FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource TextBrush}">
                    <Run Text="{Binding Lead, Mode=OneWay}" /><Run Text="{Binding Bold, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Trail, Mode=OneWay}" />
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScroll" Style="{StaticResource GutterScroll}">
            <Grid MaxWidth="{StaticResource PageFrame}">
                <ctl:Spinner Late="True" Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0">
                    <ctl:Spinner.Style>
                        <Style TargetType="ctl:Spinner">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsOpening}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctl:Spinner.Style>
                </ctl:Spinner>

                <!-- ═════════════ The library ═════════════ -->
                <StackPanel x:Name="LibraryPanel" Visibility="{Binding IsLibrary, Converter={StaticResource Vis}}">
                    <StackPanel Visibility="{Binding Ready, Converter={StaticResource Vis}}">
                        <!-- The last game played, or the one being played: its banner, logo and figures. -->
                        <Grid Height="290" ClipToBounds="True" Visibility="{Binding HasHero, Converter={StaticResource Vis}}" AutomationProperties.Name="{ctl:T 'Last played'}">
                            <Image Source="{Binding HeroBanner}" Stretch="UniformToFill" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Style="{StaticResource IconTile}" Width="150" Height="150" CornerRadius="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,28,0"
                                    Visibility="{Binding HeroHasBanner, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                <Grid>
                                    <Image Source="{Binding HeroIcon}" Width="108" Height="108" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S64}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HeroIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                </Grid>
                            </Border>
                            <Rectangle Fill="{DynamicResource BgBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#EB000000" Offset="0" />
                                        <GradientStop Color="#8C000000" Offset="0.45" />
                                        <GradientStop Color="#1A000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Fill="{DynamicResource BgBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.45" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <!-- The right edge melts into the page too: on a window wider than the page the banner ended in a hard edge. -->
                            <Rectangle Fill="{DynamicResource BgBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0.82" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <!-- The library's question for the AI (mock-up board 5), left of Export, over the banner. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,22,0">
                                <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'Which game needs tuning?'}" CommandParameter="{x:Static svc:PageAsks.Games}" AutomationProperties.Name="{ctl:T 'Which game needs tuning?'}" Height="30" Padding="12,0" Margin="0" Background="{DynamicResource Surface2Brush}" />
                                <Button Style="{StaticResource PageExportButton}" Height="30" Padding="12,0" />
                            </StackPanel>
                            <Grid Margin="28,0,28,22" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource GoodBrush}" Margin="0,0,7,0" VerticalAlignment="Center"
                                                 Visibility="{Binding HeroLive, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding HeroEyebrow}" Style="{StaticResource Eyebrow}" />
                                    </StackPanel>
                                    <Image Source="{Binding HeroLogo}" MaxHeight="92" MaxWidth="360" HorizontalAlignment="Left" Margin="0,10,0,10" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HeroHasLogo, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding HeroName}" FontSize="{x:Static ctl:TextSize.JumboLarge}" FontWeight="Bold" Margin="0,8,0,10" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HeroHasLogo, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                    <ItemsControl ItemsSource="{Binding HeroPills}" ItemTemplate="{StaticResource PillTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Style="{StaticResource PlayButton}" Command="{Binding PlayHeroCommand}" Margin="0,0,10,0"
                                            Visibility="{Binding HeroInstalled, Converter={StaticResource Vis}}" IsEnabled="{Binding HeroNotRunning}" AutomationProperties.Name="{ctl:T 'Play'}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HeroNotRunning, Converter={StaticResource Vis}}"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,9,0" Foreground="{DynamicResource OnFpsBrush}" /><TextBlock Text="{ctl:T 'Play'}" /></StackPanel>
                                            <TextBlock Text="{ctl:T 'Running'}" Visibility="{Binding HeroLive, Converter={StaticResource Vis}}" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource HeroButton}" Content="{ctl:T 'Game details'}" Command="{Binding OpenHeroCommand}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <StackPanel Margin="28,22,28,30">
                            <!-- Title, count, which games and in what order. Where the window is too narrow for all on one
                                 line (or the words are longer, as in Spanish), the search and buttons go under the title. -->
                            <Grid x:Name="LibraryHead" Margin="0,0,0,16" SizeChanged="LibraryHead_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="LibraryTitle" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{ctl:T 'Library'}" FontSize="{x:Static ctl:TextSize.Figure}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="LibraryTools" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                                    <TextBox Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search games…'}" Width="200" Margin="0,0,10,0" VerticalAlignment="Center"
                                             AutomationProperties.Name="{ctl:T 'Search the games'}" ctl:Debounce.Text="{Binding Search}" />
                                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GameFilter" Content="{ctl:T 'All'}" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=all}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GameFilter" Content="{ctl:T 'Installed'}" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=installed}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GameFilter" Content="{ctl:T 'Played before'}" ToolTip="{ctl:T 'Games played on this PC that aren\'t installed any more'}"
                                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=before}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GameSort" Content="{ctl:T 'Recently played'}" IsChecked="{Binding Sort, Converter={StaticResource Equals}, ConverterParameter=recent}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GameSort" Content="{ctl:T 'Most played'}" IsChecked="{Binding Sort, Converter={StaticResource Equals}, ConverterParameter=most}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GameSort" Content="{ctl:T 'Hardest on your PC'}" ToolTip="{ctl:T 'How busy each game keeps the GPU'}"
                                                         IsChecked="{Binding Sort, Converter={StaticResource Equals}, ConverterParameter=hard}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GameSort" Content="{ctl:T 'Size on disk'}" IsChecked="{Binding Sort, Converter={StaticResource Equals}, ConverterParameter=size}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{ctl:T 'No games yet. A game shows here once a launcher lists it as installed or RigSight sees it played.'}"
                                       Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />

                            <!-- A game marked "Not a game" just left (1.23.0, approved mock-up board "Not a game"): said here, with Undo,
                                 no pop-up asked first. -->
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Tile}" Padding="14,10" Margin="0,0,0,16"
                                    Visibility="{Binding HasLeft, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Undo'}" Command="{Binding UndoNotAGameCommand}" Height="32" Padding="14,0" VerticalAlignment="Center" />
                                    <HeaderedContentControl Style="{StaticResource IconRow}" Padding="12,0,12,0">
                                        <HeaderedContentControl.Header>
                                            <Border Style="{StaticResource IconBox}" Width="34" Height="34">
                                                <Grid>
                                                    <Image Source="{Binding Left.Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding Left.HasIcon, Converter={StaticResource Vis}}" />
                                                    <TextBlock Text="{Binding Left.Letter}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding Left.HasIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                </Grid>
                                            </Border>
                                        </HeaderedContentControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Left.Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Left.Sub}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </DockPanel>
                            </Border>

                            <!-- Two full rows of covers and half of the third; the rest scrolls inside, so the shelf below stays in sight. -->
                            <Grid>
                                <ScrollViewer x:Name="LibraryBox" Style="{StaticResource CardScroll}" ctl:WheelChain.Enabled="True">
                                    <ItemsControl x:Name="Covers" ItemsSource="{Binding Cards}" AutomationProperties.Name="{ctl:T 'Games'}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><ctl:CoverGrid MinItemWidth="132" Gap="16" RowGap="20" Margin="0,4,6,4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Name}" Cursor="Hand" Focusable="True">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <StackPanel Background="Transparent">
                                                                <ctl:AspectBox Ratio="1.5">
                                                                    <Border x:Name="Frame" CornerRadius="{x:Static ctl:Corner.Control}" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
                                                                        <!-- Rounded to the inside of the frame's line, so the picture never covers the line's corners (the hover outline). -->
                                                                        <!-- A clip its own size, not a mask bound by name: a name inside a mask's picture isn't always
                                                                             found when the library's filter rebuilds the cards (binding errors, 2026-11-08). -->
                                                                        <Grid ctl:RoundClip.Radius="{Binding TopLeft, Source={x:Static ctl:Corner.Button}}">
                                                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                                                   Visibility="{Binding HasCover, Converter={StaticResource Vis}}" />
                                                                            <!-- No picture: the game's own icon in its tile, then its name. -->
                                                                            <Grid Visibility="{Binding HasCover, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="38*" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="62*" />
                                                                                </Grid.RowDefinitions>
                                                                                <Border Grid.Row="1" Style="{StaticResource IconTile}" Width="84" Height="84" CornerRadius="{x:Static ctl:Corner.Sheet}" Margin="0,-42,0,0">
                                                                                    <Grid>
                                                                                        <Image Source="{Binding Icon}" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" />
                                                                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S38}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                                                    </Grid>
                                                                                </Border>
                                                                                <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="{x:Static ctl:TextSize.Heading}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="12,0,12,34"
                                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" Background="#B8000000" CornerRadius="{x:Static ctl:Corner.Tag}" Padding="6,2"
                                                                                    Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
                                                                                <TextBlock Text="{Binding Badge}" FontSize="{x:Static ctl:TextSize.Tiny}" FontWeight="Bold" Foreground="#DDDDDD" />
                                                                            </Border>
                                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Background="#E6000000" BorderBrush="{DynamicResource GoodBrush}" BorderThickness="1" CornerRadius="{x:Static ctl:Corner.Chip}" Padding="6,2"
                                                                                    Visibility="{Binding IsPlaying, Converter={StaticResource Vis}}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource GoodBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{ctl:T 'PLAYING'}" FontSize="{x:Static ctl:TextSize.MiniPlus}" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </ctl:AspectBox>
                                                                <TextBlock Text="{Binding Name}" FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Sub}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Faded}" Value="True">
                                                                    <Setter TargetName="Frame" Property="Opacity" Value="0.62" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                                                    <Setter TargetName="Frame" Property="RenderTransform">
                                                                        <Setter.Value><TranslateTransform Y="-3" /></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- Over the box, which keeps its height while searching: nothing under it moves. -->
                                <TextBlock VerticalAlignment="Top" Margin="0,4,0,0" Text="{ctl:T 'Nothing matches'}" Style="{StaticResource Muted}" Visibility="{Binding NoMatch, Converter={StaticResource Vis}}" />
                            </Grid>

                            <!-- At the foot of the library (1.23.0): what was marked not a game, a quiet line that opens the list to put them back. -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasNotGames, Converter={StaticResource Vis}}">
                                <Button x:Name="NotGamesButton" Style="{StaticResource QuietLink}" Click="NotGames_Click" AutomationProperties.Name="{Binding NotGamesLine}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NotGamesLine}" FontSize="{x:Static ctl:TextSize.Small}" />
                                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="NotGamesMenu" PlacementTarget="{Binding ElementName=NotGamesButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                            CornerRadius="{x:Static ctl:Corner.Tile}" Padding="6" Width="340" Margin="0,0,8,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                                        </Border.Effect>
                                        <ScrollViewer Style="{StaticResource CardScroll}" MaxHeight="260">
                                            <ItemsControl ItemsSource="{Binding NotGames}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="6,5">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'Put back'}" Height="30" Padding="12,0" Margin="10,0,0,0"
                                                                    Command="{Binding DataContext.PutBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                            <HeaderedContentControl Style="{StaticResource IconRow}" Padding="10,0,0,0">
                                                                <HeaderedContentControl.Header>
                                                                    <Border Style="{StaticResource IconBox}">
                                                                        <Grid>
                                                                            <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" />
                                                                            <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </HeaderedContentControl.Header>
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                                            </HeaderedContentControl>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <!-- Installed games not played lately: what's sitting there taking space. -->
                            <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18,16" Visibility="{Binding HasShelf, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{ctl:T 'Installed, not played in the last two weeks'}" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ShelfSummary}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Shelf}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KvLine}" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="60" Height="28" CornerRadius="{x:Static ctl:Corner.Chip}" ClipToBounds="True" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" Visibility="{Binding HasThumb, Converter={StaticResource Vis}}" />
                                                                <Border Style="{StaticResource IconTile}" Width="26" Height="26" CornerRadius="{x:Static ctl:Corner.Choice}" Visibility="{Binding HasThumb, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                                                    <Grid>
                                                                        <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S13}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding Icon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Sub}" FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Size}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Drive}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" Width="96" TextAlignment="Right" />
                                                        <Button Grid.Column="4" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Height="30" Padding="10,0"
                                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Entry}"
                                                                Visibility="{Binding HasFolder, Converter={StaticResource Vis}}">
                                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" Margin="0,0,7,0" /><TextBlock Text="{ctl:T 'Open folder'}" /></StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="5" Style="{StaticResource DangerIconButton}" Margin="6,0,0,0" Width="30" Height="30" ToolTip="{Binding UninstallTip}"
                                                                AutomationProperties.Name="{Binding UninstallTip}" IsEnabled="{Binding CanUninstall}"
                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Entry}">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ctl:SmoothBorder>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ═════════════ One game ═════════════ -->
                <!-- Built the first time a game is opened (as Settings' tabs): two thirds of the page, hidden until then, was built and
                     bound on every first visit of the library (2026-11-13). Its named parts are found when it loads (Game_Loaded). -->
                <ctl:LazyTab Shown="{Binding IsGame}"><ctl:LazyTab.Body><DataTemplate>
                <StackPanel Loaded="Game_Loaded">
                    <Grid Height="300" ClipToBounds="True">
                        <Image Source="{Binding GameBanner}" Stretch="UniformToFill" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Style="{StaticResource IconTile}" Width="150" Height="150" CornerRadius="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,28,0"
                                Visibility="{Binding GameHasBanner, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <Grid>
                                <Image Source="{Binding GameIcon}" Width="108" Height="108" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S64}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding GameIcon, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                            </Grid>
                        </Border>
                        <Rectangle Fill="{DynamicResource BgBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#EB000000" Offset="0" />
                                    <GradientStop Color="#8C000000" Offset="0.45" />
                                    <GradientStop Color="#1A000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle Fill="{DynamicResource BgBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="0.45" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- The right edge melts into the page too: on a window wider than the page the banner ended in a hard edge. -->
                        <Rectangle Fill="{DynamicResource BgBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0.82" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,16,0,0" Height="30" Padding="12,0"
                                Command="{Binding BackCommand}" AutomationProperties.Name="{Binding BackText}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Margin="0,0,8,0" /><TextBlock Text="{Binding BackText}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PageExportButton}" HorizontalAlignment="Right" Margin="0,16,22,0" Height="30" Padding="12,0" />
                        <Grid Margin="28,0,28,22" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding OpenedLive, Converter={StaticResource Vis}}">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource GoodBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{ctl:T 'PLAYING NOW · '}" Style="{StaticResource Eyebrow}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding GameEyebrow}" Style="{StaticResource Eyebrow}" />
                                </StackPanel>
                                <Image Source="{Binding GameLogo}" MaxHeight="92" MaxWidth="360" HorizontalAlignment="Left" Margin="0,10,0,10" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding GameHasLogo, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding GameName}" FontSize="{x:Static ctl:TextSize.JumboLarge}" FontWeight="Bold" Margin="0,8,0,10" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding GameHasLogo, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                <ItemsControl ItemsSource="{Binding GamePills}" ItemTemplate="{StaticResource PillTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" Margin="0,0,10,0"
                                        Visibility="{Binding GameInstalled, Converter={StaticResource Vis}}" IsEnabled="{Binding OpenedNotRunning}" AutomationProperties.Name="{ctl:T 'Play'}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding OpenedNotRunning, Converter={StaticResource Vis}}"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,9,0" Foreground="{DynamicResource OnFpsBrush}" /><TextBlock Text="{ctl:T 'Play'}" /></StackPanel>
                                        <TextBlock Text="{ctl:T 'Running'}" Visibility="{Binding OpenedLive, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource HeroButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0" Visibility="{Binding GameHasFolder, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{ctl:T 'Open game folder'}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerIconButton}" Background="{DynamicResource Surface2Brush}" Command="{Binding UninstallCommand}" Width="40" Height="40" ToolTip="{Binding UninstallTip}" AutomationProperties.Name="{Binding UninstallTip}"
                                        Visibility="{Binding GameInstalled, Converter={StaticResource Vis}}" IsEnabled="{Binding OpenedNotRunning}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" />
                                </Button>
                                <!-- More (1.23.0, approved mock-up): Not a game, and the game's folder. -->
                                <Button Style="{StaticResource HeroButton}" Click="GameMore_Click" Width="40" Height="40" Padding="0" Margin="10,0,0,0"
                                        ToolTip="{ctl:T 'More options'}" AutomationProperties.Name="{ctl:T 'More options'}">
                                    <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Margin="28,22,28,30">
                        <!-- How it runs, as one chart (approved mock-up, 2026-10-27): the plays over the range picked, or one play a
                             minute at a time, on the same scale; the numbers beside it follow what's shown. -->
                        <ctl:SmoothBorder Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Left" Text="{ctl:T 'How it runs'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Left" Style="{StaticResource SegmentHost}" Margin="14,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasFramePlays, Converter={StaticResource Vis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="RunsView" Content="{ctl:T 'All plays'}" IsChecked="{Binding ShowPlaysChart, Mode=OneWay}" Command="{Binding ShowPlaysCommand}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="RunsView" Content="{Binding FramesViewName}" IsChecked="{Binding FramesView, Mode=OneWay}" Command="{Binding ShowFramesCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- The range, as on Temperatures: the arrows step back by its own length, the label opens the menu. In a
                                         play the same control steps from play to play. -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding HasFps, Converter={StaticResource Vis}}">
                                        <Button Style="{StaticResource AiButtonSmall}" Content="{ctl:T 'Explain this chart'}" CommandParameter="{Binding RunsAsk}" Margin="0,0,10,0"
                                                VerticalAlignment="Center" AutomationProperties.Name="{ctl:T 'Explain this chart'}" />
                                        <ctl:DatePager x:Name="RunsPager" Label="{Binding RunsLabel}" CanGoPrevious="{Binding CanRunsPrevious}" CanGoNext="{Binding CanRunsNext}"
                                                       PreviousCommand="{Binding RunsPreviousCommand}" NextCommand="{Binding RunsNextCommand}" LabelText="{ctl:T 'Pick a range'}"
                                                       Pickable="{Binding ShowPlaysChart}" />
                                        <ctl:RangeEditor x:Name="RunsRangeEditor" />
                                        <Popup x:Name="RunsMenu" PlacementTarget="{Binding ElementName=RunsPager}" Placement="Custom" StaysOpen="False"
                                               AllowsTransparency="True" PopupAnimation="Fade" Closed="RunsMenu_Closed">
                                            <Border Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                    CornerRadius="{x:Static ctl:Corner.Tile}" Padding="6" MinWidth="210" Margin="0,0,8,8">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                                                </Border.Effect>
                                                <StackPanel Button.Click="RunsMenu_Click">
                                                    <StackPanel.Resources>
                                                        <!-- A line of the menu: a tick on the range shown, then its words (as Temperatures' menu). -->
                                                        <Style TargetType="Button">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Focusable" Value="False" />
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Setter Property="Command" Value="{Binding PickRunsRangeCommand}" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{x:Static ctl:Corner.Field}" Padding="10,8">
                                                                            <DockPanel>
                                                                                <TextBlock x:Name="Tick" DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S12}"
                                                                                           Foreground="{DynamicResource AccentBrush}" Width="16" TextAlignment="Center" Visibility="Hidden" />
                                                                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.FontSize="{x:Static ctl:TextSize.Body}"
                                                                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="Tag">
                                                                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                                                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </StackPanel.Resources>
                                                    <Button Content="{ctl:T 'Last 7 days'}" CommandParameter="7"
                                                            Tag="{Binding RunsPick, Converter={StaticResource Equals}, ConverterParameter=7}" />
                                                    <Button Content="{ctl:T 'Last 30 days'}" CommandParameter="30"
                                                            Tag="{Binding RunsPick, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                                    <Button Content="{ctl:T 'Last 12 months'}" CommandParameter="365"
                                                            Tag="{Binding RunsPick, Converter={StaticResource Equals}, ConverterParameter=365}" />
                                                    <Border Height="1" Margin="4,5" Background="{DynamicResource StrokeBrush}" />
                                                    <Button Content="{ctl:T 'Custom range…'}" CommandParameter="-1"
                                                            Tag="{Binding RunsPick, Converter={StaticResource Equals}, ConverterParameter=-1}" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Visibility="{Binding HasFps, Converter={StaticResource Vis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- What the numbers are for: the range, or the play. -->
                                        <TextBlock Text="{Binding RunsScope}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{ctl:T 'AVERAGE'}" Style="{StaticResource Caption}" />
                                        <TextBlock FontSize="{x:Static ctl:TextSize.Jumbo}" FontWeight="SemiBold"><Run Text="{Binding FpsAvg, Mode=OneWay}" /><Run Text=" fps" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <TextBlock Text="{ctl:T '1% LOW'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Foreground="{DynamicResource FaintBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="150"
                                                       ToolTip="{ctl:T 'The frame rate of the slowest 1 frame in 100. Close to the average means smooth; far below it, you feel it.'}" />
                                        </StackPanel>
                                        <TextBlock FontSize="{x:Static ctl:TextSize.Jumbo}" FontWeight="SemiBold"><Run Text="{Binding FpsLow, Mode=OneWay}" /><Run Text=" fps" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                                        <!-- From the frames: how smooth, in place of the update line. -->
                                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasSmooth, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{ctl:T 'SMOOTHNESS'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Foreground="{DynamicResource FaintBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="150"
                                                           ToolTip="{ctl:T 'Counted from every frame. A stutter is one frame at least 2.5 times as long as the ones before it, a hitch you feel.'}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SmoothVerdict}" FontSize="{x:Static ctl:TextSize.Heading}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SmoothDetail}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SmoothFrom}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,4,0,0" MinHeight="16" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ShowSinceUpdate, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{ctl:T 'SINCE THE LAST UPDATE'}" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                                            <TextBlock Text="{Binding SinceUpdate}" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding UpdatedNote}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Margin="20,0,0,0">
                                        <ctl:RunsChart x:Name="Runs" Points="{Binding RunsPoints}" Marks="{Binding RunsMarks}" From="{Binding RunsFrom}" To="{Binding RunsTo}"
                                                       Minutes="{Binding PlayMinutes}" Stutters="{Binding PlayStutters}" PlayStart="{Binding PlayStart}" ShowPlay="{Binding FramesView}"
                                                       Slots="{Binding RunsSlots}" Stretches="{Binding ChartStretches}" />
                                    </Grid>
                                </Grid>
                                <!-- The key, under the chart from where it starts: the play's own items only where they mean something. -->
                                <DockPanel Margin="254,10,0,0" Visibility="{Binding HasFps, Converter={StaticResource Vis}}">
                                <!-- An opened play: its hours on the Latency page, In games (issue #15). -->
                                <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="{ctl:T 'See this play on Latency'}" Command="{Binding SeeOnLatencyCommand}"
                                        FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" Margin="12,-4,0,-4"
                                        Visibility="{Binding CanSeeOnLatency, Converter={StaticResource Vis}}" />
                                <WrapPanel>
                                    <WrapPanel.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Small}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="0,0,16,0" />
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource FpsBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{ctl:T 'Average FPS'}" />
                                    <!-- The 1% low as the chart draws it: a dashed line on dates, a ring in the slots. -->
                                    <Line X1="0" X2="14" Y1="0" Y2="0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeDashArray="1.5 1.2" VerticalAlignment="Center" Margin="0,0,6,0"
                                          Visibility="{Binding LineKey, Converter={StaticResource Vis}}" />
                                    <Ellipse Width="8" Height="8" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" Fill="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                             Visibility="{Binding SlotKey, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{ctl:T '1% low'}" />
                                    <Border Width="3" Height="10" CornerRadius="{x:Static ctl:Corner.Hairline}" Background="{DynamicResource WarmBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{ctl:T 'Stutters'}" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPlaysChart, Converter={StaticResource Vis}}">
                                        <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding ShowRingKey, Converter={StaticResource Vis}}">
                                            <Ellipse Stroke="{DynamicResource FpsBrush}" StrokeThickness="1.5" Opacity="0.55" />
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource FpsBrush}" />
                                        </Grid>
                                        <TextBlock Text="{ctl:T 'Has frame data, click to open'}" Visibility="{Binding ShowRingKey, Converter={StaticResource Vis}}" />
                                        <Path Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="{DynamicResource FpsMarkTextBrush}" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{ctl:T 'Driver or game update'}" />
                                    </StackPanel>
                                </WrapPanel>
                                </DockPanel>
                                <!-- Where it stuttered (1.23.0, approved mock-ups "2 + 1 · Games" and "1 · Games, each stutter in a stretch"): an
                                     opened play's stutters by stretch, each with what was seen around them as counts, never a cause. Under the
                                     chart, across the card, since an opened stretch lists each stutter on a line of its own (when, its frame
                                     against the usual one, the readings around it). A click on a line opens it to its stutters, and lights a
                                     stretch on the chart; the stutters themselves open nothing, so they have no hover shade. -->
                                <StackPanel Margin="0,24,0,0" Visibility="{Binding ShowStretches, Converter={StaticResource Vis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StretchGrain}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Small}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="{ctl:T 'Where it stuttered'}" FontSize="{x:Static ctl:TextSize.Heading}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding StutterWhy}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                    <!-- A play from before the seconds around each stutter were kept: said once, before the stretches, as a quiet line
                                         (not a box at the foot, which read as an error). -->
                                    <TextBlock Text="{Binding StretchNote}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Small}" TextWrapping="Wrap" Margin="0,-2,0,8"
                                               Visibility="{Binding HasStretchNote, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding StretchRows}" Focusable="False" Margin="-10,0,-10,0" AutomationProperties.Name="{ctl:T 'Where it stuttered'}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <!-- One quiet line per stretch, across the card (the approved mock-up, and ChatGPT's review of the first build
                                                         on 2026-11-28): no coloured rail, no shade at rest (only on hover, it opens), the count right after the
                                                         time, what was seen as plain lines under it. -->
                                                    <Button Command="{Binding DataContext.PickStretchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding CountText}" Cursor="Hand" Margin="0,0,0,2"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="{x:Static ctl:Corner.Button}" Padding="10,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="22" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Turns to point down while the line is open, as Storage's and the Timeline's opening rows. -->
                                                                        <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Foreground="{DynamicResource MutedBrush}"
                                                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0" RenderTransformOrigin="0.5,0.5">
                                                                            <TextBlock.RenderTransform>
                                                                                <RotateTransform />
                                                                            </TextBlock.RenderTransform>
                                                                        </TextBlock>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock FontSize="{x:Static ctl:TextSize.BodyPlus}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Into, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /><Run Text=" · " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                                            <ItemsControl ItemsSource="{Binding Seen}" Focusable="False" Margin="0,2,0,0">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock ctl:Bolds.Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90"
                                                                                                     Duration="{StaticResource MotionFast}" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0"
                                                                                                     Duration="{StaticResource MotionFast}" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <!-- The line opened (approved mock-up "1b · An opened stretch, round 2"): a panel from the card's left edge,
                                                         not indented under the title. A strip of its stutters over its own minutes (hover one for what stood
                                                         out around it, click to find it in the list), then the stutters, the longest first: full rows on a
                                                         play read around each, short rows three across on one read by the minute, 8 or 9 and then the rest on
                                                         a click. A long list scrolls in its own box; only the rows in view are built. The rows open nothing,
                                                         so they have no hover shade; the one picked on the strip has a soft outline. -->
                                                    <Border Margin="10,2,10,10" Padding="16,14,16,12" Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Control}"
                                                            Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Strip.Caption, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}"
                                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                <TextBlock Text="{Binding StripTitle}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <!-- Above the list (its hover reaches over it). -->
                                                            <ctl:StretchStripChart Height="120" Panel.ZIndex="1" Strip="{Binding Strip, Mode=OneWay}" Tip="{Binding StripTip, Mode=OneWay}" Picked="{Binding StripPicked, Mode=OneWay}"
                                                                                   PickCommand="{Binding PickStutterCommand}" List="{Binding ElementName=StutterList}" PerRow="{Binding PerRow, Mode=OneWay}"
                                                                                   AutomationProperties.Name="{Binding StripTitle}" AutomationProperties.HelpText="{Binding Strip.Caption, Mode=OneWay}" />
                                                            <TextBlock Text="{ctl:T 'LONGEST FIRST'}" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                                                            <Grid Margin="8,2,8,4" Visibility="{Binding HasAround, Converter={StaticResource Vis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="136" />
                                                                    <ColumnDefinition Width="186" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{ctl:T 'WHEN'}" Style="{StaticResource Caption}" />
                                                                <TextBlock Grid.Column="1" Text="{ctl:T 'FRAME'}" Style="{StaticResource Caption}" Margin="16,0,0,0" />
                                                                <TextBlock Grid.Column="3" Text="{ctl:T 'AROUND IT'}" Style="{StaticResource Caption}" Margin="16,0,0,0" />
                                                            </Grid>
                                                            <ItemsControl x:Name="StutterList" ItemsSource="{Binding Rows}" Focusable="False" MaxHeight="420" AutomationProperties.Name="{ctl:T 'Stutters'}"
                                                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                                                          ScrollViewer.CanContentScroll="True">
                                                                <ItemsControl.Resources>
                                                                    <!-- A frame's time as a bar on the strip's scale, its own usual frame as a thin tick. -->
                                                                    <DataTemplate x:Key="StutterBar" DataType="{x:Type vm:StutterLine}">
                                                                        <Grid Height="12" VerticalAlignment="Center">
                                                                            <Border Height="6" CornerRadius="{x:Static ctl:Corner.Mark}" Background="{DynamicResource StrokeBrush}" VerticalAlignment="Center" />
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="{Binding Fill}" />
                                                                                    <ColumnDefinition Width="{Binding Empty}" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Height="6" CornerRadius="{x:Static ctl:Corner.Mark}" Background="{DynamicResource WarmBrush}" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="{Binding TickAt}" />
                                                                                    <ColumnDefinition Width="{Binding TickAfter}" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="1" Width="1.5" HorizontalAlignment="Left" Margin="-0.75,0,0,0" Background="{DynamicResource MutedBrush}" />
                                                                            </Grid>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                    <!-- The soft outline of the stutter picked on the strip. -->
                                                                    <Style x:Key="PickedStutter" TargetType="Border">
                                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                        <Setter Property="CornerRadius" Value="{x:Static ctl:Corner.Field}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FaintBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                    <!-- A short row (a play read by the minute): the frame and its time, the bar, its usual. -->
                                                                    <DataTemplate x:Key="ShortStutter" DataType="{x:Type vm:StutterLine}">
                                                                        <Border Style="{StaticResource PickedStutter}" Padding="6.5">
                                                                            <StackPanel>
                                                                                <DockPanel>
                                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeInto}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}"
                                                                                               VerticalAlignment="Bottom" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding Frame}" FontSize="{x:Static ctl:TextSize.BodyPlus}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                                                </DockPanel>
                                                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StutterBar}" Margin="0,2,0,0" />
                                                                                <TextBlock Text="{Binding Usual}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                    <!-- A full row (a play read around each stutter): when, its frame, the bar, what stood out around it. -->
                                                                    <DataTemplate DataType="{x:Type vm:StutterLine}">
                                                                        <Border Style="{StaticResource PickedStutter}" Padding="6.5,5.5">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="150" />
                                                                                    <ColumnDefinition Width="136" />
                                                                                    <ColumnDefinition Width="186" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Time}" FontSize="{x:Static ctl:TextSize.BodyPlus}" Foreground="{DynamicResource TextBrush}" />
                                                                                    <TextBlock Text="{Binding Into}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Frame}" FontSize="{x:Static ctl:TextSize.BodyPlus}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                                                    <TextBlock Text="{Binding Usual}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" />
                                                                                </StackPanel>
                                                                                <ContentPresenter Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource StutterBar}" />
                                                                                <!-- Around it: only the readings that stood out for this one stutter. -->
                                                                                <WrapPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                                                                                    <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel />
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Border Background="{DynamicResource HoverBrush}" CornerRadius="{x:Static ctl:Corner.Chip}" Padding="8,3" Margin="0,2,6,2">
                                                                                                    <TextBlock FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /></TextBlock>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="{x:Static ctl:Corner.Chip}" Padding="8,3" Margin="0,2,6,2"
                                                                                            Visibility="{Binding HasNote, Converter={StaticResource Vis}}">
                                                                                        <TextBlock Text="{Binding Note}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource MutedBrush}" />
                                                                                    </Border>
                                                                                </WrapPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                    <!-- Three short rows across (the mock-up's three columns), one virtualised row of the list. -->
                                                                    <DataTemplate DataType="{x:Type vm:StutterTriple}">
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="22" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="22" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter Content="{Binding A}" ContentTemplate="{StaticResource ShortStutter}" />
                                                                            <ContentPresenter Grid.Column="2" Content="{Binding B}" ContentTemplate="{StaticResource ShortStutter}" />
                                                                            <ContentPresenter Grid.Column="4" Content="{Binding C}" ContentTemplate="{StaticResource ShortStutter}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.Resources>
                                                                <ItemsControl.Template>
                                                                    <ControlTemplate TargetType="ItemsControl">
                                                                        <ScrollViewer Style="{StaticResource CardScroll}" Padding="0" CanContentScroll="True">
                                                                            <ItemsPresenter />
                                                                        </ScrollViewer>
                                                                    </ControlTemplate>
                                                                </ItemsControl.Template>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <VirtualizingStackPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                            <!-- "And 9 more, 30 to 64 ms": opens the rest in the same list. -->
                                                            <Button Command="{Binding ShowRestCommand}" Cursor="Hand" HorizontalAlignment="Left" Margin="-2,4,0,0" AutomationProperties.Name="{Binding MoreText}"
                                                                    Visibility="{Binding HasMore, Converter={StaticResource Vis}}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{x:Static ctl:Corner.Field}" Padding="10,6">
                                                                            <TextBlock Text="{Binding MoreText}" FontSize="{x:Static ctl:TextSize.Body}" Foreground="{DynamicResource MutedBrush}" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding DevicesNote}" Foreground="{DynamicResource FaintBrush}" FontSize="{x:Static ctl:TextSize.Small}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasDevicesNote, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasFps, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding FpsEmpty}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Start RivaTuner'}" Command="{Binding StartRtssCommand}" Margin="0,0,10,0"
                                                Visibility="{Binding CanStartRtss, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'Install RivaTuner'}" Command="{Binding InstallRtssCommand}" Margin="0,0,10,0"
                                                Visibility="{Binding CanInstallRtss, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource AiButton}" Content="{ctl:T 'How does it run without FPS?'}" CommandParameter="{Binding NoFpsAsk}" AutomationProperties.Name="{ctl:T 'How does it run without FPS?'}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <!-- Problems: only what happened, as tiles across the page, the power cut in grey; with none the card
                             isn't there (approved mock-up, 2026-11-14). -->
                        <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasProblems, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ProblemsTitle}" Style="{StaticResource H2}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" Margin="0,0,-12,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{x:Static ctl:Corner.Tile}" Padding="14,12" Margin="0,0,12,0">
                                                <HeaderedContentControl Style="{StaticResource IconRow}" Padding="12,0,0,0">
                                                    <HeaderedContentControl.Header>
                                                        <Border Width="34" Height="34">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource IconBox}">
                                                                    <Setter Property="Background" Value="{DynamicResource WarmSoftBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Grey}" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Glyph}" FontSize="{x:Static ctl:IconSize.S14}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Grey}" Value="True"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </HeaderedContentControl.Header>
                                                    <StackPanel>
                                                        <!-- The count in amber (grey for a power cut) inside its whole sentence. -->
                                                        <TextBlock FontSize="{x:Static ctl:TextSize.Body}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <Run Text="{Binding Lead, Mode=OneWay}" /><Run Text="{Binding Count, Mode=OneWay}">
                                                                <Run.Style>
                                                                    <Style TargetType="Run">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Grey}" Value="True"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Run.Style>
                                                            </Run><Run Text="{Binding Trail, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Days}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasDays, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </HeaderedContentControl>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- What to try under a game that crashed more than once (1.21.0). -->
                                <ContentControl Content="{Binding ProblemsTry}" Focusable="False" IsTabStop="False" Margin="0,14,0,0" Visibility="{Binding ProblemsTry, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <!-- Every play -->
                        <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding Rows.Count, Converter={StaticResource Vis}}">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" Text="{ctl:T 'Breaks under 15 minutes are joined; a shut-off always ends a play'}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" />
                                    <TextBlock Text="{ctl:T 'Every play'}" Style="{StaticResource H2}" />
                                </DockPanel>
                                <Grid Margin="6,0,6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{ctl:T 'WHEN'}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{ctl:T 'PLAYED'}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="{ctl:T 'FPS · 1% LOW'}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="GPU" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="4" Text="{ctl:T 'GPU POWER'}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="5" Text="RAM" Style="{StaticResource Caption}" />
                                </Grid>
                                <ScrollViewer Style="{StaticResource CardScroll}" ctl:Roomy.MaxHeight="400" ctl:WheelChain.Enabled="True">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <!-- A play -->
                                                    <Border Padding="6,9" Visibility="{Binding IsPlay, Converter={StaticResource Vis}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource KvLine}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AfterChange}" Value="True"><Setter Property="BorderThickness" Value="0" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="0.9*" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="112" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Day}" FontWeight="Medium" />
                                                                <!-- A play that ended badly says so after its times: amber for a crash or the PC going off, grey for a power cut. -->
                                                                <TextBlock FontSize="{x:Static ctl:TextSize.Label}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Times, Mode=OneWay}" /><Run Text="{Binding EndedJoin, Mode=OneWay}" /><Run Text="{Binding Ended, Mode=OneWay}">
                                                                        <Run.Style>
                                                                            <Style TargetType="Run">
                                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EndedWarm}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Run.Style>
                                                                    </Run>
                                                                </TextBlock>
                                                                <!-- Ended badly or stuttered: ask why (hidden while the AI is off). -->
                                                                <Border HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding HasAsk, Converter={StaticResource Vis}}">
                                                                    <Button Style="{StaticResource AiButtonSmall}" Content="{Binding AskText}" CommandParameter="{Binding Ask}" AutomationProperties.Name="{Binding AskText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Played}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding Fps, Converter={StaticResource Vis}}">
                                                                <TextBlock>
                                                                    <Run Text="{Binding Fps, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource FpsBrush}" /> <Run Text="{Binding Low, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" />
                                                                </TextBlock>
                                                                <!-- From every frame: amber once they're felt (a stutter every two minutes). -->
                                                                <TextBlock Text="{Binding Stutters}" FontSize="{x:Static ctl:TextSize.Label}" Visibility="{Binding Stutters, Converter={StaticResource Vis}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                                                            <Style.Triggers><DataTrigger Binding="{Binding StuttersWarm}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <!-- Nothing measured: said quietly, not in a reading's colour. -->
                                                            <TextBlock Grid.Column="2" Text="{ctl:T 'Not recorded'}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"
                                                                       Visibility="{Binding Fps, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                <TextBlock Visibility="{Binding Gpu, Converter={StaticResource Vis}}">
                                                                    <Run Text="{Binding Gpu, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource GpuBrush}" /> <Run Text="{Binding GpuPeak, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{ctl:T 'Not recorded'}" Foreground="{DynamicResource FaintBrush}" Visibility="{Binding Gpu, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                                <TextBlock Text="{Binding Usual}" FontSize="{x:Static ctl:TextSize.Label}" Visibility="{Binding Usual, Converter={StaticResource Vis}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                                                            <Style.Triggers><DataTrigger Binding="{Binding UsualWarm}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <!-- A play on battery (a laptop): under its power, how far the battery went down in it (1.18.0). -->
                                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Power}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Battery}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}"
                                                                           Visibility="{Binding Battery, Converter={StaticResource Vis}}" />
                                                            </StackPanel>
                                                            <!-- The game's own RAM in the play: its average, then its peak (from the hours it touched). -->
                                                            <TextBlock Grid.Column="5" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding Ram, Converter={StaticResource Vis}}">
                                                                <Run Text="{Binding Ram, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding RamPeak, Mode=OneWay}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" />
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="5" Text="{ctl:T 'Not recorded'}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"
                                                                       Visibility="{Binding Ram, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                                                        </Grid>
                                                    </Border>
                                                    <!-- A change between plays: blue for drivers, Windows and fans; amber for the game's own update. -->
                                                    <Border CornerRadius="{x:Static ctl:Corner.Field}" Padding="6,7" Margin="0,2" BorderThickness="1" Visibility="{Binding IsChange, Converter={StaticResource Vis}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource FpsNoteBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource FpsNoteStrokeBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGameUpdate}" Value="True"><Setter Property="Background" Value="#16110A" /><Setter Property="BorderBrush" Value="#3A2C12" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <Border Width="22" Height="22" CornerRadius="{x:Static ctl:Corner.Small}" Margin="0,0,10,0" Background="{DynamicResource FpsNoteTileBrush}">
                                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Foreground="{DynamicResource FpsNoteIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Text}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource FpsNoteTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Can it run better?: a frame cap, how smooth, what the graphics card has left -->
                            <ctl:SmoothBorder Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource AiButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                            Content="{ctl:T 'Ask how to make it run better'}" CommandParameter="{Binding BetterAsk}"
                                            AutomationProperties.Name="{ctl:T 'Ask how to make it run better'}" />
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'Can it run better?'}" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Better}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconBox}" Width="28" Height="28" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S13}" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="12,4,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </DockPanel>
                            </ctl:SmoothBorder>
                            <!-- Play time -->
                            <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{ctl:T 'last 4 weeks'}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" />
                                        <TextBlock Text="{ctl:T 'Play time'}" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Weeks}" Height="104" Margin="0,8,0,8">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="5,0" LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="{x:Static ctl:TextSize.Caption}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                    <Border DockPanel.Dock="Bottom" Height="{Binding Height}" CornerRadius="5,5,2,2" Background="{DynamicResource FpsBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0.8" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Value}" FontSize="{x:Static ctl:TextSize.Label}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource KvLine}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PlayedMostOn}" FontWeight="SemiBold" />
                                            <TextBlock Text="{ctl:T 'Played most on'}" Style="{StaticResource Muted}" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ctl:SmoothBorder>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Heat and power -->
                            <ctl:SmoothBorder Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'Heat and power'}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Heat}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KvLine}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{Binding Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Brush}" Value="{x:Null}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ctl:SmoothBorder>
                            <!-- Memory: the game's own RAM, the whole PC's and video memory, with as many rows as Heat and power
                                 (approved mock-up, 2026-11-14). What each RAM figure counts is on hover. -->
                            <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'Memory'}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Memory}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="150" Background="Transparent">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource KvLine}">
                                                            <Setter Property="Cursor" Value="Help" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tip}" Value="{x:Null}"><Setter Property="Cursor" Value="{x:Null}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ctl:SmoothBorder>
                        </Grid>

                        <!-- How it's set: the game's own saved graphics settings, read from its files when the page opens (2026-10-25); every
                             one named from its key, with NVIDIA's pick beside it when the NVIDIA App has one (approved mock-up, 2026-10-27). -->
                        <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" AutomationProperties.Name="{ctl:T 'How it\'s set'}"
                                          Visibility="{Binding HasSettings, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SettingsNote}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                                    <TextBlock Text="{ctl:T 'How it\'s set'}" Style="{StaticResource H2}" />
                                </DockPanel>
                                <!-- The main ones, each name over its value, all in one row (four, or five with a quality preset). -->
                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding SettingsRows}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,10,14,10">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Body}" />
                                                    <TextBlock Text="{Binding Value}" FontSize="{x:Static ctl:TextSize.Subtitle}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <!-- What NVIDIA would set otherwise, in one line. -->
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{x:Static ctl:Corner.Control}" Padding="14,10" Margin="0,4,0,8"
                                        Visibility="{Binding HasSettingsDiff, Converter={StaticResource Vis}}">
                                    <DockPanel>
                                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S13}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SettingsDiff}" FontSize="{x:Static ctl:TextSize.Lead}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <!-- Every graphics setting, by group: the names over the list stay put while it scrolls. -->
                                <StackPanel Visibility="{Binding HasSettingLines, Converter={StaticResource Vis}}">
                                    <!-- Clear of the list's scroll bar on the right, as the list itself, so each name sits over its column. -->
                                    <Grid Margin="0,6,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="{Binding PickColumnWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{ctl:T 'SETTING'}" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="{ctl:T 'YOURS'}" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="{ctl:T 'NVIDIA\'S PICK'}" Style="{StaticResource Caption}" Visibility="{Binding HasNvidiaPick, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <!-- Plain that it scrolls (approved mock-up A, 2026-10-29): the last line in sight is cut in half, the
                                         end with more fades, and "N more settings" scrolls on until the end. -->
                                    <Grid>
                                    <ScrollViewer x:Name="SettingsScroll" ctl:WheelChain.Enabled="True" MaxHeight="372" VerticalScrollBarVisibility="Auto" Focusable="False" PanningMode="VerticalOnly"
                                                  ScrollChanged="SettingsScroll_ScrollChanged">
                                        <ItemsControl x:Name="SettingsList" ItemsSource="{Binding SettingLines}" Focusable="False" Margin="0,0,12,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <!-- A group's heading. -->
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,6"
                                                                   Visibility="{Binding IsGroup, Converter={StaticResource Vis}}" />
                                                        <Border Style="{StaticResource KvLine}" Visibility="{Binding IsGroup, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4*" />
                                                                    <ColumnDefinition Width="3*" />
                                                                    <ColumnDefinition Width="{Binding PickWidth}" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Lead}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" Margin="0,0,10,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{x:Static ctl:TextSize.Lead}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Margin="0,0,10,0" />
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                               Visibility="{Binding Differs, Converter={StaticResource Vis}}" />
                                                                    <TextBlock Text="{Binding Pick}" FontSize="{x:Static ctl:TextSize.Lead}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Pick}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Differs}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding NotCovered}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button x:Name="SettingsMore" Style="{StaticResource GhostButton}" Background="{DynamicResource AccentSoftBrush}" Padding="12,6"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,8" Visibility="Collapsed" Click="SettingsMore_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SettingsMoreText" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S10}" Margin="8,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    </Grid>
                                    <DockPanel Margin="0,16,0,0">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource AiButton}" Content="{Binding SettingsAskText}" CommandParameter="{Binding SettingsAsk}"
                                                AutomationProperties.Name="{Binding SettingsAskText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SettingsAskNote}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </ctl:SmoothBorder>

                        <!-- About this game: everything about the game itself in one place. -->
                        <ctl:SmoothBorder Style="{StaticResource Card}" Margin="0,18,0,0" AutomationProperties.Name="{ctl:T 'About this game'}">
                            <StackPanel>
                                <TextBlock Text="{ctl:T 'About this game'}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding About}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KvLine}" Margin="0,0,18,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Width="110" />
                                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ctl:SmoothBorder>
                    </StackPanel>
                </StackPanel>
                </DataTemplate></ctl:LazyTab.Body></ctl:LazyTab>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
