<UserControl x:Class="Rigsight.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" Margin="0,4,0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Today -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="0"
                                    Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="reports">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Full report" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Today so far" Style="{StaticResource H2}" />
                        </DockPanel>

                        <UniformGrid Columns="3" Margin="-5,0,-5,6">
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="PC ON" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.OnSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="AWAY" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.IdleSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Today's hottest moments, and what was running -->
                        <UniformGrid Columns="2" Margin="-5,0,-5,6">
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="CPU PEAK" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.CpuPeak, Converter={StaticResource TempShort}, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource StatValue}"
                                               Foreground="{Binding Live.Today.CpuPeak, Converter={StaticResource TempBrush}}" />
                                    <TextBlock Text="{Binding Live.Today.CpuPeakWhile, TargetNullValue='No reading yet today'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="GPU PEAK" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.GpuPeak, Converter={StaticResource TempShort}, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource StatValue}"
                                               Foreground="{Binding Live.Today.GpuPeak, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                    <TextBlock Text="{Binding Live.Today.GpuPeakWhile, TargetNullValue='No reading yet today'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="MOST USED" Style="{StaticResource Caption}" Margin="0,12,0,6"
                                   Visibility="{Binding TodayTopApps.Count, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding TodayTopApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="24" Height="24" HorizontalAlignment="Left" />
                                        <TextBlock ctl:TrimmedText.ToolTip="True" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="2" Style="{StaticResource Bar}" Margin="12,0" VerticalAlignment="Center"
                                                     Maximum="{Binding DataContext.TodayTopMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Value="{Binding ActiveSec, Mode=OneWay}"
                                                     Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Your most-used apps show up here after a few minutes of use."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding ShowLearning, Converter={StaticResource Vis}}" />


                    </StackPanel>
                </Border>

                <!-- Yesterday -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Yesterday" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <StackPanel Visibility="{Binding YesterdayHasData, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Yesterday.ActiveSec, Converter={StaticResource Duration}}" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="active · PC on for" /> <Run Text="{Binding Yesterday.OnSec, Converter={StaticResource Duration}, Mode=OneWay}" />
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding YesterdayTopApps}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="20" Height="20" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Name}" Style="{StaticResource Body}" Margin="10,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding YesterdayInsights}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,5">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,10,0"
                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                            <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenYesterday_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open full recap" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Visibility="{Binding YesterdayHasData, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="No history for yesterday yet." Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,12,0,4" />
                            <TextBlock Text="Yesterday's active time, most-used apps and highlights show here once there's a full day of history."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Insights -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding TodayInsights.Count, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="What stands out today" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding TodayInsights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface2Brush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center"
                                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
