<UserControl x:Class="Rigsight.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:svc="clr-namespace:Rigsight.Services">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.Display}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Home is read at a glance: every line is one statement (it may wrap to a second line), its icon in a square in
             its own colour. Amber says it needs a look. Only a line with more behind it opens a page: it takes the
             pointer and has an arrow; a complete fact is plain text and opens nothing (see InsightLinks). -->
        <Style x:Key="LineText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="{x:Static ctl:TextSize.BodyPlus}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LineArrow" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="{x:Static ctl:IconSize.S10}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <!-- A line of "What changed lately" or "PC health". -->
        <DataTemplate x:Key="CardLine">
            <Button Style="{StaticResource FlatRowButton}" Margin="-8,1" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Text}"
                    Command="{Binding DataContext.OpenLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <HeaderedContentControl Style="{StaticResource IconRow}" Margin="8,6">
                    <HeaderedContentControl.Header>
                        <Border Style="{StaticResource IconBox}">
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" HorizontalAlignment="Center"
                                       Foreground="{Binding Brush, Converter={StaticResource ResourceBrush}}" />
                        </Border>
                    </HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource LineArrow}" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" />
                        <!-- The sentence, with Explain and the date beside it; under it where beside them the sentence would be squeezed (see TextAndSide). -->
                        <ctl:TextAndSide>
                        <TextBlock Text="{Binding Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LineText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TextBrush}" Value="WarmBrush">
                                            <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TextBrush}" Value="GoodBrush">
                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- A line in amber: Explain (hidden while the AI is off). -->
                            <Border VerticalAlignment="Center" Visibility="{Binding IsWarm, Converter={StaticResource Vis}}">
                                <Button Style="{StaticResource AiButtonSmall}" Content="{ctl:T 'Explain'}" CommandParameter="{Binding Ask}" AutomationProperties.Name="{ctl:T 'Explain'}" />
                            </Border>
                            <TextBlock Text="{Binding When}" FontSize="{x:Static ctl:TextSize.Small}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding When, Converter={StaticResource Vis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWarm}" Value="True">
                                                <Setter Property="Margin" Value="10,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        </ctl:TextAndSide>
                    </DockPanel>
                </HeaderedContentControl>
            </Button>
        </DataTemplate>

        <!-- A line of "What stands out today": the insight's one statement; the full sentence is on Reports. -->
        <DataTemplate x:Key="InsightLine">
            <Button Style="{StaticResource FlatRowButton}" Margin="-8,1" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Line}"
                    ToolTip="{Binding DetailOrNull}" ToolTipService.ShowOnDisabled="True"
                    Command="{Binding DataContext.OpenInsightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <HeaderedContentControl Style="{StaticResource IconRow}" Margin="8,6">
                    <HeaderedContentControl.Header>
                        <Border Style="{StaticResource IconBox}">
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S14}" HorizontalAlignment="Center"
                                       Foreground="{Binding ., Converter={StaticResource InsightBrush}}" />
                        </Border>
                    </HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource LineArrow}" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding Line}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LineText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                            <Setter Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Hot">
                                            <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </HeaderedContentControl>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="{StaticResource PageWidth}">
            <DockPanel Margin="0,0,0,20">
                <Button Style="{StaticResource PageExportButton}" />
                <!-- The page's own question for the AI (mock-up board 5), left of Export. -->
                <Button Style="{StaticResource PageAiButton}" Content="{ctl:T 'Ask about today'}" CommandParameter="{x:Static svc:PageAsks.Home}" AutomationProperties.Name="{ctl:T 'Ask about today'}" />
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Today -->
                <ctl:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Command="{Binding GoCommand}" CommandParameter="reports">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'Full report'}" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{ctl:T 'Today so far'}" Style="{StaticResource H2}" />
                        </DockPanel>

                        <!-- Until the agent has sent today's totals the figures are held back (their room kept) behind a loader. -->
                        <Grid>
                        <ctl:Spinner Late="True" Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding Live.TodayIn, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Live.TodayIn}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <UniformGrid Columns="3" Margin="-5,0,-5,6">
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'ACTIVE'}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'PC ON'}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.OnSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'AWAY'}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.IdleSec, Converter={StaticResource Duration}}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Today's hottest moments and what was running, and what came down the line. -->
                        <UniformGrid Columns="3" Margin="-5,0,-5,6">
                            <!-- Where the CPU's temperature can't be read (a standard account): how busy it got, and with what. -->
                            <Border Style="{StaticResource Tile}" Margin="5" Visibility="{Binding Live.ShowCpuBusiest, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'CPU BUSIEST'}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.CpuBusy, StringFormat='{}{0:0} %', FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource StatValue}" />
                                    <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Live.Today.CpuBusyLine, TargetNullValue={ctl:T 'No reading yet today'}}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5" Visibility="{Binding Live.ShowCpuBusiest, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'CPU PEAK'}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.CpuPeak, Converter={StaticResource TempShort}, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource StatValue}"
                                               Foreground="{Binding Live.Today.CpuPeak, Converter={StaticResource TempBrush}}" />
                                    <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Live.Today.CpuPeakLine, TargetNullValue={ctl:T 'No reading yet today'}}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'GPU PEAK'}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Live.Today.GpuPeak, Converter={StaticResource TempShort}, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource StatValue}"
                                               Foreground="{Binding Live.Today.GpuPeak, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                    <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding Live.Today.GpuPeakLine, TargetNullValue={ctl:T 'No reading yet today'}}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{ctl:T 'INTERNET'}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding TodayInternet}" Style="{StaticResource StatValue}" />
                                    <TextBlock ctl:TrimmedText.ToolTip="True" Text="{Binding TodayInternetLine}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        </StackPanel>
                        </Grid>

                        <TextBlock Text="{ctl:T 'MOST USED'}" Style="{StaticResource Caption}" Margin="0,12,0,6"
                                   Visibility="{Binding TodayTopApps.Count, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding TodayTopApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="24" Height="24" HorizontalAlignment="Left" />
                                        <TextBlock ctl:TrimmedText.ToolTip="True" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="2" Style="{StaticResource Bar}" Margin="12,0" VerticalAlignment="Center"
                                                     Maximum="{Binding DataContext.TodayTopMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Value="{Binding ActiveSec, Mode=OneWay}"
                                                     Foreground="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=Bar}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{ctl:T 'Your most-used apps show up here after a few minutes of use.'}"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding ShowLearning, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- The recap: yesterday, or the last whole week, month or year. As tall as the card beside it: its list
                     shows as many apps and lines as fit that height (see FitStack), so it never ends halfway down. -->
                <ctl:SmoothBorder Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                    <Grid.Resources>
                        <!-- While a period just picked is being read, the last one's figures are hidden but keep their
                             room, so the card and the cards under it don't move; the loader below shows over them. -->
                        <Style x:Key="HiddenWhileLoading" TargetType="FrameworkElement">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecapLoading}" Value="True">
                                    <Setter Property="Opacity" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Visibility="{Binding HasPeriods, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Day'}" IsChecked="{Binding IsYesterday}" GroupName="recap" AutomationProperties.Name="{ctl:T 'Yesterday'}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Week'}" IsChecked="{Binding IsLastWeek}" GroupName="recap" AutomationProperties.Name="{ctl:T 'Last week'}"
                                                 Visibility="{Binding HasLastWeek, Converter={StaticResource Vis}}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Month'}" IsChecked="{Binding IsLastMonth}" GroupName="recap" AutomationProperties.Name="{ctl:T 'Last month'}"
                                                 Visibility="{Binding HasLastMonth, Converter={StaticResource Vis}}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{ctl:T 'Year'}" IsChecked="{Binding IsLastYear}" GroupName="recap" AutomationProperties.Name="{ctl:T 'Last year'}"
                                                 Visibility="{Binding HasLastYear, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                            <!-- The days a week, month or year covers, quietly under its title (issue #7). -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecapTitle}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding RecapDays}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Detail}" Margin="0,2,0,0"
                                           Visibility="{Binding RecapDays, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Another day standing in for yesterday: why. -->
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RecapNote}" Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Small}" Margin="0,-8,0,12"
                                   Visibility="{Binding RecapNote, Converter={StaticResource Vis}}" />

                        <ctl:Spinner DockPanel.Dock="Top" Late="True" Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,60,0,0"
                                     Visibility="{Binding Loaded, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <StackPanel DockPanel.Dock="Top" Visibility="{Binding ShowRecapEmpty, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S28}" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding RecapEmptyTitle}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding RecapEmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource HiddenWhileLoading}">
                        <!-- The recap, and beside it how the period went asked of the AI (audit item 6, 2026-10-29: it sat in the
                             header with the tabs, next to Ask about today; here it reads as the card's second step). -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding RecapHasData, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource AccentButton}" Click="OpenRecap_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'Open full recap'}" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AiButton}" Content="{Binding RecapAskText}" CommandParameter="{Binding RecapAsk}"
                                    VerticalAlignment="Center" Margin="10,0,0,0" AutomationProperties.Name="{Binding RecapAskText}" />
                        </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" Style="{StaticResource HiddenWhileLoading}" Visibility="{Binding RecapHasData, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Recap.ActiveSec, Converter={StaticResource Duration}}" FontSize="{x:Static ctl:TextSize.Jumbo}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="{ctl:T 'active · PC on for'}" /> <Run Text="{Binding Recap.OnSec, Converter={StaticResource Duration}, Mode=OneWay}" />
                            </TextBlock>
                            <!-- The period's figures on one line (three boxes here took a third of the card). -->
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Body}" Margin="0,0,20,2" Visibility="{Binding Recap.CpuTempPeak, Converter={StaticResource Vis}}">
                                    <Run Text="{ctl:T 'CPU peak'}" /> <Run Text="{Binding Recap.CpuTempPeak.Value, Converter={StaticResource TempShort}, Mode=OneWay}" FontWeight="SemiBold"
                                                                 Foreground="{Binding Recap.CpuTempPeak.Value, Converter={StaticResource TempBrush}}" />
                                </TextBlock>
                                <!-- A period with no CPU temperature (a standard account): how busy the CPU got instead. -->
                                <TextBlock Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Body}" Margin="0,0,20,2" Visibility="{Binding ShowRecapCpuBusiest, Converter={StaticResource Vis}}">
                                    <Run Text="{ctl:T 'CPU busiest'}" /> <Run Text="{Binding Recap.CpuLoadPeak.Value, StringFormat='{}{0:0}%', Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Body}" Margin="0,0,20,2" Visibility="{Binding Recap.GpuTempPeak, Converter={StaticResource Vis}}">
                                    <Run Text="{ctl:T 'GPU peak'}" /> <Run Text="{Binding Recap.GpuTempPeak.Value, Converter={StaticResource TempShort}, Mode=OneWay}" FontWeight="SemiBold"
                                                                 Foreground="{Binding Recap.GpuTempPeak.Value, Converter={StaticResource TempBrush}, ConverterParameter='45,70,83'}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="{x:Static ctl:TextSize.Body}" Margin="0,0,0,2" Visibility="{Binding RecapInternet, Converter={StaticResource Vis}}">
                                    <Run Text="{ctl:T 'Internet'}" /> <Run Text="{Binding RecapInternet, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                </TextBlock>
                            </WrapPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RecapRows}" Margin="0,12,0,0" Focusable="False" ClipToBounds="True"
                                      Style="{StaticResource HiddenWhileLoading}" Visibility="{Binding RecapHasData, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:FitStack />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="ctl:FitStack.Rank" Value="{Binding Rank}" />
                                    <Setter Property="ctl:FitStack.Essential" Value="{Binding Essential}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid x:Name="App" Margin="0,5" Visibility="{Binding IsApp, Converter={StaticResource Vis}}">
                                            <Grid.ColumnDefinitions>
                                                <!-- The time in a fixed column: sized to its text, a short "49m" widened the name and moved
                                                     that bar (issue #7). -->
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" MaxWidth="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding App.Path, Converter={StaticResource ExeIcon}}" Style="{StaticResource AppIcon}" Width="20" Height="20" HorizontalAlignment="Left" />
                                            <TextBlock ctl:TrimmedText.ToolTip="True" Grid.Column="1" Text="{Binding App.Name}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="2" Style="{StaticResource Bar}" Margin="12,0" VerticalAlignment="Center"
                                                         Maximum="{Binding DataContext.RecapTopMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Value="{Binding App.ActiveSec, Mode=OneWay}"
                                                         Foreground="{Binding App.Category, Converter={StaticResource CategoryBrush}, ConverterParameter=Bar}" />
                                            <TextBlock Grid.Column="3" Text="{Binding App.ActiveSec, Converter={StaticResource Duration}}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Button x:Name="Line" Style="{StaticResource FlatRowButton}" Margin="-6,1" ToolTip="{Binding Line.DetailOrNull}" ToolTipService.ShowOnDisabled="True"
                                                IsEnabled="{Binding Line.CanOpen, FallbackValue=False}" AutomationProperties.Name="{Binding Line.Line}"
                                                Command="{Binding DataContext.OpenRecapInsightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Line}"
                                                Visibility="{Binding IsApp, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                            <DockPanel Margin="6,4">
                                                <TextBlock Text="{Binding Line.Icon}" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S13}" VerticalAlignment="Top" Margin="2,2,12,0"
                                                           Foreground="{Binding Line, Converter={StaticResource InsightBrush}}" />
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource LineArrow}" Visibility="{Binding Line.CanOpen, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                                                <TextBlock Text="{Binding Line.Line}" FontSize="{x:Static ctl:TextSize.Detail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <!-- A gap between the apps and the lines about the period. -->
                                        <DataTrigger Binding="{Binding StartsLines}" Value="True">
                                            <Setter TargetName="Line" Property="Margin" Value="-6,9,-6,1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <!-- A period just picked, not read yet. Not while the page itself is first being read: the loader above is
                         already turning then, and two at once looked odd. -->
                    <ctl:Spinner Width="28" Height="28" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ctl:Spinner.Style>
                            <Style TargetType="ctl:Spinner">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RecapLoading}" Value="True" />
                                            <Condition Binding="{Binding Loaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:Spinner.Style>
                    </ctl:Spinner>
                    </Grid>
                </ctl:SmoothBorder>
            </Grid>

            <!-- Three small cards: today's lines, the latest of the Timeline, and a line each on what can go wrong. -->
            <UniformGrid Columns="3" Margin="-9,0,-9,0">
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="9,18,9,0" Padding="20,18,20,14">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'What stands out today'}" Style="{StaticResource H2}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding TodayInsights}" ItemTemplate="{StaticResource InsightLine}" Focusable="False" />
                        <TextBlock Text="{ctl:T 'Nothing out of the ordinary so far.'}" Style="{StaticResource Muted}" Margin="0,7"
                                   Visibility="{Binding ShowNoInsights, Converter={StaticResource Vis}}" />
                        <ctl:Spinner Late="True" Width="20" Height="20" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,22"
                                     Visibility="{Binding Loaded, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    </StackPanel>
                </ctl:SmoothBorder>
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="9,18,9,0" Padding="20,18,20,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                    Command="{Binding GoCommand}" CommandParameter="timeline"
                                    AutomationProperties.Name="{ctl:T 'Open the Timeline'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ctl:T 'Timeline'}" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{x:Static ctl:IconSize.S11}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{ctl:T 'What changed lately'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource CardLine}" Focusable="False" />
                        <TextBlock Text="{ctl:T 'Nothing has changed in the last 30 days.'}" Style="{StaticResource Muted}" Margin="0,7"
                                   Visibility="{Binding ShowNoChanges, Converter={StaticResource Vis}}" />
                        <ctl:Spinner Late="True" Width="20" Height="20" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,22"
                                     Visibility="{Binding Loaded, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    </StackPanel>
                </ctl:SmoothBorder>
                <ctl:SmoothBorder Style="{StaticResource Card}" Margin="9,18,9,0" Padding="20,18,20,14">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'PC health'}" Style="{StaticResource H2}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding Health}" ItemTemplate="{StaticResource CardLine}" Focusable="False" />
                        <ctl:Spinner Late="True" Width="20" Height="20" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,22"
                                     Visibility="{Binding Loaded, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    </StackPanel>
                </ctl:SmoothBorder>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
