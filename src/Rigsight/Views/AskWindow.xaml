<UserControl x:Class="Rigsight.Views.AskWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rigsight.Controls"
             xmlns:vm="clr-namespace:Rigsight.ViewModels"
             xmlns:v="clr-namespace:Rigsight.Views"
             xmlns:ai="clr-namespace:Rigsight.Core.Ai;assembly=Rigsight.Core">
    <!-- The Ask window over the page: it starts stuck to the bottom-right corner, growing up and to the left, and pops
         out to float anywhere (History then a column beside the chat). The layer itself lets every click through to the
         page; only the panel takes them. Where it sits and its size are set from the code-behind (see AskWindow.xaml.cs). -->
    <UserControl.Resources>
        <!-- A button in the window's top bar: an icon, a hover and a pressed look. -->
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Resources>
                <!-- The glyph's line box is the glyph's size, so it sits in the middle of the button (as on Crashes). -->
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="LineHeight" Value="14" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style.Resources>
        </Style>

        <!-- In the top bar: the icon alone, a square of colour under it on hover (the bar has its own background now). -->
        <Style x:Key="FloatButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send: a filled square with the arrow in its middle. -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource OnAccentBrush}"
                                       LineStackingStrategy="BlockLineHeight" LineHeight="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A record an answer looked at: a quiet pill with an arrow when it opens a page, plain when it doesn't (the PC's parts). -->
        <Style x:Key="LookLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="26" CornerRadius="13" Padding="10,0" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Txt" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock x:Name="Arrow" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="8" Foreground="{DynamicResource FaintBrush}" Margin="6,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A conversation's ⋯ menu: one line per thing to do. -->
        <Style x:Key="MenuLine" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="32" CornerRadius="6" Padding="10,0" Background="Transparent">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="12" Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12.5" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop: Send's shape, quieter, with a square. -->
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Where a question is typed: the search box's look without its magnifier, growing to a few lines. -->
        <Style x:Key="ComposeBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="11,8">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource FaintBrush}" Margin="2,0" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The first-question window's dots: blue to RigSight AI, amber out to another service, green staying on this PC. -->
        <Style x:Key="FirstDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FirstTone}" Value="warm"><Setter Property="Fill" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FirstTone}" Value="good"><Setter Property="Fill" Value="{DynamicResource GoodBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── An answer's parts ───────────────────────────────────────────────── -->
        <!-- A card in an answer: tiles, bars, bands and tables sit in these. -->
        <Style x:Key="AnswerCard" TargetType="ctl:SmoothBorder">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Margin" Value="0,2,0,12" />
        </Style>

        <!-- A big number's colour, and a bar's, from its tone: a part's own colour, or warm and good for news. -->
        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Cpu"><Setter Property="Foreground" Value="{DynamicResource CpuBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Gpu"><Setter Property="Foreground" Value="{DynamicResource GpuBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warm"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToneFill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Cpu"><Setter Property="Background" Value="{DynamicResource CpuBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Gpu"><Setter Property="Background" Value="{DynamicResource GpuBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warm"><Setter Property="Background" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter Property="Background" Value="{DynamicResource GoodBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Faint"><Setter Property="Background" Value="{DynamicResource FaintBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToneSoft" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Cpu"><Setter Property="Background" Value="{DynamicResource CpuSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Gpu"><Setter Property="Background" Value="{DynamicResource GpuSoftBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A paragraph's sources: a pill at its end with the first one's name and "+2"; the list opens on hover (a tap
             where there's no pointer). RigSight's records open their page, web pages the site. The approved look, 2026-10-23. -->
        <DataTemplate x:Key="RefPill" DataType="{x:Type vm:AskRefs}">
            <Grid Margin="5,0,0,-3">
                <Button x:Name="Pill" Cursor="Hand" Focusable="False" Tag="{Binding}" MouseEnter="RefPill_Enter" MouseLeave="RefPill_Leave" Click="RefPill_Click"
                        AutomationProperties.Name="{Binding Name}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="9" Background="{DynamicResource HoverBrush}" Padding="3,1,8,1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrokeBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <!-- The mark: a solid circle with the site's first letter (a web page), or the icon of the RigSight page the
                             record came from, as in the sidebar. The letter is centred on its drawn shape, not its line box: a
                             letter's box put E and the digits a pixel right and accents over a pixel high ("the N is not at center"). -->
                        <Grid Width="16" Height="16" UseLayoutRounding="True">
                            <Ellipse x:Name="Dot" Fill="{DynamicResource CpuBrush}" />
                            <ctl:InkCentered x:Name="Letter" Text="{Binding Mark}" FontSize="9" Fill="{Binding Fill, ElementName=Dot, Converter={StaticResource InkOn}}" />
                            <Viewbox x:Name="AppMark" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <ContentControl Content="{Binding Icon, Converter={StaticResource NavIcon}}" Focusable="False" IsTabStop="False"
                                                FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource OnAccentBrush}" />
                            </Viewbox>
                        </Grid>
                        <!-- The words on the circle's own 16 px line, so they sit in the pill's middle as the mark does. -->
                        <TextBlock x:Name="Words" Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="16" Height="16" />
                        <TextBlock Text="{Binding More}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="4,0,0,0"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="16" Height="16"
                                   Visibility="{Binding HasMore, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Button>
                <!-- Below the pill, or above it flush with its top when there's no room below (see RefsPlacement): the stock flip
                     of Placement="Bottom" laid the shadow's room over the pill, the pointer fell into the shadow, the pill lost it,
                     the list closed and opened again under it: the pill flashed. The room round the card is a near-clear fill, so
                     it counts as the list (a fully clear pixel of a see-through popup lets the pointer through to what's under). -->
                <Popup IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=Pill}" Placement="Custom" CustomPopupPlacementCallback="{x:Static v:AskWindow.RefsPlacement}"
                       VerticalOffset="6" HorizontalOffset="-12" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                    <Grid Background="#01000000" MouseEnter="RefList_Enter" MouseLeave="RefList_Leave">
                    <Border Width="300" Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12"
                            Padding="4" Margin="0,0,10,12" Tag="{Binding}">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" /></Border.Effect>
                        <ItemsControl ItemsSource="{Binding List}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A click closes the list first: it stays on top of everything, the browser too. -->
                                    <Button Cursor="Hand" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}"
                                            Click="RefItem_Click"
                                            Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <!-- Inset 4 from the card with the card's radius less that, so the first and last lines' hover
                                                     follows its round corners (square ones stuck out of them); the words stay 14 in. -->
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,10">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Kind" Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                                                       LineStackingStrategy="BlockLineHeight" LineHeight="12" Height="12" VerticalAlignment="Center" Visibility="Collapsed" />
                                                            <TextBlock x:Name="Ours" Text="{ctl:T 'RigSight · '}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" />
                                                            <TextBlock Text="{Binding Site}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                            <!-- A web page opens in the browser, out of RigSight: said with the arrow. -->
                                                            <ctl:InkCentered x:Name="Out" Text="&#xE8A7;" Font="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Fill="{DynamicResource FaintBrush}"
                                                                             Width="9" Height="16" Margin="5,2,0,0" VerticalAlignment="Top" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        <TextBlock x:Name="Date" Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                    <DataTrigger Binding="{Binding IsApp}" Value="True">
                                                        <Setter TargetName="Kind" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Ours" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Out" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Date}" Value="{x:Null}"><Setter TargetName="Date" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    </Grid>
                </Popup>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsApp}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Letter" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AppMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="1"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource GpuBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="2"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PurpleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="3"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PinkBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="4"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SkyBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter TargetName="Words" Property="Foreground" Value="{DynamicResource TextBrush}" /></DataTrigger>
                <Trigger SourceName="Pill" Property="IsMouseOver" Value="True"><Setter TargetName="Words" Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AskLine}">
            <DockPanel Margin="0,0,0,8">
                <!-- A point of a list: a dot on its first line. -->
                <Ellipse DockPanel.Dock="Left" Width="4" Height="4" Fill="{DynamicResource MutedBrush}" Margin="5,9,11,0" VerticalAlignment="Top"
                         Visibility="{Binding IsPoint, Converter={StaticResource Vis}}" />
                <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" LineHeight="21">
                    <Run Text="{Binding Lead, Mode=OneWay}" FontWeight="SemiBold" /><Span ctl:Md.Text="{Binding Text}" /><InlineUIContainer BaselineAlignment="Center"><ContentControl Content="{Binding Refs}" ContentTemplate="{StaticResource RefPill}" Focusable="False" IsTabStop="False" Visibility="{Binding Refs, Converter={StaticResource Vis}}" /></InlineUIContainer>
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <!-- Big numbers side by side (two or three to a row). -->
        <DataTemplate DataType="{x:Type ai:AiTiles}">
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,2,0,6" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctl:SmoothBorder Style="{StaticResource AnswerCard}" Margin="0,0,8,6" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Style="{StaticResource ToneText}" />
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </ctl:SmoothBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Counts as bars, each with its number at the end. -->
        <DataTemplate DataType="{x:Type ai:AiBars}">
            <ctl:SmoothBorder Style="{StaticResource AnswerCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <!-- The number column is as wide as the widest number ("30.9 GB" was cut to ".9 GB" in a fixed 28), the same in every row. -->
                    <ItemsControl ItemsSource="{Binding Bars}" Focusable="False" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="BarValue" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource HoverBrush}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Share, Converter={StaticResource ShareStar}}" />
                                                <ColumnDefinition Width="{Binding Share, Converter={StaticResource ShareStar}, ConverterParameter=rest}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource ToneFill}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Shown}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <!-- Temperatures now against their usual range: the range as a band on a 0–100° line, now as a mark. -->
        <DataTemplate DataType="{x:Type ai:AiBands}">
            <ctl:SmoothBorder Style="{StaticResource AnswerCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Bands}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,11">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12.5" Foreground="{DynamicResource TextBrush}">
                                            <Run Text="{Binding Now, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource FaintBrush}" /><Run Text="{Binding Usual, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                    </DockPanel>
                                    <Grid Height="14" Margin="0,5,0,0">
                                        <Border Height="10" CornerRadius="5" Background="{DynamicResource HoverBrush}" />
                                        <Grid Height="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding LowAt, Converter={StaticResource ShareStar}}" />
                                                <ColumnDefinition Width="{Binding BandWidth, Converter={StaticResource ShareStar}}" />
                                                <ColumnDefinition Width="{Binding AfterBand, Converter={StaticResource ShareStar}}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1" Style="{StaticResource ToneSoft}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding NowAt, Converter={StaticResource ShareStar}}" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="{Binding AfterNow, Converter={StaticResource ShareStar}}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1" Style="{StaticResource ToneFill}" CornerRadius="2" Margin="-2,0,2,0" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="100°" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" />
                        <TextBlock Text="0°" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" />
                    </DockPanel>
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <!-- A table of RigSight's with a bar in its middle column (games by how busy they keep the graphics card). -->
        <DataTemplate DataType="{x:Type ai:AiBarTable}">
            <ctl:SmoothBorder Style="{StaticResource AnswerCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NameHeading}" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding BarHeading}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding ExtraHeading}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="66" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource HoverBrush}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Share, Converter={StaticResource ShareStar}}" />
                                                <ColumnDefinition Width="{Binding Share, Converter={StaticResource ShareStar}, ConverterParameter=rest}" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Fill" CornerRadius="4" Background="{DynamicResource GpuBrush}" Opacity="0.6" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Shown}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Extra}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding First}" Value="True">
                                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Fill" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <!-- A table the model wrote: headings in small caps, then its rows, all columns the same width. -->
        <DataTemplate DataType="{x:Type vm:AskTable}">
            <ctl:SmoothBorder Style="{StaticResource AnswerCard}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Headings}" Focusable="False" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,10,0"><Span ctl:Md.Text="{Binding}" /></TextBlock></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                    <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,10,0"><Span ctl:Md.Text="{Binding}" /></TextBlock></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <!-- The next step in a box of its own, with its buttons in it: the main one solid, the next quieter, a third as a
             link (the approved look, 2026-10-23). Close asks first in the same place, and each button then says what happened
             where it was, so nothing under it moves. With buttons but no step, the box holds only the buttons. -->
        <Style x:Key="SecondAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Padding" Value="11,6" />
        </Style>
        <!-- Copy, Ask again, Helpful, Not helpful under an answer: a 28 px icon, faint until hovered. -->
        <Style x:Key="IconAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="28" Height="28" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Copy, Ask again, Helpful under an answer: small words, faint until hovered. -->
        <Style x:Key="QuietAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="7,3" Margin="0,0,2,0">
                            <ContentPresenter TextElement.FontSize="12" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Show all" under a long question: words only, brighter on hover. -->
        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter Margin="0,0,4,0" TextElement.FontSize="12.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,6,4,6">
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12.5" />
                            <TextBlock x:Name="Go" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                            <!-- Nothing to open (a web search, a look-up with no page): plain words, no arrow, no hand. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Go" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A button in a step card: the main one solid, the next quieter, a third a link; Close asks in place. -->
        <DataTemplate x:Key="ActionButton">
                        <Grid Margin="0,0,8,6">
                            <!-- The main one: solid. -->
                            <Button x:Name="Main" Style="{StaticResource AccentButton}" Padding="12,6" Visibility="Collapsed" AutomationProperties.Name="{Binding Label}"
                                    Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OnAccentBrush}"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding ButtonLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- The next: quieter. -->
                            <Button x:Name="Second" Style="{StaticResource SecondAction}" Visibility="Collapsed" AutomationProperties.Name="{Binding Label}"
                                    Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- A third: a link. -->
                            <Button x:Name="Link" Style="{StaticResource LinkAction}" Content="{Binding Label}" Visibility="Collapsed" AutomationProperties.Name="{Binding Label}"
                                    Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <!-- Close: the question in the button's place. -->
                            <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" MaxWidth="400"
                                              Visibility="{Binding IsConfirming, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConfirmText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Style="{StaticResource AccentButton}" Padding="12,6" Content="{ctl:T 'Close it'}" AutomationProperties.Name="{ctl:T 'Close it'}"
                                                Command="{Binding DataContext.ConfirmActCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SecondAction}" Margin="8,0,0,0" Content="{ctl:T 'Cancel'}" AutomationProperties.Name="{ctl:T 'Cancel'}"
                                                Command="{Binding DataContext.CancelActCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </ctl:SmoothBorder>
                            <StackPanel Orientation="Horizontal" Margin="2,6,0,6" Visibility="{Binding IsWorking, Converter={StaticResource Vis}}">
                                <ctl:Spinner Width="14" Height="14" StrokeThickness="1.6" VerticalAlignment="Center" />
                                <TextBlock Text="{ctl:T 'Closing…'}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <DockPanel Margin="2,6,0,6" Visibility="{Binding IsSaid, Converter={StaticResource Vis}}">
                                <TextBlock x:Name="Mark" DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource GoodBrush}"
                                           LineStackingStrategy="BlockLineHeight" LineHeight="18" Height="18" VerticalAlignment="Top" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Said}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="380" LineHeight="18" />
                            </DockPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding IsReady}" Value="True" /><Condition Binding="{Binding IsMain}" Value="True" /></MultiDataTrigger.Conditions>
                                <Setter TargetName="Main" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding IsReady}" Value="True" /><Condition Binding="{Binding IsSecond}" Value="True" /></MultiDataTrigger.Conditions>
                                <Setter TargetName="Second" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding IsReady}" Value="True" /><Condition Binding="{Binding IsLink}" Value="True" /></MultiDataTrigger.Conditions>
                                <Setter TargetName="Link" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter TargetName="Mark" Property="Text" Value="&#xE7BA;" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A line for a step that only opens something: its sign in the kind's colour, what it opens in bold, what it's for in
             grey, and an arrow; the whole line is the button. -->
        <DataTemplate x:Key="ActionLine">
            <Grid Margin="0,0,0,6">
                <Button x:Name="Line" Cursor="Hand" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}"
                        Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding IsReady, Converter={StaticResource Vis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="1" Background="Transparent" Padding="12,9">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource FaintBrush}"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="12" Height="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock x:Name="Sign" DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource PurpleBrush}"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="16" Height="16" VerticalAlignment="Top" Margin="0,1,11,0" />
                                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18" VerticalAlignment="Center">
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run x:Name="Dot" Text=" · " Foreground="{DynamicResource FaintBrush}" /><Run x:Name="WhyRun" Text="{Binding Why, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" /></Trigger>
                                <DataTrigger Binding="{Binding HasWhy}" Value="False"><Setter TargetName="Dot" Property="Text" Value="" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="OpenWindows"><Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource SkyBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="VerifyGame"><Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource GpuBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="OpenSharing"><Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="StartAgent"><Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="CopyReport"><Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <DockPanel Margin="2,6,0,6" Visibility="{Binding IsSaid, Converter={StaticResource Vis}}">
                    <TextBlock x:Name="Mark" DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource GoodBrush}"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18" Height="18" VerticalAlignment="Top" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Said}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" />
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter TargetName="Mark" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The next step (the approved look C of 2026-10-23): a card for a step that changes something on the PC, with its sign,
             the action as its title, the step in grey and the buttons across the card's full width (no empty column under the
             sign); a step that only opens something, one line a button each; a step with no button, the words in the light card. -->
        <DataTemplate DataType="{x:Type vm:AskNext}">
            <StackPanel Margin="0,4,0,12">
                <ctl:SmoothBorder CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Padding="14,12" Visibility="{Binding IsWords, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'NEXT STEP'}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" LineHeight="20" Margin="0,5,0,0" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Height="26" Padding="10,0" Margin="0,8,0,0"
                                Content="{Binding OpensLabel}" AutomationProperties.Name="{Binding OpensLabel, TargetNullValue=''}" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.OpenNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </ctl:SmoothBorder>
                <ctl:SmoothBorder CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Padding="14,12" Visibility="{Binding IsCard, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <!-- The title and one measured line on the left, "Close it" on the right of the same row (nothing hangs
                             in empty space); its question and outcome, and the other buttons, in the row under it. -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center"
                                    DataContext="{Binding Main}" AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsReady, Converter={StaticResource Vis}}"
                                    Command="{Binding DataContext.ActCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="12" Height="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding ButtonLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CardTitle}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding CardText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding MainOnly}" ItemTemplate="{StaticResource ActionButton}" Focusable="False" Margin="0,10,0,-6">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Main.IsReady}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Rest}" ItemTemplate="{StaticResource ActionButton}" Focusable="False" Margin="0,10,0,-6"
                                      Visibility="{Binding Rest, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ctl:SmoothBorder>
                <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" ItemTemplate="{StaticResource ActionLine}" Margin="0,0,0,-6"
                              Visibility="{Binding IsLines, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- What a button did, kept in the conversation. -->
        <DataTemplate DataType="{x:Type vm:AskDone}">
            <DockPanel Margin="0,0,0,12" Visibility="{Binding Live, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource GoodBrush}"
                           LineStackingStrategy="BlockLineHeight" LineHeight="18" Height="18" VerticalAlignment="Top" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" />
            </DockPanel>
        </DataTemplate>

        <!-- Check again: a countdown, then each reading before and after, from RigSight's own records. -->
        <DataTemplate DataType="{x:Type vm:AskCheck}">
            <ctl:SmoothBorder Style="{StaticResource AnswerCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE916;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="18" Height="18" VerticalAlignment="Top" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="28,10,0,2" Visibility="{Binding IsWaiting, Converter={StaticResource Vis}}">
                        <ctl:Spinner Width="14" Height="14" StrokeThickness="1.6" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Left}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="28,10,0,0" Grid.IsSharedSizeScope="True"
                                  Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBefore" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CheckAfter" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="Change" Text="{Binding Change}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Before}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="2" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Top">
                                        <Run Text="→ " Foreground="{DynamicResource FaintBrush}" /><Run Text="{Binding After, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Better}" Value="True"><Setter TargetName="Change" Property="Foreground" Value="{DynamicResource GoodBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Better}" Value="False"><Setter TargetName="Change" Property="Foreground" Value="{DynamicResource WarmBrush}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="28,6,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource SecondAction}" HorizontalAlignment="Left" Margin="28,12,0,0"
                            Content="{ctl:T 'Ask what this means'}" AutomationProperties.Name="{ctl:T 'Ask what this means'}"
                            Visibility="{Binding HasResult, Converter={StaticResource Vis}}"
                            Command="{Binding DataContext.AskAboutCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AskQuestion}">
            <ctl:SmoothBorder HorizontalAlignment="Right" MaxWidth="340" CornerRadius="12,12,4,12" Background="{DynamicResource Surface2Brush}" Padding="12,9" Margin="40,0,0,10">
                <!-- A long one shows its first ten lines or so, so the answer isn't pushed out of sight. -->
                <StackPanel>
                    <TextBlock x:Name="Words" Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <ToggleButton x:Name="All" Style="{StaticResource LinkToggle}" Content="{ctl:T 'Show all'}" AutomationProperties.Name="{ctl:T 'Show all'}"
                                  HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ctl:SmoothBorder>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLong}" Value="True">
                    <Setter TargetName="Words" Property="MaxHeight" Value="190" />
                    <Setter TargetName="All" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=All}" Value="True">
                    <Setter TargetName="Words" Property="MaxHeight" Value="Infinity" />
                    <Setter TargetName="All" Property="Content" Value="{ctl:T 'Show less'}" />
                    <Setter TargetName="All" Property="AutomationProperties.Name" Value="{ctl:T 'Show less'}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Waiting for the answer: three dots bouncing in turn at first; when it takes a while, what it's doing instead
             ("Reviewing your crashes…"), pulsing so it's plainly still at work. -->
        <DataTemplate DataType="{x:Type vm:AskThinking}">
            <Grid Margin="0,0,0,14" MinHeight="20">
                <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,6,0,0"
                            AutomationProperties.Name="{ctl:T 'Thinking'}">
                    <StackPanel.Resources>
                        <Style TargetType="Ellipse">
                            <Setter Property="Width" Value="7" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="Margin" Value="0,0,5,0" />
                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Ellipse x:Name="Dot1" />
                    <Ellipse x:Name="Dot2" />
                    <Ellipse x:Name="Dot3" />
                </StackPanel>
                <StackPanel x:Name="Words" Visibility="Collapsed">
                    <TextBlock x:Name="StepText" Text="{Binding Step}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1.2">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-5"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1.2">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-5"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1.2">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-5"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="StepText" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding Slow}" Value="True">
                    <Setter TargetName="Dots" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Words" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AskProblem}">
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource WarmBrush}" Margin="0,2,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
            </DockPanel>
        </DataTemplate>

        <!-- A limit or a page in the way (the plans mock-up): a card in the chat with the one step that fixes it. -->
        <DataTemplate DataType="{x:Type vm:AskWall}">
            <ctl:SmoothBorder CornerRadius="12" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                              Padding="14,12" Margin="0,0,0,14" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="{Binding MainText}" Margin="0,0,8,0"
                                Command="{Binding DataContext.UseWallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding HasPlan, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource GhostButton}" Content="{ctl:T 'See all plans'}"
                                Command="{Binding DataContext.SeePlansCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </WrapPanel>
                </StackPanel>
            </ctl:SmoothBorder>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AskStopped}">
            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14" />
        </DataTemplate>

        <!-- An answer still being written: drawn as the finished one will be, so nothing moves when it's done. -->
        <DataTemplate DataType="{x:Type vm:AskWriting}">
            <StackPanel Margin="0,0,0,18">
                <!-- Drawn exactly as the finished answer's opening (its size, weight and Markdown): it was the old bold 15 pt
                     headline here, which jumped to the plain paragraph once the answer finished (2026-10-24). -->
                <TextBlock FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"
                           Visibility="{Binding Verdict, Converter={StaticResource Vis}}"><Span ctl:Md.Text="{Binding Verdict}" /></TextBlock>
                <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AskAnswer}">
            <StackPanel Margin="0,0,0,18">
                <!-- What it read, folded to one line over the answer ("Looked at Crashes and Temperatures · 17 s"); opened, each
                     record and its days, a click on one opens its page. -->
                <StackPanel Margin="0,0,0,8" Visibility="{Binding HasLooked, Converter={StaticResource Vis}}">
                    <ToggleButton x:Name="LookedToggle" Style="{StaticResource LinkToggle}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding LookedLine}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LookedArrow" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="8" Margin="0,1,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LookedLine}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </ToggleButton>
                    <ItemsControl x:Name="LookedList" ItemsSource="{Binding Looked}" Margin="15,4,0,0" Visibility="Collapsed" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkAction}" Content="{Binding Text}" AutomationProperties.Name="{Binding Text}" HorizontalAlignment="Left" IsEnabled="{Binding CanOpen}"
                                        Command="{Binding DataContext.OpenLookedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock x:Name="Verdict" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"
                           Visibility="{Binding Verdict, Converter={StaticResource Vis}}"><Span ctl:Md.Text="{Binding Verdict}" /><InlineUIContainer BaselineAlignment="Center"><ContentControl Content="{Binding VerdictRefs}" ContentTemplate="{StaticResource RefPill}" Focusable="False" IsTabStop="False" Visibility="{Binding VerdictRefs, Converter={StaticResource Vis}}" /></InlineUIContainer></TextBlock>
                <!-- Its parts in order: paragraphs and points, RigSight's own numbers, tables, the next step. -->
                <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" />

                <DockPanel Margin="0,2,0,8" Visibility="{Binding HasWeb, Converter={StaticResource Vis}}">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding FromWeb}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </DockPanel>
                <!-- A page the plan doesn't open would have helped: one quiet line, never a pop-up. -->
                <!-- Room under it: the actions below sit 6 px up to hug an answer's words, and touched this line (2026-10-24). -->
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,14"
                        Visibility="{Binding HasLocked, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ctl:T 'See plans'}" VerticalAlignment="Center" Margin="12,0,0,0"
                                Command="{Binding DataContext.SeePlansCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="{Binding LockedTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding LockedText, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <!-- Under every answer, tight under it like other chat apps' action bars: icons with their word as a tooltip,
                     quiet until hovered. No offset to line the icons up with the words: the hover was cut by the chat's edge. -->
                <StackPanel Orientation="Horizontal" Margin="0,-6,0,0">
                    <Button x:Name="CopyButton" Style="{StaticResource IconAction}" ToolTip="{ctl:T 'Copy'}" AutomationProperties.Name="{ctl:T 'Copy'}"
                            Command="{Binding DataContext.CopyAnswerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource IconAction}" ToolTip="{ctl:T 'Ask again'}" AutomationProperties.Name="{ctl:T 'Ask again'}"
                            Visibility="{Binding Asked, Converter={StaticResource Vis}}"
                            Command="{Binding DataContext.AskAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                    </Button>
                    <StackPanel Orientation="Horizontal" DataContext="{Binding Feedback}" Visibility="{Binding CanRate, Converter={StaticResource Vis}}">
                        <Button x:Name="Good" Style="{StaticResource IconAction}" ToolTip="{ctl:T 'Helpful'}" AutomationProperties.Name="{ctl:T 'Helpful'}" Command="{Binding HelpfulCommand}">
                            <TextBlock x:Name="GoodIcon" Text="&#xE8E1;" Style="{StaticResource Icon}" FontSize="13" />
                        </Button>
                        <Button x:Name="Bad" Style="{StaticResource IconAction}" ToolTip="{ctl:T 'Not helpful'}" AutomationProperties.Name="{ctl:T 'Not helpful'}" Command="{Binding NotHelpfulCommand}">
                            <TextBlock x:Name="BadIcon" Text="&#xE8E0;" Style="{StaticResource Icon}" FontSize="13" />
                        </Button>
                        <TextBlock Text="{Binding Said}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding HasSaid, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
                <!-- Not helpful: why, in four plain words and their own (both optional), then Send. -->
                <ctl:SmoothBorder DataContext="{Binding Feedback}" CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,8,0,0"
                                  Visibility="{Binding Asking, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'What was wrong?'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                        <ItemsControl ItemsSource="{Binding ReasonButtons}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Reason" Style="{StaticResource GhostButton}" Background="{DynamicResource HoverBrush}" Padding="10,5" Margin="0,0,6,6" FontSize="12"
                                            Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding Owner.PickCommand}" CommandParameter="{Binding Id}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                            <Setter TargetName="Reason" Property="Background" Value="{DynamicResource TextBrush}" />
                                            <Setter TargetName="Reason" Property="Foreground" Value="{DynamicResource BgBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Style="{StaticResource ComposeBox}" Tag="{ctl:T 'Anything else? Kept with this question on the RigSight server. (optional)'}" AutomationProperties.Name="{ctl:T 'Anything else?'}"
                                 Text="{Binding Words, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <Button Style="{StaticResource AccentButton}" Content="{ctl:T 'Send'}" AutomationProperties.Name="{ctl:T 'Send why'}" Padding="14,6" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding SendWhyCommand}" />
                    </StackPanel>
                </ctl:SmoothBorder>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LookedToggle}" Value="True">
                    <Setter TargetName="LookedList" Property="Visibility" Value="Visible" />
                    <Setter TargetName="LookedArrow" Property="Text" Value="&#xE70D;" />
                </DataTrigger>
                <!-- Pressed: in the text colour, so what was said stays plain. -->
                <DataTrigger Binding="{Binding Feedback.IsHelpful}" Value="True">
                    <Setter TargetName="Good" Property="Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feedback.IsNotHelpful}" Value="True">
                    <Setter TargetName="Bad" Property="Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
                <!-- Copied: a tick for a moment, where the copy icon was. -->
                <DataTrigger Binding="{Binding Feedback.Copied}" Value="True">
                    <Setter TargetName="CopyIcon" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="CopyButton" Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="CopyButton" Property="ToolTip" Value="{ctl:T 'Copied'}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The conversations: a new one, a search, then Pinned, Today, Yesterday and Earlier, each with its ⋯ menu (Pin,
             Rename, Archive, Delete), and the archived ones behind a line at the foot. -->
        <DataTemplate x:Key="HistoryList">
            <DockPanel Margin="8,0,8,8">
                <Button DockPanel.Dock="Top" Style="{StaticResource PickRow}" Command="{Binding NewCommand}"
                        AutomationProperties.Name="{ctl:T 'New conversation'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{ctl:T 'New conversation'}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Top" Style="{StaticResource PickRow}" Command="{Binding ToggleArchivedCommand}"
                        AutomationProperties.Name="{Binding ArchivedText}" Visibility="{Binding HasArchived, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ArchivedCount}" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                   Visibility="{Binding ShowingArchived, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ArchivedText}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>
                </Button>
                <TextBox x:Name="HistorySearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="{ctl:T 'Search conversations'}" Margin="0,12,0,0"
                         AutomationProperties.Name="{ctl:T 'Search conversations'}" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" />
                <!-- The bar in its own gutter beside the rows (drawn over them, it covered the titles and their ⋯). -->
                <ScrollViewer Style="{StaticResource GutterScroll}" FocusVisualStyle="{x:Null}">
                    <StackPanel>
                        <TextBlock Text="{ctl:T 'No conversations yet.'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="6,8"
                                   Visibility="{Binding HasHistory, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="10,20,8,6" />
                                        <ItemsControl ItemsSource="{Binding Conversations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="Row" Background="Transparent">
                                                        <Button Padding="8,7,34,7" AutomationProperties.Name="{Binding Title}"
                                                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PickRow}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" Text="&#xE718;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource FaintBrush}"
                                                                           Margin="0,1,8,0" VerticalAlignment="Center" Visibility="{Binding IsPinned, Converter={StaticResource Vis}}" />
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                            </DockPanel>
                                                        </Button>
                                                        <!-- Rename: the title typed over in place; Enter keeps it, Esc puts it back. -->
                                                        <TextBox Style="{StaticResource FieldBox}" Padding="0" FontSize="12.5" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="{ctl:T 'Conversation name'}" MaxLength="80"
                                                                 Visibility="{Binding IsRenaming, Converter={StaticResource Vis}}"
                                                                 IsVisibleChanged="Rename_Shown" PreviewKeyDown="Rename_Key" LostKeyboardFocus="Rename_Lost" />
                                                        <Button x:Name="More" HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" Margin="0,0,4,0"
                                                                ToolTip="{ctl:T 'More'}" AutomationProperties.Name="{ctl:T 'More'}" Cursor="Hand"
                                                                Command="{Binding DataContext.OpenMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE712;" FontSize="12" />
                                                        </Button>
                                                        <Popup IsOpen="{Binding IsMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=More}" Placement="Bottom" StaysOpen="False"
                                                               AllowsTransparency="True" HorizontalOffset="-140" VerticalOffset="4"
                                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource TooltipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="5" Width="170">
                                                                <StackPanel>
                                                                    <Button Tag="&#xE718;" Command="{Binding Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource MenuLine}">
                                                                                <Setter Property="Content" Value="{ctl:T 'Pin'}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Content" Value="{ctl:T 'Unpin'}" /><Setter Property="Tag" Value="&#xE77A;" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Style="{StaticResource MenuLine}" Tag="&#xE8AC;" Content="{ctl:T 'Rename'}"
                                                                            Command="{Binding Tag.StartRenameCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" />
                                                                    <Button Tag="&#xE7B8;" Command="{Binding Tag.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource MenuLine}">
                                                                                <Setter Property="Content" Value="{ctl:T 'Archive'}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Content" Value="{ctl:T 'Unarchive'}" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Style="{StaticResource MenuLine}" Tag="&#xE74D;" Content="{ctl:T 'Delete'}" Foreground="{DynamicResource HotBrush}"
                                                                            Command="{Binding Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </ctl:SmoothBorder>
                                                        </Popup>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
        <!-- From top to bottom: RigSight's name and the button that hides it (its top also moves the window), then the list. -->
        <DataTemplate x:Key="Sidebar">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="46" Padding="14,0,8,0" Background="Transparent" Cursor="SizeAll"
                        MouseLeftButtonDown="Bar_MouseDown" MouseMove="Bar_MouseMove" MouseLeftButtonUp="Bar_MouseUp">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Command="{Binding ToggleHistoryCommand}" Cursor="Hand"
                                ToolTip="{ctl:T 'Hide conversations'}" AutomationProperties.Name="{ctl:T 'Hide conversations'}">
                            <!-- The sidebar sign: a rounded frame with a line down its left part. -->
                            <Grid Width="16" Height="14">
                                <Border BorderThickness="1.3" CornerRadius="3.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Border Width="1.3" HorizontalAlignment="Left" Margin="5.2,0,0,0" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>
                        <TextBlock Text="{ctl:T 'Ask RigSight'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryList}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Layer">
        <!-- Where it will stick when let go near the corner while being dragged. -->
        <Border x:Name="DropSpot" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource FaintBrush}"
                Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- The panel's shadow on an empty box of its own behind it: an effect on the panel itself drew every word of the
             chat without ClearType (greyscale, thinner and softer than the rest of the app). -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False"
                Width="{Binding Width, ElementName=Panel}" Height="{Binding Height, ElementName=Panel}" Margin="{Binding Margin, ElementName=Panel}"
                Visibility="{Binding Visibility, ElementName=Panel}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>
        <ctl:SmoothBorder x:Name="Panel" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource HoverBrush}" BorderThickness="1" AutomationProperties.Name="Ask RigSight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HistoryColumn" Width="0" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Wide: the conversations as a column from top to bottom beside the chat. -->
                <Border Grid.RowSpan="3" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0"
                        Visibility="{Binding ShowHistoryColumn, Converter={StaticResource Vis}}">
                    <!-- Built only while shown: a hidden copy kept its own ⋯ menus, which opened beside it with the shown one's. -->
                    <ContentControl ContentTemplate="{StaticResource Sidebar}" Focusable="False" IsTabStop="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Content" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowHistoryColumn}" Value="True"><Setter Property="Content" Value="{Binding}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>

                <!-- The conversation, or where to start on a new one. -->
                <Grid Grid.Column="1">
                    <!-- The chat starts under the top bar: text scrolling up under the buttons crowded them (2026-10-22). -->
                    <ScrollViewer x:Name="Chat" VerticalScrollBarVisibility="Auto" Focusable="False" FocusVisualStyle="{x:Null}" Padding="16,0,16,4" Margin="0,46,0,0" Visibility="{Binding ShowChat, Converter={StaticResource Vis}}">
                        <StackPanel Margin="0,10,0,0">
                            <!-- Opened from an Explain button: what it is about. -->
                            <TextBlock Text="{Binding LookingAt}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,10" Visibility="{Binding HasLookingAt, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Current.Messages}" />
                            <!-- What they might ask next, under the latest answer (approved mock-up 2026-10-24): a short list under a small
                                 heading, full-width rows with an arrow that wrap long questions; quiet until the pointer is on one. -->
                            <!-- Full width on every layer: the theme's buttons sit left by default, which made the rows and their line
                                 only as wide as their words (2026-10-24). -->
                            <StackPanel Margin="0,4,0,12" HorizontalAlignment="Stretch" Visibility="{Binding HasNextQuestions, Converter={StaticResource Vis}}">
                                <TextBlock Text="{ctl:T 'Ask next'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,4" />
                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding NextQuestions}" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" Focusable="False" AutomationProperties.Name="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.AskSuggestedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Background="Transparent" Padding="6,9">
                                                                <DockPanel>
                                                                    <TextBlock x:Name="Go" DockPanel.Dock="Right" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                                                               VerticalAlignment="Center" Margin="12,0,2,0" />
                                                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                                    <Setter TargetName="Go" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- A new chat (approved mock-up 2026-10-24): in the middle of the space, the PC named, and four questions from its
                         own records, each with the page it reads; two by two when wide, one column when narrow. The box to type
                         in stays at the bottom, so nothing moves when the first question goes. -->
                    <ScrollViewer Style="{StaticResource GutterScroll}" Margin="0,46,0,0" Padding="18,0,18,8" Visibility="{Binding ShowStarters, Converter={StaticResource Vis}}">
                        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <StackPanel VerticalAlignment="Center" MaxWidth="720">
                            <TextBlock Text="{ctl:T 'Ask about this PC'}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PcLine}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Visibility="{Binding HasPcLine, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Starters}" Margin="0,14,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:TileWrap MinTileWidth="300" Gap="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PickRow}" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,0,0,8" MinHeight="74"
                                                VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Text}"
                                                Command="{Binding DataContext.StarterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Text}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PageName}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" LineHeight="18" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{ctl:T 'or type your own below'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <!-- The first question with this way of answering: what is sent and where, before anything goes, with the
                         same switches as Settings › Ask RigSight (approved mock-up 2026-10-21). One version each for RigSight AI, my own
                         key and Ollama. Start asking closes it for good for that way. -->
                    <!-- The approved draft of 2026-10-23: what is kept said truly (with the privacy page), one line per page with
                         its own switch, the plan's other pages grouped under a small "In Essentials" / "In Complete", an example
                         of what one question sends, and Start asking always in view under the list. -->
                    <DockPanel Visibility="{Binding ShowFirstQuestion, Converter={StaticResource Vis}}">
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="{ctl:T 'Start asking'}" Command="{Binding StartAskingCommand}" />
                                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Background="{DynamicResource HoverBrush}" Content="{ctl:T 'Not now'}" Margin="8,0,0,0" Command="{Binding CloseCommand}" />
                                <TextBlock Text="{Binding FirstExtra}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding FirstExtra, Converter={StaticResource Vis}}" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="18,52,18,12">
                            <StackPanel>
                                <TextBlock Text="{ctl:T 'Before your first question'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FirstIntro}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,12,0,0">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top" Style="{StaticResource FirstDot}" />
                                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">
                                            <Run Text="{Binding FirstWhere, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding FirstWhereText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </ctl:SmoothBorder>
                                <!-- RigSight AI: what's kept, and by whom, plainly; the privacy page for the rest. -->
                                <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,8,0,0"
                                                  Visibility="{Binding FirstKept, Converter={StaticResource Vis}}">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top" Style="{StaticResource FirstDot}" />
                                        <StackPanel>
                                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">
                                                <Run Text="{ctl:T 'What is kept.'}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding FirstKept, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Style="{StaticResource LinkAction}" Content="{ctl:T 'Privacy page'}" AutomationProperties.Name="{ctl:T 'Privacy page'}" HorizontalAlignment="Left"
                                                    Command="{Binding OpenPrivacyCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                </ctl:SmoothBorder>
                                <ctl:SmoothBorder CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,8,0,0">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top" Style="{StaticResource FirstDot}" />
                                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">
                                            <Run Text="{Binding FirstMore, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> <Run Text="{Binding FirstMoreText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </ctl:SmoothBorder>
                                <!-- The heading right above the switches, bigger than their names, so it reads as one. -->
                                <TextBlock Text="{ctl:T 'Pick the pages it may read'}" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
                                <TextBlock Text="{Binding Pages.OpenHeading}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="2,0,0,6"
                                           Visibility="{Binding Pages.HasOutside, Converter={StaticResource Vis}}" />
                                <!-- One line a page, its own switch: the same pages as Settings › AI › What answers can read. -->
                                <ItemsControl ItemsSource="{Binding Pages.Tiles}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ctl:SmoothBorder CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="12,8" Margin="0,0,0,4" ToolTip="{Binding Tip}">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding On, Mode=OneWay}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center"
                                                              Command="{Binding DataContext.Pages.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                </DockPanel>
                                            </ctl:SmoothBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- The plan's other pages: grouped, a quiet tag saying which plan, never a grey switch (it looks broken), no price. -->
                                <TextBlock Text="{ctl:T 'WITH A PLAN'}" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="2,10,0,6"
                                           Visibility="{Binding Pages.HasOutside, Converter={StaticResource Vis}}" />
                                <ItemsControl ItemsSource="{Binding Pages.OutsideGroups}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ctl:SmoothBorder CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="12,8" Margin="0,0,0,4" ToolTip="{Binding All}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="7,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tag}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Names}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                                </DockPanel>
                                            </ctl:SmoothBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- What one question sends, so it isn't left to the imagination. -->
                                <ToggleButton x:Name="ExampleToggle" Style="{StaticResource LinkToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                              AutomationProperties.Name="{ctl:T 'See what one question sends'}" Visibility="{Binding FirstExample, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ExampleArrow" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="8" Margin="0,1,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{ctl:T 'See what one question sends'}" FontSize="12.5" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="{Binding FirstExample}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="15,6,0,0"
                                           Visibility="{Binding IsChecked, ElementName=ExampleToggle, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding FirstNever}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Visibility="{Binding FirstNever, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{ctl:T 'You can change these any time in Settings › Ask RigSight.'}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>


                <!-- The top bar, in the panel's colour with a line under it: it moves the window (stuck, a drag pops it out).
                     Rounded at the top to fit the panel; only on the right while the conversations are a column beside it. -->
                <Border x:Name="Bar" Grid.Column="1" Height="46" VerticalAlignment="Top" Cursor="SizeAll"
                        MouseLeftButtonDown="Bar_MouseDown" MouseMove="Bar_MouseMove" MouseLeftButtonUp="Bar_MouseUp" PreviewMouseWheel="Bar_MouseWheel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="CornerRadius" Value="13,13,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowHistoryColumn}" Value="True"><Setter Property="CornerRadius" Value="0,13,0,0" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                            Visibility="{Binding ShowHistoryColumn, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                    <Button Style="{StaticResource FloatButton}" Command="{Binding ToggleHistoryCommand}" ToolTip="{ctl:T 'Show conversations'}" AutomationProperties.Name="{ctl:T 'Conversations'}" Margin="0,0,4,0">
                        <!-- The sidebar sign: a rounded frame with a line down its left part. -->
                            <Grid Width="16" Height="14">
                                <Border BorderThickness="1.3" CornerRadius="3.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Border Width="1.3" HorizontalAlignment="Left" Margin="5.2,0,0,0" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                    </Button>
                    <Button Style="{StaticResource FloatButton}" Command="{Binding NewCommand}" ToolTip="{ctl:T 'New conversation'}" AutomationProperties.Name="{ctl:T 'New conversation'}">
                        <TextBlock Text="&#xE70F;" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                        <!-- Questions left on RigSight AI (this week's free ones, or today's): amber when few are left; opens the plans. -->
                        <Button Command="{Binding SeePlansCommand}" Margin="0,0,4,0" VerticalAlignment="Center" Height="30" Cursor="Hand"
                                ToolTip="{ctl:T 'See plans'}" Visibility="{Binding ShowQuestionsPill, Converter={StaticResource Vis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,0">
                                        <TextBlock x:Name="Txt" Text="{Binding QuestionsLeftText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource WarmBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    <Button Style="{StaticResource FloatButton}" Command="{Binding ToggleSizeCommand}" x:Name="SizeButton" Margin="0,0,4,0"
                            ToolTip="{ctl:T 'Bigger'}" AutomationProperties.Name="{ctl:T 'Bigger'}"
                            Visibility="{Binding IsPoppedOut, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                        <TextBlock x:Name="SizeIcon" Text="&#xE740;" />
                    </Button>
                    <Button Style="{StaticResource FloatButton}" Command="{Binding PopOutCommand}" x:Name="PopButton" Margin="0,0,4,0"
                            ToolTip="{ctl:T 'Pop out'}" AutomationProperties.Name="{ctl:T 'Pop out'}">
                        <TextBlock x:Name="PopIcon" Text="&#xE8A7;" />
                    </Button>
                    <Button Style="{StaticResource FloatButton}" Command="{Binding CloseCommand}" ToolTip="{ctl:T 'Close'}" AutomationProperties.Name="{ctl:T 'Close'}">
                        <TextBlock Text="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- One question left: said before it's used. -->
                <ctl:SmoothBorder Grid.Row="1" Grid.Column="1" CornerRadius="10" Margin="12,0,12,10" Padding="12,9" Background="{DynamicResource Surface2Brush}"
                                  Visibility="{Binding IsLastQuestion, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding LastQuestionTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" />
                        <TextBlock Text="{Binding LastQuestionText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding LastQuestionText, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </ctl:SmoothBorder>
                <!-- RigSight AI with nothing left: where to get more. -->
                <ctl:SmoothBorder Grid.Row="1" Grid.Column="1" CornerRadius="10" Margin="12,0,12,10" Padding="12" Background="{DynamicResource Surface2Brush}"
                                  Visibility="{Binding IsOutOfQuestions, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding OutTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" />
                        <TextBlock Text="{Binding OutText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding LicenceOff, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <Button Style="{StaticResource AccentButton}" Content="{Binding OutOffer.MainText}" Command="{Binding UseWallCommand}" CommandParameter="{Binding OutOffer}"
                                    Margin="0,0,8,0" Visibility="{Binding OutOffer, Converter={StaticResource Vis}}" />
                            <!-- On the box's own colour a ghost button vanished into it (read as words): a shade lighter, so it's a button. -->
                            <Button Style="{StaticResource GhostButton}" Background="{DynamicResource HoverBrush}" Content="{ctl:T 'See plans'}" Command="{Binding SeePlansCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ctl:SmoothBorder>

                <!-- Where the question is typed; Enter sends it, Shift+Enter starts a new line. -->
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SendButton}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                Command="{Binding SendCommand}" ToolTip="{ctl:T 'Send'}" AutomationProperties.Name="{ctl:T 'Send'}"
                                Visibility="{Binding IsAnswering, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                        <!-- While an answer is on its way, Stop takes Send's place, the same size. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource StopButton}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                Command="{Binding StopCommand}" ToolTip="{ctl:T 'Stop'}" AutomationProperties.Name="{ctl:T 'Stop'}"
                                Visibility="{Binding IsAnswering, Converter={StaticResource Vis}}" />
                        <TextBox x:Name="Question" Style="{StaticResource ComposeBox}" Tag="{ctl:T 'Ask about your PC…'}" AutomationProperties.Name="{ctl:T 'Ask about your PC'}"
                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="38" MaxLength="4000"
                                 VerticalScrollBarVisibility="Auto" PreviewKeyDown="Question_KeyDown" />
                    </DockPanel>
                </Border>

                <!-- Narrow: the conversations open over the chat, which dims behind them (a click on it closes them). -->
                <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="{Binding ShowHistoryOver, Converter={StaticResource Vis}}">
                    <Border Background="#73000000" CornerRadius="14" MouseLeftButtonDown="Dim_MouseDown" />
                    <!-- Its shadow on a box of its own, for the same reason as the panel's. -->
                    <Border Width="290" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" CornerRadius="14,0,0,14" IsHitTestVisible="False">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="0" Opacity="0.45" Color="Black" /></Border.Effect>
                    </Border>
                    <Border Width="290" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" CornerRadius="14,0,0,14">
                        <!-- Built only while shown: a hidden copy kept its own ⋯ menus, which opened beside it with the shown one's. -->
                    <ContentControl ContentTemplate="{StaticResource Sidebar}" Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Content" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowHistoryOver}" Value="True"><Setter Property="Content" Value="{Binding}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    </Border>
                </Grid>
                <!-- The edges it resizes from: top and left while stuck (it grows up and to the left), bottom and right popped out. -->
                <Thumb x:Name="TopEdge" Grid.RowSpan="3" Grid.ColumnSpan="2" Height="6" VerticalAlignment="Top" Cursor="SizeNS" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
                <Thumb x:Name="LeftEdge" Grid.RowSpan="3" Grid.ColumnSpan="2" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
                <Thumb x:Name="TopLeft" Grid.RowSpan="3" Grid.ColumnSpan="2" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
                <Thumb x:Name="BottomEdge" Grid.RowSpan="3" Grid.ColumnSpan="2" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
                <Thumb x:Name="RightEdge" Grid.RowSpan="3" Grid.ColumnSpan="2" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
                <Thumb x:Name="BottomRight" Grid.RowSpan="3" Grid.ColumnSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
                <!-- Popped out, every side and corner pulls (only the right and bottom did, 2026-10-24). -->
                <Thumb x:Name="TopRight" Grid.RowSpan="3" Grid.ColumnSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
                <Thumb x:Name="BottomLeft" Grid.RowSpan="3" Grid.ColumnSpan="2" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragStarted="Edge_Start" DragDelta="Edge_Drag" DragCompleted="Edge_End" Opacity="0" />
            </Grid>
        </ctl:SmoothBorder>
    </Grid>
</UserControl>
