<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004's own APIs: the Media tile reads Windows' media controls (Windows.Media.Control). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Rigsight.Agent</RootNamespace>
    <AssemblyName>Rigsight.Agent</AssemblyName>
    <AssemblyTitle>RigSight background agent</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\Rigsight.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutDir>$(SharedBinDir)</OutDir>

    <!-- Keep the always-running agent small: no background GC thread, workstation GC, trimmed heap. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!-- Windows' own APIs for .NET (the Media tile's media controls) stay as they come, not compiled ahead of time:
       ReadyToRun doubled the file to 53 MB for the handful of types one tile uses. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="WinRT.Runtime.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\Rigsight.ico" Link="Rigsight.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rigsight.Core\Rigsight.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rigsight.Tests" />
    <!-- tools\Rigsight.DiskTraceProbe: measures the disk trace on its own. -->
    <InternalsVisibleTo Include="Rigsight.DiskTraceProbe" />
  </ItemGroup>

</Project>
